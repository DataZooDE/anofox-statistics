    SELECT (elasticnet_fit_predict(y, [x1, x2], {'alpha': 0.1, 'l1_ratio': 0.5}) OVER (ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)).yhat AS yhat FROM ts);
----
60	0

query II
SELECT count(*), count(yhat) FROM (
    SELECT (wls_fit_predict(y, [x1, x2], w) OVER (ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)).yhat AS yhat FROM ts);
----
60	0

query II
SELECT count(*), count(yhat) FROM (
