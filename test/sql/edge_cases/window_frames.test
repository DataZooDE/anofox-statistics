SELECT count(*) FILTER (WHERE ref.n >= 4 AND (win.yhat IS NULL) <> (ref.r IS NULL)),
       count(*) FILTER (WHERE ref.r IS NOT NULL
                          AND abs(win.yhat - (ref.r.intercept + ref.r.coefficients[1] * win.x1 + ref.r.coefficients[2] * win.x2)) > 1e-6)
FROM win JOIN ref USING (t);
----
0	0

# theil_sen_fit_predict
query II
WITH win AS (
    SELECT t, x1, x2, (theil_sen_fit_predict(y, [x1, x2]) OVER (ORDER BY t RANGE BETWEEN 6 PRECEDING AND CURRENT ROW)).yhat AS yhat
    FROM ts),
ref AS (
    SELECT o.t, theil_sen_fit_agg(i.y, [i.x1, i.x2] ORDER BY i.t) AS r, count(*) AS n
    FROM ts o JOIN ts i ON i.t BETWEEN o.t - 6 AND o.t
    GROUP BY o.t)
SELECT count(*) FILTER (WHERE ref.n >= 4 AND (win.yhat IS NULL) <> (ref.r IS NULL)),
       count(*) FILTER (WHERE ref.r IS NOT NULL
                          AND abs(win.yhat - (ref.r.intercept + ref.r.coefficients[1] * win.x1 + ref.r.coefficients[2] * win.x2)) > 1e-6)
FROM win JOIN ref USING (t);
----
0	0

# ransac_fit_predict
# The final RANSAC model is the OLS fit on the inliers; when the inliers are
# collinear (4-row frames where x2 = 1.5 x1 - 1.75) a column is aliased and its
# coefficient is NaN (R: NA), contributing nothing to the prediction.
query II
WITH win AS (
    SELECT t, x1, x2, (ransac_fit_predict(y, [x1, x2], {'random_state': 42}) OVER (ORDER BY t RANGE BETWEEN 6 PRECEDING AND CURRENT ROW)).yhat AS yhat
    FROM ts),
ref AS (
    SELECT o.t, ransac_fit_agg(i.y, [i.x1, i.x2], {'random_state': 42} ORDER BY i.t) AS r, count(*) AS n
    FROM ts o JOIN ts i ON i.t BETWEEN o.t - 6 AND o.t
    GROUP BY o.t)
SELECT count(*) FILTER (WHERE ref.n >= 4 AND (win.yhat IS NULL) <> (ref.r IS NULL)),
       count(*) FILTER (WHERE ref.r IS NOT NULL
                          AND abs(win.yhat - (ref.r.intercept
                                              + CASE WHEN isnan(ref.r.coefficients[1]) THEN 0 ELSE ref.r.coefficients[1] * win.x1 END
                                              + CASE WHEN isnan(ref.r.coefficients[2]) THEN 0 ELSE ref.r.coefficients[2] * win.x2 END)) > 1e-6)
FROM win JOIN ref USING (t);
----
0	0

# =============================================================================
# Frames that hold fewer rows than parameters (2 rows, 2 features + intercept):
# every prediction is NULL, no error.
# =============================================================================

query II
SELECT count(*), count(yhat) FROM (
    SELECT (ols_fit_predict(y, [x1, x2]) OVER (ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)).yhat AS yhat FROM ts);
----
60	0

query II
SELECT count(*), count(yhat) FROM (
    SELECT (ridge_fit_predict(y, [x1, x2], {'alpha': 0.5}) OVER (ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)).yhat AS yhat FROM ts);
----
60	0

query II
