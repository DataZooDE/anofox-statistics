60	0

query II
SELECT count(*), count(yhat) FROM (
    SELECT (ransac_fit_predict(y, [x1, x2], {'random_state': 42}) OVER (ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)).yhat AS yhat FROM ts);
