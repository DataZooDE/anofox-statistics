# name: test/sql/edge_cases/window_frames.test
# description: Window *_fit_predict with RANGE frames, frames holding fewer rows than
#              parameters, and the start of expanding windows. A window fit_predict
#              predicts for the LAST row of its frame (by design: a window aggregate
#              cannot see the current row), so every frame here ends at CURRENT ROW
#              over a unique ORDER BY key, making "last row of frame" = current row.
# group: [edge_cases]

require anofox_statistics

# t has gaps (every 5th step jumps by 4), so RANGE frames differ from ROWS frames.
statement ok
CREATE TABLE ts AS
SELECT (i + (i // 5) * 3)::INTEGER AS t,
       ((i % 7) + 0.5)::DOUBLE AS x1,
       (((i * 3) % 11) / 2.0)::DOUBLE AS x2,
       (3.0 + 0.8 * ((i % 7) + 0.5) - 0.3 * (((i * 3) % 11) / 2.0) + ((i * 37) % 13) / 13.0 - 0.5)::DOUBLE AS y,
       (1 + (i % 4))::DOUBLE AS w
FROM range(1, 61) t(i);

# =============================================================================
# RANGE BETWEEN 6 PRECEDING AND CURRENT ROW == fit on {s : t - 6 <= s.t <= t},
# evaluated at the current row's x. Frames with >= p + 2 rows must agree on NULL-ness;
# for smaller frames the window min-obs guard may be stricter than the aggregate's.
# =============================================================================

# ols_fit_predict
query II
WITH win AS (
    SELECT t, x1, x2, (ols_fit_predict(y, [x1, x2]) OVER (ORDER BY t RANGE BETWEEN 6 PRECEDING AND CURRENT ROW)).yhat AS yhat
    FROM ts),
ref AS (
    SELECT o.t, ols_fit_agg(i.y, [i.x1, i.x2]) AS r, count(*) AS n
    FROM ts o JOIN ts i ON i.t BETWEEN o.t - 6 AND o.t
    GROUP BY o.t)
SELECT count(*) FILTER (WHERE ref.n >= 4 AND (win.yhat IS NULL) <> (ref.r IS NULL)),
       count(*) FILTER (WHERE ref.r IS NOT NULL
                          AND abs(win.yhat - (ref.r.intercept + ref.r.coefficients[1] * win.x1 + ref.r.coefficients[2] * win.x2)) > 1e-6)
FROM win JOIN ref USING (t);
----
0	0

# ridge_fit_predict
query II
WITH win AS (
    SELECT t, x1, x2, (ridge_fit_predict(y, [x1, x2], {'alpha': 0.5}) OVER (ORDER BY t RANGE BETWEEN 6 PRECEDING AND CURRENT ROW)).yhat AS yhat
    FROM ts),
ref AS (
    SELECT o.t, ridge_fit_agg(i.y, [i.x1, i.x2], {'alpha': 0.5}) AS r, count(*) AS n
    FROM ts o JOIN ts i ON i.t BETWEEN o.t - 6 AND o.t
    GROUP BY o.t)
SELECT count(*) FILTER (WHERE ref.n >= 4 AND (win.yhat IS NULL) <> (ref.r IS NULL)),
       count(*) FILTER (WHERE ref.r IS NOT NULL
                          AND abs(win.yhat - (ref.r.intercept + ref.r.coefficients[1] * win.x1 + ref.r.coefficients[2] * win.x2)) > 1e-6)
FROM win JOIN ref USING (t);
----
0	0

# elasticnet_fit_predict
query II
WITH win AS (
    SELECT t, x1, x2, (elasticnet_fit_predict(y, [x1, x2], {'alpha': 0.1, 'l1_ratio': 0.5}) OVER (ORDER BY t RANGE BETWEEN 6 PRECEDING AND CURRENT ROW)).yhat AS yhat
    FROM ts),
ref AS (
    SELECT o.t, elasticnet_fit_agg(i.y, [i.x1, i.x2], {'alpha': 0.1, 'l1_ratio': 0.5}) AS r, count(*) AS n
    FROM ts o JOIN ts i ON i.t BETWEEN o.t - 6 AND o.t
    GROUP BY o.t)
SELECT count(*) FILTER (WHERE ref.n >= 4 AND (win.yhat IS NULL) <> (ref.r IS NULL)),
       count(*) FILTER (WHERE ref.r IS NOT NULL
                          AND abs(win.yhat - (ref.r.intercept + ref.r.coefficients[1] * win.x1 + ref.r.coefficients[2] * win.x2)) > 1e-6)
FROM win JOIN ref USING (t);
----
0	0

# wls_fit_predict
query II
WITH win AS (
    SELECT t, x1, x2, (wls_fit_predict(y, [x1, x2], w) OVER (ORDER BY t RANGE BETWEEN 6 PRECEDING AND CURRENT ROW)).yhat AS yhat
    FROM ts),
ref AS (
    SELECT o.t, wls_fit_agg(i.y, [i.x1, i.x2], i.w) AS r, count(*) AS n
    FROM ts o JOIN ts i ON i.t BETWEEN o.t - 6 AND o.t
    GROUP BY o.t)
SELECT count(*) FILTER (WHERE ref.n >= 4 AND (win.yhat IS NULL) <> (ref.r IS NULL)),
       count(*) FILTER (WHERE ref.r IS NOT NULL
                          AND abs(win.yhat - (ref.r.intercept + ref.r.coefficients[1] * win.x1 + ref.r.coefficients[2] * win.x2)) > 1e-6)
FROM win JOIN ref USING (t);
----
0	0

# rls_fit_predict
query II
WITH win AS (
    SELECT t, x1, x2, (rls_fit_predict(y, [x1, x2]) OVER (ORDER BY t RANGE BETWEEN 6 PRECEDING AND CURRENT ROW)).yhat AS yhat
    FROM ts),
ref AS (
    SELECT o.t, rls_fit_agg(i.y, [i.x1, i.x2] ORDER BY i.t) AS r, count(*) AS n
    FROM ts o JOIN ts i ON i.t BETWEEN o.t - 6 AND o.t
    GROUP BY o.t)
SELECT count(*) FILTER (WHERE ref.n >= 4 AND (win.yhat IS NULL) <> (ref.r IS NULL)),
       count(*) FILTER (WHERE ref.r IS NOT NULL
                          AND abs(win.yhat - (ref.r.intercept + ref.r.coefficients[1] * win.x1 + ref.r.coefficients[2] * win.x2)) > 1e-6)
FROM win JOIN ref USING (t);
----
0	0

