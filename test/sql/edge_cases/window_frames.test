60	0

# =============================================================================
# Expanding window: the first rows (frame smaller than the min-obs guard) are
# NULL, later rows are populated, and nothing errors. OLS needs n >= p + 2 here.
# =============================================================================

query III
SELECT count(*) FILTER (WHERE rn <= 3 AND yhat IS NOT NULL),
       count(*) FILTER (WHERE rn >= 5 AND yhat IS NULL),
       count(*)
FROM (SELECT row_number() OVER (ORDER BY t) AS rn,
             (ols_fit_predict(y, [x1, x2]) OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)).yhat AS yhat
      FROM ts);
----
0	0	60

# Expanding window equals a per-row fit on all rows up to t, at the current x.
query I
WITH win AS (
    SELECT t, x1, x2, (ols_fit_predict(y, [x1, x2]) OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)).yhat AS yhat
    FROM ts),
ref AS (
    SELECT o.t, ols_fit_agg(i.y, [i.x1, i.x2]) AS r FROM ts o JOIN ts i ON i.t <= o.t GROUP BY o.t)
SELECT count(*) FILTER (WHERE ref.r IS NOT NULL
                          AND abs(win.yhat - (ref.r.intercept + ref.r.coefficients[1] * win.x1 + ref.r.coefficients[2] * win.x2)) > 1e-6)
FROM win JOIN ref USING (t);
----
0

# Empty frame (ROWS BETWEEN 2 PRECEDING AND 1 PRECEDING on the first row, plus a
# frame that is always empty) -> NULL, no error.
query II
SELECT count(*), count(yhat) FROM (
    SELECT (ols_fit_predict(y, [x1, x2]) OVER (ORDER BY t ROWS BETWEEN 3 FOLLOWING AND 2 FOLLOWING)).yhat AS yhat FROM ts);
----
60	0
