# isotonic takes a scalar x: a NULL x keeps the row with NULL yhat
query III
SELECT len(r), r[5].yhat IS NULL, r[5].is_training
FROM (SELECT isotonic_fit_predict_agg(y, CASE WHEN t = 5 THEN NULL ELSE t::DOUBLE END ORDER BY t) AS r FROM d);
----
20	true	false

# The _by macros keep the row as well
statement ok
CREATE TABLE dg AS SELECT 1 AS g, t, y, x FROM d;

query III
SELECT count(*), bool_and(yhat IS NULL) FILTER (WHERE t = 5), count(*) FILTER (WHERE isnan(yhat))
FROM ols_fit_predict_by('dg', g, y, x);
----
20	true	0

# =============================================================================
# Window *_fit_predict: NULL, never NaN, for an incomplete current x
# =============================================================================

# ols_fit_predict, cumulative frame
query III
SELECT bool_and(yhat IS NULL) FILTER (WHERE bad_x), count(*) FILTER (WHERE isnan(yhat)),
       bool_and(yhat IS NOT NULL) FILTER (WHERE NOT bad_x AND t >= 12)
FROM (SELECT t, bad_x, (ols_fit_predict(y, x) OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)).yhat AS yhat FROM d);
----
true	0	true

# ridge_fit_predict, cumulative frame
query III
SELECT bool_and(yhat IS NULL) FILTER (WHERE bad_x), count(*) FILTER (WHERE isnan(yhat)),
