# The whole struct is NULL, so the bounds are NULL too
query I
SELECT bool_and(r IS NULL) FROM (SELECT t, ols_fit_predict(y, x) OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS r FROM d) WHERE t IN (5, 6, 10);
----
true

# null_policy 'zero' fills a NULL element (t = 6 is predicted) but not a NULL list or NaN
query III
SELECT t, r IS NULL, isnan(r) FROM (
    SELECT t, (ols_fit_predict(y, x, {'null_policy': 'zero'}) OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)).yhat AS r FROM d
) WHERE t IN (5, 6, 10) ORDER BY t;
----
5	true	NULL
6	false	false
10	true	NULL

# Long partition: frames are built from segment-tree combines. A frame whose last row has
# a NULL x must not reuse the x of an earlier combined block.
statement ok
CREATE TABLE big AS
SELECT i AS t,
       CASE WHEN i % 37 = 0 THEN NULL
            WHEN i % 41 = 0 THEN [i::DOUBLE, NULL]
            WHEN i % 43 = 0 THEN [i::DOUBLE, 'NaN'::DOUBLE]
            ELSE [i::DOUBLE, ((i * 7) % 11)::DOUBLE] END AS x,
       2.0 * i + sin(i) AS y,
       1.0 + i % 3 AS w
FROM range(1, 2001) r(i);

statement ok
CREATE TABLE big_pred AS
SELECT t, (x IS NULL OR len(list_filter(x, lambda e: e IS NULL OR isnan(e))) > 0) AS bad_x,
       [(ols_fit_predict(y, x) OVER s).yhat, (ridge_fit_predict(y, x) OVER s).yhat,
        (wls_fit_predict(y, x, w) OVER s).yhat, (rls_fit_predict(y, x) OVER s).yhat,
        (elasticnet_fit_predict(y, x) OVER s).yhat, (huber_fit_predict(y, x) OVER s).yhat,
        (ransac_fit_predict(y, x) OVER s).yhat, (theil_sen_fit_predict(y, x) OVER s).yhat,
        (passive_aggressive_fit_predict(y, x) OVER s).yhat,
        (ols_fit_predict(y, x) OVER c).yhat, (passive_aggressive_fit_predict(y, x) OVER c).yhat] AS preds
FROM big
WINDOW s AS (ORDER BY t ROWS BETWEEN 50 PRECEDING AND CURRENT ROW),
       c AS (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW);

query III
SELECT count(*) FILTER (WHERE bad_x AND v IS NOT NULL),
       count(*) FILTER (WHERE isnan(v)),
       count(*) FILTER (WHERE NOT bad_x AND v IS NULL AND t > 60)
FROM (SELECT t, bad_x, unnest(preds) AS v FROM big_pred);
----
0	0	0

# =============================================================================
# ols_augment_by / wls_augment_by: the NaN that marks held-out rows never leaks
# =============================================================================

statement ok
CREATE TABLE aug AS
SELECT i AS t, 1 AS g,
       CASE WHEN i IN (4, 10) THEN NULL ELSE i::DOUBLE END AS x1,
       CASE WHEN i = 7 THEN NULL ELSE 2.0 * i + sin(i) END AS y,
       1.0 + i % 2 AS w,
       CASE WHEN i > 8 THEN 'test' ELSE 'train' END AS s
FROM range(1, 11) r(i);

query II
SELECT count(*) FILTER (WHERE isnan(y) OR isnan(fitted) OR isnan(residual) OR isnan(std_residual) OR isnan(stud_residual)
                         OR isnan(leverage) OR isnan(cooks_d) OR isnan(dffits) OR isnan(weight)),
       count(*) FILTER (WHERE t = 9 AND y IS NOT NULL AND residual IS NULL AND fitted IS NOT NULL AND NOT is_training)
FROM ols_augment_by('aug', g, y, [x1], split := s);
----
0	1

query II
SELECT count(*) FILTER (WHERE isnan(y) OR isnan(fitted) OR isnan(residual) OR isnan(std_residual) OR isnan(stud_residual)
                         OR isnan(leverage) OR isnan(cooks_d) OR isnan(dffits) OR isnan(weight)),
       count(*) FILTER (WHERE t = 9 AND y IS NOT NULL AND residual IS NULL AND fitted IS NOT NULL AND NOT is_training)
FROM wls_augment_by('aug', g, y, [x1], w, split := s);
----
0	1

query I
SELECT count(*) FILTER (WHERE isnan(y) OR isnan(fitted) OR isnan(residual) OR isnan(leverage) OR isnan(cooks_d))
FROM ols_augment_by('aug', g, y, [x1], {'null_policy': 'zero'}, split := s);
----
0
