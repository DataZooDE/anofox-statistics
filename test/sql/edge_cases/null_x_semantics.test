# name: test/sql/edge_cases/null_x_semantics.test
# description: NULL / incomplete x contract of docs/NULL_SEMANTICS.md (#208).
#              *_fit_predict_agg keeps a row whose x list is NULL (yhat NULL, is_training false).
#              Window *_fit_predict returns NULL (never NaN) for a row whose x is NULL or has a
#              NULL/NaN element, in cumulative and sliding frames, also across segment-tree
#              combines of long partitions.
# group: [edge_cases]

require anofox_statistics

# 20 rows: t = 5 has a NULL x list, t = 6 a NULL element, t = 10 a NaN element, t = 8 a NULL y.
statement ok
CREATE TABLE d AS
SELECT i AS t,
       CASE WHEN i = 5 THEN NULL
            WHEN i = 6 THEN [6.0, NULL]
            WHEN i = 10 THEN [10.0, 'NaN'::DOUBLE]
            ELSE [i::DOUBLE, ((i * 7) % 5)::DOUBLE] END AS x,
       CASE WHEN i = 8 THEN NULL ELSE 1.0 + 2 * i + ((i * 7) % 5) + 0.3 * sin(i) END AS y,
       1.0 + (i % 3) AS w,
       (x IS NULL OR len(list_filter(x, lambda e: e IS NULL OR isnan(e))) > 0) AS bad_x
FROM range(1, 21) r(i);

# =============================================================================
# *_fit_predict_agg: a NULL x list keeps its row, in input order, with NULL yhat
# =============================================================================

query IIIII
SELECT len(r), r[5].yhat IS NULL, r[5].is_training, r[5].y IS NOT NULL, r[6].yhat IS NULL
FROM (SELECT ols_fit_predict_agg(y, x ORDER BY t) AS r FROM d);
----
20	true	false	true	true

query IIIII
SELECT len(r), r[5].yhat IS NULL, r[5].is_training, r[5].y IS NOT NULL, r[6].yhat IS NULL
FROM (SELECT ridge_fit_predict_agg(y, x ORDER BY t) AS r FROM d);
----
20	true	false	true	true

query IIIII
SELECT len(r), r[5].yhat IS NULL, r[5].is_training, r[5].y IS NOT NULL, r[6].yhat IS NULL
