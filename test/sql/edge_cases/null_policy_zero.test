# name: test/sql/edge_cases/null_policy_zero.test
# description: null_policy 'zero' fits a NULL y or NULL x element as 0, which must equal
#              fitting the explicitly COALESCE(..., 0)-filled data; 'ignore' is an alias for
#              'drop' (#8). Covers every function that accepts null_policy.
# group: [edge_cases]

require anofox_statistics

# NULL y at t = 5, 17 (and the 'test' rows 28-30); NULL x2 at t = 9, 23, 29.
statement ok
CREATE TABLE nz AS
SELECT t, 'a' AS g,
       CASE WHEN t IN (5, 17) OR t >= 28 THEN NULL ELSE 2.0 + 0.5 * t + 0.3 * ((t * 7) % 11) + sin(t) END AS y,
       CASE WHEN t IN (5, 17) OR t >= 28 THEN NULL ELSE round(exp(0.5 + 0.05 * t)) END::DOUBLE AS y_cnt,
       t::DOUBLE AS x1,
       CASE WHEN t IN (9, 23, 29) THEN NULL ELSE ((t * 7) % 11)::DOUBLE END AS x2,
       (1.0 + t % 3)::DOUBLE AS w,
       CASE WHEN t <= 27 THEN 'train' ELSE 'test' END AS split
FROM range(1, 31) r(t);

statement ok
CREATE VIEW nz_filled AS
SELECT t, g, coalesce(y, 0.0) AS y, coalesce(y_cnt, 0.0) AS y_cnt, x1, coalesce(x2, 0.0) AS x2, w, split FROM nz;

# =============================================================================
# *_fit_predict_agg: 'zero' == fitting the zero-filled data (no split column, so every
# row trains), and with a split column (the 'test' rows are predicted, not trained on)
# =============================================================================

query II
SELECT
    (SELECT ols_fit_predict_agg(y, [x1, x2], {'null_policy': 'zero'} ORDER BY t) FROM nz)
  = (SELECT ols_fit_predict_agg(y, [x1, x2] ORDER BY t) FROM nz_filled),
    (SELECT ols_fit_predict_agg(y, [x1, x2], split, {'null_policy': 'zero'} ORDER BY t) FROM nz)
  = (SELECT ols_fit_predict_agg(y, [x1, x2], split ORDER BY t) FROM nz_filled);
----
true	true

query II
SELECT
    (SELECT ridge_fit_predict_agg(y, [x1, x2], {'null_policy': 'zero'} ORDER BY t) FROM nz)
  = (SELECT ridge_fit_predict_agg(y, [x1, x2] ORDER BY t) FROM nz_filled),
    (SELECT ridge_fit_predict_agg(y, [x1, x2], split, {'null_policy': 'zero'} ORDER BY t) FROM nz)
  = (SELECT ridge_fit_predict_agg(y, [x1, x2], split ORDER BY t) FROM nz_filled);
----
true	true

