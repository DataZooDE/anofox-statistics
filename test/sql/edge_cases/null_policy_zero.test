    SELECT t, wls_fit_predict(y, [x1, x2], w)
               OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS b FROM nz_filled
) USING (t);
----
true

# Row t = 29 (NULL y, NULL x2) gets a prediction under 'zero', NULL under 'drop' (#208)
query II
SELECT
    (SELECT p FROM (SELECT t, (ols_fit_predict(y, [x1, x2], {'null_policy': 'zero'})
        OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)).yhat AS p FROM nz) WHERE t = 29) > 0,
    (SELECT p FROM (SELECT t, (ols_fit_predict(y, [x1, x2])
        OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)).yhat AS p FROM nz) WHERE t = 29)
        IS NULL;
----
true	true

# =============================================================================
# ols_augment_agg / wls_augment_agg
# =============================================================================

query II
SELECT
    (SELECT ols_augment_agg(y, [x1, x2], {'null_policy': 'zero'} ORDER BY t) FROM nz)
  = (SELECT ols_augment_agg(y, [x1, x2] ORDER BY t) FROM nz_filled),
    (SELECT wls_augment_agg(y, [x1, x2], w, {'null_policy': 'zero'} ORDER BY t) FROM nz)
  = (SELECT wls_augment_agg(y, [x1, x2], w ORDER BY t) FROM nz_filled);
----
true	true

# =============================================================================
# 'ignore' is an alias for 'drop'; values are case-insensitive
# =============================================================================

query III
SELECT
    (SELECT ols_fit_predict_agg(y, [x1, x2], {'null_policy': 'ignore'} ORDER BY t) FROM nz)
  = (SELECT ols_fit_predict_agg(y, [x1, x2], {'null_policy': 'drop'} ORDER BY t) FROM nz),
    (SELECT ols_fit_predict_agg(y, [x1, x2], {'null_policy': 'ZERO'} ORDER BY t) FROM nz)
  = (SELECT ols_fit_predict_agg(y, [x1, x2], {'null_policy': 'zero'} ORDER BY t) FROM nz),
    (SELECT bool_and(a IS NOT DISTINCT FROM b) FROM (
        SELECT t, ridge_fit_predict(y, [x1, x2], {'null_policy': 'ignore'})
                   OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS a,
                  ridge_fit_predict(y, [x1, x2])
                   OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS b FROM nz));
----
true	true	true

statement error
SELECT ols_fit_predict_agg(y, [x1], {'null_policy': 'fill'}) FROM nz;
----
Invalid null_policy: 'fill'. Valid values are 'drop', 'drop_y_zero_x', 'zero', 'ignore'
