true	true

# Every row trains without a split column; the zero-filled y is reported as 0
query III
SELECT count(*) FILTER (WHERE p.is_training), count(*) FILTER (WHERE p.y = 0.0), count(*) FILTER (WHERE p.yhat IS NULL)
FROM (SELECT unnest(ols_fit_predict_agg(y, [x1, x2], {'null_policy': 'zero'} ORDER BY t)) AS p FROM nz);
----
30	5	0

# With a split column the 'test' rows (NULL y, one NULL x2) are predicted, not trained on
query II
SELECT count(*) FILTER (WHERE p.is_training), count(*) FILTER (WHERE NOT p.is_training AND p.yhat IS NOT NULL)
FROM (SELECT unnest(ols_fit_predict_agg(y, [x1, x2], split, {'null_policy': 'zero'} ORDER BY t)) AS p FROM nz);
----
27	3

# The default 'drop' leaves the NULL rows out of training
query I
SELECT count(*) FILTER (WHERE p.is_training)
FROM (SELECT unnest(ols_fit_predict_agg(y, [x1, x2] ORDER BY t)) AS p FROM nz);
----
23

# A NULL x list is not zero-filled (its length is unknown): the row is left out as under 'drop'
query II
SELECT p.is_training, p.yhat IS NULL
FROM (SELECT (ols_fit_predict_agg(y, x, {'null_policy': 'zero'} ORDER BY t))[3] AS p
      FROM (SELECT t, y, CASE WHEN t = 3 THEN NULL ELSE [x1] END AS x FROM nz));
----
false	true

# NaN is not NULL and is not zero-filled
statement ok
CREATE VIEW nan_rows AS
SELECT t, CASE WHEN t = 2 THEN 'NaN'::DOUBLE ELSE coalesce(y, 1.0) END AS y, x1 FROM nz;

query I
SELECT (SELECT ols_fit_predict_agg(y, [x1], {'null_policy': 'zero'} ORDER BY t) FROM nan_rows)
     = (SELECT ols_fit_predict_agg(y, [x1] ORDER BY t) FROM nan_rows)
FROM (SELECT 1);
----
true

# =============================================================================
# *_fit_predict_by macros pass null_policy through
# =============================================================================

query I
SELECT count(*) FILTER (WHERE is_training)
FROM ols_fit_predict_by('nz', g, y, [x1, x2], {'null_policy': 'zero'}, order_by := t);
----
30

# With split := the held-out rows stay out of the fit under 'zero' (the macros pass the
# split to the aggregate rather than NULLing y), for the fit-predict and augment macros
query II
SELECT count(*) FILTER (WHERE is_training), count(*) FILTER (WHERE NOT is_training AND yhat IS NOT NULL)
FROM ols_fit_predict_by('nz', g, y, [x1, x2], {'null_policy': 'zero'}, split := split, order_by := t);
----
27	3

query I
SELECT count(*) FILTER (WHERE is_training)
FROM lm_dynamic_fit_predict_by('nz', g, y, [x1, x2], {'null_policy': 'zero'}, split := split, order_by := t);
----
27

query I
SELECT count(*) FILTER (WHERE is_training)
FROM ols_augment_by('nz', g, y, [x1, x2], {'null_policy': 'zero'}, split := split, order_by := t);
----
27

# The split change leaves the default 'drop' results of the macros unchanged
query I
SELECT count(*) FILTER (WHERE is_training)
FROM ols_fit_predict_by('nz', g, y, [x1, x2], split := split, order_by := t);
----
23

# =============================================================================
# Window *_fit_predict: 'zero' == the zero-filled data
# =============================================================================

query I
SELECT bool_and(a IS NOT DISTINCT FROM b) FROM (
    SELECT t, ols_fit_predict(y, [x1, x2], {'null_policy': 'zero'})
               OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS a FROM nz
) JOIN (
    SELECT t, ols_fit_predict(y, [x1, x2])
               OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS b FROM nz_filled
) USING (t);
----
true

