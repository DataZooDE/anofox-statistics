# name: test/sql/regression/test_splines.test
# description: #317 spline bases (rcs, lsp, bspline, spline_spec / spline_basis, restricted_interaction) and knot aggregates: behaviour, NULLs, edge cases, errors
# group: [regression]

require anofox_statistics

# =============================================================================
# rcs / lsp / bspline: shapes and basic values
# =============================================================================

# k knots give k - 1 rcs columns; the first is x itself; nothing nonlinear below the first knot.
query III
SELECT len(rcs(2.5, [0.0, 1.0, 3.0, 4.0, 6.0])), rcs(2.5, [0.0, 1.0, 3.0, 4.0, 6.0])[1], rcs(-1.0, [0.0, 1.0, 3.0]);
----
4	2.5	[-1.0, 0.0]

# Knots are sorted and de-duplicated (as upstream / rcspline.eval).
query I
SELECT rcs(2.5, [4.0, 0.0, 1.0, 1.0, 3.0, 6.0]) = rcs(2.5, [0.0, 1.0, 3.0, 4.0, 6.0]);
----
true

# Linear beyond the outer knots: second differences vanish.
query I
SELECT bool_and(abs(rcs(10.0, k)[j] - 2 * rcs(11.0, k)[j] + rcs(12.0, k)[j]) < 1e-9)
FROM (SELECT [0.0, 1.0, 3.0, 4.0, 6.0] AS k), range(1, 5) r(j);
----
true

query II
SELECT lsp(3.0, [1.0, 2.0, 5.0]), lsp(3.0, []::DOUBLE[]);
----
[3.0, 2.0, 1.0, 0.0]	[3.0]

# B-splines: n_knots + degree - 1 columns, summing to one inside the knots; include_bias drops the last.
query III
SELECT len(bspline(0.7, [0.0, 1.0, 2.0])), abs(list_sum(bspline(0.7, [0.0, 1.0, 2.0])) - 1) < 1e-12,
       len(bspline(0.7, [0.0, 1.0, 2.0], 3, {'include_bias': false}));
----
5	true	4

query I
SELECT len(bspline(0.7, [0.0, 1.0, 2.0, 3.0], 2, {'extrapolation': 'periodic'}));
----
3

# Vectorised over a column with per-row knots.
query II
SELECT x, list_transform(rcs(x, k), lambda v: round(v, 9)) FROM (VALUES (1.0, [0.0, 2.0, 4.0]), (3.0, [0.0, 1.0, 2.0]), (5.0, [0.0, 2.0, 4.0])) t(x, k) ORDER BY x;
----
1.0	[1.0, 0.0625]
3.0	[3.0, 3.0]
5.0	[5.0, 4.5]

# =============================================================================
# NULL handling: NULL / NaN / Inf x or NULL knots give NULL
# =============================================================================

query IIIII
SELECT rcs(NULL, [0.0, 1.0, 2.0]), rcs(1.0, NULL), lsp('NaN'::DOUBLE, [1.0]), bspline('inf'::DOUBLE, [0.0, 1.0]),
       spline_basis(NULL, spline_spec('rcs', [0.0, 1.0, 2.0]));
----
NULL	NULL	NULL	NULL	NULL

query II
SELECT x, lsp(x, [1.0]) FROM (VALUES (2.0), (NULL), (0.5)) t(x) ORDER BY x NULLS LAST;
----
0.5	[0.5, 0.0]
2.0	[2.0, 1.0]
NULL	NULL

# =============================================================================
# spline_spec / spline_basis
# =============================================================================

query IIIIIIII
SELECT s.kind, s.knots, s.norm, s.degree, s.extrapolation, s.include_bias, s.n_columns, s.nonlinear
FROM (SELECT spline_spec('rcs', [3.0, 1.0, 2.0, 4.0]) AS s);
----
rcs	[1.0, 2.0, 3.0, 4.0]	2	NULL	NULL	NULL	3	[false, true, true]

query IIIIIIII
SELECT s.kind, s.knots, s.norm, s.degree, s.extrapolation, s.include_bias, s.n_columns, s.nonlinear
FROM (SELECT spline_spec('bspline', [0.0, 1.0, 2.0], {'degree': 2, 'extrapolation': 'linear', 'include_bias': false}) AS s);
----
bspline	[0.0, 1.0, 2.0]	NULL	2	linear	false	3	[true, true, true]

query II
SELECT (spline_spec('lsp', [5.0])).n_columns, (spline_spec('LSP', [5.0])).nonlinear;
----
2	[false, true]

# spline_basis reproduces the direct functions.
query III
SELECT spline_basis(2.5, spline_spec('rcs', [0.0, 1.0, 3.0, 4.0, 6.0], {'norm': 0})) = rcs(2.5, [0.0, 1.0, 3.0, 4.0, 6.0], {'norm': 0}),
       spline_basis(2.5, spline_spec('lsp', [1.0, 2.0])) = lsp(2.5, [1.0, 2.0]),
       spline_basis(12.0, spline_spec('bspline', [0.0, 5.0, 10.0], {'degree': 2, 'extrapolation': 'continue'}))
           = bspline(12.0, [0.0, 5.0, 10.0], 2, {'extrapolation': 'continue'});
----
true	true	true

# A hand-written STRUCT with only kind and knots works (defaults for the rest).
query I
SELECT spline_basis(2.5, {'kind': 'rcs', 'knots': [0, 1, 3, 4, 6]}) = rcs(2.5, [0.0, 1.0, 3.0, 4.0, 6.0]);
----
true

# The spec stored in a table expands new data later.
statement ok
CREATE TABLE spline_train AS SELECT (i * 7 % 101)::DOUBLE AS x, sin((i * 7 % 101) / 10.0) + (i * 7 % 101) / 50.0 AS y FROM range(200) t(i);

statement ok
CREATE TABLE spline_specs AS SELECT spline_spec('rcs', rcs_knots_agg(x, 4)) AS spec FROM spline_train;

query II
SELECT len(spline_basis(50.0, spec)), spline_basis(50.0, spec) = rcs(50.0, spec.knots) FROM spline_specs;
----
3	true

# And the basis feeds any fit.
query I
SELECT (ols_fit_agg(y, spline_basis(x, spec))).r_squared > 0.5 FROM spline_train, spline_specs;
----
true

# =============================================================================
# restricted_interaction
# =============================================================================

# rcs(4 knots) %ia% rcs(3 knots): x1*x2, x1*x2', x1'*x2, x1''*x2
query I
SELECT restricted_interaction([2.0, 0.5, 0.25], [3.0, 0.1]);
----
[6.0, 0.2, 1.5, 0.75]

query I
SELECT restricted_interaction([2.0, 0.5], [0.2, 0.3, 0.5], [false, true], (spline_spec('bspline', [0.0, 1.0], {'degree': 2})).nonlinear);
----
[0.4, 0.6, 1.0]

query II
SELECT restricted_interaction(NULL, [1.0]), restricted_interaction([1.0, NULL], [1.0]);
----
NULL	NULL

# =============================================================================
# rcs_knots_agg / bspline_knots_agg
# =============================================================================

query II
SELECT len(rcs_knots_agg(x)), len(rcs_knots_agg(x, 3)) FROM spline_train;
----
5	3

# Per group; NULL / NaN / Inf values skipped; too few values give NULL.
query II
SELECT g, rcs_knots_agg(x, 3) FROM (VALUES (1, 1.0::DOUBLE), (1, 2.0), (1, 3.0), (1, 4.0), (1, 5.0), (1, 6.0), (1, 7.0), (1, NULL),
    (1, 'NaN'), (1, 'inf'), (2, 1.0), (2, 2.0)) t(g, x) GROUP BY g ORDER BY g;
----
1	[3.0, 4.0, 5.0]
2	NULL

query I
SELECT rcs_knots_agg(x, 3) FROM (SELECT 1.0 AS x FROM range(20));
----
NULL

query I
SELECT rcs_knots_agg(x) FROM (SELECT 1.0 AS x WHERE false);
----
NULL

query II
SELECT bspline_knots_agg(x, 3), bspline_knots_agg(x, 3, {'knots': 'quantile'}) FROM (VALUES (0.0), (1.0), (2.0), (10.0)) t(x);
----
[0.0, 5.0, 10.0]	[0.0, 1.5, 10.0]

query I
SELECT bspline_knots_agg(x) FROM (SELECT 2.0 AS x FROM range(10));
----
NULL

query I
SELECT default_knot_quantiles(NULL);
----
NULL

# =============================================================================
# Errors: invalid knots and options raise
# =============================================================================

statement error
SELECT rcs(1.0, [0.0, 1.0]);
----
need at least 3 knots

statement error
SELECT rcs(1.0, [0.0, NULL, 1.0, 2.0]);
----
knots must be finite

statement error
SELECT rcs(1.0, [0.0, 1.0, 2.0], {'norm': 3});
----
norm must be 0, 1 or 2

statement error
SELECT rcs(1.0, [0.0, 1.0, 2.0], {'degree': 3});
----
unknown option 'degree'

statement error
SELECT bspline(1.0, [0.0]);
----
need at least 2 knots

statement error
SELECT bspline(1.0, [0.0, 2.0, 1.0]);
----
knots must be sorted without duplicates

statement error
SELECT bspline(1.0, [0.0, 1.0, 2.0], 3, {'extrapolation': 'periodic'});
----
periodic splines require degree < n_knots

statement error
SELECT bspline(5.0, [0.0, 1.0, 2.0], 3, {'extrapolation': 'error'});
----
beyond the limits of the knots

statement error
SELECT bspline(1.0, [0.0, 1.0, 2.0], 3, {'extrapolation': 'wrap'});
----
Invalid extrapolation

statement error
SELECT bspline(1.0, [0.0, 1.0, 2.0], -1);
----
degree must be between 0 and 100

statement error
SELECT spline_spec('natural', [0.0, 1.0, 2.0]);
----
kind must be 'rcs', 'lsp' or 'bspline'

statement error
SELECT spline_spec('lsp', [0.0, 1.0, 2.0], {'norm': 1});
----
norm applies only to kind 'rcs'

statement error
SELECT spline_spec('rcs', [0.0, 1.0, 2.0], {'degree': 2});
----
apply only to kind 'bspline'

statement error
SELECT spline_basis(1.0, 3.0);
----
spec must be a STRUCT

statement error
SELECT spline_basis(1.0, {'knots': [0.0, 1.0, 2.0]});
----
must have the fields 'kind' and 'knots'

statement error
SELECT default_knot_quantiles(2);
----
nk must be between 3 and 1000

statement error
SELECT restricted_interaction([1.0, 2.0], [1.0], [false], [false]);
----
one flag per element

statement error
SELECT rcs_knots_agg(x, 2) FROM spline_train;
----
nk must be between 3 and 1000

statement error
SELECT rcs_knots_agg(x, n) FROM (SELECT x, 4 AS n FROM spline_train);
----
nk must be a constant

statement error
SELECT rcs_knots_agg(x, 4, {'knots': 'uniform'}) FROM spline_train;
----
unknown option 'knots'

statement error
SELECT bspline_knots_agg(x, 4, {'knots': 'random'}) FROM spline_train;
----
Invalid knots

# Parallel aggregation (Combine) gives the same knots as a single thread.
statement ok
CREATE TABLE spline_big AS SELECT (i * 7919 % 100003) / 1000.0 AS x, i % 4 AS g FROM range(400000) t(i);

statement ok
CREATE TABLE knots_par AS SELECT g, rcs_knots_agg(x, 5) AS k, bspline_knots_agg(x, 6, {'knots': 'quantile'}) AS b FROM spline_big GROUP BY g;

statement ok
SET threads = 1;

query I
SELECT bool_and(p.k = s.k AND p.b = s.b) FROM knots_par p
JOIN (SELECT g, rcs_knots_agg(x, 5) AS k, bspline_knots_agg(x, 6, {'knots': 'quantile'}) AS b FROM spline_big GROUP BY g) s USING (g);
----
true
