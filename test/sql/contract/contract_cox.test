# name: test/sql/contract/contract_cox.test
# description: integration contract (#312): cox_tidy_by `terms`, cox_glance_by `summary`, cox_augment_by `obs`
# group: [contract]

require anofox_statistics

statement ok
CREATE TABLE d AS SELECT range::DOUBLE AS x1, (range % 7)::DOUBLE AS x2,
    (2 * range + (range % 7) + (range % 3) * 1.5 + sin(range))::DOUBLE AS y, (1 + (range * 13 % 17))::DOUBLE AS dur,
    (range % 4 <> 0)::DOUBLE AS ev, (range % 2)::VARCHAR AS g
FROM range(40);

# The same columns as every other <model>_tidy_by / <model>_glance_by
query II
SELECT (SELECT string_agg(column_name || ' ' || column_type, ', ') FROM (DESCRIBE SELECT * FROM cox_tidy_by('d', g, dur, [x1, x2], ev)))
     = (SELECT string_agg(column_name || ' ' || column_type, ', ') FROM (DESCRIBE SELECT * FROM ols_tidy_by('d', g, y, [x1, x2]))),
       (SELECT string_agg(column_name || ' ' || column_type, ', ') FROM (DESCRIBE SELECT * FROM cox_glance_by('d', g, dur, [x1, x2], ev)))
     = (SELECT string_agg(column_name || ' ' || column_type, ', ') FROM (DESCRIBE SELECT * FROM ols_glance_by('d', g, y, [x1, x2])));
----
true	true

# No intercept term: one row per covariate and group
query I
SELECT count(*) FROM cox_tidy_by('d', g, dur, [x1, x2], ev);
----
4

# The source columns, the obs columns, then the Cox extras
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM cox_augment_by('d', g, dur, [x1, x2], ev))
----
x1	DOUBLE
x2	DOUBLE
y	DOUBLE
dur	DOUBLE
ev	DOUBLE
g	VARCHAR
model_id	VARCHAR
model_name	VARCHAR
row_id	BIGINT
fitted	DOUBLE
residual	DOUBLE
resid_type	VARCHAR
std_residual	DOUBLE
stud_residual	DOUBLE
leverage	DOUBLE
cooks_d	DOUBLE
dffits	DOUBLE
weight	DOUBLE
is_training	BOOLEAN
n_params	INTEGER
risk	DOUBLE
deviance_residual	DOUBLE
score_residuals	DOUBLE[]
dfbeta	DOUBLE[]
dfbetas	DOUBLE[]
schoenfeld_residuals	DOUBLE[]
scaled_schoenfeld_residuals	DOUBLE[]
stratum	DOUBLE
row_order	BIGINT

query III
SELECT function_name, tags['anofox.output'], tags['anofox.contract'] = anofox_contract_version()::VARCHAR
FROM duckdb_functions() WHERE function_name IN ('cox_tidy_by', 'cox_glance_by', 'cox_augment_by')
ORDER BY function_name;
----
cox_augment_by	obs	true
cox_glance_by	summary	true
cox_tidy_by	terms	true
