# name: test/sql/contract/contract_aft_augment.test
# description: integration contract (#322): aft_augment_by `obs`
# group: [contract]

require anofox_statistics

statement ok
CREATE TABLE d AS SELECT range::DOUBLE AS x1, (range % 7)::DOUBLE AS x2, (1 + (range * 13 % 17))::DOUBLE AS dur,
    (range % 4 <> 0)::DOUBLE AS ev, (range % 2)::VARCHAR AS g
FROM range(40);

# The source columns, the obs columns, then the AFT extra
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM aft_augment_by('d', g, dur, [x1, x2], ev))
----
x1	DOUBLE
x2	DOUBLE
dur	DOUBLE
ev	DOUBLE
g	VARCHAR
model_id	VARCHAR
model_name	VARCHAR
row_id	BIGINT
fitted	DOUBLE
residual	DOUBLE
resid_type	VARCHAR
std_residual	DOUBLE
stud_residual	DOUBLE
leverage	DOUBLE
cooks_d	DOUBLE
dffits	DOUBLE
weight	DOUBLE
is_training	BOOLEAN
n_params	INTEGER
score_contributions	DOUBLE[]
row_order	BIGINT

# The obs columns match cox_augment_by's
query I
SELECT (SELECT string_agg(column_name || ' ' || column_type, ', ') FROM (SELECT * FROM (DESCRIBE SELECT * FROM aft_augment_by('d', g, dur, [x1, x2], ev)) LIMIT 19))
     = (SELECT string_agg(column_name || ' ' || column_type, ', ') FROM (SELECT * FROM (DESCRIBE SELECT * FROM cox_augment_by('d', g, dur, [x1, x2], ev)) LIMIT 19))
----
true

query III
SELECT function_name, tags['anofox.output'], tags['anofox.contract'] = anofox_contract_version()::VARCHAR
FROM duckdb_functions() WHERE function_name = 'aft_augment_by'
----
aft_augment_by	obs	true

query II
SELECT count(*), count(DISTINCT row_id) FROM aft_augment_by('d', g, dur, [x1, x2], ev)
----
40	40
