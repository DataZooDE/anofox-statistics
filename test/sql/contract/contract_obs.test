# All nine macros (incl. glmm_augment_by, #218) are tagged as obs producers of contract version 1
query III
SELECT DISTINCT function_name, tags['anofox.output'], tags['anofox.contract'] FROM duckdb_functions()
WHERE function_name LIKE '%\_augment\_by' ESCAPE '\'
ORDER BY function_name
----
binomial_augment_by	obs	1
gamma_augment_by	obs	1
glmm_augment_by	obs	1
logistic_augment_by	obs	1
negbinom_augment_by	obs	1
ols_augment_by	obs	1
poisson_augment_by	obs	1
tweedie_augment_by	obs	1
wls_augment_by	obs	1
