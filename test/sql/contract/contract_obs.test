# name: test/sql/contract/contract_obs.test
# description: integration contract `obs` schema (#151): columns and types added by <model>_augment_by
# group: [contract]

require anofox_statistics

statement ok
CREATE TABLE d AS SELECT range::DOUBLE AS x1, (range % 7)::DOUBLE AS x2,
    (2 * range + (range % 7) + (range % 3) * 1.5 + sin(range))::DOUBLE AS y, (1.0 + (range % 4))::DOUBLE AS w,
    (range % 2)::VARCHAR AS g
FROM range(40);

# The source columns, then exactly the obs columns
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM ols_augment_by('d', g, y, [x1, x2]))
----
x1	DOUBLE
x2	DOUBLE
y	DOUBLE
w	DOUBLE
g	VARCHAR
model_id	VARCHAR
row_id	BIGINT
fitted	DOUBLE
residual	DOUBLE
resid_type	VARCHAR
std_residual	DOUBLE
stud_residual	DOUBLE
leverage	DOUBLE
cooks_d	DOUBLE
dffits	DOUBLE
weight	DOUBLE
is_training	BOOLEAN
n_params	INTEGER

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM wls_augment_by('d', g, y, [x1, x2], w))
----
x1	DOUBLE
x2	DOUBLE
y	DOUBLE
w	DOUBLE
g	VARCHAR
model_id	VARCHAR
row_id	BIGINT
fitted	DOUBLE
residual	DOUBLE
resid_type	VARCHAR
std_residual	DOUBLE
stud_residual	DOUBLE
leverage	DOUBLE
cooks_d	DOUBLE
dffits	DOUBLE
weight	DOUBLE
is_training	BOOLEAN
n_params	INTEGER

# Both macros are tagged as obs producers of contract version 1
query III
SELECT DISTINCT function_name, tags['anofox.output'], tags['anofox.contract'] FROM duckdb_functions()
WHERE function_name LIKE '%\_augment\_by' ESCAPE '\'
ORDER BY function_name
----
ols_augment_by	obs	1
wls_augment_by	obs	1
