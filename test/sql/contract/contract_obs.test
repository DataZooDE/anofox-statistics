# name: test/sql/contract/contract_obs.test
# description: integration contract `obs` schema (#151): columns and types added by <model>_augment_by
# group: [contract]

require anofox_statistics

statement ok
CREATE TABLE d AS SELECT range::DOUBLE AS x1, (range % 7)::DOUBLE AS x2,
    (2 * range + (range % 7) + (range % 3) * 1.5 + sin(range))::DOUBLE AS y, (1.0 + (range % 4))::DOUBLE AS w,
    (range % 2)::VARCHAR AS g
FROM range(40);

# The source columns, then exactly the obs columns
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM ols_augment_by('d', g, y, [x1, x2]))
----
x1	DOUBLE
x2	DOUBLE
y	DOUBLE
w	DOUBLE
g	VARCHAR
model_id	VARCHAR
model_name	VARCHAR
row_id	BIGINT
fitted	DOUBLE
residual	DOUBLE
resid_type	VARCHAR
std_residual	DOUBLE
stud_residual	DOUBLE
leverage	DOUBLE
cooks_d	DOUBLE
dffits	DOUBLE
weight	DOUBLE
is_training	BOOLEAN
n_params	INTEGER

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM wls_augment_by('d', g, y, [x1, x2], w))
----
x1	DOUBLE
x2	DOUBLE
y	DOUBLE
w	DOUBLE
g	VARCHAR
model_id	VARCHAR
model_name	VARCHAR
row_id	BIGINT
fitted	DOUBLE
residual	DOUBLE
resid_type	VARCHAR
std_residual	DOUBLE
stud_residual	DOUBLE
leverage	DOUBLE
cooks_d	DOUBLE
dffits	DOUBLE
weight	DOUBLE
is_training	BOOLEAN
n_params	INTEGER

# The GLM macros return the same obs columns
statement ok
CREATE TABLE dg AS SELECT range::DOUBLE AS x1, (range % 7)::DOUBLE AS x2, (range % 5)::DOUBLE AS yc,
    ((range * 7) % 5 < 2)::INTEGER::DOUBLE AS yb, (1.0 + (range % 4) + 0.1 * range)::DOUBLE AS yp,
    (range % 2)::VARCHAR AS g
FROM range(40);

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM poisson_augment_by('dg', g, yc, [x1, x2]))
----
x1	DOUBLE
x2	DOUBLE
yc	DOUBLE
yb	DOUBLE
yp	DOUBLE
g	VARCHAR
model_id	VARCHAR
model_name	VARCHAR
row_id	BIGINT
fitted	DOUBLE
residual	DOUBLE
resid_type	VARCHAR
std_residual	DOUBLE
stud_residual	DOUBLE
leverage	DOUBLE
cooks_d	DOUBLE
dffits	DOUBLE
weight	DOUBLE
is_training	BOOLEAN
n_params	INTEGER

