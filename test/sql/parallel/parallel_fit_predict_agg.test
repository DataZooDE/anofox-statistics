    SELECT 'poisson_fit_predict_agg' AS fn, g, 1e-6::DOUBLE AS tol, [list_count(poisson_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE cnt END, [x1, x2])), list_sum(list_transform(poisson_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE cnt END, [x1, x2]), p -> p.yhat)), list_sum(list_transform(poisson_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE cnt END, [x1, x2]), p -> p.yhat * p.yhat)), list_min(list_transform(poisson_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE cnt END, [x1, x2]), p -> p.yhat)), list_max(list_transform(poisson_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE cnt END, [x1, x2]), p -> p.yhat)), list_sum(list_transform(poisson_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE cnt END, [x1, x2]), p -> p.is_training::INT))::DOUBLE]::DOUBLE[] AS vals FROM big GROUP BY g
