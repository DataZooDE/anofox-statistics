    UNION ALL
    SELECT 'quantile_fit_predict_agg' AS fn, g, 1e-6::DOUBLE AS tol, [list_count(quantile_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'tau': 0.5})), list_sum(list_transform(quantile_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'tau': 0.5}), p -> p.yhat)), list_sum(list_transform(quantile_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'tau': 0.5}), p -> p.yhat * p.yhat)), list_min(list_transform(quantile_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'tau': 0.5}), p -> p.yhat)), list_max(list_transform(quantile_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'tau': 0.5}), p -> p.yhat)), list_sum(list_transform(quantile_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'tau': 0.5}), p -> p.is_training::INT))::DOUBLE]::DOUBLE[] AS vals FROM small GROUP BY g
