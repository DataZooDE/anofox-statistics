    UNION ALL
    SELECT 'bls_fit_predict_agg' AS fn, -1 AS g, 1e-8::DOUBLE AS tol, [list_count(bls_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'intercept': true, 'lower_bound': 0.0})), list_sum(list_transform(bls_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'intercept': true, 'lower_bound': 0.0}), p -> p.yhat)), list_sum(list_transform(bls_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'intercept': true, 'lower_bound': 0.0}), p -> p.yhat * p.yhat)), list_min(list_transform(bls_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'intercept': true, 'lower_bound': 0.0}), p -> p.yhat)), list_max(list_transform(bls_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'intercept': true, 'lower_bound': 0.0}), p -> p.yhat)), list_sum(list_transform(bls_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2], {'intercept': true, 'lower_bound': 0.0}), p -> p.is_training::INT))::DOUBLE]::DOUBLE[] AS vals FROM small
    UNION ALL
    SELECT 'huber_fit_predict_agg' AS fn, g, 1e-6::DOUBLE AS tol, [list_count(huber_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2])), list_sum(list_transform(huber_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2]), p -> p.yhat)), list_sum(list_transform(huber_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2]), p -> p.yhat * p.yhat)), list_min(list_transform(huber_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2]), p -> p.yhat)), list_max(list_transform(huber_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2]), p -> p.yhat)), list_sum(list_transform(huber_fit_predict_agg(CASE WHEN i % 10 = 3 THEN NULL ELSE y END, [x1, x2]), p -> p.is_training::INT))::DOUBLE]::DOUBLE[] AS vals FROM big GROUP BY g
