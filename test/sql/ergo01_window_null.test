# name: test/sql/ergo01_window_null.test
# description: Regression test for ERGO-01 — rolling fit_predict degenerate-frame NULL guard
# group: [sql]
#
# Bug: anofox_stats_ols_fit_agg(...) OVER (ROWS BETWEEN N PRECEDING AND CURRENT ROW)
# returns a non-NULL result when the frame has exactly min_obs = n_features+1 rows
# instead of returning NULL for the degenerate (exactly-determined) case.
#
# Root cause (pinned): src/aggregate_functions/ols_aggregate.cpp OlsAggFinalize()
# uses a fixed `y_values.size() < 2` guard (line 263) instead of the scaling
# `y_values.size() <= (fit_intercept ? n_features+1 : n_features)` guard.
# With 1 feature + intercept: min_obs = 2, so a 2-row frame passes `< 2` but must
# fail `<= 2`. The function name that first triggers the wrong non-NULL result is:
# anofox_stats_ols_fit_agg(y, [x1]) OVER (ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
# at the row where the frame contains exactly 2 rows.

require anofox_statistics

# =============================================================================
# SETUP
# =============================================================================

statement ok
CREATE TABLE ergo01_data AS
SELECT
    t::INTEGER AS t,
    t::DOUBLE  AS x1,
    (t * 0.5)::DOUBLE AS x2,
    (2.0 * t + 1.0)::DOUBLE AS y
FROM range(1, 8) t(t);

# =============================================================================
# CASE A — 1 feature, fit_intercept=true: min_obs = 2
# Frame of exactly 2 rows (t=1 and t=2) is degenerate and must be NULL.
# Frame of 3+ rows (t>=3) is valid and must be non-NULL.
#
# ROWS BETWEEN 1 PRECEDING AND CURRENT ROW produces frames of size 1 (t=1) and 2 (t=2).
# Both must be NULL; t>=3 has frame size >=3 and must return a result.
# =============================================================================

# All rows where frame <= min_obs (t=1 and t=2) must be NULL
query I
SELECT
    COUNT(*) AS degenerate_null_count
FROM (
    SELECT
        anofox_stats_ols_fit_agg(y, [x1]) OVER (ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS result
    FROM ergo01_data
)
WHERE result IS NULL;
----
2

# All rows where frame > min_obs (t=3 through t=7, 5 rows) must be non-NULL
query I
SELECT
    COUNT(*) AS valid_non_null_count
FROM (
    SELECT
        anofox_stats_ols_fit_agg(y, [x1]) OVER (ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS result
    FROM ergo01_data
)
WHERE result IS NOT NULL;
----
5

# The row-level pattern: 2 NULLs then 5 non-NULLs
query II
SELECT
    t,
    CASE WHEN result IS NULL THEN 'NULL' ELSE 'non-NULL' END AS result_status
FROM (
    SELECT
        t,
        anofox_stats_ols_fit_agg(y, [x1]) OVER (ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS result
    FROM ergo01_data
)
ORDER BY t;
----
1	NULL
2	NULL
3	non-NULL
4	non-NULL
5	non-NULL
6	non-NULL
7	non-NULL

# =============================================================================
# CASE B — 2 features, fit_intercept=true: min_obs = 3
# ROWS BETWEEN 2 PRECEDING AND CURRENT ROW → frames of size 1, 2, 3, 3, 3, 3, 3.
# Frames with exactly 1 or 2 rows (t=1, t=2) must be NULL.
# Frames with 3 rows (t>=3) must be non-NULL.
# The weak `< 2` guard passes the 2-row frame; the scaling guard catches it.
# =============================================================================

# Rows t=1 and t=2 (frames of size 1 and 2) must both be NULL with the scaling guard
query I
SELECT
    COUNT(*) AS degenerate_null_count
FROM (
    SELECT
        anofox_stats_ols_fit_agg(y, [x1, x2]) OVER (ORDER BY t ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS result
    FROM ergo01_data
)
WHERE result IS NULL;
----
2

# Rows t>=3 (5 rows with frame size 3) must be non-NULL
query I
SELECT
    COUNT(*) AS valid_non_null_count
FROM (
    SELECT
        anofox_stats_ols_fit_agg(y, [x1, x2]) OVER (ORDER BY t ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS result
    FROM ergo01_data
)
WHERE result IS NOT NULL;
----
5

# =============================================================================
# CASE C — ols_fit_predict window function: already correct, must stay correct
# anofox_stats_ols_fit_predict uses min_obs guard since Phase 3/4; verify here
# so any regression is caught. With 1 feature + intercept (min_obs=2), the first
# 2 rows (frames of size 1 and 2) must be NULL; rows 3+ must yield a yhat.
# =============================================================================

query I
SELECT
    COUNT(*) AS degenerate_null_count
FROM (
    SELECT
        anofox_stats_ols_fit_predict(y, [x1]) OVER (ORDER BY t) AS pred
    FROM ergo01_data
)
WHERE pred IS NULL;
----
2

query I
SELECT
    COUNT(*) AS valid_non_null_count
FROM (
    SELECT
        anofox_stats_ols_fit_predict(y, [x1]) OVER (ORDER BY t) AS pred
    FROM ergo01_data
)
WHERE pred IS NOT NULL;
----
5

# =============================================================================
# CLEANUP
# =============================================================================

statement ok
DROP TABLE ergo01_data;
