# name: test/sql/ergo03_naming.test
# description: ERGO-03 smoke test — verify unprefixed names resolve and prefixed names do not
# group: [sql]

require anofox_statistics

# ---------------------------------------------------------------------------
# Positive checks: unprefixed names must resolve
# ---------------------------------------------------------------------------

# OLS family
query I
SELECT (ols_fit([1.0, 2.0, 3.0], [[1.0, 2.0, 3.0]])).r_squared IS NOT NULL;
----
true

query I
SELECT ols_fit_agg(y, [x]) IS NOT NULL FROM (VALUES (1.0, 1.0), (2.0, 2.0), (3.0, 3.0)) t(y, x);
----
true

# Theil-Sen family (theil_sen rename verified)
query I
SELECT theil_sen_fit([1.0, 2.0, 3.0], [[1.0, 2.0, 3.0]]) IS NOT NULL;
----
true

query I
SELECT theil_sen_fit_agg(y, [x]) IS NOT NULL FROM (VALUES (1.0, 1.0), (2.0, 2.0), (3.0, 3.0)) t(y, x);
----
true

# GLM Poisson family
query I
SELECT poisson_fit_agg(y, [x]) IS NOT NULL FROM (VALUES (1.0, 1.0), (2.0, 2.0), (3.0, 3.0)) t(y, x);
----
true

# t-test (value DOUBLE, group_id INTEGER)
query I
SELECT t_test_agg(x, g) IS NOT NULL FROM (VALUES (1.0, 0), (2.0, 0), (3.0, 1), (4.0, 1)) t(x, g);
----
true

# VIF (variance inflation factor) — takes a single DOUBLE[][] feature matrix
query I
SELECT vif([[2.0, 4.0, 6.0, 7.0, 9.0], [1.0, 3.0, 5.0, 6.0, 8.0]]) IS NOT NULL;
----
true

# BLS and NNLS
query I
SELECT bls_fit_agg(y, [x]) IS NOT NULL FROM (VALUES (1.0, 1.0), (2.0, 2.0), (3.0, 3.0)) t(y, x);
----
true

query I
SELECT nnls_fit_agg(y, [x]) IS NOT NULL FROM (VALUES (1.0, 1.0), (2.0, 2.0), (3.0, 3.0)) t(y, x);
----
true

# ---------------------------------------------------------------------------
# Negative checks: old prefixed names must NOT resolve (breaking rename)
# ---------------------------------------------------------------------------

statement error
SELECT anofox_stats_ols_fit([1.0, 2.0, 3.0], [[1.0, 2.0, 3.0]]);
----

statement error
SELECT anofox_stats_theil_sen_fit([1.0, 2.0, 3.0], [[1.0, 2.0, 3.0]]);
----

statement error
SELECT anofox_stats_t_test_agg(x, y) FROM (VALUES (1.0, 2.0)) t(x, y);
----
