# name: test/sql/survival/test_aft_basic.test
# description: AFT survival regression with right censoring (issue #107)
# group: [survival]

require anofox_statistics

# Weibull AFT data generated by inverting the quantile function:
#   log T = 2.0 + 0.3*x + 0.5*W,  W standard extreme value
# then right-censored at staggered thresholds, as staggered entry would produce.
statement ok
CREATE TABLE po_lines AS
SELECT
    (i % 10) / 3.0 AS x,
    LEAST(EXP(2.0 + 0.3 * ((i % 10) / 3.0) + 0.5 * LN(-LN(1 - ((i + 0.5) / 300.0)))),
          9.0 + (i % 7) * 0.9) AS days,
    CASE WHEN EXP(2.0 + 0.3 * ((i % 10) / 3.0) + 0.5 * LN(-LN(1 - ((i + 0.5) / 300.0))))
              > 9.0 + (i % 7) * 0.9 THEN 0.0 ELSE 1.0 END::DOUBLE AS delivered
FROM range(0, 300) t(i);

# ==== TEST 1: the fixture really is censored ====
query I
SELECT COUNT(*) FILTER (WHERE delivered = 0.0) FROM po_lines;
----
109

# ==== TEST 2: Weibull recovers the generating parameters ====
query IIIII
SELECT
    ROUND((aft_fit_agg(days, [x], delivered, {'dist': 'weibull'})).intercept, 4),
    ROUND((aft_fit_agg(days, [x], delivered, {'dist': 'weibull'})).coefficients[1], 4),
    ROUND((aft_fit_agg(days, [x], delivered, {'dist': 'weibull'})).scale, 4),
    (aft_fit_agg(days, [x], delivered, {'dist': 'weibull'})).n_censored,
    (aft_fit_agg(days, [x], delivered, {'dist': 'weibull'})).converged
FROM po_lines;
----
1.974	0.3091	0.4904	109	true

# ==== TEST 3: event/censored counts add up ====
query I
SELECT (aft_fit_agg(days, [x], delivered)).n_events
     + (aft_fit_agg(days, [x], delivered)).n_censored
     = (aft_fit_agg(days, [x], delivered)).n_observations
FROM po_lines;
----
true

# ==== TEST 4: ignoring censoring attenuates the covariate effect ====
# This is the bias the feature exists to remove. Treating every censored row as
# an observed event halves the slope and compresses the scale.
query I
SELECT (aft_fit_agg(days, [x], 1.0::DOUBLE, {'dist':'weibull'})).coefficients[1]
     < 0.5 * (aft_fit_agg(days, [x], delivered, {'dist':'weibull'})).coefficients[1]
FROM po_lines;
----
true

query I
SELECT (aft_fit_agg(days, [x], 1.0::DOUBLE, {'dist':'weibull'})).scale
     < 0.8 * (aft_fit_agg(days, [x], delivered, {'dist':'weibull'})).scale
FROM po_lines;
----
true

# ==== TEST 5: every distribution fits ====
query IIII
SELECT
    (aft_fit_agg(days, [x], delivered, {'dist':'weibull'})).converged,
    (aft_fit_agg(days, [x], delivered, {'dist':'lognormal'})).converged,
    (aft_fit_agg(days, [x], delivered, {'dist':'loglogistic'})).converged,
    (aft_fit_agg(days, [x], delivered, {'dist':'exponential'})).converged
FROM po_lines;
----
true	true	true	true

# ==== TEST 6: exponential pins the scale at 1 ====
query I
SELECT (aft_fit_agg(days, [x], delivered, {'dist':'exponential'})).scale = 1.0 FROM po_lines;
----
true

# ==== TEST 7: inference is populated and sane ====
query I
SELECT (aft_fit_agg(days, [x], delivered, {'dist':'weibull','compute_inference':true})).std_errors[1] > 0
   AND (aft_fit_agg(days, [x], delivered, {'dist':'weibull','compute_inference':true})).ci_lower[1]
     < (aft_fit_agg(days, [x], delivered, {'dist':'weibull','compute_inference':true})).coefficients[1]
   AND (aft_fit_agg(days, [x], delivered, {'dist':'weibull','compute_inference':true})).ci_upper[1]
     > (aft_fit_agg(days, [x], delivered, {'dist':'weibull','compute_inference':true})).coefficients[1]
FROM po_lines;
----
true

# ==== TEST 8: the scale standard error is present, except for exponential ====
query II
SELECT
    (aft_fit_agg(days, [x], delivered, {'dist':'weibull','compute_inference':true})).log_scale_std_error > 0,
    isnan((aft_fit_agg(days, [x], delivered, {'dist':'exponential','compute_inference':true})).log_scale_std_error)
FROM po_lines;
----
true	true

# ==== TEST 9: priors work on AFT coefficients too ====
query I
SELECT ABS((aft_fit_agg(days, [x], delivered, {'dist':'weibull',
             'feature_names': ['x'],
             'prior': MAP {'x': {'dist':'normal','loc':0.0,'scale':0.001}}})).coefficients[1])
     < 0.05
FROM po_lines;
----
true

# ==== TEST 10: survival and quantile helpers ====
# median of W (extreme value) is ln(-ln(0.5)); T median = exp(2.0 + 0.5*that).
query II
SELECT ROUND(anofox_stats_aft_quantile(0.5, 2.0, 0.5, 'weibull'), 6),
       ROUND(anofox_stats_aft_cdf(EXP(2.0 + 0.5 * LN(-LN(0.5))), 2.0, 0.5, 'weibull'), 6);
----
6.151793	0.5

# ==== TEST 11: the CDF is monotone in t ====
query I
SELECT anofox_stats_aft_cdf(5.0, 2.0, 0.5, 'weibull')
     < anofox_stats_aft_cdf(10.0, 2.0, 0.5, 'weibull')
   AND anofox_stats_aft_cdf(10.0, 2.0, 0.5, 'weibull')
     < anofox_stats_aft_cdf(20.0, 2.0, 0.5, 'weibull');
----
true

# ==== TEST 12: quantile inverts the CDF for every distribution ====
query I
SELECT bool_and(ABS(anofox_stats_aft_cdf(anofox_stats_aft_quantile(p, 1.5, 0.7, d), 1.5, 0.7, d) - p) < 1e-9)
FROM (VALUES (0.1),(0.25),(0.5),(0.75),(0.9)) AS ps(p),
     (VALUES ('weibull'),('lognormal'),('loglogistic'),('exponential')) AS ds(d);
----
true

# ==== TEST 13: the short alias resolves ====
query I
SELECT ROUND(aft_cdf(20.0, 2.0, 0.5, 'weibull'), 6) = ROUND(anofox_stats_aft_cdf(20.0, 2.0, 0.5, 'weibull'), 6);
----
true

# ==== TEST 14: GROUP BY gives one fit per group ====
query I
SELECT COUNT(*) FROM (
    SELECT (i % 3) AS g, (aft_fit_agg(days, [x], delivered)).converged AS ok
    FROM po_lines, range(0, 3) s(i) GROUP BY g
) WHERE ok;
----
3

# ==== TEST 15: the fully-qualified name resolves ====
query I
SELECT (anofox_stats_aft_fit_agg(days, [x], delivered)).coefficients[1] IS NOT NULL FROM po_lines;
----
true

statement ok
DROP TABLE IF EXISTS po_lines;
