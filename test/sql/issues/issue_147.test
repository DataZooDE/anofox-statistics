# name: test/sql/issues/issue_147.test
# description: #147 lars_fit_agg reports adj_r_squared / residual_std_error (not 0, not NULL)
# group: [issues]

require anofox_statistics

statement ok
CREATE TABLE d AS
SELECT i, chr(65 + (i % 2)::INT) AS grp, i / 10.0 AS x1, sin(i) AS x2, cos(i * 3) AS x3,
       2 + 1.5 * (i / 10.0) - 0.8 * sin(i) + 0.3 * cos(i * 7) AS y
FROM range(60) t(i);

# Both predictors enter the active set, so the full LARS path is the OLS fit on it.
# R: summary(lm(y ~ x1 + x2)): r2 0.993640840379574, adj.r2 0.993417711971839,
#    sigma 0.216257642550628
query III
SELECT round(m.r_squared, 8), round(m.adj_r_squared, 8), round(m.residual_std_error, 8)
FROM (SELECT lars_fit_agg(y, [x1, x2]) AS m FROM d);
----
0.99364084	0.99341771	0.21625764
