# name: test/sql/options/test_test_result_fields.test
# description: Every hypothesis-test aggregate reports statistic, p_value,
#              n (total sample size, BIGINT), method (VARCHAR) and alternative
#              (VARCHAR: two_sided | less | greater, NULL when not applicable).
#              The fields were appended to the existing result structs.
# group: [options]

require anofox_statistics

statement ok
CREATE TABLE tg AS SELECT (CASE WHEN i % 2 = 0 THEN 10.0 ELSE 10.8 END + sin(i * 1.3) * 2.0) AS v, (i % 2)::BIGINT AS g, (i % 3)::INTEGER AS g3 FROM range(60) t(i);

statement ok
CREATE TABLE pr AS SELECT (5.0 + sin(i * 0.9)) AS x, (5.05 + sin(i * 0.9) + 0.2 * cos(i * 2.1)) AS y FROM range(60) t(i);

statement ok
CREATE TABLE fc AS SELECT sin(i * 0.3) * 3.0 AS actual, sin(i * 0.3) * 3.0 + 0.8 * cos(i * 1.7) AS f1, sin(i * 0.3) * 3.0 + 0.5 * cos(i * 2.3 + 1.0) AS f2 FROM range(80) t(i);

statement ok
CREATE TABLE bn AS SELECT (CASE WHEN (i * 7) % 10 < 6 THEN 1 ELSE 0 END)::BIGINT AS s, (i % 2)::BIGINT AS g FROM range(80) t(i);

statement ok
CREATE TABLE rt AS SELECT (s * 1.0 + r * 0.3 + sin(s * 7 + r)) AS rating, s::BIGINT AS subject, r::BIGINT AS rater FROM range(12) a(s), range(3) b(r);

statement ok
CREATE TABLE kp AS SELECT (i % 3)::BIGINT AS r1, (CASE WHEN i % 7 = 0 THEN (i + 1) % 3 ELSE i % 3 END)::BIGINT AS r2, (i % 2)::BIGINT AS b1, (CASE WHEN i % 5 = 0 THEN 1 - i % 2 ELSE (i % 3 = 0)::BIGINT END)::BIGINT AS b2 FROM range(60) t(i);

statement ok
CREATE TABLE gof AS SELECT * FROM (VALUES (18::BIGINT, 0.25), (22, 0.25), (31, 0.25), (29, 0.25)) t(obs, p);

query TTTTTITT
SELECT typeof(r.statistic), typeof(r.p_value), typeof(r.n), typeof(r.method), typeof(r.alternative),
       r.n, r.alternative, r.statistic IS NOT NULL AND r.p_value IS NOT NULL AND r.method IS NOT NULL
FROM (SELECT t_test_agg(v, g, {'alternative': 'less'}) AS r FROM tg);
----
DOUBLE	DOUBLE	BIGINT	VARCHAR	VARCHAR	60	less	true

query TTTTTITT
SELECT typeof(r.statistic), typeof(r.p_value), typeof(r.n), typeof(r.method), typeof(r.alternative),
       r.n, r.alternative, r.statistic IS NOT NULL AND r.p_value IS NOT NULL AND r.method IS NOT NULL
FROM (SELECT mann_whitney_u_agg(v, g, {'alternative': 'greater'}) AS r FROM tg);
----
DOUBLE	DOUBLE	BIGINT	VARCHAR	VARCHAR	60	greater	true

