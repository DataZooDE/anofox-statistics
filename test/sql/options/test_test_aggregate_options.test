# =============================================================================
# confidence_level must be in (0, 1); integers must be non-negative and fit
# =============================================================================

statement error
SELECT t_test_agg(v, g, {'confidence_level': 1.0}) FROM tg;
----
confidence_level must be in (0, 1), got 1.0

statement error
SELECT yuen_agg(v, g, {'confidence_level': 0.0}) FROM tg;
----
confidence_level must be in (0, 1)

statement error
SELECT pearson_agg(x, y, {'confidence_level': 95}) FROM pr;
----
confidence_level must be in (0, 1), got 95

statement error
SELECT fisher_exact_agg(b1::INTEGER, b2::INTEGER, {'confidence_level': -0.5}) FROM kp;
----
confidence_level must be in (0, 1)

statement error
SELECT tost_paired_agg(x, y, {'confidence_level': 1.5}) FROM pr;
----
confidence_level must be in (0, 1)

statement error
SELECT permutation_t_test_agg(v, g, {'n_permutations': -5}) FROM tg;
----
Expected a non-negative integer, got -5

statement error
SELECT distance_cor_agg(x, y, {'n_permutations': -5}) FROM pr;
----
Expected a non-negative integer, got -5

statement error
SELECT energy_distance_agg(v, g::INTEGER, {'n_permutations': 10000000000}) FROM tg;
----
is too large (maximum 4294967295)

statement error
SELECT diebold_mariano_agg(actual, f1, f2, {'horizon': -1}) FROM fc;
----
Expected a non-negative integer, got -1

statement error
SELECT mmd_agg(v, g::INTEGER, {'seed': -3}) FROM tg;
----
Expected a non-negative integer, got -3

# =============================================================================
# Options must be constant
# =============================================================================

statement error
SELECT yuen_agg(v, g, {'trim': v / 100}) FROM tg;
----
yuen_agg: options must be a constant expression

statement error
SELECT t_test_agg(v, g, {'mu': v}) FROM tg;
----
t_test_agg: options must be a constant expression

statement error
SELECT binom_test_agg(s, {'p0': s / 2}) FROM bn;
----
binom_test_agg: options must be a constant expression

# =============================================================================
# t_test_agg: paired is not silently ignored; mu is applied
# =============================================================================

statement error
SELECT t_test_agg(v, g, {'paired': true}) FROM tg;
----
t_test_agg: 'paired': true is not supported

query I
SELECT (t_test_agg(v, g, {'paired': false})).p_value = (t_test_agg(v, g)).p_value FROM tg;
----
true

query I
SELECT (t_test_agg(v, g, {'mu': -0.8})).statistic != (t_test_agg(v, g)).statistic FROM tg;
----
true

# =============================================================================
# McNemar exact option
# =============================================================================

query II
SELECT (mcnemar_agg(b1, b2, {'exact': true})).method, (mcnemar_agg(b1, b2)).method FROM kp;
----
McNemar's exact test	McNemar's test
