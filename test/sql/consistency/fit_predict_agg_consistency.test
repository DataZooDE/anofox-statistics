# name: test/sql/consistency/fit_predict_agg_consistency.test
# description: Every *_fit_predict_agg must predict exactly what predict() gives with the
#              coefficients of the matching *_fit_agg trained on the same rows (y NULL = not trained,
#              but predicted). Output list order follows the aggregate ORDER BY, checked via the y field.
# group: [consistency]

require anofox_statistics

statement ok
CREATE TABLE d AS
SELECT i AS t,
       (i % 11)::DOUBLE + 0.1 * i AS x1,
       ((i * 7) % 13)::DOUBLE AS x2,
       CASE WHEN i <= 30 THEN 2.0 + 1.5 * ((i % 11) + 0.1 * i) - 0.7 * ((i * 7) % 13) + ((i * 37) % 17 - 8) * 0.25 END AS y,
       CASE WHEN i <= 30 THEN ((i * 13) % 7 + (i % 11) // 3)::DOUBLE END AS yc,
       1.0 + (i % 4) * 0.5 AS w,
       CASE WHEN i <= 25 THEN 'train' ELSE 'test' END AS split
FROM range(1, 41) r(i);

# ols: yhat from ols_fit_predict_agg(y, [x1, x2] ORDER BY t) must equal
# intercept + coef . x (intercept is NaN when not fitted) with the coefficients of ols_fit_agg(y, [x1, x2])
query III
WITH f AS (SELECT ols_fit_agg(y, [x1, x2]) AS m FROM d),
     fp AS (SELECT ols_fit_predict_agg(y, [x1, x2] ORDER BY t) AS l FROM d),
     u AS (SELECT unnest(l) AS p, generate_subscripts(l, 1) AS i FROM fp)
SELECT count(*), count(*) FILTER ((p).y IS DISTINCT FROM d.y),
       max(abs((p).yhat - ((m).intercept + list_dot_product((m).coefficients, [x1, x2])))) < 1e-9
FROM u JOIN d ON d.t = u.i, f;
----
40	0	true

# ols_no_intercept: yhat from ols_fit_predict_agg(y, [x1, x2], {'intercept': false} ORDER BY t) must equal
# intercept + coef . x (intercept is NaN when not fitted) with the coefficients of ols_fit_agg(y, [x1, x2], {'intercept': false})
query III
WITH f AS (SELECT ols_fit_agg(y, [x1, x2], {'intercept': false}) AS m FROM d),
     fp AS (SELECT ols_fit_predict_agg(y, [x1, x2], {'intercept': false} ORDER BY t) AS l FROM d),
     u AS (SELECT unnest(l) AS p, generate_subscripts(l, 1) AS i FROM fp)
SELECT count(*), count(*) FILTER ((p).y IS DISTINCT FROM d.y),
       max(abs((p).yhat - list_dot_product((m).coefficients, [x1, x2]))) < 1e-9
FROM u JOIN d ON d.t = u.i, f;
----
40	0	true

# wls: yhat from wls_fit_predict_agg(y, [x1, x2], w ORDER BY t) must equal
# intercept + coef . x (intercept is NaN when not fitted) with the coefficients of wls_fit_agg(y, [x1, x2], w)
query III
WITH f AS (SELECT wls_fit_agg(y, [x1, x2], w) AS m FROM d),
     fp AS (SELECT wls_fit_predict_agg(y, [x1, x2], w ORDER BY t) AS l FROM d),
     u AS (SELECT unnest(l) AS p, generate_subscripts(l, 1) AS i FROM fp)
SELECT count(*), count(*) FILTER ((p).y IS DISTINCT FROM d.y),
       max(abs((p).yhat - ((m).intercept + list_dot_product((m).coefficients, [x1, x2])))) < 1e-9
FROM u JOIN d ON d.t = u.i, f;
----
40	0	true

