# poisson: yhat from poisson_fit_predict_agg(yc, [x1, x2] ORDER BY t) must equal
# intercept + coef . x (intercept is NaN when not fitted) with the coefficients of poisson_fit_agg(yc, [x1, x2])
query III
WITH f AS (SELECT poisson_fit_agg(yc, [x1, x2]) AS m FROM d),
     fp AS (SELECT poisson_fit_predict_agg(yc, [x1, x2] ORDER BY t) AS l FROM d),
     u AS (SELECT unnest(l) AS p, generate_subscripts(l, 1) AS i FROM fp)
SELECT count(*), count(*) FILTER ((p).y IS DISTINCT FROM d.yc),
       max(abs((p).yhat - exp(((m).intercept + list_dot_product((m).coefficients, [x1, x2]))))) < 1e-9
FROM u JOIN d ON d.t = u.i, f;
----
40	0	true

# bls without intercept (the default): intercept is reported as NaN, coefficients alone predict
query II
WITH f AS (SELECT bls_fit_agg(y, [x1, x2], {'lower_bound': 0.0}) AS m FROM d),
     fp AS (SELECT bls_fit_predict_agg(y, [x1, x2], {'lower_bound': 0.0} ORDER BY t) AS l FROM d),
     u AS (SELECT unnest(l) AS p, generate_subscripts(l, 1) AS i FROM fp)
SELECT count(*), max(abs((p).yhat - list_dot_product((m).coefficients, [x1, x2]))) < 1e-9
FROM u JOIN d ON d.t = u.i, f;
----
40	true

# split_col variant: only 'train' rows (t <= 25) are fitted even though y is known for t <= 30
query III
WITH f AS (SELECT ols_fit_agg(y, [x1, x2]) FILTER (WHERE split = 'train') AS m FROM d),
     fp AS (SELECT ols_fit_predict_agg(y, [x1, x2], split ORDER BY t) AS l FROM d),
     u AS (SELECT unnest(l) AS p, generate_subscripts(l, 1) AS i FROM fp)
SELECT count(*), count(*) FILTER ((p).is_training) ,
       max(abs((p).yhat - ((m).intercept + list_dot_product((m).coefficients, [x1, x2])))) < 1e-9
FROM u JOIN d ON d.t = u.i, f;
----
40	25	true

# GROUP BY: each group predicted with its own fit
query II
WITH g AS (SELECT t % 2 AS grp, * FROM d),
     f AS (SELECT grp, ols_fit_agg(y, [x1, x2]) AS m FROM g GROUP BY grp),
     fp AS (SELECT grp, ols_fit_predict_agg(y, [x1, x2] ORDER BY t) AS l, list(t ORDER BY t) AS ts FROM g GROUP BY grp),
     u AS (SELECT grp, unnest(l) AS p, unnest(ts) AS t FROM fp)
SELECT count(*), max(abs((p).yhat - ((m).intercept + list_dot_product((m).coefficients, [x1, x2])))) < 1e-9
FROM u JOIN d USING (t) JOIN f USING (grp);
----
40	true

# isotonic_fit_predict_agg, pls_fit_predict_agg and quantile_fit_predict_agg have no matching
# *_fit_agg, so they are not covered here (see test/sql/reference for quantile vs quantreg::rq).
