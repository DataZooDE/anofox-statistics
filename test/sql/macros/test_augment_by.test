CREATE TABLE ref (model VARCHAR, row_id BIGINT, fitted DOUBLE, residual DOUBLE, std_residual DOUBLE,
    stud_residual DOUBLE, leverage DOUBLE, cooks_d DOUBLE, dffits DOUBLE);

