# name: test/sql/macros/test_augment_by.test
# description: ols_augment_by / wls_augment_by (#151, contract `obs` schema) against R lm():
#              fitted, residuals, rstandard, rstudent, hatvalues, cooks.distance, dffits;
#              row alignment, non-training rows (split = 'test', NULL y), weight, n_params, model_id.
# group: [macros]

require anofox_statistics

# Reference values from R 4.x (stats::lm), produced by:
#   i <- 1:15
#   a <- data.frame(g = "a", x1 = as.numeric(i), x2 = as.numeric((i * 7) %% 11))
#   a$x1[15] <- 40                                   # high-leverage row
#   a$y <- round(1 + 0.5 * a$x1 - 0.3 * a$x2 + sin(i * 1.3), 3)
#   b <- data.frame(g = "b", x1 = i * 0.5, x2 = as.numeric((i * 5) %% 13))
#   b$y <- round(3 - 0.2 * b$x1 + 0.8 * b$x2 + cos(i * 0.7), 3)
#   d <- rbind(a, b)
#   d$w <- 1 + (rep(i, 2) %% 3)
#   d$row_id <- seq_len(nrow(d))
#   d$row_id[d$g == "b"] <- d$row_id[d$g == "b"] + 1   # a test row is inserted after group a
#   out <- NULL
#   for (grp in c("a", "b")) {
#     s <- d[d$g == grp, ]
#     for (m in c("ols", "wls")) {
#       f <- if (m == "ols") lm(y ~ x1 + x2, data = s) else lm(y ~ x1 + x2, data = s, weights = w)
#       out <- rbind(out, data.frame(model = m, row_id = s$row_id, fitted = fitted(f), residual = residuals(f),
#         std_residual = rstandard(f), stud_residual = rstudent(f), leverage = hatvalues(f),
#         cooks_d = cooks.distance(f), dffits = dffits(f)))
#       if (grp == "a") cat(m, "pred test row a:", sprintf("%.12f", predict(f, data.frame(x1 = 7.5, x2 = 3))), "\n")
#       if (grp == "b") cat(m, "pred null row b:", sprintf("%.12f", predict(f, data.frame(x1 = 4.2, x2 = 6))), "\n")
#     }
#   }
#   cat("DATA\n")
#   for (k in seq_len(nrow(d))) cat(sprintf("(%d, '%s', %s, %s, %s, %s, 'train'),\n", d$row_id[k], d$g[k], format(d$x1[k]), format(d$x2[k]), format(d$y[k]), format(d$w[k])))
#   cat("REF\n")
#   for (k in seq_len(nrow(out))) with(out[k, ], cat(sprintf("('%s', %d, %.12g, %.12g, %.12g, %.12g, %.12g, %.12g, %.12g),\n", model, row_id, fitted, residual, std_residual, stud_residual, leverage, cooks_d, dffits)))
# Row 16 (group a, split = 'test') and row 32 (group b, NULL y) are not used by the fits;
# R's predict() at them: ols a 3.948740062408, wls a 3.958489688248,
#                        ols b 6.817528835568, wls b 6.818672849240.

statement ok
CREATE TABLE d (id INTEGER, g VARCHAR, x1 DOUBLE, x2 DOUBLE, y DOUBLE, w DOUBLE, split VARCHAR);

statement ok
