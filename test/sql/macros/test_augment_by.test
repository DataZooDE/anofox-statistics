statement ok
CREATE TABLE aug AS
    SELECT 'ols' AS model, * FROM ols_augment_by('d', g, y, [x1, x2], split := split)
    UNION ALL BY NAME
    SELECT 'wls' AS model, * FROM wls_augment_by('d', g, y, [x1, x2], w, split := split);

# Every source row comes back once per model, row_id is the source row number
query II
SELECT count(*), count(*) FILTER (WHERE row_id = id) FROM aug
----
64	64

# All seven measures match R to 1e-8 on all 60 training rows
query IIIIIIII
SELECT count(*),
    max(abs(a.fitted - r.fitted)) < 1e-8,
    max(abs(a.residual - r.residual)) < 1e-8,
    max(abs(a.std_residual - r.std_residual)) < 1e-8,
    max(abs(a.stud_residual - r.stud_residual)) < 1e-8,
    max(abs(a.leverage - r.leverage)) < 1e-8,
    max(abs(a.cooks_d - r.cooks_d)) < 1e-8,
    max(abs(a.dffits - r.dffits)) < 1e-8
FROM aug a JOIN ref r USING (model, row_id)
----
60	true	true	true	true	true	true	true

# The high-leverage row (x1 = 40) is flagged by leverage and Cook's distance
query IIII
SELECT model, row_id, round(leverage, 6), round(cooks_d, 6) FROM aug WHERE g = 'a' AND cooks_d = (SELECT max(cooks_d) FROM aug a2 WHERE a2.model = aug.model AND a2.g = 'a') ORDER BY model
----
ols	15	0.82643	2.284454
wls	15	0.680664	1.022884

# Non-training rows: prediction as fitted, NULL diagnostics, is_training false
query IIIIIIIIIII
SELECT model, row_id, round(fitted, 9), residual, std_residual, stud_residual, leverage, cooks_d, dffits, is_training, weight
FROM aug WHERE row_id IN (16, 32) ORDER BY model, row_id
----
ols	16	3.948740062	NULL	NULL	NULL	NULL	NULL	NULL	false	1.0
ols	32	6.817528836	NULL	NULL	NULL	NULL	NULL	NULL	false	1.0
wls	16	3.958489688	NULL	NULL	NULL	NULL	NULL	NULL	false	1.0
wls	32	6.81867285	NULL	NULL	NULL	NULL	NULL	NULL	false	2.0

# model_id = model_name = the method; resid_type, n_params, is_training per group; OLS weight is 1, WLS weight is the prior weight
query IIIIIII
SELECT model, g, any_value(resid_type), min(n_params), max(n_params), count(*) FILTER (WHERE is_training),
    bool_and(CASE WHEN model = 'ols' THEN weight = 1.0 ELSE weight = w END) AND bool_and(model_id = model AND model_name = model)
FROM aug GROUP BY model, g ORDER BY model, g
----
ols	a	response	3	3	15	true
ols	b	response	3	3	15	true
wls	a	response	3	3	15	true
wls	b	response	3	3	15	true

# Output is ordered by group, then source row; the source columns come first
query IIII
SELECT g, id, row_id, y FROM ols_augment_by('d', g, y, [x1, x2], split := split) LIMIT 3
----
a	1	1	0.364
a	2	2	1.616
a	3	3	-1.188

# Without split the 'test' row is a training row (y is present)
query II
SELECT is_training, leverage IS NOT NULL FROM ols_augment_by('d', g, y, [x1, x2]) WHERE id = 16
----
true	true

# order_by does not change the per-row values
query I
SELECT count(*) FROM ols_augment_by('d', g, y, [x1, x2], split := split, order_by := -id) a
JOIN aug b ON b.model = 'ols' AND a.row_id = b.row_id
WHERE abs(a.cooks_d - b.cooks_d) > 1e-12 OR (a.cooks_d IS NULL) <> (b.cooks_d IS NULL)
----
0

# fit_intercept := false drops the intercept from n_params
query I
SELECT DISTINCT n_params FROM ols_augment_by('d', g, y, [x1, x2], options := {'fit_intercept': false})
----
2

# Leverages of a fit sum to n_params (trace of the hat matrix)
query II
SELECT g, round(sum(leverage), 9) FROM ols_augment_by('d', g, y, [x1, x2], split := split) GROUP BY 1 ORDER BY 1
----
a	3.0
b	3.0

# A NULL feature makes a row non-training and its fitted NULL
statement ok
INSERT INTO d VALUES (33, 'b', NULL, 6, 7.0, 1, 'train');

query IIII
SELECT is_training, fitted, residual, weight FROM ols_augment_by('d', g, y, [x1, x2]) WHERE id = 33
----
false	NULL	NULL	1.0

# A NULL weight keeps the row out of the WLS fit
query II
SELECT is_training, fitted IS NOT NULL FROM wls_augment_by('d', g, y, [x1, x2], CASE WHEN id = 1 THEN NULL ELSE w END) WHERE id = 1
----
false	true

# Unknown options are rejected
statement error
SELECT * FROM ols_augment_by('d', g, y, [x1, x2], options := {'bogus': 1})
----
bogus

# A group with too few training rows yields NULL diagnostics instead of an error
statement ok
CREATE TABLE tiny AS SELECT * FROM (VALUES ('t', 1.0, 2.0)) v(g, x, y);

query III
SELECT fitted, leverage, is_training FROM ols_augment_by('tiny', g, y, [x])
----
NULL	NULL	NULL
