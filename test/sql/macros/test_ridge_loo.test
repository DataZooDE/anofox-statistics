query III
SELECT r.model, count(*), max(abs(a.approx_loo_fitted - r.approx_loo_fitted)) < 1e-6
    AND max(abs(a.approx_loo_residual - (a.y - r.approx_loo_fitted))) < 1e-6
FROM (SELECT 'poisson' AS model, id, yc AS y, approx_loo_fitted, approx_loo_residual
          FROM poisson_augment_by('gd', g, yc, [x1, x2], {'tolerance': 1e-12})
      UNION ALL
      SELECT 'logistic', id, yb, approx_loo_fitted, approx_loo_residual
          FROM logistic_augment_by('gd', g, yb, [x1, x2], {'tolerance': 1e-12})) a
JOIN glm_ref r ON a.model = r.model AND a.id = r.id
GROUP BY r.model ORDER BY r.model;
----
logistic	20	true
poisson	20	true

# The exact LOO columns stay with the linear models: none on the GLM macros, NULL approx_* in ridge_augment_agg
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM poisson_augment_by('gd', g, yc, [x1, x2])) WHERE column_name LIKE 'loo_%';
----
0

query II
SELECT count((a[1]).approx_loo_fitted), count((a[1]).loo_residual) FROM (
    SELECT ridge_augment_agg(y, [x1, x2]) OVER (PARTITION BY g ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS a
    FROM d);
----
0	32
