statement ok
CREATE TABLE aug AS
SELECT 'ols' AS model, id, g, y, residual, leverage, loo_residual, loo_fitted, is_training
FROM ols_augment_by('d', g, y, [x1, x2], split := split)
UNION ALL
SELECT 'wls', id, g, y, residual, leverage, loo_residual, loo_fitted, is_training
FROM wls_augment_by('d', g, y, [x1, x2], w, split := split);

# The macro's row_id is the source position; join the reference on id (the R row_id).
query II
SELECT count(*), count(*) FILTER (WHERE abs(a.loo_residual - r.loo_residual) > 1e-8
                                   OR abs(a.loo_fitted - r.loo_fitted) > 1e-8)
FROM aug a JOIN ref r ON a.model = r.model AND a.id = r.row_id;
----
60	0

# loo_residual = residual / (1 - leverage) and loo_fitted = y - loo_residual on every training row
query I
SELECT count(*) FILTER (WHERE abs(loo_residual - residual / (1 - leverage)) > 1e-10
                         OR abs(loo_fitted - (y - loo_residual)) > 1e-10)
FROM aug WHERE is_training AND g IN ('a', 'b');
----
0

# Rows not used by the fit (split = 'test', NULL y) have no leave-one-out values
query IIIII
SELECT model, id, is_training, loo_residual IS NULL, loo_fitted IS NULL FROM aug WHERE id IN (16, 32) ORDER BY model, id;
----
ols	16	false	true	true
ols	32	false	true	true
wls	16	false	true	true
wls	32	false	true	true

# Leverage 1 (the single-observation dummy): NULL; the other rows match R
query IIII
SELECT id, round(leverage, 7), round(loo_residual, 7), round(loo_fitted, 7) FROM aug WHERE model = 'ols' AND g = 'c' ORDER BY id;
----
33	0.4642857	0.18	1.02
34	0.2857143	-0.25	2.15
35	0.1785714	0.1782609	3.0217391
36	0.1428571	-0.2666667	4.0666667
37	0.1785714	0.1173913	4.9826087
38	0.2857143	0.31	5.89
39	0.4642857	-0.2866667	7.0866667
40	1.0	NULL	NULL

statement ok
CREATE VIEW dt AS SELECT * FROM d WHERE split = 'train' AND y IS NOT NULL;

# glance_by: PRESS, its RMSE and the predicted R-squared (Q^2), against R
query IIIII
SELECT model_id, g,
       max(value) FILTER (WHERE metric = 'press'),
       max(value) FILTER (WHERE metric = 'press_rmse'),
       max(value) FILTER (WHERE metric = 'loo_r_squared')
FROM (SELECT * FROM ols_glance_by('dt', g, y, [x1, x2]) UNION ALL SELECT * FROM wls_glance_by('dt', g, y, [x1, x2], w))
WHERE g IN ('a', 'b')
GROUP BY ALL ORDER BY ALL;
----
ols	a	15.5350901067	1.0176800449	0.953328668314
ols	b	10.4545118506	0.834845768216	0.926436603095
wls	a	27.1764788071	1.34601829624	0.932541453145
wls	b	22.8050694466	1.23301985511	0.928791224018

# Predicted R-squared never exceeds R-squared
query I
SELECT bool_and(q < r2) FROM (
    SELECT g, max(value) FILTER (WHERE metric = 'loo_r_squared') AS q, max(value) FILTER (WHERE metric = 'r_squared') AS r2
    FROM ols_glance_by('dt', g, y, [x1, x2]) WHERE g IN ('a', 'b') GROUP BY g);
----
true

# A row with leverage 1 makes PRESS undefined: the metrics are absent (NULL) for group c
query I
SELECT count(*) FROM ols_glance_by('dt', g, y, [x1, x2]) WHERE g = 'c' AND metric IN ('press', 'press_rmse', 'loo_r_squared');
----
0

# The fields come from the fit STRUCT (opt-in: compute_loo, one more QR of the design) and glance()
query IIII
SELECT g, round((m).press, 8), round((m).press_rmse, 8), round(glance(m).loo_r_squared, 8)
FROM (SELECT g, ols_fit_agg(y, [x1, x2], {'compute_loo': true}) AS m FROM dt GROUP BY g) ORDER BY g;
----
a	15.53509011	1.01768004	0.95332867
b	10.45451185	0.83484577	0.92643660
c	NULL	NULL	NULL

query II
SELECT g, round((wls_fit_agg(y, [x1, x2], w, {'compute_loo': true})).press, 8) FROM dt WHERE g = 'a' GROUP BY g;
----
a	27.17647881

# Without compute_loo the fields are present and NULL; compute_inference does not imply it
query III
SELECT (ols_fit_agg(y, [x1, x2])).press IS NULL,
       (ols_fit_agg(y, [x1, x2], {'compute_inference': true})).loo_r_squared IS NULL,
       (wls_fit_agg(y, [x1, x2], w)).press_rmse IS NULL
FROM dt WHERE g = 'a';
----
true	true	true

# The scalar fits take the option too
query II
SELECT (ols_fit(list(y ORDER BY id), [list(x1 ORDER BY id), list(x2 ORDER BY id)])).press IS NULL,
       round((ols_fit(list(y ORDER BY id), [list(x1 ORDER BY id), list(x2 ORDER BY id)], {'compute_loo': true})).press, 8)
FROM dt WHERE g = 'a';
----
true	15.53509011

# glance_by turns compute_loo on; an explicit compute_loo := false from the user wins
query I
SELECT count(*) FROM ols_glance_by('dt', g, y, [x1, x2], options := {'compute_loo': false})
WHERE metric IN ('press', 'press_rmse', 'loo_r_squared');
----
0

# Models without exact leave-one-out statistics report NULL
query II
SELECT glance(ridge_fit_agg(y, [x1, x2], {'alpha': 1.0})).press IS NULL,
       glance(poisson_fit_agg(round(abs(y))::DOUBLE, [x1, x2])).press IS NULL
FROM dt WHERE g = 'a';
----
true	true
