# name: test/sql/macros/test_loo_press.test
# description: leave-one-out diagnostics (#220): loo_residual / loo_fitted in ols_augment_by and
#              wls_augment_by, press / press_rmse / loo_r_squared in ols_glance_by, wls_glance_by and the
#              ols_fit_agg / wls_fit_agg STRUCT, against R lm(); leverage-1 rows, non-training rows.
# group: [macros]

require anofox_statistics

# Data as in test_augment_by.test (groups a and b) plus group c, whose dummy x2 has a single 1
# (that row has leverage 1 and no leave-one-out prediction). Reference values from R 4.6.1:
#   (same data construction as test_augment_by.test)
#   for (grp in c("a", "b")) for (m in c("ols", "wls")) {
#     s <- d[d$g == grp, ]
#     f <- if (m == "ols") lm(y ~ x1 + x2, data = s) else lm(y ~ x1 + x2, data = s, weights = w)
#     ww <- if (m == "ols") 1 else s$w
#     lr <- residuals(f) / (1 - hatvalues(f))        # = refit without the row, y - prediction
#     press <- sum(rstandard(f, type = "predictive")^2)   # = sum(ww * lr^2)
#     loo_r2 <- 1 - press / sum(ww * (s$y - weighted.mean(s$y, ww))^2)
#     # loo_fitted = s$y - lr; press_rmse = sqrt(press / nrow(s))
#   }
#   x <- 1:8; dd <- c(0, 0, 0, 0, 0, 0, 0, 1); y <- c(1.2, 1.9, 3.2, 3.8, 5.1, 6.2, 6.8, 20)
#   rstandard(lm(y ~ x + dd), type = "predictive")  # 0.18 -0.25 0.1782609 -0.2666667 0.1173913 0.31 -0.2866667 NaN

statement ok
CREATE TABLE d (id INTEGER, g VARCHAR, x1 DOUBLE, x2 DOUBLE, y DOUBLE, w DOUBLE, split VARCHAR);

