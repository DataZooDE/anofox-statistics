FROM ard_fit_predict_by('sp205', g, y, [x, x2], split := sp, order_by := t) m
JOIN (SELECT g, t, l[rn] AS p FROM (
    SELECT g, t, row_number() OVER win AS rn, ard_fit_predict_agg(y, [x, x2], sp) OVER win AS l FROM sp205 WINDOW win AS (PARTITION BY g ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING))) a
USING (g, t);
----
