query III
SELECT count(*), count(*) FILTER (WHERE m.is_training),
       count(*) FILTER (WHERE m.is_training IS DISTINCT FROM coalesce((m.yr IS NOT NULL AND lower(m.sp) IN ('train', 'training')), false)
                        OR NOT (m.yhat IS NOT DISTINCT FROM predict(f.model, [m.x, m.x2]) OR abs(m.yhat - predict(f.model, [m.x, m.x2])) <= 1e-9 * greatest(1.0, abs(predict(f.model, [m.x, m.x2])))))
FROM binomial_fit_predict_by('sp205', g, yr, [x, x2], split := sp) m
JOIN (SELECT g, binomial_fit_agg(yr, [x, x2]) FILTER (WHERE (yr IS NOT NULL AND lower(sp) IN ('train', 'training'))) AS model FROM sp205 GROUP BY g) f USING (g);
