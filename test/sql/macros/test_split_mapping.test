# =============================================================================
# null_policy 'zero' with split (#207): a NULL y is fitted as 0 on a training row, and the
# held-out rows (other values and per-row NULL splits) stay out of the fit
# =============================================================================

query IIII
SELECT count(*), count(*) FILTER (WHERE m.is_training),
       count(*) FILTER (WHERE m.is_training IS DISTINCT FROM (a.p).is_training OR NOT (m.yhat IS NOT DISTINCT FROM (a.p).yhat OR abs(m.yhat - (a.p).yhat) <= 1e-9 * greatest(1.0, abs((a.p).yhat)))),
       count(*) FILTER (WHERE m.is_training IS DISTINCT FROM ((lower(m.sp) IN ('train', 'training')) IS TRUE))
FROM ols_fit_predict_by('sp205', g, y, [x, x2], {'null_policy': 'zero'}, split := sp, order_by := t) m
JOIN (SELECT g, t, l[rn] AS p FROM (
    SELECT g, t, row_number() OVER win AS rn, ols_fit_predict_agg(y, [x, x2], sp, {'null_policy': 'zero'}) OVER win AS l
    FROM sp205 WINDOW win AS (PARTITION BY g ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING))) a
USING (g, t);
----
80	56	0	0

query I
SELECT count(*) FILTER (WHERE is_training)
FROM lm_dynamic_fit_predict_by('sp205', g, y, [x, x2], {'null_policy': 'zero'}, split := sp, order_by := t);
