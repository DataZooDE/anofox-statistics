# A split expression (not a column) follows the same rule
query I
SELECT count(*) FILTER (WHERE is_training)
FROM ols_fit_predict_by('sp205', g, y, [x, x2], split := CASE WHEN t <= 20 THEN 'TRAIN' END, order_by := t);
