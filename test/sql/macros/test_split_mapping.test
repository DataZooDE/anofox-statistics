# name: test/sql/macros/test_split_mapping.test
# description: The split argument of the *_fit_predict_by / *_augment_by / *_prediction_by
#              macros follows the *_fit_predict_agg split_col rule (#205): 'train' / 'training'
#              in any case is a training row; any other value, or a per-row NULL, is predicted.
#              With split omitted every row with a non-NULL y trains.
# group: [macros]

require anofox_statistics

# Two groups of 40 rows. sp by t % 10: 'train', 'Train', 'TRAINING', 'training', 'train',
# 'Train', 'test', 'future', NULL, 'training' (28 training labels, 4 'test', 4 'future',
# 4 NULL per group). y is NULL at t = 5 ('Train') and t = 33 ('training'), so 26 rows
# per group (52 in all) train with sp, and the 76 rows with a non-NULL y without it.
statement ok
CREATE TABLE sp205 AS
SELECT g, t, x, x2, w,
       CASE WHEN t IN (5, 33) THEN NULL ELSE 2.0 + 0.8 * x + 0.3 * x2 + e END AS y,
       CASE WHEN t IN (5, 33) THEN NULL ELSE round(2.0 + 0.8 * x + 0.3 * x2 + e) END AS yc,
       CASE WHEN t IN (5, 33) THEN NULL ELSE 1.0 / (1.0 + exp(-((x - 6.0) / 3.0 + e / 2.0))) END AS yr,
       CASE WHEN t IN (5, 33) THEN NULL WHEN x + 2.0 * e > 6.5 THEN 1.0 ELSE 0.0 END AS yb,
       ['train', 'Train', 'TRAINING', 'training', 'train', 'Train', 'test', 'future', NULL, 'training'][t % 10 + 1] AS sp
FROM (
    SELECT g, t, ((t * 7) % 13)::DOUBLE + g AS x, ((t * 5) % 7)::DOUBLE AS x2, (1 + t % 3)::DOUBLE AS w,
           (((t * 31) % 9) - 4) / 4.0 AS e
    FROM range(1, 3) gr(g), range(1, 41) r(t)
);

# The rule itself, on the data
query IIII
SELECT count(*) FILTER (WHERE lower(sp) IN ('train', 'training')),
       count(*) FILTER (WHERE y IS NOT NULL AND lower(sp) IN ('train', 'training')),
       count(*) FILTER (WHERE sp IS NULL),
       count(*) FILTER (WHERE y IS NOT NULL)
FROM sp205;
----
56	52	8	76


# =============================================================================
# Fit-predict macros built on *_fit_predict_agg: same training rows and yhat as the
# aggregate called with the same split column. Columns: rows, training rows, rows whose
# is_training or yhat differ from the aggregate, rows whose is_training differs from the rule.
# =============================================================================

query IIII
SELECT count(*), count(*) FILTER (WHERE m.is_training),
       count(*) FILTER (WHERE m.is_training IS DISTINCT FROM (a.p).is_training OR NOT (m.yhat IS NOT DISTINCT FROM (a.p).yhat OR abs(m.yhat - (a.p).yhat) <= 1e-9 * greatest(1.0, abs((a.p).yhat)))),
       count(*) FILTER (WHERE m.is_training IS DISTINCT FROM coalesce((m.y IS NOT NULL AND lower(m.sp) IN ('train', 'training')), false))
FROM ols_fit_predict_by('sp205', g, y, [x, x2], split := sp, order_by := t) m
JOIN (SELECT g, t, l[rn] AS p FROM (
    SELECT g, t, row_number() OVER win AS rn, ols_fit_predict_agg(y, [x, x2], sp) OVER win AS l FROM sp205 WINDOW win AS (PARTITION BY g ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING))) a
USING (g, t);
----
80	52	0	0

# split omitted: every row with a non-NULL y trains (unchanged), as does an explicit split := NULL
query III
SELECT count(*), count(*) FILTER (WHERE is_training),
       count(*) FILTER (WHERE is_training IS DISTINCT FROM (y IS NOT NULL))
FROM ols_fit_predict_by('sp205', g, y, [x, x2], order_by := t);
----
80	76	0

query I
SELECT count(*) FILTER (WHERE is_training)
FROM ols_fit_predict_by('sp205', g, y, [x, x2], split := NULL, order_by := t);
----
76

