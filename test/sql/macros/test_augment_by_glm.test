# name: test/sql/macros/test_augment_by_glm.test
# description: poisson/binomial/logistic/negbinom/gamma/tweedie_augment_by (#151, contract `obs` schema)
#              against R glm() / MASS::glm.nb(): fitted, deviance residuals, rstandard, rstudent,
#              hatvalues, cooks.distance, dffits; offset; non-training rows; row alignment; errors.
# group: [macros]

require anofox_statistics

# Reference values from R 4.6.1 (stats::glm, MASS::glm.nb, statmod::tweedie), produced by the script
# below. Conventions (upstream anofox_regression::diagnostics::augment_glm, as R):
# - residual is the deviance residual (resid_type 'deviance'); fitted is on the response scale.
# - std_residual is the deviance residual standardised by sqrt(phi * (1 - h)), i.e.
#   rstandard(f, type = "deviance") -- broom's .std.resid with type.residuals = "deviance".
#   R >= 4.6 changed the default of rstandard.glm to type = "pearson", hence the explicit type.
# - phi = 1 for poisson / binomial / negative binomial (glm.nb objects), the Pearson estimate
#   summary(f)$dispersion (= sigma(f)^2) for Gamma and Tweedie.
# - R is run with glm.control(epsilon = 1e-14): with the default 1e-8 the Gamma fit is only
#   converged to ~5e-6. Likewise the Gamma / Tweedie macros are given 'tolerance': 1e-15 below
#   (the default 1e-8 matches <family>_fit_agg and is good to ~5e-5 here).
# Max abs differences observed over all seven columns: poisson 2.5e-8, binomial / logistic 1.6e-8,
# negbinom 1.1e-8, gamma 7.1e-8, tweedie 3.2e-7, poisson with offset 1.2e-8.
#
#   suppressMessages({library(MASS); library(statmod)})
#   i <- 1:20
#   mk <- function(g, x1, x2, k) {
#     yc <- round(exp(0.8 + 0.15 * x1 + 0.1 * x2 + 1.1 * sin(i * 1.7 + k)))
#     yb <- as.numeric(0.8 * sin(i * 2.3 + k) + 0.25 * x1 - 0.3 * x2 > 0.2)
#     yp <- round(exp(0.5 + 0.1 * x1 - 0.2 * x2) * (1 + 0.5 * cos(i * 1.1 + k)), 4)
#     data.frame(g = g, x1 = x1, x2 = x2, yc = yc, yb = yb, yp = yp)
#   }
#   a <- mk("a", i / 4, ((i * 7) %% 11) / 5, 0); a$x1[20] <- 12          # high-leverage row
#   a <- mk("a", a$x1, a$x2, 0)
#   b <- mk("b", ((i * 3) %% 7) / 2 + i / 10, ((i * 5) %% 13) / 4, 1)
#   d <- rbind(a, b)
#   d$row_id <- seq_len(nrow(d)); d$row_id[d$g == "b"] <- d$row_id[d$g == "b"] + 1   # test row 21 after group a
#   ctl <- glm.control(epsilon = 1e-14, maxit = 100)   # tighter than R's default 1e-8 (under-converged for Gamma)
#   fits <- list(
#     poisson  = function(s) glm(yc ~ x1 + x2, family = poisson, data = s, control = ctl),
#     binomial = function(s) glm(yb ~ x1 + x2, family = binomial, data = s, control = ctl),
#     logistic = function(s) glm(yb ~ x1 + x2, family = binomial, data = s, control = ctl),
#     negbinom = function(s) glm.nb(yc ~ x1 + x2, data = s, control = ctl),
#     gamma    = function(s) glm(yp ~ x1 + x2, family = Gamma(link = "log"), data = s, control = ctl),
#     poisson_offset = function(s) glm(yc ~ x1 + offset(log(1 + x2)), family = poisson, data = s, control = ctl),
#     tweedie  = function(s) glm(yp ~ x1 + x2, family = tweedie(var.power = 1.5, link.power = 0), data = s, control = ctl))
#   out <- NULL; preds <- NULL
#   for (grp in c("a", "b")) {
#     s <- d[d$g == grp, ]
#     for (m in names(fits)) {
#       f <- fits[[m]](s)
#       out <- rbind(out, data.frame(model = m, row_id = s$row_id, fitted = fitted(f),
#         residual = residuals(f, type = "deviance"), std_residual = rstandard(f, type = "deviance"), stud_residual = rstudent(f),
#         leverage = hatvalues(f), cooks_d = cooks.distance(f), dffits = dffits(f)))
#       nd <- if (grp == "a") data.frame(x1 = 2.6, x2 = 0.8) else data.frame(x1 = 1.7, x2 = 1.1)
#       preds <- rbind(preds, data.frame(model = m, g = grp, pred = predict(f, nd, type = "response")))
#     }
#   }
#   cat("DATA\n")
#   for (k in seq_len(nrow(d))) cat(sprintf("(%d, '%s', %s, %s, %s, %s, %s, 'train'),\n", d$row_id[k], d$g[k], format(d$x1[k]), format(d$x2[k]), format(d$yc[k]), format(d$yb[k]), format(d$yp[k])))
#   cat("REF\n")
#   for (k in seq_len(nrow(out))) with(out[k, ], cat(sprintf("('%s', %d, %.12g, %.12g, %.12g, %.12g, %.12g, %.12g, %.12g),\n", model, row_id, fitted, residual, std_residual, stud_residual, leverage, cooks_d, dffits)))
#   cat("PRED\n")
#   for (k in seq_len(nrow(preds))) with(preds[k, ], cat(sprintf("('%s', '%s', %.12g),\n", model, g, pred)))
#
# Row 21 (group a, split = 'test') and row 42 (group b, NULL y) are not used by the fits; `pred`
# holds R's predict(f, newdata, type = "response") at them.

statement ok
CREATE TABLE d (id INTEGER, g VARCHAR, x1 DOUBLE, x2 DOUBLE, yc DOUBLE, yb DOUBLE, yp DOUBLE, split VARCHAR);

statement ok
