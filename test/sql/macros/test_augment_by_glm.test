statement ok
CREATE TABLE pred (model VARCHAR, g VARCHAR, pred DOUBLE);

statement ok
INSERT INTO pred VALUES
('poisson', 'a', 5.27884174911),
('binomial', 'a', 0.578106521666),
('logistic', 'a', 0.578106521666),
('negbinom', 'a', 5.35882064993),
('gamma', 'a', 1.83252116641),
('poisson_offset', 'a', 4.49112911402),
('tweedie', 'a', 1.8351330709),
('poisson', 'b', 4.40086041459),
('binomial', 'b', 0.820343046183),
('logistic', 'b', 0.820343046183),
('negbinom', 'b', 4.36348998089),
('gamma', 'b', 1.30899488682),
('poisson_offset', 'b', 3.56011788231),
('tweedie', 'b', 1.31218832089);;

statement ok
CREATE VIEW d_off AS SELECT *, ln(1 + x2) AS lx2 FROM d;

statement ok
CREATE TABLE aug AS
SELECT 'poisson' AS model, * FROM poisson_augment_by('d', g, yc, [x1, x2], split := split)
UNION ALL BY NAME SELECT 'binomial' AS model, * FROM binomial_augment_by('d', g, yb, [x1, x2], split := split)
UNION ALL BY NAME SELECT 'logistic' AS model, * FROM logistic_augment_by('d', g, yb, [x1, x2], split := split)
UNION ALL BY NAME SELECT 'negbinom' AS model, * FROM negbinom_augment_by('d', g, yc, [x1, x2], split := split)
UNION ALL BY NAME SELECT 'gamma' AS model, * FROM gamma_augment_by('d', g, yp, [x1, x2], {'tolerance': 1e-15, 'max_iterations': 200}, split := split)
UNION ALL BY NAME SELECT 'poisson_offset' AS model, * EXCLUDE (lx2) FROM poisson_augment_by('d_off', g, yc, [x1, lx2], {'offset': 2}, split := split)
UNION ALL BY NAME SELECT 'tweedie' AS model, * FROM tweedie_augment_by('d', g, yp, [x1, x2], {'power': 1.5, 'tolerance': 1e-15, 'max_iterations': 200}, split := split);

# Every training row of every model matches R (40 rows per model, 7 models)
query IIII
SELECT count(*), count(DISTINCT model),
    max(greatest(abs(a.fitted - r.fitted), abs(a.residual - r.residual), abs(a.std_residual - r.std_residual),
        abs(a.stud_residual - r.stud_residual), abs(a.leverage - r.leverage), abs(a.cooks_d - r.cooks_d),
        abs(a.dffits - r.dffits))) < 1e-6,
    bool_and(a.is_training)
FROM aug a JOIN ref r USING (model, row_id);
----
280	7	true	true

# Non-training rows: R's response-scale prediction as fitted, NULL diagnostics
query IIIII
SELECT count(*), max(abs(a.fitted - p.pred)) < 1e-7, bool_and(NOT a.is_training),
    count(*) FILTER (WHERE a.residual IS NOT NULL OR a.std_residual IS NOT NULL OR a.stud_residual IS NOT NULL
        OR a.leverage IS NOT NULL OR a.cooks_d IS NOT NULL OR a.dffits IS NOT NULL),
    bool_and(a.resid_type = 'deviance')
FROM aug a JOIN pred p ON a.model = p.model AND a.g = p.g
WHERE a.row_id IN (21, 42);
----
14	true	true	0	true

# Alignment: every source row once per model, row_id in source order, model_id = model_name = the method, source columns kept
query IIIII
SELECT model, count(*), count(*) FILTER (WHERE row_id <> id OR model_id <> split_part(model, '_', 1) OR model_name <> model_id), min(n_params), max(n_params)
FROM aug GROUP BY model ORDER BY model;
----
binomial	42	0	3	3
gamma	42	0	3	3
logistic	42	0	3	3
negbinom	42	0	3	3
poisson	42	0	3	3
poisson_offset	42	0	2	2
tweedie	42	0	3	3

query III
SELECT bool_and(resid_type = 'deviance'), bool_and(weight = 1.0), count(DISTINCT g)
FROM aug;
----
true	true	2

# Logistic is binomial with the logit link
query I
SELECT count(*) FROM aug a JOIN aug b USING (row_id)
WHERE a.model = 'binomial' AND b.model = 'logistic' AND abs(a.fitted - b.fitted) > 1e-12;
----
0

# Family options pass through: a probit link and a fixed Negative Binomial theta change the fit
query II
SELECT bool_and(fitted > 0 AND fitted < 1), count(*) FILTER (WHERE is_training)
FROM binomial_augment_by('d', g, yb, [x1, x2], {'link': 'probit'}, split := split);
----
true	40

query I
SELECT count(*) FROM negbinom_augment_by('d', g, yc, [x1, x2], {'theta': 2.0}, split := split) a
JOIN aug b ON b.model = 'negbinom' AND a.row_id = b.row_id
WHERE a.is_training AND abs(a.fitted - b.fitted) > 1e-6;
----
40

# Penalized fits have no augment counterpart: upstream rejects them
statement error
SELECT * FROM poisson_augment_by('d', g, yc, [x1, x2], {'glm_lambda': 0.5})
----
augment is not defined for a penalized GLM fit

statement error
SELECT * FROM logistic_augment_by('d', g, yb, [x1, x2],
    {'prior': {'x1': {'dist': 'normal', 'loc': 0, 'scale': 1}}, 'feature_names': ['x1', 'x2']})
----
augment is not defined for a penalized GLM fit

# Only the keys that change the fit of that family
statement error
SELECT * FROM gamma_augment_by('d', g, yp, [x1, x2], {'power': 1.5})
----
unsupported option 'power'

statement error
SELECT * FROM tweedie_augment_by('d', g, yp, [x1, x2], {'bogus': 1})
----
bogus
