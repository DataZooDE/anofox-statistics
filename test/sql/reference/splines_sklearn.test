# name: test/sql/reference/splines_sklearn.test
# description: #317 bspline / bspline_knots_agg vs scikit-learn SplineTransformer
# group: [reference]
#
# Generated by validation/generators/make_reference_splines.py (scikit-learn 1.9.1,
# numpy 2.5.4). Do not edit by hand.

require anofox_statistics

statement ok
CREATE MACRO max_abs_diff(a, b) AS CASE WHEN len(a) = len(b) THEN coalesce(list_max(list_transform(range(1, len(a) + 1), lambda i: abs(a[i] - b[i]))), 0) ELSE 1e300 END;

