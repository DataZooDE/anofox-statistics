CREATE TABLE shuffled AS SELECT * FROM d ORDER BY (t * 17) % 41;

# passive_aggressive_fit_agg, one online pass = partial_fit: PA-I, C = 1, epsilon = 0.1 (defaults)
query IIIII
SELECT
    abs((m.intercept) - (0.3890994251604374)) <= 1e-09 * (1 + abs(0.3890994251604374)),
    abs((m.coefficients[1]) - (1.022916078156287)) <= 1e-09 * (1 + abs(1.022916078156287)),
    abs((m.coefficients[2]) - (-0.4260207447597908)) <= 1e-09 * (1 + abs(-0.4260207447597908)),
    m.iterations = 1,
    m.n_observations = 40
FROM (SELECT passive_aggressive_fit_agg(y, [x1, x2] ORDER BY t) AS m FROM shuffled)
----
true	true	true	true	true

# passive_aggressive_fit_agg, one online pass = partial_fit: PA-I, C = 0.05, epsilon = 0
query IIIII
SELECT
    abs((m.intercept) - (0.5202642408210679)) <= 1e-09 * (1 + abs(0.5202642408210679)),
    abs((m.coefficients[1]) - (0.9753059081730793)) <= 1e-09 * (1 + abs(0.9753059081730793)),
    abs((m.coefficients[2]) - (-0.6446348238246198)) <= 1e-09 * (1 + abs(-0.6446348238246198)),
    m.iterations = 1,
    m.n_observations = 40
FROM (SELECT passive_aggressive_fit_agg(y, [x1, x2], {'c': 0.05, 'epsilon': 0} ORDER BY t) AS m FROM shuffled)
----
true	true	true	true	true

# passive_aggressive_fit_agg, one online pass = partial_fit: PA-II, C = 0.5, epsilon = 0.2
query IIIII
SELECT
    abs((m.intercept) - (0.4469910473936694)) <= 1e-09 * (1 + abs(0.4469910473936694)),
    abs((m.coefficients[1]) - (1.1311729864022684)) <= 1e-09 * (1 + abs(1.1311729864022684)),
    abs((m.coefficients[2]) - (-0.7372821550605979)) <= 1e-09 * (1 + abs(-0.7372821550605979)),
    m.iterations = 1,
    m.n_observations = 40
FROM (SELECT passive_aggressive_fit_agg(y, [x1, x2], {'variant': 'pa2', 'C': 0.5, 'epsilon': 0.2} ORDER BY t) AS m FROM shuffled)
----
true	true	true	true	true

# passive_aggressive_fit_agg, max_iterations = 50, tolerance = 1e-6 = fit(max_iter=50, tol=1e-6)
query IIII
SELECT
    abs((m.intercept) - (0.3827653012334594)) <= 1e-09 * (1 + abs(0.3827653012334594)),
    abs((m.coefficients[1]) - (1.033793110717802)) <= 1e-09 * (1 + abs(1.033793110717802)),
    abs((m.coefficients[2]) - (-0.3815793096230602)) <= 1e-09 * (1 + abs(-0.3815793096230602)),
    m.iterations = 7
FROM (SELECT passive_aggressive_fit_agg(y, [x1, x2], {'max_iterations': 50, 'tolerance': 1e-6} ORDER BY t) AS m FROM shuffled)
----
true	true	true	true

statement ok
CREATE TABLE w AS SELECT t, (passive_aggressive_fit_predict(y, [x1, x2]) OVER (ORDER BY t ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)).yhat AS p FROM shuffled;

# passive_aggressive_fit_predict OVER a cumulative frame = partial_fit on the prefix, predicting its last row
query IIIII
SELECT
    abs(((SELECT p FROM w WHERE t = 1)) - (0.0)) <= 1e-09 * (1 + abs(0.0)),
    abs(((SELECT p FROM w WHERE t = 2)) - (-1.963864569268112)) <= 1e-09 * (1 + abs(-1.963864569268112)),
    abs(((SELECT p FROM w WHERE t = 10)) - (0.7818687759574356)) <= 1e-09 * (1 + abs(0.7818687759574356)),
    abs(((SELECT p FROM w WHERE t = 25)) - (3.022441763641387)) <= 1e-09 * (1 + abs(3.022441763641387)),
    abs(((SELECT p FROM w WHERE t = 40)) - (1.9310939729803542)) <= 1e-09 * (1 + abs(1.9310939729803542))
----
true	true	true	true	true

# passive_aggressive_fit_predict_agg: fit on rows 1-30 (y NULL after), predict all
query IIIIII
SELECT
    abs((p[1].yhat) - (-2.063058247358269)) <= 1e-09 * (1 + abs(-2.063058247358269)),
    abs((p[30].yhat) - (0.7272449840497834)) <= 1e-09 * (1 + abs(0.7272449840497834)),
    abs((p[31].yhat) - (0.6266931974924189)) <= 1e-09 * (1 + abs(0.6266931974924189)),
    abs((p[40].yhat) - (2.8893684054806434)) <= 1e-09 * (1 + abs(2.8893684054806434)),
    p[31].is_training = false,
    p[30].is_training = true
FROM (SELECT passive_aggressive_fit_predict_agg(CASE WHEN t <= 30 THEN y END, [x1, x2] ORDER BY t) AS p FROM shuffled)
----
true	true	true	true	true	true
