    abs(((SELECT multinomial_predict(t.m, [x1, x2, x3], {'type': 'prob'})[3] FROM d WHERE id = 62)) - (0.0928336103912798)) <= 1e-6 * (1 + abs(0.0928336103912798))
FROM (SELECT multinomial_fit_agg(y, [x1, x2, x3], w, {'C': 2}) AS m FROM d) t;
