0

# ---- bspline_knots_agg = seq(min, max, length = n) / quantile(x, seq(0, 1, length = n), type = 7) ----

query II
SELECT max_abs_diff(bspline_knots_agg(x, 2), [20.899999999999999, 73.150000000000006]) < 1e-12, max_abs_diff(bspline_knots_agg(x, 2, {'knots': 'quantile'}), [20.899999999999999, 73.150000000000006]) < 1e-12 FROM dsA;
----
true	true

query II
SELECT max_abs_diff(bspline_knots_agg(x, 5), [20.899999999999999, 33.962499999999999, 47.025000000000006, 60.087500000000006, 73.150000000000006]) < 1e-12, max_abs_diff(bspline_knots_agg(x, 5, {'knots': 'quantile'}), [20.899999999999999, 35.737499999999997, 44.409999999999997, 50.592500000000001, 73.150000000000006]) < 1e-12 FROM dsA;
----
true	true

query II
SELECT max_abs_diff(bspline_knots_agg(x, 7), [20.899999999999999, 29.608333333333334, 38.316666666666663, 47.024999999999999, 55.733333333333334, 64.441666666666663, 73.150000000000006]) < 1e-12, max_abs_diff(bspline_knots_agg(x, 7, {'knots': 'quantile'}), [20.899999999999999, 32.911666666666669, 38.616666666666674, 44.409999999999997, 47.663333333333334, 53.821666666666658, 73.150000000000006]) < 1e-12 FROM dsA;
----
true	true

# ---- default_knot_quantiles(nk): RMS Table 2.3 (rcspline.eval: seq(outer, 1 - outer, length = nk)) ----

query I
SELECT max_abs_diff(default_knot_quantiles(3), [0.10000000000000001, 0.5, 0.90000000000000002]) < 1e-15;
----
true

query I
SELECT max_abs_diff(default_knot_quantiles(4), [0.050000000000000003, 0.34999999999999998, 0.65000000000000002, 0.94999999999999996]) < 1e-15;
----
true

query I
SELECT max_abs_diff(default_knot_quantiles(5), [0.050000000000000003, 0.27499999999999997, 0.49999999999999994, 0.72499999999999998, 0.94999999999999996]) < 1e-15;
----
true

query I
SELECT max_abs_diff(default_knot_quantiles(6), [0.050000000000000003, 0.22999999999999998, 0.40999999999999998, 0.59000000000000008, 0.77000000000000002, 0.94999999999999996]) < 1e-15;
----
true

query I
SELECT max_abs_diff(default_knot_quantiles(7), [0.025000000000000001, 0.18333333333333332, 0.34166666666666667, 0.5, 0.65833333333333333, 0.81666666666666665, 0.97499999999999998]) < 1e-15;
----
true

query I
SELECT max_abs_diff(default_knot_quantiles(10), [0.025000000000000001, 0.13055555555555556, 0.2361111111111111, 0.34166666666666667, 0.44722222222222224, 0.55277777777777781, 0.65833333333333333, 0.76388888888888895, 0.86944444444444446, 0.97499999999999998]) < 1e-15;
