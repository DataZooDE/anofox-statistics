# rms::lsp(x, [40])
query I
SELECT count(*) FROM (VALUES (-5, [-5, 0]), (0, [0, 0]), (20.5, [20.5, 0]), (25, [25, 0]), (31.699999999999999, [31.699999999999999, 0]), (40, [40, 0]), (44.439999999999998, [44.439999999999998, 4.4399999999999977]), (52, [52, 12]), (60, [60, 20]), (66.599999999999994, [66.599999999999994, 26.599999999999994]), (75, [75, 35]), (90, [90, 50])) t(x, e)
WHERE NOT max_abs_diff(lsp(x, [40]), e) <= 1e-12 * greatest(1, list_max(list_transform(e, lambda v: abs(v))));
----
0

# rms::lsp(x, [30, 45, 60])
query I
SELECT count(*) FROM (VALUES (-5, [-5, 0, 0, 0]), (0, [0, 0, 0, 0]), (20.5, [20.5, 0, 0, 0]), (25, [25, 0, 0, 0]), (31.699999999999999, [31.699999999999999, 1.6999999999999993, 0, 0]), (40, [40, 10, 0, 0]), (44.439999999999998, [44.439999999999998, 14.439999999999998, 0, 0]), (52, [52, 22, 7, 0]), (60, [60, 30, 15, 0]), (66.599999999999994, [66.599999999999994, 36.599999999999994, 21.599999999999994, 6.5999999999999943]), (75, [75, 45, 30, 15]), (90, [90, 60, 45, 30])) t(x, e)
WHERE NOT max_abs_diff(lsp(x, [30, 45, 60]), e) <= 1e-12 * greatest(1, list_max(list_transform(e, lambda v: abs(v))));
----
0

# ---- restricted_interaction(rcs(a, ka), rcs(b, kb)) = rms::rcs(a, ka) %ia% rms::rcs(b, kb) ----

# rms: rcs(a, [2, 4, 6, 8]) %ia% rcs(b, [1, 3, 6]), columns a * b, a * b', a' * b, a'' * b
query I
SELECT count(*) FROM (VALUES (1.5, 2, [3, 0.059999999999999998, 0, 0]), (3, 0.5, [1.5, 0, 0.013888888888888893, 0]), (4.2000000000000002, 3.2999999999999998, [13.859999999999999, 2.0364960000000001, 0.97606666666666708, 0.00073333333333333562]), (5, 6, [30, 16.000000000000007, 4.5000000000000018, 0.16666666666666671]), (6.7999999999999998, 1, [6.7999999999999998, 0, 3.0293333333333341, 0.58133333333333326]), (8, 4.4000000000000004, [35.200000000000003, 11.11381333333334, 23.466666666666679, 5.8666666666666689]), (9.9000000000000004, 7, [69.299999999999997, 43.559999999999988, 63.933333333333351, 18.200000000000006])) t(a, b, e)
WHERE NOT max_abs_diff(restricted_interaction(rcs(a, [2, 4, 6, 8]), rcs(b, [1, 3, 6])), e) <= 1e-10 * greatest(1, list_max(list_transform(e, lambda v: abs(v))));
----
0

# rms: lsp(a, 5) %ia% rcs(b, [1, 3, 6]), columns a * b, a * b', a' * b
query I
SELECT count(*) FROM (VALUES (1.5, 2, [3, 0.059999999999999998, 0]), (3, 0.5, [1.5, 0, 0]), (4.2000000000000002, 3.2999999999999998, [13.859999999999999, 2.0364960000000001, 0]), (5, 6, [30, 16.000000000000007, 0]), (6.7999999999999998, 1, [6.7999999999999998, 0, 1.7999999999999998]), (8, 4.4000000000000004, [35.200000000000003, 11.11381333333334, 13.200000000000001]), (9.9000000000000004, 7, [69.299999999999997, 43.559999999999988, 34.300000000000004])) t(a, b, e)
WHERE NOT max_abs_diff(restricted_interaction(lsp(a, [5.0]), rcs(b, [1, 3, 6])), e) <= 1e-10 * greatest(1, list_max(list_transform(e, lambda v: abs(v))));
----
0

# ---- bspline(x, knots, degree) = splineDesign on the extended knot vector (inside the base knots) ----

# splineDesign(knots = [-7.5, -5, -2.5, 0, 2.5, 5, 7.5, 10, 12.5, 15, 17.5], ord = 4)
query I
SELECT count(*) FROM (VALUES (0, [0.16666666666666666, 0.66666666666666663, 0.16666666666666666, 0, 0, 0, 0]), (0.29999999999999999, [0.11357866666666669, 0.65313066666666675, 0.23300266666666666, 0.00028800000000000001, 0, 0, 0]), (1.25, [0.020833333333333332, 0.47916666666666669, 0.47916666666666669, 0.020833333333333332, 0, 0, 0]), (2.5, [0, 0.16666666666666666, 0.66666666666666663, 0.16666666666666666, 0, 0, 0]), (3.9900000000000002, [0, 0.010989877333333327, 0.41730503466666669, 0.53642029866666674, 0.035284789333333351, 0, 0]), (4, [0, 0.010666666666666666, 0.41466666666666674, 0.53866666666666674, 0.036000000000000011, 0, 0]), (5.5, [0, 0, 0.08533333333333333, 0.6306666666666666, 0.28266666666666668, 0.0013333333333333333, 0]), (7.2000000000000002, [0, 0, 0.00028799999999999952, 0.23300266666666664, 0.65313066666666675, 0.11357866666666669, 0]), (8.8000000000000007, [0, 0, 0, 0.018431999999999969, 0.46657066666666652, 0.49156266666666687, 0.023434666666666708]), (10, [0, 0, 0, 0, 0.16666666666666666, 0.66666666666666663, 0.16666666666666666])) t(x, e)
WHERE NOT max_abs_diff(bspline(x, [0, 2.5, 5, 7.5, 10], 3), e) <= 1e-12;
----
0

# splineDesign(knots = [-2, -1, 0, 1, 4, 6, 10, 14, 18], ord = 3)
query I
SELECT count(*) FROM (VALUES (0, [0.5, 0.5, 0, 0, 0, 0]), (0.29999999999999999, [0.24499999999999997, 0.73249999999999993, 0.022499999999999999, 0, 0, 0]), (1.25, [0, 0.63020833333333326, 0.36562499999999998, 0.0041666666666666666, 0, 0]), (2.5, [0, 0.1875, 0.66250000000000009, 0.15000000000000002, 0, 0]), (3.9900000000000002, [0, 8.333333333332978e-06, 0.40398499999999987, 0.59600666666666668, 0, 0]), (4, [0, 0, 0.40000000000000002, 0.60000000000000009, 0, 0]), (5.5, [0, 0, 0.025000000000000001, 0.78749999999999998, 0.1875, 0]), (7.2000000000000002, [0, 0, 0, 0.32666666666666661, 0.6283333333333333, 0.045000000000000012]), (8.8000000000000007, [0, 0, 0, 0.059999999999999928, 0.69499999999999995, 0.24500000000000013]), (10, [0, 0, 0, 0, 0.5, 0.5])) t(x, e)
WHERE NOT max_abs_diff(bspline(x, [0, 1, 4, 6, 10], 2), e) <= 1e-12;
----
0

# splineDesign(knots = [-3, 0, 3, 10, 17], ord = 2)
query I
SELECT count(*) FROM (VALUES (0, [1, 0, 0]), (0.29999999999999999, [0.90000000000000002, 0.099999999999999992, 0]), (1.25, [0.58333333333333326, 0.41666666666666663, 0]), (2.5, [0.16666666666666666, 0.83333333333333326, 0]), (3.9900000000000002, [0, 0.85857142857142854, 0.14142857142857146]), (4, [0, 0.8571428571428571, 0.14285714285714285]), (5.5, [0, 0.64285714285714279, 0.3571428571428571]), (7.2000000000000002, [0, 0.39999999999999997, 0.59999999999999998]), (8.8000000000000007, [0, 0.17142857142857132, 0.82857142857142863]), (10, [0, 0, 1])) t(x, e)
WHERE NOT max_abs_diff(bspline(x, [0, 3, 10], 1), e) <= 1e-12;
----
0

# splineDesign(knots = [-6, -4, -2, 0, 2, 5, 9, 10, 11, 12, 13], ord = 4)
query I
SELECT count(*) FROM (VALUES (0, [0.16666666666666666, 0.69047619047619047, 0.14285714285714285, 0, 0, 0, 0]), (0.29999999999999999, [0.10235416666666666, 0.6817279761904762, 0.21561785714285708, 0.00029999999999999997, 0, 0, 0]), (1.25, [0.0087890625, 0.47586495535714285, 0.49364459325396826, 0.021701388888888888, 0, 0, 0]), (2.5, [0, 0.14880952380952381, 0.68055555555555558, 0.169890873015873, 0.00074404761904761901, 0, 0]), (3.9900000000000002, [0, 0.0098123904761904697, 0.47202981904761898, 0.47124946309523807, 0.046908327380952387, 0, 0]), (4, [0, 0.0095238095238095229, 0.46984126984126984, 0.473015873015873, 0.047619047619047616, 0, 0]), (5.5, [0, 0, 0.1701388888888889, 0.57673611111111112, 0.25208333333333338, 0.0010416666666666667, 0]), (7.2000000000000002, [0, 0, 0.023142857142857135, 0.31737142857142853, 0.57075238095238101, 0.088733333333333358, 0]), (8.8000000000000007, [0, 0, 3.1746031746031406e-05, 0.042882539682539612, 0.49981904761904739, 0.45726666666666688, 0]), (10, [0, 0, 0, 0, 0.083333333333333329, 0.75, 0.16666666666666666])) t(x, e)
WHERE NOT max_abs_diff(bspline(x, [0, 2, 5, 9, 10], 3), e) <= 1e-12;
