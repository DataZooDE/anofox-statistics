    abs((r.conf_high[2]) - (-0.053173491226915864)) <= 1e-08 * (1 + abs(-0.053173491226915864))
FROM (SELECT poisson_fit_agg(cnt, [x1, x2], firm, {'vcov': 'cluster', 'tolerance': 1e-12}) AS r FROM d) s;
