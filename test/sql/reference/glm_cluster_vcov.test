FROM (SELECT logistic_fit_agg(yb, [x1, x2], firm, {'vcov': 'cluster', 'tolerance': 1e-12, 'feature_names': ['x1', 'x2'], 'prior': MAP {'x1': {'normal': [0.0, 0.5]}, 'x2': {'normal': [0.0, 0.5]}}}) AS r FROM d) s;
