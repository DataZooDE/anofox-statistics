    abs((r.conf_high[2]) - (-0.053173491226511382)) <= 1e-05 * (1 + abs(-0.053173491226511382))
FROM (SELECT negbinom_fit_agg(cnt, [x1, x2], firm, {'vcov': 'cluster', 'tolerance': 1e-12}) AS r FROM d) s;
