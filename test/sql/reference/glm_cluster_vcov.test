    abs((r.vcov[16]) - (0.013338277515010833)) <= 1e-06 * (1 + abs(0.013338277515010833))
FROM (SELECT aft_fit_agg(tt, [x1, x2], ev, firm, {'distribution': 'weibull', 'tolerance': 1e-12}) AS r FROM d) s;
----
true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true

# aft (weibull), firm: survreg(cluster =): vcov_type and clusters per dimension
query TT
SELECT r.vcov_type, r.n_clusters::VARCHAR FROM (SELECT aft_fit_agg(tt, [x1, x2], ev, firm, {'distribution': 'weibull', 'tolerance': 1e-12}) AS r FROM d) s;
