# poisson, firm, default (HC0, cadjust): slope std_errors, z, p, CI (normal) with V
query IIIIIIIIII
SELECT
    abs((r.std_errors[1]) - (0.0509653817531091)) <= 1e-08 * (1 + abs(0.0509653817531091)),
    abs((r.z_values[1]) - ( 7.345966728980887)) <= 1e-08 * (1 + abs( 7.345966728980887)),
    abs((r.p_values[1]) - (2.0427718902159046e-13)) <= 1e-08 * (1 + abs(2.0427718902159046e-13)),
    abs((r.conf_low[1]) - (0.27449968599372038)) <= 1e-08 * (1 + abs(0.27449968599372038)),
    abs((r.conf_high[1]) - (0.4742803113825777)) <= 1e-08 * (1 + abs(0.4742803113825777)),
    abs((r.std_errors[2]) - (0.085672155407598913)) <= 1e-08 * (1 + abs(0.085672155407598913)),
    abs((r.z_values[2]) - (-2.5806264503544658)) <= 1e-08 * (1 + abs(-2.5806264503544658)),
    abs((r.p_values[2]) - (0.0098621231115679567)) <= 1e-08 * (1 + abs(0.0098621231115679567)),
