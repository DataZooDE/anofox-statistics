# penalized logistic (Normal(0, 0.5) slopes): coefficients = posterior mode
query III
SELECT
    abs((r.intercept) - (0.45683779041614336)) <= 1e-08 * (1 + abs(0.45683779041614336)),
    abs((r.coefficients[1]) - (0.20898684466958856)) <= 1e-08 * (1 + abs(0.20898684466958856)),
