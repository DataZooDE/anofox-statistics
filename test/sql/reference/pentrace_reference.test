    abs((t[16].interaction) - (8)) <= 1e-08 * (1 + abs(8)),
    abs((t[16].nonlinear_interaction) - (20)) <= 1e-08 * (1 + abs(20))
FROM (SELECT pentrace_agg(y, [b1, b2, b3, b4, b5, b6, b7, b8], {'terms': ['age', 'age', 'age', 'sex', 'bp', 'age * sex', 'age * sex', 'age * sex'], 'nonlinear': [false, true, true, false, false, false, true, true], 'interactions': MAP {'age * sex': ['age', 'sex']}, 'penalties': {'simple': [0, 1], 'nonlinear': [1, 4], 'interaction': [4, 8], 'nonlinear_interaction': [8, 20]}}) AS t FROM d) s;
----
true	true	true

