# ols, pentrace(f, list(simple = c(0, 2, 5), nonlinear = c(0, 2, 5, 20))): row count and best row
query II
SELECT len(t), list_position(list_transform(t, lambda r: r.is_best), true) FROM (SELECT pentrace_agg(y, [a1, a2, a3, a4, a5, a6, a7, a8], {'terms': ['age', 'age', 'age', 'bp', 'sex', 'race', 'race', 'bp * sex'], 'nonlinear': [false, true, true, false, false, false, false, false], 'interactions': MAP {'bp * sex': ['bp', 'sex']}, 'categorical': ['race'], 'penalties': {'simple': [0, 2, 5], 'nonlinear': [0, 2, 5, 20]}}) AS t FROM d) s;
----
9	6

# ols, pentrace(f, list(simple = c(0, 2, 5), nonlinear = c(0, 2, 5, 20))): row 1
query IIIIII
SELECT
    abs((t[1].df) - (8)) <= 1e-08 * (1 + abs(8)),
    abs((t[1].aic) - (131.63499491935511)) <= 1e-08 * (1 + abs(131.63499491935511)),
    abs((t[1].bic) - (109.33506097709875)) <= 1e-08 * (1 + abs(109.33506097709875)),
    abs((t[1].aic_c) - (130.33769762205782)) <= 1e-08 * (1 + abs(130.33769762205782)),
    abs((t[1].lr_chisq) - (147.63499491935511)) <= 1e-08 * (1 + abs(147.63499491935511)),
    abs((t[1].simple) - (0)) <= 1e-08 * (1 + abs(0))
FROM (SELECT pentrace_agg(y, [a1, a2, a3, a4, a5, a6, a7, a8], {'terms': ['age', 'age', 'age', 'bp', 'sex', 'race', 'race', 'bp * sex'], 'nonlinear': [false, true, true, false, false, false, false, false], 'interactions': MAP {'bp * sex': ['bp', 'sex']}, 'categorical': ['race'], 'penalties': {'simple': [0, 2, 5], 'nonlinear': [0, 2, 5, 20]}}) AS t FROM d) s;
----
true	true	true	true	true	true

