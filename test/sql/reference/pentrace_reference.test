SELECT
    abs((m.vcov[7]) - (5.003972671977368e-06)) <= 1e-08 * (1 + abs(5.003972671977368e-06)),
    abs((m.vcov[8]) - (-6.573610769195977e-05)) <= 1e-08 * (1 + abs(-6.573610769195977e-05)),
    abs((m.vcov[9]) - (-0.0042070165941081629)) <= 1e-08 * (1 + abs(-0.0042070165941081629)),
    abs((m.vcov[10]) - (5.0039726719774933e-06)) <= 1e-08 * (1 + abs(5.0039726719774933e-06)),
    abs((m.vcov[11]) - (3.2843964452697186e-05)) <= 1e-08 * (1 + abs(3.2843964452697186e-05)),
    abs((m.vcov[12]) - (-2.0525350828540454e-05)) <= 1e-08 * (1 + abs(-2.0525350828540454e-05))
FROM (SELECT penalized_ols_fit_agg(y, [c1, c2, c3], {'penalty': 10}) AS m FROM d) s;
----
true	true	true	true	true	true

# ols(y ~ age + bp + sex, penalty = 10), default terms: vcov (row-major, intercept first)
query IIII
SELECT
    abs((m.vcov[13]) - (-0.010809053552521)) <= 1e-08 * (1 + abs(-0.010809053552521)),
    abs((m.vcov[14]) - (-6.5736107691982836e-05)) <= 1e-08 * (1 + abs(-6.5736107691982836e-05)),
    abs((m.vcov[15]) - (-2.0525350828583247e-05)) <= 1e-08 * (1 + abs(-2.0525350828583247e-05)),
    abs((m.vcov[16]) - (0.031533182739839169)) <= 1e-08 * (1 + abs(0.031533182739839169))
FROM (SELECT penalized_ols_fit_agg(y, [c1, c2, c3], {'penalty': 10}) AS m FROM d) s;
----
true	true	true	true

# ols(y ~ age + bp + sex, penalty = 10), default terms: Model L.R., d.f., R2, Sigma
query IIIII
SELECT
    abs((m.lr_chisq) - (135.03220235145284)) <= 1e-08 * (1 + abs(135.03220235145284)),
    abs((m.effective_df) - (3.334879991516809)) <= 1e-08 * (1 + abs(3.334879991516809)),
    abs((m.r_squared) - (0.67851255544164346)) <= 1e-08 * (1 + abs(0.67851255544164346)),
    abs((m.sigma) - (1.010195445555176)) <= 1e-08 * (1 + abs(1.010195445555176)),
    abs((m.n_observations) - (120)) <= 1e-08 * (1 + abs(120))
FROM (SELECT penalized_ols_fit_agg(y, [c1, c2, c3], {'penalty': 10}) AS m FROM d) s;
----
true	true	true	true	true

# ols(y ~ age + bp + sex, penalty = 10), default terms: effective.df.diagonal
query IIII
SELECT
    abs((m.effective_df_diagonal[1]) - (1.1517669093023233)) <= 1e-08 * (1 + abs(1.1517669093023233)),
    abs((m.effective_df_diagonal[2]) - (1.0603366384531396)) <= 1e-08 * (1 + abs(1.0603366384531396)),
    abs((m.effective_df_diagonal[3]) - (1.0606312117980197)) <= 1e-08 * (1 + abs(1.0606312117980197)),
    abs((m.effective_df_diagonal[4]) - (1.062145231963326)) <= 1e-08 * (1 + abs(1.062145231963326))
FROM (SELECT penalized_ols_fit_agg(y, [c1, c2, c3], {'penalty': 10}) AS m FROM d) s;
----
true	true	true	true

# effective d.f. by term: labels
query I
SELECT m.terms = ['x1', 'x2', 'x3'] FROM (SELECT penalized_ols_fit_agg(y, [c1, c2, c3], {'penalty': 10}) AS m FROM d) s;
----
true

# ols(y ~ age + bp + sex, penalty = 10), default terms: effective d.f. by term
query III
SELECT
    abs((m.effective_df_by_term[1]) - (1.0603366384531396)) <= 1e-08 * (1 + abs(1.0603366384531396)),
    abs((m.effective_df_by_term[2]) - (1.0606312117980197)) <= 1e-08 * (1 + abs(1.0606312117980197)),
    abs((m.effective_df_by_term[3]) - (1.062145231963326)) <= 1e-08 * (1 + abs(1.062145231963326))
FROM (SELECT penalized_ols_fit_agg(y, [c1, c2, c3], {'penalty': 10}) AS m FROM d) s;
----
true	true	true

