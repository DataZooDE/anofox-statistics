# One outer group: the macros fit one model per group_col.
statement ok
CREATE TABLE d4o AS SELECT 'all' AS grp, * FROM d4;

# gaussian: lmerTest contest1D(lmer(ly ~ q1 + (1|g)), e_j, confint = TRUE): slope SE, t, df, p, 95% t interval
query IIIIII
SELECT
    abs((r.std_errors[1]) - (0.12726636309685166)) <= 1e-06 * (1 + abs(0.12726636309685166)),
    abs((r.t_values[1]) - (4.7081715241295656)) <= 1e-06 * (1 + abs(4.7081715241295656)),
    abs((r.df[1]) - (43.44885071243138)) <= 1e-06 * (1 + abs(43.44885071243138)),
    abs((r.p_values[1]) - (2.5684972568582242e-05)) <= 1e-06 * (1 + abs(2.5684972568582242e-05)),
    abs((r.ci_lower[1]) - (0.34261143868434324)) <= 1e-06 * (1 + abs(0.34261143868434324)),
    abs((r.ci_upper[1]) - (0.85577229473991823)) <= 1e-06 * (1 + abs(0.85577229473991823))
FROM (SELECT glmm_fit_agg(ly, [q1], g, {'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

# gaussian: the intercept's Satterthwaite df, p and interval
query IIII
SELECT
    abs((r.intercept_df) - (7.2698563578114461)) <= 1e-06 * (1 + abs(7.2698563578114461)),
    abs((r.intercept_p_value) - (1.129007103420909e-07)) <= 1e-06 * (1 + abs(1.129007103420909e-07)),
    abs((r.intercept_conf_low) - (2.2136353460068747)) <= 1e-06 * (1 + abs(2.2136353460068747)),
    abs((r.intercept_conf_high) - (2.7912975810360443)) <= 1e-06 * (1 + abs(2.7912975810360443))
FROM (SELECT glmm_fit_agg(ly, [q1], g, {'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true

# gaussian: BLUP conditional SEs, sqrt(attr(ranef(m, condVar = TRUE)$g, 'postVar'))
query IIIIII
SELECT
    abs((r.ranef[1].se) - (0.15729183367291388)) <= 1e-06 * (1 + abs(0.15729183367291388)),
    abs((r.ranef[2].se) - (0.15729183367291388)) <= 1e-06 * (1 + abs(0.15729183367291388)),
    abs((r.ranef[3].se) - (0.15729183367291388)) <= 1e-06 * (1 + abs(0.15729183367291388)),
    abs((r.ranef[4].se) - (0.15729183367291388)) <= 1e-06 * (1 + abs(0.15729183367291388)),
    abs((r.ranef[5].se) - (0.15729183367291388)) <= 1e-06 * (1 + abs(0.15729183367291388)),
    abs((r.ranef[6].se) - (0.15729183367291388)) <= 1e-06 * (1 + abs(0.15729183367291388))
FROM (SELECT glmm_fit_agg(ly, [q1], g, {'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

# gaussian: BLUP conditional SEs, sqrt(attr(ranef(m, condVar = TRUE)$g, 'postVar'))
query II
SELECT
    abs((r.ranef[7].se) - (0.15729183367291388)) <= 1e-06 * (1 + abs(0.15729183367291388)),
    abs((r.ranef[8].se) - (0.15729183367291388)) <= 1e-06 * (1 + abs(0.15729183367291388))
FROM (SELECT glmm_fit_agg(ly, [q1], g, {'compute_inference': true}) AS r FROM d4) s;
----
true	true

# gaussian, ddf := 'wald': z = t value, p = 2 pnorm(-|z|), confint(method = 'Wald')
query IIIII
SELECT
    abs((r.z_values[1]) - (4.7081715241295656)) <= 1e-06 * (1 + abs(4.7081715241295656)),
    abs((r.p_values[1]) - (2.4994874107823262e-06)) <= 1e-06 * (1 + abs(2.4994874107823262e-06)),
    abs((r.ci_lower[1]) - (0.34975437859890413)) <= 1e-06 * (1 + abs(0.34975437859890413)),
    abs((r.ci_upper[1]) - (0.8486293548253574)) <= 1e-06 * (1 + abs(0.8486293548253574)),
    abs((r.intercept_p_value) - (6.4051700829194439e-92)) <= 1e-06 * (1 + abs(6.4051700829194439e-92))
FROM (SELECT glmm_fit_agg(ly, [q1], g, {'compute_inference': true, 'ddf': 'wald'}) AS r FROM d4) s;
----
true	true	true	true	true

# Satterthwaite fills t_values (z_values NULL); Wald fills z_values (t_values and df NULL)
query II
SELECT r.z_values IS NULL, r.t_values IS NOT NULL FROM (SELECT glmm_fit_agg(ly, [q1], g, {'compute_inference': true}) AS r FROM d4) s 
----
true	true

query III
SELECT r.df IS NULL, r.intercept_df IS NULL, r.t_values IS NULL FROM (SELECT glmm_fit_agg(ly, [q1], g, {'compute_inference': true, 'ddf': 'wald'}) AS r FROM d4) s 
----
true	true	true

# glmm_tidy_by fixed rows: estimate, std_error, statistic, df, p_value, conf_low (lmerTest)
query IIIIII
SELECT
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'fixed' AND term = 'q1')) - (0.59919186671213076)) <= 1e-06 * (1 + abs(0.59919186671213076)),
    abs(((SELECT std_error FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'fixed' AND term = 'q1')) - (0.12726636309685166)) <= 1e-06 * (1 + abs(0.12726636309685166)),
    abs(((SELECT statistic FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'fixed' AND term = 'q1')) - (4.7081715241295656)) <= 1e-06 * (1 + abs(4.7081715241295656)),
    abs(((SELECT df FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'fixed' AND term = 'q1')) - (43.44885071243138)) <= 1e-06 * (1 + abs(43.44885071243138)),
    abs(((SELECT p_value FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'fixed' AND term = 'q1')) - (2.5684972568582242e-05)) <= 1e-06 * (1 + abs(2.5684972568582242e-05)),
    abs(((SELECT conf_low FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'fixed' AND term = '(Intercept)')) - (2.2136353460068747)) <= 1e-06 * (1 + abs(2.2136353460068747))
FROM (SELECT 1) s;
----
true	true	true	true	true	true

# glmm_tidy_by ran_pars / ran_vals: broom.mixed::tidy(effects = 'ran_pars' / 'ran_vals', conf.int = TRUE)
query IIIIII
SELECT
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'ran_pars' AND re_group = 'g' AND term = 'sd__(Intercept)')) - (0.28897118617259993)) <= 1e-06 * (1 + abs(0.28897118617259993)),
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'ran_pars' AND re_group = 'Residual' AND term = 'sd__Observation')) - (0.45928477604362139)) <= 1e-06 * (1 + abs(0.45928477604362139)),
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'ran_vals' AND re_level = 'g3')) - (-0.039850283558685896)) <= 1e-06 * (1 + abs(-0.039850283558685896)),
    abs(((SELECT std_error FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'ran_vals' AND re_level = 'g3')) - (0.15729183367291388)) <= 1e-06 * (1 + abs(0.15729183367291388)),
    abs(((SELECT conf_low FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'ran_vals' AND re_level = 'g3')) - (-0.34813661261986156)) <= 1e-06 * (1 + abs(-0.34813661261986156)),
    abs(((SELECT conf_high FROM glmm_tidy_by('d4o', grp, ly, [q1], g, names := ['q1'], re_names := ['g']) WHERE effect = 'ran_vals' AND re_level = 'g3')) - (0.26843604550248973)) <= 1e-06 * (1 + abs(0.26843604550248973))
FROM (SELECT 1) s;
----
true	true	true	true	true	true

# glmm_glance_by: broom.mixed::glance (nobs, sigma, logLik, AIC, BIC, df.residual)
query IIIIII
SELECT
    abs(((SELECT value FROM glmm_glance_by('d4o', grp, ly, [q1], g) WHERE metric = 'n_observations')) - (48)) <= 1e-06 * (1 + abs(48)),
    abs(((SELECT value FROM glmm_glance_by('d4o', grp, ly, [q1], g) WHERE metric = 'sigma')) - (0.45928477604362139)) <= 1e-06 * (1 + abs(0.45928477604362139)),
    abs(((SELECT value FROM glmm_glance_by('d4o', grp, ly, [q1], g) WHERE metric = 'log_likelihood')) - (-36.955827484838871)) <= 1e-06 * (1 + abs(-36.955827484838871)),
    abs(((SELECT value FROM glmm_glance_by('d4o', grp, ly, [q1], g) WHERE metric = 'aic')) - (81.911654969677741)) <= 1e-06 * (1 + abs(81.911654969677741)),
    abs(((SELECT value FROM glmm_glance_by('d4o', grp, ly, [q1], g) WHERE metric = 'bic')) - (89.396459013309311)) <= 1e-06 * (1 + abs(89.396459013309311)),
    abs(((SELECT value FROM glmm_glance_by('d4o', grp, ly, [q1], g) WHERE metric = 'df_residual')) - (44)) <= 1e-06 * (1 + abs(44))
FROM (SELECT 1) s;
----
true	true	true	true	true	true

# glmm_augment_by rows 1 / 20 / 48: broom.mixed::augment .fitted / .resid, predict(re.form = NA)
query IIIIII
SELECT
    abs(((SELECT fitted FROM glmm_augment_by('d4o', grp, ly, [q1], g) WHERE row_id = 1)) - (2.730176592267179)) <= 1e-06 * (1 + abs(2.730176592267179)),
    abs(((SELECT residual FROM glmm_augment_by('d4o', grp, ly, [q1], g) WHERE row_id = 1)) - (0.1778234077328209)) <= 1e-06 * (1 + abs(0.1778234077328209)),
    abs(((SELECT fitted FROM glmm_augment_by('d4o', grp, ly, [q1], g) WHERE row_id = 20)) - (2.9469012383247768)) <= 1e-06 * (1 + abs(2.9469012383247768)),
    abs(((SELECT residual FROM glmm_augment_by('d4o', grp, ly, [q1], g) WHERE row_id = 48)) - (0.44225292425124207)) <= 1e-06 * (1 + abs(0.44225292425124207)),
    abs(((SELECT fitted_population FROM glmm_augment_by('d4o', grp, ly, [q1], g) WHERE row_id = 20)) - (2.8619815835487379)) <= 1e-06 * (1 + abs(2.8619815835487379)),
    abs(((SELECT pearson_residual FROM glmm_augment_by('d4o', grp, ly, [q1], g) WHERE row_id = 48)) - (0.44225292425124207)) <= 1e-06 * (1 + abs(0.44225292425124207))
FROM (SELECT 1) s;
----
true	true	true	true	true	true

# random slope, lmer(pc ~ q1 + (1 + q1 | g)): lmerTest Satterthwaite df and p; BLUP SEs of g1 (intercept, slope)
query IIIIII
SELECT
    abs((r.df[1]) - (5.1310360018778525)) <= 1e-05 * (1 + abs(5.1310360018778525)),
    abs((r.intercept_df) - (6.4158057215594271)) <= 1e-05 * (1 + abs(6.4158057215594271)),
    abs((r.p_values[1]) - (0.057083908535114594)) <= 1e-05 * (1 + abs(0.057083908535114594)),
    abs((r.ranef[1].effects_se[1]) - (0.58774539748798771)) <= 1e-05 * (1 + abs(0.58774539748798771)),
    abs((r.ranef[1].effects_se[2]) - (1.0269632548373038)) <= 1e-05 * (1 + abs(1.0269632548373038)),
    abs((r.std_errors[1]) - (0.68531876440676731)) <= 1e-05 * (1 + abs(0.68531876440676731))
FROM (SELECT glmm_fit_agg(pc, [q1], g, {'compute_inference': true, 'random': [1]}) AS r FROM d4) s;
----
true	true	true	true	true	true

# random slope: glmm_tidy_by ran_pars sd__(Intercept), sd__q1, cor__(Intercept).q1 (broom.mixed)
query III
SELECT
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, pc, [q1], g, options := {'random': [1]}, names := ['q1'], re_names := ['g']) WHERE effect = 'ran_pars' AND term = 'sd__(Intercept)')) - (1.1402071273484051)) <= 1e-05 * (1 + abs(1.1402071273484051)),
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, pc, [q1], g, options := {'random': [1]}, names := ['q1'], re_names := ['g']) WHERE effect = 'ran_pars' AND term = 'sd__q1')) - (1.6104740595242573)) <= 1e-05 * (1 + abs(1.6104740595242573)),
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, pc, [q1], g, options := {'random': [1]}, names := ['q1'], re_names := ['g']) WHERE effect = 'ran_pars' AND term = 'cor__(Intercept).q1')) - (0.2638154638833306)) <= 1e-05 * (1 + abs(0.2638154638833306))
FROM (SELECT 1) s;
----
true	true	true

# poisson: summary(glmer(nAGQ = 0)) z / Pr(>|z|), confint(method = 'Wald'), BLUP SE of g1
query IIIIII
SELECT
    abs((r.std_errors[1]) - (0.17348260700888776)) <= 1e-05 * (1 + abs(0.17348260700888776)),
    abs((r.z_values[1]) - (3.6271905331671701)) <= 1e-05 * (1 + abs(3.6271905331671701)),
    abs((r.p_values[1]) - (0.00028652186690703734)) <= 1e-05 * (1 + abs(0.00028652186690703734)),
    abs((r.ci_lower[1]) - (0.28923480813026231)) <= 1e-05 * (1 + abs(0.28923480813026231)),
    abs((r.ci_upper[1]) - (0.96927413149333419)) <= 1e-05 * (1 + abs(0.96927413149333419)),
    abs((r.ranef[1].se) - (0.21450217005212927)) <= 1e-05 * (1 + abs(0.21450217005212927))
FROM (SELECT glmm_fit_agg(pc, [q1], g, {'family': 'poisson', 'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

# poisson: Wald inference, no degrees of freedom
query I
SELECT r.df IS NULL FROM (SELECT glmm_fit_agg(pc, [q1], g, {'family': 'poisson', 'compute_inference': true}) AS r FROM d4) s 
----
true

# poisson: glmm_augment_by fitted (response scale), population fitted, Pearson residual
query IIII
SELECT
    abs(((SELECT fitted FROM glmm_augment_by('d4o', grp, pc, [q1], g, options := {'family': 'poisson'}) WHERE row_id = 5)) - (1.9760231171313671)) <= 1e-05 * (1 + abs(1.9760231171313671)),
    abs(((SELECT fitted_population FROM glmm_augment_by('d4o', grp, pc, [q1], g, options := {'family': 'poisson'}) WHERE row_id = 5)) - (2.8781937140382476)) <= 1e-05 * (1 + abs(2.8781937140382476)),
    abs(((SELECT pearson_residual FROM glmm_augment_by('d4o', grp, pc, [q1], g, options := {'family': 'poisson'}) WHERE row_id = 5)) - (0.017056766774215314)) <= 1e-05 * (1 + abs(0.017056766774215314)),
    abs(((SELECT residual FROM glmm_augment_by('d4o', grp, pc, [q1], g, options := {'family': 'poisson'}) WHERE row_id = 30)) - (0.17539724654318434)) <= 1e-05 * (1 + abs(0.17539724654318434))
FROM (SELECT 1) s;
----
true	true	true	true

# poisson has no residual SD row
query I
SELECT count(*) FROM glmm_tidy_by('d4o', grp, pc, [q1], g, options := {'family': 'poisson'}) WHERE re_group = 'Residual';
----
0

# crossed: Satterthwaite df / p (lmerTest) and the SD of each factor (broom.mixed ran_pars)
query IIIII
SELECT
    abs(((SELECT df FROM glmm_tidy_by('d4o', grp, lc, [q1, h], g, options := {'groups': [2]}, names := ['q1'], re_names := ['g', 'h']) WHERE effect = 'fixed' AND term = 'q1')) - (45.92906774855134)) <= 1e-05 * (1 + abs(45.92906774855134)),
    abs(((SELECT p_value FROM glmm_tidy_by('d4o', grp, lc, [q1, h], g, options := {'groups': [2]}, names := ['q1'], re_names := ['g', 'h']) WHERE effect = 'fixed' AND term = 'q1')) - (0.0038955043382298787)) <= 1e-05 * (1 + abs(0.0038955043382298787)),
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, lc, [q1, h], g, options := {'groups': [2]}, names := ['q1'], re_names := ['g', 'h']) WHERE effect = 'ran_pars' AND re_group = 'g')) - (0.2521982375417216)) <= 1e-05 * (1 + abs(0.2521982375417216)),
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, lc, [q1, h], g, options := {'groups': [2]}, names := ['q1'], re_names := ['g', 'h']) WHERE effect = 'ran_pars' AND re_group = 'h')) - (0.44661250352475323)) <= 1e-05 * (1 + abs(0.44661250352475323)),
    abs(((SELECT estimate FROM glmm_tidy_by('d4o', grp, lc, [q1, h], g, options := {'groups': [2]}, names := ['q1'], re_names := ['g', 'h']) WHERE effect = 'ran_pars' AND re_group = 'Residual')) - (0.6944455593015959)) <= 1e-05 * (1 + abs(0.6944455593015959))
FROM (SELECT 1) s;
----
true	true	true	true	true

# crossed: BLUP SE of the first factor (g1, g8)
query II
SELECT
    abs((r.ranef[1].se) - (0.19438390370519432)) <= 1e-05 * (1 + abs(0.19438390370519432)),
    abs((r.ranef[8].se) - (0.19438390370519432)) <= 1e-05 * (1 + abs(0.19438390370519432))
FROM (SELECT glmm_fit_agg(lc, [q1, h], g, {'groups': [2]}) AS r FROM d4) s;
----
true	true

