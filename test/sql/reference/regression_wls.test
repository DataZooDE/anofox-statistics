# coef(lm(y ~ x1 + x2, weights = w)), summary: r.squared, adj.r.squared, sigma, fstatistic
query IIIIII
SELECT
    abs((r.intercept) - (1.6468324038024929)) <= 1e-09 * (1 + abs(1.6468324038024929)),
    abs((r.coefficients[1]) - (0.76784053541912956)) <= 1e-09 * (1 + abs(0.76784053541912956)),
    abs((r.coefficients[2]) - (-0.48262428479814251)) <= 1e-09 * (1 + abs(-0.48262428479814251)),
    abs((r.r_squared) - (0.65821566631963024)) <= 1e-09 * (1 + abs(0.65821566631963024)),
    abs((r.adj_r_squared) - (0.618005744710175)) <= 1e-09 * (1 + abs(0.618005744710175)),
    abs((r.residual_std_error) - (1.1361968603813821)) <= 1e-09 * (1 + abs(1.1361968603813821))
FROM (SELECT wls_fit_agg(y, [x1, x2], w, {'compute_inference': true}) AS r FROM d1) s;
