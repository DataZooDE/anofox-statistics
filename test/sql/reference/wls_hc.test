# WLS, HC0: slope std_errors, t, p, CI = coeftest / coefci(fit, vcov = vcovHC)
query IIIIIIIIII
SELECT
    abs((r.std_errors[1]) - (0.20003484326990137)) <= 1e-09 * (1 + abs(0.20003484326990137)),
    abs((r.t_values[1]) - (4.5179327260465199)) <= 1e-09 * (1 + abs(4.5179327260465199)),
    abs((r.p_values[1]) - (0.00011121057495291396)) <= 1e-09 * (1 + abs(0.00011121057495291396)),
    abs((r.conf_low[1]) - (0.49330636897813923)) <= 1e-09 * (1 + abs(0.49330636897813923)),
    abs((r.conf_high[1]) - (1.3141815605392084)) <= 1e-09 * (1 + abs(1.3141815605392084)),
    abs((r.std_errors[2]) - (0.20605178584556733)) <= 1e-09 * (1 + abs(0.20605178584556733)),
    abs((r.t_values[2]) - (-2.7396483760532599)) <= 1e-09 * (1 + abs(-2.7396483760532599)),
