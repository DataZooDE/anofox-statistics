    abs((r.conf_high[2]) - (-0.14172609830148719)) <= 1e-09 * (1 + abs(-0.14172609830148719))
FROM (SELECT wls_fit_agg(y, [x1, x2], w, {'hc_type': 'hc0', 'compute_inference': true}) AS r FROM d) s;
