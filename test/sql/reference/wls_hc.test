# Unit weights: wls_fit_agg(hc_type) = ols_fit_agg(hc_type)
query IIII
SELECT
    list_distance((wls_fit_agg(y, [x1, x2], 1.0, {'hc_type': 'hc0', 'compute_inference': true})).std_errors, (ols_fit_agg(y, [x1, x2], {'hc_type': 'hc0', 'compute_inference': true})).std_errors) < 1e-9,
    list_distance((wls_fit_agg(y, [x1, x2], 1.0, {'hc_type': 'hc1', 'compute_inference': true})).std_errors, (ols_fit_agg(y, [x1, x2], {'hc_type': 'hc1', 'compute_inference': true})).std_errors) < 1e-9,
    list_distance((wls_fit_agg(y, [x1, x2], 1.0, {'hc_type': 'hc2', 'compute_inference': true})).std_errors, (ols_fit_agg(y, [x1, x2], {'hc_type': 'hc2', 'compute_inference': true})).std_errors) < 1e-9,
    list_distance((wls_fit_agg(y, [x1, x2], 1.0, {'hc_type': 'hc3', 'compute_inference': true})).std_errors, (ols_fit_agg(y, [x1, x2], {'hc_type': 'hc3', 'compute_inference': true})).std_errors) < 1e-9
FROM d;
----
true	true	true	true

