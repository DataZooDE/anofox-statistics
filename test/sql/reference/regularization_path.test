FROM (SELECT elasticnet_path_agg(ys, [x1, x2, x3, x4], {'l1_ratio': 1.0, 'standardize': true, 'lambdas': [0.63355522516671392, 0.23616364788041611, 0.088032213080570784, 0.032814832466456237, 0.012232036343514904, 0.0045596061860750277, 0.001699635938632243, 0.00063355522516671378]} ORDER BY d3.id) AS r FROM d3 JOIN d3s USING (id)) s;
