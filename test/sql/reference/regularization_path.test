# ---- lars_path_agg (method 'lasso', standardize false) ----
# 5 knots read from the extension (421.801, 127.564, 10.4155, 8.94475, 1.3145e-13).
# The first knot is max|x~'(y - mean(y))| with all coefficients 0; the coefficients at every knot are the lasso solution at lambda = alpha / n (glmnet objective, alpha = 1, standardize = FALSE, coordinate descent); the last knot is coef(lm(y ~ x)).

# first knot: alpha_max
query I
SELECT
    abs((r[1].index_value) - (421.80089500000003)) <= 1e-10 * (1 + abs(421.80089500000003))
FROM (SELECT lars_path_agg(y, [x1, x2, x3, x4], {'standardize': false}) AS r FROM d3) s;
----
true

query I
SELECT DISTINCT e.index_name FROM (SELECT unnest(r) AS e FROM (SELECT lars_path_agg(y, [x1, x2, x3, x4], {'standardize': false}) AS r FROM d3) s);
----
alpha

