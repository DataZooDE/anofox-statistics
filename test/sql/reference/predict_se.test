# OLS lm(y ~ x1 + x2) at x = [3, 4]: predict(se.fit = TRUE, interval = 'confidence'); interval = 'prediction', level = 0.9
query IIIIII
SELECT
    abs((c.yhat) - (2.2557860024607463)) <= 1e-09 * (1 + abs(2.2557860024607463)),
    abs((c.se_fit) - (0.69986557695524565)) <= 1e-09 * (1 + abs(0.69986557695524565)),
    abs((c.yhat_lower) - (0.77919870581126727)) <= 1e-09 * (1 + abs(0.77919870581126727)),
    abs((c.yhat_upper) - (3.7323732991102254)) <= 1e-09 * (1 + abs(3.7323732991102254)),
    abs((p.yhat_lower) - (-1.7288092813930516)) <= 1e-09 * (1 + abs(-1.7288092813930516)),
    abs((p.yhat_upper) - (6.2403812863145447)) <= 1e-09 * (1 + abs(6.2403812863145447))
FROM (SELECT predict(m, [3, 4], {'se_fit': true, 'interval': 'confidence'}) AS c, predict(m, [3, 4], {'interval': 'prediction', 'level': 0.9}) AS p FROM (SELECT ols_fit_agg(y, [x1, x2], {'compute_inference': true}) AS m FROM d1)) s;
----
true	true	true	true	true	true

