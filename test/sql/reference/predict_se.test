# Gamma glm(gam ~ z1 + z2, family = Gamma('log')) at z = [-0.80000000000000004, 0.29999999999999999]: predict.glm(type = 'link' / 'response', se.fit = TRUE); interval eta -/+ qnorm(.975) se mapped by the inverse link
query II
SELECT
    abs((r.yhat_lower) - (0.44699338939278072)) <= 1e-06 * (1 + abs(0.44699338939278072)),
    abs((r.yhat_upper) - (1.0181757176010435)) <= 1e-06 * (1 + abs(1.0181757176010435))
FROM (SELECT predict(m, [-0.80000000000000004, 0.29999999999999999], {'type': 'link', 'interval': 'confidence'}) AS l, predict(m, [-0.80000000000000004, 0.29999999999999999], {'se_fit': true, 'interval': 'confidence'}) AS r FROM (SELECT gamma_fit_agg(gam, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12}) AS m FROM d2)) s;
----
true	true

