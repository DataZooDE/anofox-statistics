# R: -rank_biserial(pr) with rank_biserial = (T+ - T-) / (T+ + T-) = 0.8545454545454545
#    wilcox.test(paired = TRUE, exact = FALSE, correct = TRUE): V = 51
query IIIII
SELECT abs(r.rank_biserial - (-0.8545454545454545)) < 1e-12,
       abs(r.effect_size - (-0.8545454545454545)) < 1e-12, r.effect_name = 'rank_biserial',
       abs(r.statistic - 51) < 1e-9,
       abs(r.p_value - 0.019058891601730465) <= 1e-9 * (1 + 0.019058891601730465)
FROM (SELECT wilcoxon_signed_rank_agg(x, y) AS r FROM pr);
----
true	true	true	true	true

