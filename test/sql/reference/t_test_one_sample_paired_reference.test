require anofox_statistics

statement ok
CREATE TABLE one AS SELECT v::DOUBLE AS v FROM (VALUES (5.1),(4.9),(6.2),(5.8),(6.05),(5.5),(5.3),(6.1)) t(v);

statement ok
CREATE TABLE pr AS SELECT x::DOUBLE AS x, y::DOUBLE AS y FROM (VALUES (12.1,11.5),(14.3,13.2),(11.8,12.3),(15.2,13.9),(13.9,13),(12.7,11.1),(14.8,14.6),(13.1,11.4),(12.4,12.6),(15.6,13.85)) t(x, y);

statement ok
CREATE TABLE ties AS SELECT x::DOUBLE AS x, y::DOUBLE AS y FROM (VALUES (3,4),(5,5),(4,2),(6,4),(7,9),(2,3),(8,6),(5,5),(4,6),(9,6),(6,4),(3,1)) t(x, y);

# R: t.test(g1, mu = 0, alternative = 'two.sided', conf.level = 0.95)
query IIIIIIII
SELECT abs(r.statistic - 32.346740686941629) < 1e-9,
       abs(r.df - 7) < 1e-12,
       abs(r.p_value - 6.9815470088600048e-09) <= 1e-12 * (1 + 6.9815470088600048e-09),
       abs(r.ci_lower - 5.2080059116782795) < 1e-9,
       abs(r.ci_upper - 6.0294940883217212) < 1e-9,
       abs(r.effect_size - 11.436299844509616) < 1e-9,
       abs(r.estimate - 5.6187500000000004) < 1e-9,
       r.n = 8
FROM (SELECT t_test_one_sample_agg(v, {'mu': 0, 'alternative': 'two_sided', 'confidence_level': 0.95}) AS r FROM one);
----
true	true	true	true	true	true	true	true

