# The AR(1) dependence widens the block-bootstrap SE over the IID one (0.1274, 0.1217 vs 0.0972).
query I
SELECT (SELECT bootstrap_mean_ci_agg(x, {'method': 'circular_block', 'block_length': 10} ORDER BY t).std_error FROM series) > 1.15 * (SELECT bootstrap_mean_ci_agg(x).std_error FROM series);
----
true

