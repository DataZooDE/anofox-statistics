# IID: exact bootstrap SE 0.097227, boot::boot percentile interval
query IIIIIIIII
SELECT
    abs(r.estimate - 9.7430000000000003) <= 1e-12,
    abs(r.std_error - 0.097226511016514652) <= 0.02 * 0.097226511016514652,
    abs(r.conf_low - 9.5537499999999991) <= 0.0058335906609908788,
    abs(r.conf_high - 9.9335000000000004) <= 0.0058335906609908788,
    r.conf_level = 0.95,
    r.n = 120,
    r.n_bootstrap = 50000,
    r.block_length IS NULL,
    r.method = 'iid'
FROM (SELECT bootstrap_mean_ci_agg(x, {'n_bootstrap': 50000}) AS r FROM series) s;
----
true	true	true	true	true	true	true	true	true

# IID, confidence_level 0.9 (ORDER BY does not change the IID result)
query IIIIIIIII
SELECT
    abs(r.estimate - 9.7430000000000003) <= 1e-12,
    abs(r.std_error - 0.097226511016514652) <= 0.02 * 0.097226511016514652,
    abs(r.conf_low - 9.5834166666666665) <= 0.0058335906609908788,
    abs(r.conf_high - 9.9028333333333336) <= 0.0058335906609908788,
    r.conf_level = 0.9,
    r.n = 120,
    r.n_bootstrap = 50000,
    r.block_length IS NULL,
    r.method = 'iid'
FROM (SELECT bootstrap_mean_ci_agg(x, {'n_bootstrap': 50000, 'confidence_level': 0.9} ORDER BY t) AS r FROM series) s;
----
true	true	true	true	true	true	true	true	true

# circular block bootstrap, l = 6: exact SE 0.127406, tsboot(sim = 'fixed', endcorr = TRUE) interval
query IIIIIIIII
SELECT
    abs(r.estimate - 9.7430000000000003) <= 1e-12,
    abs(r.std_error - 0.12740624366931913) <= 0.02 * 0.12740624366931913,
    abs(r.conf_low - 9.4924999999999997) <= 0.0076443746201591478,
    abs(r.conf_high - 9.993666666666666) <= 0.0076443746201591478,
    r.conf_level = 0.95,
    r.n = 120,
    r.n_bootstrap = 50000,
    r.block_length = 6,
    r.method = 'circular_block'
FROM (SELECT bootstrap_mean_ci_agg(x, {'method': 'circular_block', 'block_length': 6, 'n_bootstrap': 50000} ORDER BY t) AS r FROM series) s;
----
true	true	true	true	true	true	true	true	true

