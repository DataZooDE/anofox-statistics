statement ok
CREATE TABLE v_ols_boot AS SELECT unnest(validate_agg(yc, [x1, x2, x3], {'B': 30, 'seed': 11}), recursive := true) FROM d;

# validate(ols, B = 30), seed 11: R-square
query IIIIII
SELECT
    abs((index_orig) - (0.42674428387164731)) <= 1e-09 * (1 + abs(0.42674428387164731)),
    abs((training) - (0.43178350102130836)) <= 1e-09 * (1 + abs(0.43178350102130836)),
    abs((test) - (0.40802486127222909)) <= 1e-09 * (1 + abs(0.40802486127222909)),
    abs((optimism) - (0.023758639749079269)) <= 1e-09 * (1 + abs(0.023758639749079269)),
    abs((index_corrected) - (0.40298564412256804)) <= 1e-09 * (1 + abs(0.40298564412256804)),
    abs((n) - (30)) <= 1e-09 * (1 + abs(30))
