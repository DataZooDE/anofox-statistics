    abs((estimate) - (0.54074148168249481)) <= 1e-09 * (1 + abs(0.54074148168249481)),
    abs((std_error) - (0.19358048534089156)) <= 1e-09 * (1 + abs(0.19358048534089156)),
    abs((conf_low) - (0.1734111857659284)) <= 1e-09 * (1 + abs(0.1734111857659284)),
    abs((conf_high) - (0.9270116995254426)) <= 1e-09 * (1 + abs(0.9270116995254426)),
    abs((boot_mean) - (0.51879772975149452)) <= 1e-09 * (1 + abs(0.51879772975149452)),
    abs((vcov[1]) - (0.037473404304815133)) <= 1e-09 * (1 + abs(0.037473404304815133))
FROM b_ols WHERE k = 1;
