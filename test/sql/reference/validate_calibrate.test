CREATE TABLE b_ols AS SELECT row_number() OVER () AS k, * FROM (SELECT unnest(bootcov_agg(yc, [x1, x2, x3], {'B': 50, 'seed': 5}), recursive := true) FROM d);

# bootcov(ols, B = 50), seed 5: Intercept
query IIIIII
