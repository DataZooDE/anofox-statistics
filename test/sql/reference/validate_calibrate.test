statement ok
CREATE TABLE c_cph AS SELECT unnest(calibrate_cph_agg(time, [s1, s2, s3], event, {'u': 5, 'm': 60, 'B': 25, 'seed': 21, 'tolerance': 1e-4, 'max_iterations': 10}), recursive := true) FROM s;

query I
SELECT count(*) FROM c_cph;
----
5

# calibrate(cph, cmethod = 'KM', u = 5, m = 60, B = 25), seed 21: group 1
query IIIIII
SELECT
    abs((index_orig) - (0.019570267220031023)) <= 1e-08 * (1 + abs(0.019570267220031023)),
    abs((training) - (-0.0058980980715608979)) <= 1e-08 * (1 + abs(-0.0058980980715608979)),
    abs((test) - (-0.0023775909339201384)) <= 1e-08 * (1 + abs(-0.0023775909339201384)),
    abs((optimism) - (-0.0035205071376407594)) <= 1e-08 * (1 + abs(-0.0035205071376407594)),
    abs((index_corrected) - (0.023090774357671782)) <= 1e-08 * (1 + abs(0.023090774357671782)),
    abs((n) - (25)) <= 1e-08 * (1 + abs(25))
FROM c_cph WHERE group_index = 1;
----
true	true	true	true	true	true

# calibrate(cph, cmethod = 'KM', u = 5, m = 60, B = 25), seed 21: group 1
query IIII
SELECT
    abs((mean_predicted) - (0.20732048908248993)) <= 1e-08 * (1 + abs(0.20732048908248993)),
    abs((km) - (0.22689075630252095)) <= 1e-08 * (1 + abs(0.22689075630252095)),
    abs((km_corrected) - (0.23041126344016172)) <= 1e-08 * (1 + abs(0.23041126344016172)),
    abs((std_err) - (0.24984928824479677)) <= 1e-08 * (1 + abs(0.24984928824479677))
FROM c_cph WHERE group_index = 1;
----
true	true	true	true

