# vif_agg: one VIF per column, car::vif(lm(y ~ age + income + rb + rc + e2 + e3 + e4))
statement ok
CREATE TABLE v_agg AS SELECT vif_agg([age, income, rb, rc, e2, e3, e4]) AS v FROM vd;

# vif_agg vs car::vif (numeric columns)
query IIIIII
SELECT
    abs((v[1]) - (8.1748718157721001)) <= 1e-08 * (1 + abs(8.1748718157721001)),
    abs((v[2]) - (8.4724622452495044)) <= 1e-08 * (1 + abs(8.4724622452495044)),
    abs((v[3]) - (1.3783047373466495)) <= 1e-08 * (1 + abs(1.3783047373466495)),
    abs((v[4]) - (1.661082852287596)) <= 1e-08 * (1 + abs(1.661082852287596)),
    abs((v[5]) - (1.6876210340550823)) <= 1e-08 * (1 + abs(1.6876210340550823)),
    abs((v[6]) - (1.4785788969138107)) <= 1e-08 * (1 + abs(1.4785788969138107))
FROM v_agg;
----
true	true	true	true	true	true

# vif_agg vs car::vif (numeric columns)
query I
SELECT
    abs((v[7]) - (1.7188761076081354)) <= 1e-08 * (1 + abs(1.7188761076081354))
FROM v_agg;
----
true

