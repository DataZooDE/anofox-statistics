# gvif_agg with factor terms: car::vif(lm(y ~ age + income + region + edu))
statement ok
CREATE TABLE g_fac AS SELECT gvif_agg([age, income, rb, rc, e2, e3, e4], {'terms': ['age', 'income', 'region', 'region', 'edu', 'edu', 'edu']}) AS g FROM vd;

query TTTTIIII
SELECT g[1].term, g[2].term, g[3].term, g[4].term, g[1].df, g[2].df, g[3].df, g[4].df FROM g_fac;
----
age	income	region	edu	1	1	2	3

# gvif_agg (factor terms) GVIF vs car::vif
query IIII
SELECT
    abs((g[1].gvif) - (8.1748718157721001)) <= 1e-08 * (1 + abs(8.1748718157721001)),
    abs((g[2].gvif) - (8.4724622452495044)) <= 1e-08 * (1 + abs(8.4724622452495044)),
