query IIII
SELECT
    abs((g[1].gvif_adj) - (2.8591732748772154)) <= 1e-08 * (1 + abs(2.8591732748772154)),
    abs((g[2].gvif_adj) - (2.910749430172495)) <= 1e-08 * (1 + abs(2.910749430172495)),
