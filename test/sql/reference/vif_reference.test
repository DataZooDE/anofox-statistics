# Columns of a term need not be adjacent; integer labels work too (terms in first-appearance order)
statement ok
CREATE TABLE g_mix AS SELECT gvif_agg([rb, age, e2, rc, income, e3, e4], {'terms': [3, 1, 4, 3, 2, 4, 4]}) AS g FROM vd;

query TTTT
SELECT g[1].term, g[2].term, g[3].term, g[4].term FROM g_mix;
----
3	1	4	2

# gvif_agg (non-adjacent integer terms) vs car::vif
query IIII
SELECT
    abs((g[1].gvif) - (1.2781847375420263)) <= 1e-08 * (1 + abs(1.2781847375420263)),
    abs((g[2].gvif) - (8.1748718157721001)) <= 1e-08 * (1 + abs(8.1748718157721001)),
    abs((g[3].gvif) - (1.2335164718752343)) <= 1e-08 * (1 + abs(1.2335164718752343)),
    abs((g[4].gvif) - (8.4724622452495044)) <= 1e-08 * (1 + abs(8.4724622452495044))
FROM g_mix;
----
true	true	true	true

