SELECT list_max(list_transform(range(1, 5), lambda _i: abs((m.sdev)[_i] - ([83.7324002464017, 14.2124018491813, 6.48942607287723, 2.48279000001273])[_i]) / (1 + abs(([83.7324002464017, 14.2124018491813, 6.48942607287723, 2.48279000001273])[_i])))) < 1e-9 AND len(m.sdev) = 4,
       list_max(list_transform(range(1, 5), lambda _i: abs((m.proportion_of_variance)[_i] - ([0.965534220566882, 0.0278173366321749, 0.00579953492234191, 0.000848907878600712])[_i]) / (1 + abs(([0.965534220566882, 0.0278173366321749, 0.00579953492234191, 0.000848907878600712])[_i])))) < 1e-9 AND len(m.proportion_of_variance) = 4,
       list_max(list_transform(range(1, 5), lambda _i: abs((m.center)[_i] - ([7.788, 170.76, 65.54, 21.232])[_i]) / (1 + abs(([7.788, 170.76, 65.54, 21.232])[_i])))) < 1e-9 AND len(m.center) = 4,
