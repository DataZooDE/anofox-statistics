       list_max(list_transform(range(1, 5), lambda _i: abs((m.loadings[1])[_i] - ([0.535899474938155, 0.58318363490967, 0.278190874619433, 0.543432091445683])[_i]) / (1 + abs(([0.535899474938155, 0.58318363490967, 0.278190874619433, 0.543432091445683])[_i])))) < 1e-9 AND len(m.loadings[1]) = 4,
       list_max(list_transform(range(1, 5), lambda _i: abs((m.loadings[4])[_i] - ([-0.649227804341944, 0.74340747993671, -0.133877730824247, -0.0890243227036251])[_i]) / (1 + abs(([-0.649227804341944, 0.74340747993671, -0.133877730824247, -0.0890243227036251])[_i])))) < 1e-9 AND len(m.loadings[4]) = 4,
       list_max(list_transform(range(1, 5), lambda _i: abs((m.center)[_i] - ([7.788, 170.76, 65.54, 21.232])[_i]) / (1 + abs(([7.788, 170.76, 65.54, 21.232])[_i])))) < 1e-9 AND len(m.center) = 4,
       list_max(list_transform(range(1, 5), lambda _i: abs((m.scale)[_i] - ([4.35550976420929, 83.3376608400171, 14.4747634008368, 9.36638453105965])[_i]) / (1 + abs(([4.35550976420929, 83.3376608400171, 14.4747634008368, 9.36638453105965])[_i])))) < 1e-9 AND len(m.scale) = 4,
       list_max(list_transform(range(1, 5), lambda _i: abs((pca_transform(m, [10, 200, 60, 20]))[_i] - ([0.29882676228516, -0.634397025196105, -0.230268194851546, -0.00593572215910151])[_i]) / (1 + abs(([0.29882676228516, -0.634397025196105, -0.230268194851546, -0.00593572215910151])[_i])))) < 1e-9 AND len(pca_transform(m, [10, 200, 60, 20])) = 4
FROM (SELECT pca_agg([murder, assault, urbanpop, rape], {'scale': true}) AS m FROM usarrests);
----
true	true	true	true	true	true	true

# Scaled, two components: scores of a fitted row (prcomp()$x) and of a new row.
query II
SELECT list_max(list_transform(range(1, 3), lambda _i: abs((pca_transform(m, [13.2, 236, 58, 21.2]))[_i] - ([0.975660448333605, -1.12200121043341])[_i]) / (1 + abs(([0.975660448333605, -1.12200121043341])[_i])))) < 1e-9 AND len(pca_transform(m, [13.2, 236, 58, 21.2])) = 2,
       list_max(list_transform(range(1, 3), lambda _i: abs((pca_transform(m, [2.5, 90, 80, 12.25]))[_i] - ([-1.45900131784215, 1.40134608563685])[_i]) / (1 + abs(([-1.45900131784215, 1.40134608563685])[_i])))) < 1e-9 AND len(pca_transform(m, [2.5, 90, 80, 12.25])) = 2
FROM (SELECT pca_agg([murder, assault, urbanpop, rape], {'scale': true, 'n_components': 2}) AS m FROM usarrests);
----
true	true

# Scaled wide data (n = 4 < d = 6).
query IIII
SELECT list_max(list_transform(range(1, 4), lambda _i: abs((m.sdev)[_i] - ([1.90394441168275, 1.20290202912344, 0.963339185101874])[_i]) / (1 + abs(([1.90394441168275, 1.20290202912344, 0.963339185101874])[_i])))) < 1e-9 AND len(m.sdev) = 3,
       list_max(list_transform(range(1, 7), lambda _i: abs((m.loadings[2])[_i] - ([-0.373967541984814, -0.00510802668993082, 0.667171733446004, -0.496721697887566, 0.399198934449535, -0.0944024855492433])[_i]) / (1 + abs(([-0.373967541984814, -0.00510802668993082, 0.667171733446004, -0.496721697887566, 0.399198934449535, -0.0944024855492433])[_i])))) < 1e-9 AND len(m.loadings[2]) = 6,
       list_max(list_transform(range(1, 7), lambda _i: abs((m.scale)[_i] - ([1.10867789130417, 0.645497224367903, 1.10867789130417, 1.19023807142381, 1.29099444873581, 0.661437827766148])[_i]) / (1 + abs(([1.10867789130417, 0.645497224367903, 1.10867789130417, 1.19023807142381, 1.29099444873581, 0.661437827766148])[_i])))) < 1e-9 AND len(m.scale) = 6,
       list_max(list_transform(range(1, 4), lambda _i: abs((pca_transform(m, x0))[_i] - ([0.170608502013257, -0.380338165382673, -1.40990151697197])[_i]) / (1 + abs(([0.170608502013257, -0.380338165382673, -1.40990151697197])[_i])))) < 1e-9 AND len(pca_transform(m, x0)) = 3
FROM (SELECT pca_agg(x, {'scale': true}) AS m, (SELECT x FROM wide WHERE id = 2) AS x0 FROM wide);
----
true	true	true	true

# A constant column cannot be scaled (prcomp: 'cannot rescale a constant/zero column').
statement error
SELECT pca_agg([murder, 1.0], {'scale': true}) FROM usarrests;
----

