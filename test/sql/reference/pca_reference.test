       list_max(list_transform(range(1, 4), lambda _i: abs((pca_transform(m, x0))[_i] - ([-0.447188681855058, -0.416507924762037, -1.13948165032665])[_i]) / (1 + abs(([-0.447188681855058, -0.416507924762037, -1.13948165032665])[_i])))) < 1e-9 AND len(pca_transform(m, x0)) = 3,
