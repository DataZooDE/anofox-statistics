statement ok
CREATE VIEW usarrests_g AS SELECT 'US' AS region, * FROM usarrests;

query II
SELECT count(*), bool_and(list_max(list_transform(range(1, 5), lambda _i: abs(b.scores[_i] - s.ref[_i]) / (1 + abs(s.ref[_i])))) < 1e-9)
FROM pca_by('usarrests_g', region, [murder, assault, urbanpop, rape]) b JOIN usarrests_sc s USING (id);
----
50	true

# Wide data (n = 4 < d = 6): min(n - 1, d) = 3 components; prcomp's 4th has sdev 0.
statement ok
CREATE TABLE wide AS SELECT * FROM (VALUES
    (1, [1, 2, 0.5, 3, -1, 0.25]),
    (2, [2, 0.5, 1.5, 2.5, 0, 1]),
    (3, [0.5, 1.5, 2.5, 1, 1, 0.5]),
    (4, [3, 1, 0, 0.5, 2, 1.75])
) t(id, x);

