       list_max(list_transform(range(1, 4), lambda _i: abs((m.proportion_of_variance)[_i] - ([0.610841290146845, 0.292770381502801, 0.0963883283503542])[_i]) / (1 + abs(([0.610841290146845, 0.292770381502801, 0.0963883283503542])[_i])))) < 1e-9 AND len(m.proportion_of_variance) = 3,
