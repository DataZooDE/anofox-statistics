# spearman2(hp, mpg, p = 1): the squared Spearman correlation
query IIIII
SELECT abs((s.rho2) - (0.800424828354906)) <= 1e-9 * (1 + abs(0.800424828354906)),
       abs((s.statistic) - (120.319299503594)) <= 1e-8 * (1 + abs(120.319299503594)),
       s.df1 = 1 AND s.df2 = 30 AND s.n = 32,
       abs((s.p_value) - (5.08593167580784e-12)) <= 1e-8 * (1 + abs(5.08593167580784e-12)),
       abs((s.adjusted_rho2) - (0.793772322633403)) <= 1e-9 * (1 + abs(0.793772322633403))
FROM (SELECT spearman2_agg(mpg, hp) AS s FROM cars);
----
true	true	true	true	true

# spearman2(hp, mpg, p = 2): rank(hp) and its square
query IIIII
SELECT abs((s.rho2) - (0.80147231814604)) <= 1e-9 * (1 + abs(0.80147231814604)),
       abs((s.statistic) - (58.5376734598976)) <= 1e-8 * (1 + abs(58.5376734598976)),
