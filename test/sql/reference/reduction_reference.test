# varclus(x): squared Spearman, complete linkage
query IIIIII
SELECT len(v.similarity_matrix[1]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[1])[_i] - ([1, 0.826067151111185, 0.800424828354906, 0.424394222420873, 0.785744021067049, 0.218028999174463])[_i]) / (1 + abs(([1, 0.826067151111185, 0.800424828354906, 0.424394222420873, 0.785744021067049, 0.218028999174463])[_i])))) <= 1e-9 AND len(v.similarity_matrix[2]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[2])[_i] - ([0.826067151111185, 1, 0.724273552958989, 0.467298156255503, 0.805876847264602, 0.211399266647164])[_i]) / (1 + abs(([0.826067151111185, 1, 0.724273552958989, 0.467298156255503, 0.805876847264602, 0.211399266647164])[_i])))) <= 1e-9 AND len(v.similarity_matrix[3]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[3])[_i] - ([0.800424828354906, 0.724273552958989, 1, 0.270530000864734, 0.600124041257945, 0.44436358770681])[_i]) / (1 + abs(([0.800424828354906, 0.724273552958989, 1, 0.270530000864734, 0.600124041257945, 0.44436358770681])[_i])))) <= 1e-9 AND len(v.similarity_matrix[4]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[4])[_i] - ([0.424394222420873, 0.467298156255503, 0.270530000864734, 1, 0.563085774833637, 0.00843984542396418])[_i]) / (1 + abs(([0.424394222420873, 0.467298156255503, 0.270530000864734, 1, 0.563085774833637, 0.00843984542396418])[_i])))) <= 1e-9 AND len(v.similarity_matrix[5]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[5])[_i] - ([0.785744021067049, 0.805876847264602, 0.600124041257945, 0.563085774833637, 1, 0.0508057012513457])[_i]) / (1 + abs(([0.785744021067049, 0.805876847264602, 0.600124041257945, 0.563085774833637, 1, 0.0508057012513457])[_i])))) <= 1e-9 AND len(v.similarity_matrix[6]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[6])[_i] - ([0.218028999174463, 0.211399266647164, 0.44436358770681, 0.00843984542396418, 0.0508057012513457, 1])[_i]) / (1 + abs(([0.218028999174463, 0.211399266647164, 0.44436358770681, 0.00843984542396418, 0.0508057012513457, 1])[_i])))) <= 1e-9,
       v.merges = [[-1, -2], [-5, 1], [-3, 2], [-4, 3], [-6, 4]],
       len(v.height) = 5 AND list_max(list_transform(range(1, 6), lambda _i: abs((v.height)[_i] - ([0.173932848888815, 0.214255978932951, 0.399875958742055, 0.729469999135266, 0.991560154576036])[_i]) / (1 + abs(([0.173932848888815, 0.214255978932951, 0.399875958742055, 0.729469999135266, 0.991560154576036])[_i])))) <= 1e-9,
       v.dendrogram_order = [6, 4, 3, 5, 1, 2],
       v.clusters IS NULL,
       v.variables = ['mpg', 'disp', 'hp', 'drat', 'wt', 'qsec']
FROM (SELECT varclus_agg([mpg, disp, hp, drat, wt, qsec], {'feature_names': ['mpg', 'disp', 'hp', 'drat', 'wt', 'qsec']}) AS v FROM cars);
----
true	true	true	true	true	true

# varclus(x, similarity = 'pearson', method = 'average'), cut at 0.5
query IIIIII
SELECT len(v.similarity_matrix[1]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[1])[_i] - ([1, 0.71834334048973, 0.602437341423934, 0.463995167985086, 0.752832793658264, 0.175296320261013])[_i]) / (1 + abs(([1, 0.71834334048973, 0.602437341423934, 0.463995167985086, 0.752832793658264, 0.175296320261013])[_i])))) <= 1e-9 AND len(v.similarity_matrix[2]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[2])[_i] - ([0.71834334048973, 1, 0.625599666280395, 0.504403822345197, 0.788508341978376, 0.188093851819964])[_i]) / (1 + abs(([0.71834334048973, 1, 0.625599666280395, 0.504403822345197, 0.788508341978376, 0.188093851819964])[_i])))) <= 1e-9 AND len(v.similarity_matrix[3]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[3])[_i] - ([0.602437341423934, 0.625599666280395, 1, 0.201384744976563, 0.433948779081184, 0.501580368531109])[_i]) / (1 + abs(([0.602437341423934, 0.625599666280395, 1, 0.201384744976563, 0.433948779081184, 0.501580368531109])[_i])))) <= 1e-9 AND len(v.similarity_matrix[4]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[4])[_i] - ([0.463995167985086, 0.504403822345197, 0.201384744976563, 1, 0.507571675066569, 0.00831830818303006])[_i]) / (1 + abs(([0.463995167985086, 0.504403822345197, 0.201384744976563, 1, 0.507571675066569, 0.00831830818303006])[_i])))) <= 1e-9 AND len(v.similarity_matrix[5]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[5])[_i] - ([0.752832793658264, 0.788508341978376, 0.433948779081184, 0.507571675066569, 1, 0.0305256382745972])[_i]) / (1 + abs(([0.752832793658264, 0.788508341978376, 0.433948779081184, 0.507571675066569, 1, 0.0305256382745972])[_i])))) <= 1e-9 AND len(v.similarity_matrix[6]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[6])[_i] - ([0.175296320261013, 0.188093851819964, 0.501580368531109, 0.00831830818303006, 0.0305256382745972, 1])[_i]) / (1 + abs(([0.175296320261013, 0.188093851819964, 0.501580368531109, 0.00831830818303006, 0.0305256382745972, 1])[_i])))) <= 1e-9,
       v.merges = [[-2, -5], [-1, 1], [-3, 2], [-4, 3], [-6, 4]],
       len(v.height) = 5 AND list_max(list_transform(range(1, 6), lambda _i: abs((v.height)[_i] - ([0.211491658021624, 0.264411932926003, 0.446004737738162, 0.580661147406646, 0.819237102586057])[_i]) / (1 + abs(([0.211491658021624, 0.264411932926003, 0.446004737738162, 0.580661147406646, 0.819237102586057])[_i])))) <= 1e-9,
       v.dendrogram_order = [6, 4, 3, 1, 2, 5],
       v.clusters = [1, 1, 1, 2, 1, 3],
       v.variables = ['mpg', 'disp', 'hp', 'drat', 'wt', 'qsec']
FROM (SELECT varclus_agg([mpg, disp, hp, drat, wt, qsec], {'similarity': 'pearson', 'method': 'average', 'cut_height': 0.5, 'feature_names': ['mpg', 'disp', 'hp', 'drat', 'wt', 'qsec']}) AS v FROM cars);
----
true	true	true	true	true	true

# varclus(x, similarity = 'hoeffding')
query IIIIII
SELECT len(v.similarity_matrix[1]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[1])[_i] - ([1, 0.473253003709479, 0.481463313652074, 0.125134155137653, 0.40637724952328, 0.0658467400534324])[_i]) / (1 + abs(([1, 0.473253003709479, 0.481463313652074, 0.125134155137653, 0.40637724952328, 0.0658467400534324])[_i])))) <= 1e-9 AND len(v.similarity_matrix[2]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[2])[_i] - ([0.473253003709479, 1, 0.365629081295686, 0.142368551242452, 0.446348885294176, 0.0829889578450262])[_i]) / (1 + abs(([0.473253003709479, 1, 0.365629081295686, 0.142368551242452, 0.446348885294176, 0.0829889578450262])[_i])))) <= 1e-9 AND len(v.similarity_matrix[3]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[3])[_i] - ([0.481463313652074, 0.365629081295686, 1, 0.107528640453679, 0.301587344693509, 0.133476214891546])[_i]) / (1 + abs(([0.481463313652074, 0.365629081295686, 1, 0.107528640453679, 0.301587344693509, 0.133476214891546])[_i])))) <= 1e-9 AND len(v.similarity_matrix[4]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[4])[_i] - ([0.125134155137653, 0.142368551242452, 0.107528640453679, 1, 0.190020471655014, 0.00340338160952646])[_i]) / (1 + abs(([0.125134155137653, 0.142368551242452, 0.107528640453679, 1, 0.190020471655014, 0.00340338160952646])[_i])))) <= 1e-9 AND len(v.similarity_matrix[5]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[5])[_i] - ([0.40637724952328, 0.446348885294176, 0.301587344693509, 0.190020471655014, 1, 0.022378535674559])[_i]) / (1 + abs(([0.40637724952328, 0.446348885294176, 0.301587344693509, 0.190020471655014, 1, 0.022378535674559])[_i])))) <= 1e-9 AND len(v.similarity_matrix[6]) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((v.similarity_matrix[6])[_i] - ([0.0658467400534324, 0.0829889578450262, 0.133476214891546, 0.00340338160952646, 0.022378535674559, 1])[_i]) / (1 + abs(([0.0658467400534324, 0.0829889578450262, 0.133476214891546, 0.00340338160952646, 0.022378535674559, 1])[_i])))) <= 1e-9,
       v.merges = [[-1, -3], [-2, -5], [1, 2], [-4, 3], [-6, 4]],
       len(v.height) = 5 AND list_max(list_transform(range(1, 6), lambda _i: abs((v.height)[_i] - ([0.518536686347926, 0.553651114705824, 0.698412655306491, 0.892471359546321, 0.996596618390474])[_i]) / (1 + abs(([0.518536686347926, 0.553651114705824, 0.698412655306491, 0.892471359546321, 0.996596618390474])[_i])))) <= 1e-9,
       v.dendrogram_order = [6, 4, 1, 3, 2, 5],
       v.clusters IS NULL,
       v.variables = ['mpg', 'disp', 'hp', 'drat', 'wt', 'qsec']
FROM (SELECT varclus_agg([mpg, disp, hp, drat, wt, qsec], {'similarity': 'hoeffding', 'feature_names': ['mpg', 'disp', 'hp', 'drat', 'wt', 'qsec']}) AS v FROM cars);
----
true	true	true	true	true	true

# redun(~ mpg + disp + hp + drat + wt + qsec, r2 = 0.8)
query IIIIIII
SELECT r.kept = ['mpg', 'drat', 'qsec'],
       r.removed = ['wt', 'hp', 'disp'],
       len(r.r_squared) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((r.r_squared)[_i] - ([0.929732833293331, 0.914325324678391, 0.846917341077441])[_i]) / (1 + abs(([0.929732833293331, 0.914325324678391, 0.846917341077441])[_i])))) <= 1e-9,
       len(r.r_squared_later) = 2,
       len(r.r_squared_later[1]) = 1 AND list_max(list_transform(range(1, 2), lambda _i: abs((r.r_squared_later[1])[_i] - ([0.925474101821234])[_i]) / (1 + abs(([0.925474101821234])[_i])))) <= 1e-9 AND len(r.r_squared_later[2]) = 2 AND list_max(list_transform(range(1, 3), lambda _i: abs((r.r_squared_later[2])[_i] - ([0.860235124785039, 0.894339072469394])[_i]) / (1 + abs(([0.860235124785039, 0.894339072469394])[_i])))) <= 1e-9,
       len(r.r_squared_first) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((r.r_squared_first)[_i] - ([0.90344598545419, 0.920583551199111, 0.921562995398104, 0.76507269808769, 0.929732833293331, 0.769352988738914])[_i]) / (1 + abs(([0.90344598545419, 0.920583551199111, 0.921562995398104, 0.76507269808769, 0.929732833293331, 0.769352988738914])[_i])))) <= 1e-9,
       len(r.too_few) = 0
FROM (SELECT redun_agg([mpg, disp, hp, drat, wt, qsec], {'r2': 0.8, 'feature_names': ['mpg', 'disp', 'hp', 'drat', 'wt', 'qsec']}) AS r FROM cars);
----
true	true	true	true	true	true	true

# redun(..., r2 = 0.8, type = 'adjusted')
query IIIIIII
SELECT r.kept = ['mpg', 'drat', 'qsec'],
       r.removed = ['wt', 'hp', 'disp'],
       len(r.r_squared) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((r.r_squared)[_i] - ([0.896272277718727, 0.884525437610005, 0.810177502936027])[_i]) / (1 + abs(([0.896272277718727, 0.884525437610005, 0.810177502936027])[_i])))) <= 1e-9,
