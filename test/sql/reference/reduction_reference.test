# redun with a categorical cyl and a linear drat
query IIIIIII
SELECT r.kept = ['mpg', 'qsec', 'drat'],
       r.removed = ['cyl', 'wt', 'hp', 'disp'],
       len(r.r_squared) = 4 AND list_max(list_transform(range(1, 5), lambda _i: abs((r.r_squared)[_i] - ([0.955885918429912, 0.922536603502056, 0.902930210052704, 0.836275036067924])[_i]) / (1 + abs(([0.955885918429912, 0.922536603502056, 0.902930210052704, 0.836275036067924])[_i])))) <= 1e-9,
       len(r.r_squared_later) = 3,
       len(r.r_squared_later[1]) = 1 AND list_max(list_transform(range(1, 2), lambda _i: abs((r.r_squared_later[1])[_i] - ([0.952235071851708])[_i]) / (1 + abs(([0.952235071851708])[_i])))) <= 1e-9 AND len(r.r_squared_later[2]) = 2 AND list_max(list_transform(range(1, 3), lambda _i: abs((r.r_squared_later[2])[_i] - ([0.945948618071333, 0.913187296510073])[_i]) / (1 + abs(([0.945948618071333, 0.913187296510073])[_i])))) <= 1e-9 AND len(r.r_squared_later[3]) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((r.r_squared_later[3])[_i] - ([0.866947869870762, 0.858392626056137, 0.889680118552795])[_i]) / (1 + abs(([0.866947869870762, 0.858392626056137, 0.889680118552795])[_i])))) <= 1e-9,
       len(r.r_squared_first) = 7 AND list_max(list_transform(range(1, 8), lambda _i: abs((r.r_squared_first)[_i] - ([0.904479870729883, 0.93796711210497, 0.933566151580702, 0.934242229851738, 0.82095317841963, 0.955885918429912, 0.765807654650118])[_i]) / (1 + abs(([0.904479870729883, 0.93796711210497, 0.933566151580702, 0.934242229851738, 0.82095317841963, 0.955885918429912, 0.765807654650118])[_i])))) <= 1e-9,
       len(r.too_few) = 0
FROM (SELECT redun_agg([mpg, disp, hp, wt, qsec, cyl, drat], {'r2': 0.8, 'types': ['spline', 'spline', 'spline', 'spline', 'spline', 'categorical', 'linear'], 'feature_names': ['mpg', 'disp', 'hp', 'wt', 'qsec', 'cyl', 'drat']}) AS r FROM cars);
----
true	true	true	true	true	true	true

