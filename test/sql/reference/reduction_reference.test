       len(r.r_squared_first) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((r.r_squared_first)[_i] - ([0.857467883289519, 0.882766194627259, 0.884212040825773, 0.653202554319924, 0.896272277718727, 0.659521078614587])[_i]) / (1 + abs(([0.857467883289519, 0.882766194627259, 0.884212040825773, 0.653202554319924, 0.896272277718727, 0.659521078614587])[_i])))) <= 1e-9,
       len(r.too_few) = 0
FROM (SELECT redun_agg([mpg, disp, hp, drat, wt, qsec], {'r2': 0.8, 'type': 'adjusted', 'feature_names': ['mpg', 'disp', 'hp', 'drat', 'wt', 'qsec']}) AS r FROM cars);
