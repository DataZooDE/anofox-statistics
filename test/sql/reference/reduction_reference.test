# redun(..., r2 = 0.8, nk = 4)
query IIIIIII
SELECT r.kept = ['disp', 'drat', 'qsec'],
       r.removed = ['wt', 'hp', 'mpg'],
       len(r.r_squared) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((r.r_squared)[_i] - ([0.975498281990579, 0.951664290587259, 0.890017948443127])[_i]) / (1 + abs(([0.975498281990579, 0.951664290587259, 0.890017948443127])[_i])))) <= 1e-9,
       len(r.r_squared_later) = 2,
       len(r.r_squared_later[1]) = 1 AND list_max(list_transform(range(1, 2), lambda _i: abs((r.r_squared_later[1])[_i] - ([0.95076223073192])[_i]) / (1 + abs(([0.95076223073192])[_i])))) <= 1e-9 AND len(r.r_squared_later[2]) = 2 AND list_max(list_transform(range(1, 3), lambda _i: abs((r.r_squared_later[2])[_i] - ([0.917105240344942, 0.919133795721508])[_i]) / (1 + abs(([0.917105240344942, 0.919133795721508])[_i])))) <= 1e-9,
       len(r.r_squared_first) = 6 AND list_max(list_transform(range(1, 7), lambda _i: abs((r.r_squared_first)[_i] - ([0.927788939529668, 0.935844054349286, 0.968182069982458, 0.777731139487312, 0.975498281990579, 0.835553877167877])[_i]) / (1 + abs(([0.927788939529668, 0.935844054349286, 0.968182069982458, 0.777731139487312, 0.975498281990579, 0.835553877167877])[_i])))) <= 1e-9,
