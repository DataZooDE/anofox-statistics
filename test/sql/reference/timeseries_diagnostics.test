# Box.test(e, lag = 5, type = 'Ljung-Box', fitdf = 2)
query IIII
SELECT
    abs((r.statistic) - (6.5159965017096395)) <= 1e-10 * (1 + abs(6.5159965017096395)),
    abs((r.df1) - (3)) <= 1e-10 * (1 + abs(3)),
    abs((r.p_value) - (0.089033771782901616)) <= 1e-10 * (1 + abs(0.089033771782901616)),
    abs((r.n) - (40)) <= 1e-10 * (1 + abs(40))
FROM (SELECT ljung_box_agg(e, 5, 2 ORDER BY t) AS r FROM ts) s;
----
true	true	true	true

# ljung_box_agg method string and lag/fitdf
query III
SELECT r.method, r.lag, r.fitdf FROM (SELECT ljung_box_agg(e, 5, 2 ORDER BY t) AS r FROM ts) s;
----
Box-Ljung test	5	2

# Box.test(e, lag = 1, type = 'Ljung-Box', fitdf = 0)
query IIII
SELECT
    abs((r.statistic) - (2.680094155648602)) <= 1e-10 * (1 + abs(2.680094155648602)),
    abs((r.df1) - (1)) <= 1e-10 * (1 + abs(1)),
    abs((r.p_value) - (0.10160972044233585)) <= 1e-10 * (1 + abs(0.10160972044233585)),
    abs((r.n) - (40)) <= 1e-10 * (1 + abs(40))
FROM (SELECT ljung_box_agg(e ORDER BY t) AS r FROM ts) s;
----
true	true	true	true

# ljung_box_agg method string and lag/fitdf
query III
SELECT r.method, r.lag, r.fitdf FROM (SELECT ljung_box_agg(e ORDER BY t) AS r FROM ts) s;
----
Box-Ljung test	1	0

# Box.test(e, lag = 5, type = 'Box-Pierce', fitdf = 2)
query IIII
SELECT
    abs((r.statistic) - (5.8500015794692706)) <= 1e-10 * (1 + abs(5.8500015794692706)),
    abs((r.df1) - (3)) <= 1e-10 * (1 + abs(3)),
    abs((r.p_value) - (0.11914044931542445)) <= 1e-10 * (1 + abs(0.11914044931542445)),
    abs((r.n) - (40)) <= 1e-10 * (1 + abs(40))
FROM (SELECT box_pierce_agg(e, 5, 2 ORDER BY t) AS r FROM ts) s;
