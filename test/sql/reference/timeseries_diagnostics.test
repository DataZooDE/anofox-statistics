Box-Pierce test	10	0

# lmtest::dwtest(lm(y ~ x1 + x2))$statistic (p_value: not available upstream)
query III
SELECT
    abs((r.statistic) - (2.4950976911255971)) <= 1e-10 * (1 + abs(2.4950976911255971)),
    (r.p_value) IS NULL,
    abs((r.n) - (40)) <= 1e-10 * (1 + abs(40))
FROM (SELECT durbin_watson_agg(e ORDER BY t) AS r FROM ts) s;
----
true	true	true

# bptest(fit)
query III
SELECT
    abs((r.statistic) - (14.373846157843088)) <= 1e-08 * (1 + abs(14.373846157843088)),
    abs((r.df1) - (2)) <= 1e-08 * (1 + abs(2)),
    abs((r.p_value) - (0.0007564129665154119)) <= 1e-08 * (1 + abs(0.0007564129665154119))
FROM (SELECT breusch_pagan_agg(e, [x1, x2]) AS r FROM ts) s;
----
true	true	true

# bptest(fit, studentize = FALSE)
query III
SELECT
    abs((r.statistic) - (13.735404088792077)) <= 1e-08 * (1 + abs(13.735404088792077)),
    abs((r.df1) - (2)) <= 1e-08 * (1 + abs(2)),
    abs((r.p_value) - (0.0010408661827979735)) <= 1e-08 * (1 + abs(0.0010408661827979735))
FROM (SELECT breusch_pagan_agg(e, [x1, x2], false) AS r FROM ts) s;
----
true	true	true

# bptest(fit, ~ x1 * x2 + I(x1^2) + I(x2^2))
query III
SELECT
    abs((r.statistic) - (23.969599795928506)) <= 1e-08 * (1 + abs(23.969599795928506)),
    abs((r.df1) - (5)) <= 1e-08 * (1 + abs(5)),
    abs((r.p_value) - (0.0002200528904008662)) <= 1e-08 * (1 + abs(0.0002200528904008662))
FROM (SELECT white_test_agg(e, [x1, x2]) AS r FROM ts) s;
----
true	true	true

# method strings
query III
SELECT breusch_pagan_agg(e, [x1, x2]).method, breusch_pagan_agg(e, [x1, x2], false).method, white_test_agg(e, [x1, x2]).method FROM ts;
----
studentized Breusch-Pagan test	Breusch-Pagan test	White test

