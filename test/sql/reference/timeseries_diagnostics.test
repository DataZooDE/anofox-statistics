# e are the residuals of lm(y ~ x1 + x2) (written with 17 significant digits).

# acf_agg returns lags 0..max_lag
query III
SELECT len(r), r[1].lag, r[9].lag FROM (SELECT acf_agg(e, 8 ORDER BY t) AS r FROM ts) s;
----
9	0	8

# acf(e, lag.max = 8)$acf
query IIIIII
SELECT
    abs((r[1].acf) - (1)) <= 1e-10 * (1 + abs(1)),
    abs((r[2].acf) - (-0.24943229837054778)) <= 1e-10 * (1 + abs(-0.24943229837054778)),
    abs((r[3].acf) - (0.099610072080719869)) <= 1e-10 * (1 + abs(0.099610072080719869)),
    abs((r[4].acf) - (-0.23808408058262154)) <= 1e-10 * (1 + abs(-0.23808408058262154)),
    abs((r[5].acf) - (0.098882709615355183)) <= 1e-10 * (1 + abs(0.098882709615355183)),
    abs((r[6].acf) - (-0.087461888092155285)) <= 1e-10 * (1 + abs(-0.087461888092155285))
FROM (SELECT acf_agg(e, 8 ORDER BY t) AS r FROM ts) s;
----
true	true	true	true	true	true

# acf(e, lag.max = 8)$acf
query III
SELECT
    abs((r[7].acf) - (0.052927660599244752)) <= 1e-10 * (1 + abs(0.052927660599244752)),
    abs((r[8].acf) - (0.064171909330868915)) <= 1e-10 * (1 + abs(0.064171909330868915)),
    abs((r[9].acf) - (0.24636822153338617)) <= 1e-10 * (1 + abs(0.24636822153338617))
FROM (SELECT acf_agg(e, 8 ORDER BY t) AS r FROM ts) s;
----
true	true	true

# white-noise band qnorm(0.975) / sqrt(n)
query II
SELECT
    abs((r[2].conf_high) - (0.30989751615228067)) <= 1e-12 * (1 + abs(0.30989751615228067)),
    abs((r[2].conf_low) - (-0.30989751615228067)) <= 1e-12 * (1 + abs(-0.30989751615228067))
FROM (SELECT acf_agg(e, 8 ORDER BY t) AS r FROM ts) s;
----
true	true

# default lag.max = floor(10 log10 n) = 16
query II
SELECT len(acf_agg(e ORDER BY t)) - 1, len(pacf_agg(e ORDER BY t)) FROM ts;
----
16	16

# pacf_agg returns lags 1..max_lag
query III
SELECT len(r), r[1].lag, r[8].lag FROM (SELECT pacf_agg(e, 8 ORDER BY t) AS r FROM ts) s;
----
8	1	8

# pacf(e, lag.max = 8)$acf
query IIIIII
SELECT
    abs((r[1].pacf) - (-0.24943229837054778)) <= 1e-10 * (1 + abs(-0.24943229837054778)),
    abs((r[2].pacf) - (0.039874448071121345)) <= 1e-10 * (1 + abs(0.039874448071121345)),
    abs((r[3].pacf) - (-0.21818273664510388)) <= 1e-10 * (1 + abs(-0.21818273664510388)),
