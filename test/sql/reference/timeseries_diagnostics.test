# pacf(e, lag.max = 8)$acf
query II
SELECT
    abs((r[7].pacf) - (0.10064319512475706)) <= 1e-10 * (1 + abs(0.10064319512475706)),
    abs((r[8].pacf) - (0.28952397190079604)) <= 1e-10 * (1 + abs(0.28952397190079604))
