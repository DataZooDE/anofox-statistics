true	true	true	true

# box_pierce_agg method string and lag/fitdf
query III
SELECT r.method, r.lag, r.fitdf FROM (SELECT box_pierce_agg(e, 5, 2 ORDER BY t) AS r FROM ts) s;
----
Box-Pierce test	5	2

# Box.test(e, lag = 10, type = 'Box-Pierce', fitdf = 0)
query IIII
SELECT
    abs((r.statistic) - (10.934066343858134)) <= 1e-10 * (1 + abs(10.934066343858134)),
    abs((r.df1) - (10)) <= 1e-10 * (1 + abs(10)),
    abs((r.p_value) - (0.36267789186157395)) <= 1e-10 * (1 + abs(0.36267789186157395)),
    abs((r.n) - (40)) <= 1e-10 * (1 + abs(40))
