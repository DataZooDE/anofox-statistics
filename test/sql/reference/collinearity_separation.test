    abs((r.singular_values[1]) - (1.7029285382798545)) <= 1e-09 * (1 + abs(1.7029285382798545)),
    abs((r.singular_values[2]) - (0.28424075041674635)) <= 1e-09 * (1 + abs(0.28424075041674635)),
