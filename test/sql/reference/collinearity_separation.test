# longley [unemployed, armed], intercept - shape
query IIIII
SELECT len(r.singular_values), len(r.condition_indices), len(r.variance_proportions), len(r.variance_proportions[1]), r.n_observations FROM (SELECT condition_diagnostic_agg([unemployed, armed]) AS r FROM longley) s;
----
3	3	3	3	16

# longley [unemployed, armed], intercept - kappa(X, exact = TRUE), scaled kappa
query III
SELECT
    abs((r.condition_number) - (2454.8413146655089)) <= 1e-08 * (1 + abs(2454.8413146655089)),
    abs((r.condition_number_xtx) - (6026245.880188684)) <= 1e-08 * (1 + abs(6026245.880188684)),
    abs((r.scaled_condition_number) - (12.276539149356863)) <= 1e-08 * (1 + abs(12.276539149356863))
FROM (SELECT condition_diagnostic_agg([unemployed, armed]) AS r FROM longley) s;
----
true	true	true

# longley [unemployed, armed], intercept - singular values of the unit-length design
