    abs((r.condition_indices[6]) - (1086.0170218411542)) <= 1e-08 * (1 + abs(1086.0170218411542))
FROM (SELECT condition_diagnostic_agg([deflator, gnp, unemployed, armed, population, year], {'fit_intercept': false}) AS r FROM longley) s;
