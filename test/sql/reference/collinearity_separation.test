# severity uses the BKW cut-offs 30 / 100 / 1000 of the scaled condition number
query II
SELECT condition_diagnostic_agg([deflator, gnp, unemployed, armed, population, year]).severity, condition_diagnostic_agg([unemployed, armed]).severity FROM longley;
----
severe	well_conditioned

# complete: detect_separation(y ~ x1 + x2): outcome TRUE, coefficients -Inf Inf -Inf
query IIIII
SELECT r.separated, r.infinite = ['-inf'::DOUBLE, 'inf'::DOUBLE, '-inf'::DOUBLE], r0.separated, r0.infinite = [0.0, 0.0], r.n_observations FROM (SELECT detect_separation_agg(y, [x1, x2]) AS r, detect_separation_agg(y, [x1, x2], {'fit_intercept': false}) AS r0 FROM sep WHERE g = 'complete') s;
----
true	true	false	true	12

# combination: detect_separation(y ~ x1 + x2): outcome TRUE, coefficients -Inf Inf Inf
query IIIII
SELECT r.separated, r.infinite = ['-inf'::DOUBLE, 'inf'::DOUBLE, 'inf'::DOUBLE], r0.separated, r0.infinite = [0.0, 0.0], r.n_observations FROM (SELECT detect_separation_agg(y, [x1, x2]) AS r, detect_separation_agg(y, [x1, x2], {'fit_intercept': false}) AS r0 FROM sep WHERE g = 'combination') s;
----
true	true	false	true	12

# quasi: detect_separation(y ~ x1 + x2): outcome TRUE, coefficients -Inf Inf 0
query IIIII
SELECT r.separated, r.infinite = ['-inf'::DOUBLE, 'inf'::DOUBLE, 0.0], r0.separated, r0.infinite = [0.0, 0.0], r.n_observations FROM (SELECT detect_separation_agg(y, [x1, x2]) AS r, detect_separation_agg(y, [x1, x2], {'fit_intercept': false}) AS r0 FROM sep WHERE g = 'quasi') s;
----
true	true	false	true	12

# overlap: detect_separation(y ~ x1 + x2): outcome FALSE, coefficients 0 0 0
query IIIII
SELECT r.separated, r.infinite = [0.0, 0.0, 0.0], r0.separated, r0.infinite = [0.0, 0.0], r.n_observations FROM (SELECT detect_separation_agg(y, [x1, x2]) AS r, detect_separation_agg(y, [x1, x2], {'fit_intercept': false}) AS r0 FROM sep WHERE g = 'overlap') s;
----
false	true	false	true	12

# endometrial (Heinze & Schemper 2002): outcome TRUE, coefficients 0 Inf 0 0
query III
SELECT r.separated, r.infinite = [0.0, 'inf'::DOUBLE, 0.0, 0.0], r.n_observations FROM (SELECT detect_separation_agg(hg, [nv, pi, eh]) AS r FROM endometrial) s;
----
true	true	79

