    abs(((SELECT multinomial_predict(t.m, [x1, x2, x3], {'type': 'prob'})[3] FROM d WHERE id = 120)) - (0.11836061947051)) <= 1e-6 * (1 + abs(0.11836061947051)),
    abs(((SELECT multinomial_predict(t.m, [x1, x2, x3], {'type': 'prob'})[4] FROM d WHERE id = 120)) - (0.394222418941793)) <= 1e-6 * (1 + abs(0.394222418941793))
