    abs(((SELECT multinomial_predict(t.m, [x1, x2, x3], {'type': 'prob'})[1] FROM d WHERE id = 40)) - (0.0373639763183054)) <= 1e-6 * (1 + abs(0.0373639763183054)),
    abs(((SELECT multinomial_predict(t.m, [x1, x2, x3], {'type': 'prob'})[2] FROM d WHERE id = 40)) - (0.00227834484660283)) <= 1e-6 * (1 + abs(0.00227834484660283)),
    abs(((SELECT multinomial_predict(t.m, [x1, x2, x3], {'type': 'prob'})[3] FROM d WHERE id = 40)) - (0.897639027920087)) <= 1e-6 * (1 + abs(0.897639027920087)),
    abs(((SELECT multinomial_predict(t.m, [x1, x2, x3], {'type': 'prob'})[4] FROM d WHERE id = 40)) - (0.0627186509150051)) <= 1e-6 * (1 + abs(0.0627186509150051))
FROM (SELECT multinomial_fit_agg(y, [x1, x2, x3], wt, {'lambda': 0}) AS m FROM d) t;
----
true	true	true	true	true	true

