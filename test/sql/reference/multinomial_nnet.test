query IIIIII
SELECT
    abs((m.intercepts[2] - m.intercepts[1]) - (0.321811936128219)) <= 1e-6 * (1 + abs(0.321811936128219)),
    abs((m.coefficients[2][1] - m.coefficients[1][1]) - (1.34785525703697)) <= 1e-6 * (1 + abs(1.34785525703697)),
    abs((m.coefficients[2][2] - m.coefficients[1][2]) - (-0.834533859396362)) <= 1e-6 * (1 + abs(-0.834533859396362)),
    abs((m.coefficients[2][3] - m.coefficients[1][3]) - (0.305000833488377)) <= 1e-6 * (1 + abs(0.305000833488377)),
    abs((m.intercepts[3] - m.intercepts[1]) - (-0.861627019936788)) <= 1e-6 * (1 + abs(-0.861627019936788)),
    abs((m.coefficients[3][1] - m.coefficients[1][1]) - (-0.91676677388009)) <= 1e-6 * (1 + abs(-0.91676677388009))
FROM (SELECT multinomial_fit_agg(y, [x1, x2, x3], {'lambda': 0}) AS m FROM d) t;
