# multinomial_fit_agg lambda = 0, case weights: predicted classes
query IIIII
SELECT
    (SELECT predict(t.m, [x1, x2, x3]) FROM d WHERE id = 1) = 'alpha',
    (SELECT predict(t.m, [x1, x2, x3]) FROM d WHERE id = 9) = 'beta',
    (SELECT predict(t.m, [x1, x2, x3]) FROM d WHERE id = 40) = 'delta',
    (SELECT predict(t.m, [x1, x2, x3]) FROM d WHERE id = 77) = 'gamma',
    (SELECT predict(t.m, [x1, x2, x3]) FROM d WHERE id = 120) = 'gamma'
FROM (SELECT multinomial_fit_agg(y, [x1, x2, x3], wt, {'lambda': 0}) AS m FROM d) t;
----
true	true	true	true	true

# lambda = 0, case weights: accuracy = share of rows whose predicted class is their class
query I
SELECT abs((m.accuracy) - (0.575)) <= 1e-12 * (1 + abs(0.575)) FROM (SELECT multinomial_fit_agg(y, [x1, x2, x3], wt, {'lambda': 0}) AS m FROM d) t;
----
true

