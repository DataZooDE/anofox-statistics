    abs(((SELECT multinomial_predict(t.m, [x1, x2, x3], {'type': 'prob'})[1] FROM d WHERE id = 120)) - (0.199808733997332)) <= 1e-6 * (1 + abs(0.199808733997332)),
    abs(((SELECT multinomial_predict(t.m, [x1, x2, x3], {'type': 'prob'})[2] FROM d WHERE id = 120)) - (0.287608227590366)) <= 1e-6 * (1 + abs(0.287608227590366))
