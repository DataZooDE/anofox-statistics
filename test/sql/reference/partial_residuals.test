# OLS lm(y ~ x1 + x2), term 1, row 1: residuals(type = 'partial')[1, 1]; lsfit residuals of x_1 and y on the other column
query III
SELECT
    abs((partial_residual) - (-2.8653375259246916)) <= 1e-08 * (1 + abs(-2.8653375259246916)),
    abs((x_residual) - (0.70782628260229452)) <= 1e-08 * (1 + abs(0.70782628260229452)),
    abs((y_residual) - (-3.0669432153179592)) <= 1e-08 * (1 + abs(-3.0669432153179592))
FROM (SELECT * FROM ols_partial_residuals_by('d1', g, y, [x1, x2]) WHERE term_index = 1 AND row_id = 1) s;
