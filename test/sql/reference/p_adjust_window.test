# name: test/sql/reference/p_adjust_window.test
# description: #224 window function p_adjust(p, method, n) OVER (...) on DuckDB 2.0 vs R p.adjust and p_adjust_by; absent on DuckDB 1.5
# group: [reference]
#
# p_adjust needs DuckDB 2.0's batched window callback, so it is registered on 2.0 only.
# This file runs on both lines: every query that uses p_adjust goes through
# v2_or(sql, fallback), which runs `sql` on DuckDB 2.0 and the constant `fallback`
# (the expected result) on 1.5, where `sql` would not bind.
#
# R 4.6.1 reference values: the families of test/sql/reference/p_adjust_reference.test,
#   fam <- list(e1 = c(0.01, 0.04, 0.04, 0.0001, 0.2, 0.9, NA, 0.03, 0, 1),
#               e2 = c(0.02, 0.5, 0.013), e3 = c(0.3))
#   p.adjust(fam[[e]], m) and p.adjust(fam[[e]], m, n = 15) for every method m.

require anofox_statistics

statement ok
CREATE MACRO v2_or(sql, fallback) AS TABLE
    SELECT * FROM query(CASE WHEN version() >= 'v2' THEN sql ELSE fallback END);

# Registered exactly on DuckDB 2.0.
query I
SELECT (count(*) > 0) = (version() >= 'v2') FROM duckdb_functions() WHERE function_name = 'p_adjust';
----
true

statement ok
CREATE TABLE ref(endpoint VARCHAR, id INTEGER, method VARCHAR, n BIGINT, p DOUBLE, expected DOUBLE);

statement ok
