statement ok
CREATE TABLE results AS SELECT DISTINCT endpoint, id, p FROM ref;

statement ok
CREATE MACRO padj_matches(got, want) AS
    CASE WHEN want IS NULL THEN got IS NULL ELSE coalesce(abs(got - want) <= 1e-14 * (1 + abs(want)), false) END;

# ---------------------------------------------------------------------------
# Against R: one family per endpoint (no ORDER BY in OVER: the frame is the partition)
# ---------------------------------------------------------------------------

foreach method holm hommel BH

query I
FROM v2_or($$
    SELECT count(*) FILTER (WHERE NOT padj_matches(got, expected)) || ' mismatches of ' || count(*)
    FROM (SELECT endpoint, id, p_adjust(p, '${method}') OVER (PARTITION BY endpoint) AS got FROM results)
    JOIN ref USING (endpoint, id) WHERE ref.method = '${method}' AND ref.n IS NULL
$$, $$SELECT '0 mismatches of 14'$$);
----
0 mismatches of 14

endloop

foreach method holm BY

query I
FROM v2_or($$
    SELECT count(*) FILTER (WHERE NOT padj_matches(got, expected)) || ' mismatches of ' || count(*)
    FROM (SELECT endpoint, id, p_adjust(p, '${method}', 15) OVER (PARTITION BY endpoint) AS got FROM results)
    JOIN ref USING (endpoint, id) WHERE ref.method = '${method}' AND ref.n = 15
$$, $$SELECT '0 mismatches of 14'$$);
----
0 mismatches of 14

endloop

# The whole-partition frame written out, and an ORDER BY inside the call, change nothing.
query I
FROM v2_or($$
    SELECT count(*) FILTER (WHERE NOT padj_matches(got, expected)) || ' mismatches of ' || count(*)
    FROM (SELECT endpoint, id,
                 p_adjust(p ORDER BY p DESC) OVER (PARTITION BY endpoint ORDER BY id
                     ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS got
          FROM results)
    JOIN ref USING (endpoint, id) WHERE ref.method = 'holm' AND ref.n IS NULL
$$, $$SELECT '0 mismatches of 14'$$);
----
0 mismatches of 14

# ---------------------------------------------------------------------------
# Equal to p_adjust_by on many partitions and on one large family, all methods
# (parallel evaluation of one hash group shares the family)
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE big AS
SELECT i, i % 37 AS g,
       CASE WHEN i % 11 = 0 THEN NULL ELSE ((i * 7919) % 10007) / 10007.0 END AS p
FROM range(150000) t(i);

statement ok
CREATE TABLE big_one AS SELECT i, 1 AS g, p FROM big;

foreach method holm hochberg hommel bonferroni BH BY none

query I
FROM v2_or($$
    SELECT count(*) FILTER (WHERE NOT padj_matches(w.got, a.p_adjusted)) || ' mismatches of ' || count(*)
    FROM (SELECT i, p_adjust(p, '${method}') OVER (PARTITION BY g) AS got FROM big) w
    JOIN p_adjust_by('big', g, p, method := '${method}') a USING (i)
$$, $$SELECT '0 mismatches of 150000'$$);
----
0 mismatches of 150000

query I
FROM v2_or($$
    SELECT count(*) FILTER (WHERE NOT padj_matches(w.got, a.p_adjusted)) || ' mismatches of ' || count(*)
    FROM (SELECT i, p_adjust(p, '${method}', 200000) OVER () AS got FROM big_one) w
    JOIN p_adjust_by('big_one', g, p, method := '${method}', n := 200000) a USING (i)
$$, $$SELECT '0 mismatches of 150000'$$);
----
0 mismatches of 150000

endloop

# ---------------------------------------------------------------------------
# Semantics
# ---------------------------------------------------------------------------

# The family is the frame: with ORDER BY the default frame grows row by row, a row
# outside its own frame and an EXCLUDE CURRENT ROW frame give NULL.
query IIIII
FROM v2_or($$
    SELECT i,
           p_adjust(p, 'bonferroni') OVER (PARTITION BY g) AS whole,
           p_adjust(p, 'bonferroni') OVER (PARTITION BY g ORDER BY i) AS running,
           p_adjust(p, 'bonferroni') OVER (PARTITION BY g ORDER BY i ROWS BETWEEN 2 PRECEDING AND 1 PRECEDING) AS before,
           p_adjust(p, 'bonferroni') OVER (PARTITION BY g ORDER BY i
               ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE CURRENT ROW) AS excluded
    FROM (VALUES ('a', 1, 0.01), ('a', 2, 0.02), ('a', 3, 0.03), ('b', 4, 0.2)) t(g, i, p)
    ORDER BY i
$$, $$SELECT * FROM (VALUES (1, 0.03, 0.01, NULL::DOUBLE, NULL::DOUBLE), (2, 0.06, 0.04, NULL, NULL),
                            (3, 0.09, 0.09, NULL, NULL), (4, 0.2, 0.2, NULL, NULL)) t(i, a, b, c, d)$$);
----
1	0.03	0.01	NULL	NULL
2	0.06	0.04	NULL	NULL
3	0.09	0.09	NULL	NULL
4	0.2	0.2	NULL	NULL

# NULL p-values stay NULL and are not counted; rows removed by FILTER are NULL and not
# counted; NULL method / n mean holm / the non-NULL count.
query IIII
FROM v2_or($$
    SELECT i,
           p_adjust(p, 'bonferroni') OVER () AS bonf,
           p_adjust(p, 'bonferroni') FILTER (WHERE i <> 3) OVER () AS filtered,
           p_adjust(p, NULL, NULL) OVER () AS defaults
    FROM (VALUES (1, 0.01), (2, NULL), (3, 0.02), (4, 0.04)) t(i, p)
    ORDER BY i
$$, $$SELECT * FROM (VALUES (1, 0.03, 0.02, 0.03), (2, NULL, NULL, NULL), (3, 0.06, NULL, 0.04),
                            (4, 0.12, 0.08, 0.04)) t(i, a, b, c)$$);
----
1	0.03	0.02	0.03
2	NULL	NULL	NULL
3	0.06	NULL	0.04
4	0.12	0.08	0.04

# An all-NULL partition, an empty table, and the default method (holm).
query III
FROM v2_or($$
    SELECT g, i, p_adjust(p) OVER (PARTITION BY g) AS got
    FROM (VALUES ('a', 1, NULL::DOUBLE), ('b', 2, 0.01), ('b', 3, 0.02)) t(g, i, p)
    ORDER BY i
$$, $$SELECT * FROM (VALUES ('a', 1, NULL::DOUBLE), ('b', 2, 0.02), ('b', 3, 0.02)) t(g, i, got)$$);
----
a	1	NULL
b	2	0.02
b	3	0.02

query I
FROM v2_or($$
    SELECT count(*) FROM (SELECT p_adjust(p) OVER () AS got FROM (SELECT 0.5::DOUBLE AS p WHERE false))
$$, $$SELECT 0::BIGINT$$);
----
0

# ---------------------------------------------------------------------------
# Errors
# ---------------------------------------------------------------------------

statement error
FROM v2_or($$
    SELECT p_adjust(p) FROM (VALUES (0.01), (0.02)) t(p)
$$, $$SELECT error('Function ''p_adjust'' can only be used as a window function')$$);
----
can only be used as a window function

statement error
FROM v2_or($$
    SELECT p_adjust(p, 'nope') OVER () FROM (VALUES (0.01), (0.02)) t(p)
$$, $$SELECT error('unknown p-value adjustment method ''nope''')$$);
----
unknown p-value adjustment method 'nope'

statement error
FROM v2_or($$
    SELECT p_adjust(p, m) OVER () FROM (VALUES (0.01, 'holm'), (0.02, 'BH')) t(p, m)
$$, $$SELECT error('p_adjust: method must be a constant')$$);
----
method must be a constant

statement error
FROM v2_or($$
    SELECT p_adjust(p, 'holm', -1) OVER () FROM (VALUES (0.01), (0.02)) t(p)
$$, $$SELECT error('p_adjust: n must be non-negative')$$);
----
n must be non-negative

# n may not be smaller than the number of non-NULL p-values of a family.
statement error
FROM v2_or($$
    SELECT p_adjust(p, 'holm', 2) OVER (PARTITION BY g)
    FROM (VALUES ('a', 0.01), ('a', 0.02), ('b', 0.01), ('b', 0.02), ('b', 0.03)) t(g, p)
$$, $$SELECT error('n (2) must be at least the number of non-missing p-values (3)')$$);
----
must be at least the number of non-missing p-values

# The connection is still usable after the errors above.
query I
FROM v2_or($$
    SELECT p_adjust(p, 'bonferroni') OVER () FROM (VALUES (0.25)) t(p)
$$, $$SELECT 0.25$$);
----
0.25
