# name: test/sql/reference/normality_reference.test
# description: Normality tests vs R/scipy (shapiro.test, Jarque-Bera, scipy.stats.normaltest)
# group: [reference]
#
# Reference values: validation/generators/make_reference_tests.R / make_reference_tests.py.

require anofox_statistics

statement ok
CREATE TABLE nv AS SELECT unnest([2.31, 3.85, 1.97, 4.42, 3.10, 2.76, 5.94, 3.33, 2.05, 4.88,
                                  3.61, 2.49, 7.12, 3.02, 2.88, 4.15, 3.47, 1.64, 5.21, 2.95])::DOUBLE AS v;

statement ok
CREATE TABLE nv10 AS SELECT unnest([4.1, 5.3, 3.8, 6.9, 5.0, 4.4, 9.2, 5.7, 4.9, 6.1])::DOUBLE AS v;

# ---------------------------------------------------------------------------
# shapiro_wilk_agg — R: shapiro.test(nv) (Royston AS R94; scipy.stats.shapiro identical)
# W tolerance 1e-6, p tolerance 1e-5 (AS R94 itself is an approximation, but R and
# scipy agree to ~1e-15; the implementation claims AS R94).
# ---------------------------------------------------------------------------
query III
SELECT abs(r.statistic - 0.93325039684015909) < 1e-6, abs(r.p_value - 0.1783034135065848) < 1e-5, r.n = 20
FROM (SELECT shapiro_wilk_agg(v) AS r FROM nv);
----
true	true	true

# Small-sample branch (n <= 11). R: shapiro.test(c(4.1, 5.3, 3.8, 6.9, 5.0, 4.4, 9.2, 5.7, 4.9, 6.1))
query II
SELECT abs(r.statistic - 0.88790406283629908) < 1e-6, abs(r.p_value - 0.16058545199963783) < 1e-5
FROM (SELECT shapiro_wilk_agg(v) AS r FROM nv10);
----
true	true

# ---------------------------------------------------------------------------
# jarque_bera_agg / jarque_bera(list)
# JB = n/6 (S^2 + (K-3)^2/4) with population moments; scipy.stats.jarque_bera agrees.
# The 'kurtosis' field is EXCESS kurtosis (K - 3), = scipy.stats.kurtosis(nv).
# ---------------------------------------------------------------------------
query IIIII
SELECT abs(r.statistic - 3.0379837126405342) < 1e-9, abs(r.p_value - 0.21893249114040278) < 1e-12,
       abs(r.skewness - 0.93551884097936755) < 1e-9, abs(r.kurtosis - 0.38052391233551175) < 1e-9, r.n = 20
FROM (SELECT jarque_bera_agg(v) AS r FROM nv);
----
true	true	true	true	true

query III
SELECT abs(r.statistic - 3.0379837126405342) < 1e-9, abs(r.p_value - 0.21893249114040278) < 1e-12,
       abs(r.kurtosis - 0.38052391233551175) < 1e-9
FROM (SELECT jarque_bera(list(v)) AS r FROM nv);
----
true	true	true

# ---------------------------------------------------------------------------
# dagostino_k2_agg — scipy.stats.normaltest(nv)
# ---------------------------------------------------------------------------
query III
SELECT abs(r.statistic - 4.847165755153492) < 1e-9, abs(r.p_value - 0.0886035922530012) < 1e-12, r.n = 20
FROM (SELECT dagostino_k2_agg(v) AS r FROM nv);
----
true	true	true
