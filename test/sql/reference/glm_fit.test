# R fits use glm.control(epsilon = 1e-14); the extension is run with
# {'tolerance': 1e-12}. Coefficients, SEs and derived values compare at 1e-6.

# ---- Poisson (log link) ----
# CONVENTION: the extension scales the Poisson covariance by max(1, Pearson
# chi^2/df) (here 1.005776), a floored quasi-Poisson correction; R's
# summary.glm uses dispersion 1. Reference: summary(glm(cnt ~ z1 + z2, poisson),
# dispersion = max(1, sum(residuals(fit, 'pearson')^2)/df.residual)).
# glm(cnt ~ z1 + z2, family = poisson): coefficients
query III
SELECT
    abs((r.intercept) - (0.34293045400482675)) <= 1e-06 * (1 + abs(0.34293045400482675)),
    abs((r.coefficients[1]) - (0.80895637159164679)) <= 1e-06 * (1 + abs(0.80895637159164679)),
    abs((r.coefficients[2]) - (0.44226702505967747)) <= 1e-06 * (1 + abs(0.44226702505967747))
FROM (SELECT poisson_fit_agg(cnt, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM d2) s;
----
true	true	true

# glm(cnt ~ z1 + z2, family = poisson): slope SE, z, p, Wald CI (b -/+ qnorm(.975)*se)
query IIIIII
SELECT
    abs((r.std_errors[1]) - (0.22952105972601644)) <= 1e-06 * (1 + abs(0.22952105972601644)),
    abs((r.std_errors[2]) - (0.2224740742942983)) <= 1e-06 * (1 + abs(0.2224740742942983)),
