# accuracy = mean((fitted > 0.5) == bin)
query I
SELECT
    abs((r.accuracy) - (0.69999999999999996)) <= 1e-12 * (1 + abs(0.69999999999999996))
FROM (SELECT logistic_fit_agg(bin, [z1, z2], {'tolerance': 1e-12}) AS r FROM d2) s;
----
true

# ---- Negative binomial ----
# MASS::glm.nb estimates theta by maximum likelihood (theta = 1.829468473259).
# Passing that theta reproduces glm.nb's coefficients, SEs (conditional on theta,
# dispersion fixed at 1 as summary(glm.nb) reports them, not summary.glm's Pearson
# estimate) and AIC (= -2 logLik + 2 (p + 1), theta counted as a parameter).
# MASS::glm.nb(nb ~ z1 + z2) at its ML theta: coefficients
query III
SELECT
    abs((r.intercept) - (1.1413104756299139)) <= 1e-06 * (1 + abs(1.1413104756299139)),
    abs((r.coefficients[1]) - (0.44450754256439012)) <= 1e-06 * (1 + abs(0.44450754256439012)),
    abs((r.coefficients[2]) - (0.15639173352687216)) <= 1e-06 * (1 + abs(0.15639173352687216))
FROM (SELECT negbinom_fit_agg(nb, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12, 'theta': 1.8294684732585813}) AS r FROM d2) s;
----
true	true	true

# MASS::glm.nb(nb ~ z1 + z2) at its ML theta: slope SE, z, p, Wald CI (b -/+ qnorm(.975)*se)
query IIIIII
SELECT
    abs((r.std_errors[1]) - (0.29539270951207597)) <= 1e-06 * (1 + abs(0.29539270951207597)),
    abs((r.std_errors[2]) - (0.31149705719544607)) <= 1e-06 * (1 + abs(0.31149705719544607)),
    abs((r.z_values[1]) - (1.5048020084809106)) <= 1e-06 * (1 + abs(1.5048020084809106)),
    abs((r.z_values[2]) - (0.50206488284332507)) <= 1e-06 * (1 + abs(0.50206488284332507)),
    abs((r.p_values[1]) - (0.13237498724480834)) <= 1e-06 * (1 + abs(0.13237498724480834)),
    abs((r.p_values[2]) - (0.61562188147792818)) <= 1e-06 * (1 + abs(0.61562188147792818))
FROM (SELECT negbinom_fit_agg(nb, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12, 'theta': 1.8294684732585813}) AS r FROM d2) s;
----
true	true	true	true	true	true

# MASS::glm.nb(nb ~ z1 + z2) at its ML theta: slope SE, z, p, Wald CI (b -/+ qnorm(.975)*se)
query IIII
SELECT
    abs((r.ci_lower[1]) - (-0.13445152937498089)) <= 1e-06 * (1 + abs(-0.13445152937498089)),
    abs((r.ci_lower[2]) - (-0.45413127986641522)) <= 1e-06 * (1 + abs(-0.45413127986641522)),
    abs((r.ci_upper[1]) - (1.0234666145037612)) <= 1e-06 * (1 + abs(1.0234666145037612)),
    abs((r.ci_upper[2]) - (0.7669147469201596)) <= 1e-06 * (1 + abs(0.7669147469201596))
FROM (SELECT negbinom_fit_agg(nb, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12, 'theta': 1.8294684732585813}) AS r FROM d2) s;
----
true	true	true	true

# MASS::glm.nb(nb ~ z1 + z2) at its ML theta: deviance, null deviance, pseudo R^2 = 1 - dev/null, AIC
query IIII
SELECT
    abs((r.deviance) - (35.659057534031305)) <= 1e-06 * (1 + abs(35.659057534031305)),
    abs((r.null_deviance) - (38.257742900599176)) <= 1e-06 * (1 + abs(38.257742900599176)),
    abs((r.pseudo_r_squared) - (0.067925736584088181)) <= 1e-06 * (1 + abs(0.067925736584088181)),
    abs((r.aic) - (151.08887012335052)) <= 1e-06 * (1 + abs(151.08887012335052))
FROM (SELECT negbinom_fit_agg(nb, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12, 'theta': 1.8294684732585813}) AS r FROM d2) s;
----
true	true	true	true

# negbinom dispersion field reports theta
query I
SELECT
    abs((r.dispersion) - (1.8294684732585813)) <= 1e-12 * (1 + abs(1.8294684732585813))
FROM (SELECT negbinom_fit_agg(nb, [z1, z2], {'theta': 1.8294684732585813}) AS r FROM d2) s;
----
true

# Without 'theta' the extension estimates theta by maximum likelihood, alternating
# IRLS with MASS::theta.ml as MASS::glm.nb does.
# negbinom default: ML theta and coefficients equal MASS::glm.nb
query IIII
SELECT
    abs((r.dispersion) - (1.8294684732585813)) <= 1e-05 * (1 + abs(1.8294684732585813)),
    abs((r.intercept) - (1.1413104675159913)) <= 1e-05 * (1 + abs(1.1413104675159913)),
    abs((r.coefficients[1]) - (0.44450755553098531)) <= 1e-05 * (1 + abs(0.44450755553098531)),
    abs((r.coefficients[2]) - (0.15639174208149006)) <= 1e-05 * (1 + abs(0.15639174208149006))
FROM (SELECT negbinom_fit_agg(nb, [z1, z2], {'tolerance': 1e-12}) AS r FROM d2) s;
----
true	true	true	true

# ---- Gamma (log link) ----
# SEs use the Pearson dispersion exactly like summary.glm. CONVENTIONS: (1) the
# extension reports normal (z) p-values where summary.glm uses t(n-p); the
# reference p = 2*pnorm(-|b/se|). (2) R's Gamma()$aic plugs in dispersion =
# deviance/n; the extension plugs in the Pearson dispersion. Reference AIC =
# -2*sum(dgamma(y, shape = 1/phi_P, rate = 1/(phi_P*mu), log = TRUE)) + 2*(p + 1).
# glm(gam ~ z1 + z2, family = Gamma(link = 'log')): coefficients
query III
SELECT
    abs((r.intercept) - (-0.36567360054686338)) <= 1e-06 * (1 + abs(-0.36567360054686338)),
    abs((r.coefficients[1]) - (0.32391556490928353)) <= 1e-06 * (1 + abs(0.32391556490928353)),
    abs((r.coefficients[2]) - (0.7706885758051405)) <= 1e-06 * (1 + abs(0.7706885758051405))
FROM (SELECT gamma_fit_agg(gam, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM d2) s;
----
true	true	true

# glm(gam ~ z1 + z2, family = Gamma(link = 'log')): slope SE, z, p, Wald CI (b -/+ qnorm(.975)*se)
query IIIIII
SELECT
    abs((r.std_errors[1]) - (0.20073566032917778)) <= 1e-06 * (1 + abs(0.20073566032917778)),
    abs((r.std_errors[2]) - (0.21473977951070894)) <= 1e-06 * (1 + abs(0.21473977951070894)),
    abs((r.z_values[1]) - (1.6136423611933641)) <= 1e-06 * (1 + abs(1.6136423611933641)),
    abs((r.z_values[2]) - (3.588941823267108)) <= 1e-06 * (1 + abs(3.588941823267108)),
    abs((r.p_values[1]) - (0.10660502282479895)) <= 1e-06 * (1 + abs(0.10660502282479895)),
    abs((r.p_values[2]) - (0.00033202291721577259)) <= 1e-06 * (1 + abs(0.00033202291721577259))
FROM (SELECT gamma_fit_agg(gam, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM d2) s;
----
true	true	true	true	true	true

# glm(gam ~ z1 + z2, family = Gamma(link = 'log')): slope SE, z, p, Wald CI (b -/+ qnorm(.975)*se)
query IIII
SELECT
    abs((r.ci_lower[1]) - (-0.069519099748770519)) <= 1e-06 * (1 + abs(-0.069519099748770519)),
    abs((r.ci_lower[2]) - (0.34980634191607884)) <= 1e-06 * (1 + abs(0.34980634191607884)),
    abs((r.ci_upper[1]) - (0.71735022956733752)) <= 1e-06 * (1 + abs(0.71735022956733752)),
    abs((r.ci_upper[2]) - (1.1915708096942021)) <= 1e-06 * (1 + abs(1.1915708096942021))
FROM (SELECT gamma_fit_agg(gam, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM d2) s;
----
true	true	true	true

# glm(gam ~ z1 + z2, family = Gamma(link = 'log')): deviance, null deviance, pseudo R^2 = 1 - dev/null, AIC
query IIII
SELECT
    abs((r.deviance) - (11.637173254838117)) <= 1e-06 * (1 + abs(11.637173254838117)),
    abs((r.null_deviance) - (18.575443413052398)) <= 1e-06 * (1 + abs(18.575443413052398)),
    abs((r.pseudo_r_squared) - (0.37351841374289718)) <= 1e-06 * (1 + abs(0.37351841374289718)),
    abs((r.aic) - (76.654252737139956)) <= 1e-06 * (1 + abs(76.654252737139956))
FROM (SELECT gamma_fit_agg(gam, [z1, z2], {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM d2) s;
----
true	true	true	true

# Gamma dispersion = Pearson chi^2 / df
query I
SELECT
    abs((r.dispersion) - (0.39168985667426931)) <= 1e-06 * (1 + abs(0.39168985667426931))
FROM (SELECT gamma_fit_agg(gam, [z1, z2], {'tolerance': 1e-12}) AS r FROM d2) s;
----
true

