# Gamma: anova.glm divides the deviance difference by the full model's Pearson
# dispersion (summary(g1)$dispersion), as upstream lr_test does.
# gamma: anova(glm(gam ~ z1, Gamma(log)), glm(gam ~ z1 + z2 + z3, Gamma(log)), test = 'LRT')
query III
SELECT
    abs((r.statistic) - (9.8938240751539297)) <= 1e-06 * (1 + abs(9.8938240751539297)),
    abs((r.df1) - (2)) <= 1e-06 * (1 + abs(2)),
    abs((r.p_value) - (0.0071053160364062239)) <= 1e-06 * (1 + abs(0.0071053160364062239))
FROM (SELECT lr_test(gamma_fit_agg(gam, [z1, z2, z3], {'tolerance': 1e-12, 'max_iterations': 100}), gamma_fit_agg(gam, [z1], {'tolerance': 1e-12, 'max_iterations': 100})) AS r FROM d) s;
----
true	true	true

# gamma: the dispersion used is summary(full)$dispersion
query I
SELECT
    abs((r.dispersion) - (0.40932472092035177)) <= 1e-06 * (1 + abs(0.40932472092035177))
FROM (SELECT lr_test(gamma_fit_agg(gam, [z1, z2, z3], {'tolerance': 1e-12, 'max_iterations': 100}), gamma_fit_agg(gam, [z1], {'tolerance': 1e-12, 'max_iterations': 100})) AS r FROM d) s;
----
true

