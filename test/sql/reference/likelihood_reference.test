# R fits use glm.control(epsilon = 1e-14); the extension runs with tolerance 1e-12.

# poisson: anova(glm(cnt ~ z1), glm(cnt ~ z1 + z2 + z3), test = 'LRT')
query III
SELECT
    abs((r.statistic) - (4.1151101571327295)) <= 1e-06 * (1 + abs(4.1151101571327295)),
    abs((r.df1) - (2)) <= 1e-06 * (1 + abs(2)),
    abs((r.p_value) - (0.1277659660852884)) <= 1e-06 * (1 + abs(0.1277659660852884))
FROM (SELECT lr_test(poisson_fit_agg(cnt, [z1, z2, z3], {'tolerance': 1e-12, 'max_iterations': 100}), poisson_fit_agg(cnt, [z1], {'tolerance': 1e-12, 'max_iterations': 100})) AS r FROM d) s;
----
true	true	true

