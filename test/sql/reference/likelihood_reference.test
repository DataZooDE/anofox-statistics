    abs((r.intercept_conf_high) - (0.18359013755773504)) <= 1e-05 * (1 + abs(0.18359013755773504)),
    abs((r.conf_low[1]) - (0.3679068125821654)) <= 1e-05 * (1 + abs(0.3679068125821654)),
    abs((r.conf_low[2]) - (0.095198727295135677)) <= 1e-05 * (1 + abs(0.095198727295135677)),
    abs((r.conf_high[1]) - (1.2509762285967929)) <= 1e-05 * (1 + abs(1.2509762285967929)),
    abs((r.conf_high[2]) - (0.99238301230028458)) <= 1e-05 * (1 + abs(0.99238301230028458))
FROM (SELECT poisson_fit_agg(cnt, [z1, z2, lexpo], {'tolerance': 1e-12, 'max_iterations': 100, 'profile_ci': true, 'offset': 3}) AS r FROM d) s;
----
true	true	true	true	true	true

# poisson at level 0.9: confint(..., level = 0.9)
query IIIII
SELECT
    abs((r.intercept_conf_low) - (-0.1200924952061693)) <= 1e-05 * (1 + abs(-0.1200924952061693)),
    abs((r.intercept_conf_high) - (0.76745249064017129)) <= 1e-05 * (1 + abs(0.76745249064017129)),
    abs((r.conf_low[1]) - (0.44230555640541408)) <= 1e-05 * (1 + abs(0.44230555640541408)),
    abs((r.conf_high[2]) - (0.81078478144272481)) <= 1e-05 * (1 + abs(0.81078478144272481)),
    abs((r.conf_level) - (0.90000000000000002)) <= 1e-05 * (1 + abs(0.90000000000000002))
FROM (SELECT poisson_fit_agg(cnt, [z1, z2], {'tolerance': 1e-12, 'max_iterations': 100, 'profile_ci': true, 'confidence_level': 0.9}) AS r FROM d) s;
----
true	true	true	true	true

# negbinom: confint(glm.nb) profiles at the fitted theta (dispersion 1).
# negbinom: confint(glm.nb(nb ~ z1 + z2))
query IIIIII
SELECT
    abs((r.intercept_conf_low) - (0.47946239670193191)) <= 0.0001 * (1 + abs(0.47946239670193191)),
    abs((r.intercept_conf_high) - (1.8265182888498634)) <= 0.0001 * (1 + abs(1.8265182888498634)),
    abs((r.conf_low[1]) - (-0.16958895036552005)) <= 0.0001 * (1 + abs(-0.16958895036552005)),
    abs((r.conf_low[2]) - (-0.45796945342894191)) <= 0.0001 * (1 + abs(-0.45796945342894191)),
    abs((r.conf_high[1]) - (1.0651162283646458)) <= 0.0001 * (1 + abs(1.0651162283646458)),
    abs((r.conf_high[2]) - (0.77577415711087772)) <= 0.0001 * (1 + abs(0.77577415711087772))
FROM (SELECT negbinom_fit_agg(nb, [z1, z2], {'tolerance': 1e-12, 'max_iterations': 100, 'profile_ci': true}) AS r FROM d) s;
----
true	true	true	true	true	true

