# kaplan_meier_by: one row per (stratum, time)
query IIII
SELECT count(*), count(DISTINCT series), min(curve_type), max(curve_type) FROM kaplan_meier_by('sv', arm, rt, ev);
----
17	2	km	km

# survfit(Surv(rt, ev) ~ arm), stratum a: time, n.censor, n.risk
query IIIIII
SELECT
    abs((r[1].x) - (2)) <= 0 * (1 + abs(2)),
    abs((r[2].x) - (3)) <= 0 * (1 + abs(3)),
    abs((r[3].x) - (4)) <= 0 * (1 + abs(4)),
    abs((r[4].x) - (5)) <= 0 * (1 + abs(5)),
    abs((r[5].x) - (6)) <= 0 * (1 + abs(6)),
    abs((r[6].x) - (8)) <= 0 * (1 + abs(8))
FROM (SELECT list(struct_pack(x, y, y_low, y_high, n_censor, weight) ORDER BY x) AS r FROM kaplan_meier_by('sv', arm, rt, ev) WHERE series = 'a') s;
----
true	true	true	true	true	true

# survfit(Surv(rt, ev) ~ arm), stratum a: time, n.censor, n.risk
query IIIIII
SELECT
    abs((r[7].x) - (11)) <= 0 * (1 + abs(11)),
    abs((r[1].n_censor) - (0)) <= 0 * (1 + abs(0)),
    abs((r[2].n_censor) - (2)) <= 0 * (1 + abs(2)),
    abs((r[3].n_censor) - (1)) <= 0 * (1 + abs(1)),
    abs((r[4].n_censor) - (2)) <= 0 * (1 + abs(2)),
    abs((r[5].n_censor) - (0)) <= 0 * (1 + abs(0))
FROM (SELECT list(struct_pack(x, y, y_low, y_high, n_censor, weight) ORDER BY x) AS r FROM kaplan_meier_by('sv', arm, rt, ev) WHERE series = 'a') s;
----
true	true	true	true	true	true

