# survdiff(Surv(rt, ev) ~ arm)
query IIII
SELECT
    abs((r.statistic) - (18.463465230783385)) <= 1e-10 * (1 + abs(18.463465230783385)),
    abs((r.df1) - (1)) <= 1e-10 * (1 + abs(1)),
    abs((r.p_value) - (1.7319277483717202e-05)) <= 1e-10 * (1 + abs(1.7319277483717202e-05)),
    abs((r.n) - (40)) <= 1e-10 * (1 + abs(40))
FROM (SELECT log_rank_test_agg(rt, ev, arm) AS r FROM sv) s;
----
true	true	true	true

# survdiff(Surv(time, ev) ~ g3)
query IIII
