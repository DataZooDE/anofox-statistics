true	true	true	true

# survdiff(Surv(rt, ev) ~ g3), BOOLEAN event, VARCHAR group
query IIII
SELECT
    abs((r.statistic) - (28.262220952737209)) <= 1e-10 * (1 + abs(28.262220952737209)),
    abs((r.df1) - (2)) <= 1e-10 * (1 + abs(2)),
    abs((r.p_value) - (7.2935119179212058e-07)) <= 1e-10 * (1 + abs(7.2935119179212058e-07)),
    abs((r.n) - (40)) <= 1e-10 * (1 + abs(40))
FROM (SELECT log_rank_test_agg(rt, ev = 1, g3::VARCHAR) AS r FROM sv) s;
----
true	true	true	true

# log_rank_test_agg method
query I
SELECT log_rank_test_agg(rt, ev, arm).method FROM sv;
----
Log-rank test

