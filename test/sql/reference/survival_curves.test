    abs((r[7].surv) - (0.2077292887384945)) <= 1e-06 * (1 + abs(0.2077292887384945)),
    abs((r[1].time) - (0.5)) <= 1e-06 * (1 + abs(0.5)),
    abs((r[2].time) - (1)) <= 1e-06 * (1 + abs(1)),
    abs((r[3].time) - (2.5)) <= 1e-06 * (1 + abs(2.5)),
    abs((r[4].time) - (4)) <= 1e-06 * (1 + abs(4)),
    abs((r[5].time) - (6)) <= 1e-06 * (1 + abs(6))
FROM (SELECT aft_survival(m, [1.7], [0.5, 1, 2.5, 4, 6, 9, 15]) AS r FROM (SELECT aft_fit_agg(time, [a1], ev, {'dist': 'lognormal'}) AS m FROM sv)) s;
----
true	true	true	true	true	true

