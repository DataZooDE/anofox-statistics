SELECT
    abs((r.intercept) - (1.3289411337143702)) <= 1e-06 * (1 + abs(1.3289411337143702)),
    abs((r.coefficients[1]) - (0.66915628247076819)) <= 1e-06 * (1 + abs(0.66915628247076819)),
    abs((r.scale) - (0.38255706067263073)) <= 1e-06 * (1 + abs(0.38255706067263073)),
    abs((r.log_likelihood) - (-64.97385090251089)) <= 1e-06 * (1 + abs(-64.97385090251089)),
    abs((r.null_log_likelihood) - (-76.88257923293817)) <= 1e-06 * (1 + abs(-76.88257923293817)),
    abs((r.aic) - (135.94770180502178)) <= 1e-06 * (1 + abs(135.94770180502178))
FROM (SELECT aft_fit_agg(time, [a1], ev, {'dist': 'weibull', 'compute_inference': true}) AS r FROM d3) s;
