# 'single' / 'average' stay aliases of ICC1 / ICC1k; the default is ICC1.
query III
SELECT icc_agg(rating, subject, rater, {'type': 'single'}) = icc_agg(rating, subject, rater, {'type': 'icc1'}),
       icc_agg(rating, subject, rater, {'type': 'average'}) = icc_agg(rating, subject, rater, {'type': 'icc1k'}),
       icc_agg(rating, subject, rater) = icc_agg(rating, subject, rater, {'type': 'ICC1'})
FROM sf;
----
true	true	true
