# psych::ICC(sw)$results['ICC1k', ]  (rater effect)
query IIIIIII
SELECT abs(r.icc - (0.821808988266539)) <= 1e-9 * (1 + abs(0.821808988266539)),
       abs(r.f_statistic - (5.61195534091139)) <= 1e-9 * (1 + abs(5.61195534091139)),
