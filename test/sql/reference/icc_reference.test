# name: test/sql/reference/icc_reference.test
# description: icc_agg, all six Shrout & Fleiss types, vs psych::ICC (#298)
# group: [reference]
#
# Generated by validation/generators/make_reference_icc.R (psych::ICC(x, lmer = FALSE);
# every ICC is also recomputed there from the two-way ANOVA mean squares in base R).
#
# Checked per type: icc, F (= statistic), p_value, ci_lower, ci_upper, method.
# ICC2 and ICC2k have no interval (NULL): upstream (anofox-statistics 0.7.0,
# correlation::icc) computes it with the plain F = MS_R / MS_E interval of
# ICC3 / ICC3k instead of the approximate-F interval of Shrout & Fleiss (1979) /
# McGraw & Wong (1996) that psych uses; for sf it is [0.342, 0.946] around
# ICC2 = 0.290. The point estimates, F and p of ICC2 / ICC2k match psych.

require anofox_statistics

# Shrout & Fleiss (1979), Table 4: 6 subjects x 4 judges.
statement ok
CREATE TABLE sf AS
SELECT s::BIGINT AS subject, r::BIGINT AS rater, v::DOUBLE AS rating
FROM (VALUES (1, 1, 9), (1, 2, 2), (1, 3, 5), (1, 4, 8),
             (2, 1, 6), (2, 2, 1), (2, 3, 3), (2, 4, 2),
             (3, 1, 8), (3, 2, 4), (3, 3, 6), (3, 4, 8),
             (4, 1, 7), (4, 2, 1), (4, 3, 2), (4, 4, 6),
             (5, 1, 10), (5, 2, 5), (5, 3, 6), (5, 4, 9),
             (6, 1, 6), (6, 2, 2), (6, 3, 4), (6, 4, 7)) t(s, r, v);

# 12 subjects x 3 raters with a systematic rater effect (ICC2 != ICC3).
statement ok
CREATE TABLE sw AS
SELECT s::BIGINT AS subject, rr::BIGINT AS rater, s * 0.2 + rr * 0.3 + sin(s * 7 + rr) AS rating
FROM range(12) a(s), range(3) b(rr);

# psych::ICC(sf)$results['ICC1', ]  (Shrout & Fleiss)
query IIIIIII
SELECT abs(r.icc - (0.165741768405476)) <= 1e-9 * (1 + abs(0.165741768405476)),
       abs(r.f_statistic - (1.79467849223947)) <= 1e-9 * (1 + abs(1.79467849223947)),
       abs(r.statistic - (1.79467849223947)) <= 1e-9 * (1 + abs(1.79467849223947)),
       abs(r.p_value - (0.16476880834464)) <= 1e-9 * (1 + abs(0.16476880834464)),
       abs(r.ci_lower - (-0.132932324874751)) <= 1e-9 * (1 + abs(-0.132932324874751)),
       abs(r.ci_upper - (0.722560062328121)) <= 1e-9 * (1 + abs(0.722560062328121)),
       r.method = 'ICC1'
FROM (SELECT icc_agg(rating, subject, rater, {'type': 'icc1'}) AS r FROM sf);
----
true	true	true	true	true	true	true

# psych::ICC(sf)$results['ICC2', ]  (Shrout & Fleiss)
query IIIIIII
SELECT abs(r.icc - (0.289763779527559)) <= 1e-9 * (1 + abs(0.289763779527559)),
       abs(r.f_statistic - (11.0272479564033)) <= 1e-9 * (1 + abs(11.0272479564033)),
       abs(r.statistic - (11.0272479564033)) <= 1e-9 * (1 + abs(11.0272479564033)),
       abs(r.p_value - (0.000134566516484337)) <= 1e-9 * (1 + abs(0.000134566516484337)),
       r.ci_lower IS NULL AND r.ci_upper IS NULL,
       r.conf_low IS NULL AND r.conf_high IS NULL,
       r.method = 'ICC2'
FROM (SELECT icc_agg(rating, subject, rater, {'type': 'icc2'}) AS r FROM sf);
----
true	true	true	true	true	true	true

# psych::ICC(sf)$results['ICC3', ]  (Shrout & Fleiss)
query IIIIIII
SELECT abs(r.icc - (0.714840714840715)) <= 1e-9 * (1 + abs(0.714840714840715)),
       abs(r.f_statistic - (11.0272479564033)) <= 1e-9 * (1 + abs(11.0272479564033)),
       abs(r.statistic - (11.0272479564033)) <= 1e-9 * (1 + abs(11.0272479564033)),
       abs(r.p_value - (0.000134566516484337)) <= 1e-9 * (1 + abs(0.000134566516484337)),
       abs(r.ci_lower - (0.342464765033925)) <= 1e-9 * (1 + abs(0.342464765033925)),
       abs(r.ci_upper - (0.94585825995536)) <= 1e-9 * (1 + abs(0.94585825995536)),
       r.method = 'ICC3'
FROM (SELECT icc_agg(rating, subject, rater, {'type': 'icc3'}) AS r FROM sf);
----
true	true	true	true	true	true	true

# psych::ICC(sf)$results['ICC1k', ]  (Shrout & Fleiss)
query IIIIIII
SELECT abs(r.icc - (0.442797133679269)) <= 1e-9 * (1 + abs(0.442797133679269)),
       abs(r.f_statistic - (1.79467849223947)) <= 1e-9 * (1 + abs(1.79467849223947)),
       abs(r.statistic - (1.79467849223947)) <= 1e-9 * (1 + abs(1.79467849223947)),
       abs(r.p_value - (0.16476880834464)) <= 1e-9 * (1 + abs(0.16476880834464)),
       abs(r.ci_lower - (-0.884442155238119)) <= 1e-9 * (1 + abs(-0.884442155238119)),
       abs(r.ci_upper - (0.912415420340776)) <= 1e-9 * (1 + abs(0.912415420340776)),
       r.method = 'ICC1k'
FROM (SELECT icc_agg(rating, subject, rater, {'type': 'icc1k'}) AS r FROM sf);
----
true	true	true	true	true	true	true

# psych::ICC(sf)$results['ICC2k', ]  (Shrout & Fleiss)
query IIIIIII
SELECT abs(r.icc - (0.620050547598989)) <= 1e-9 * (1 + abs(0.620050547598989)),
       abs(r.f_statistic - (11.0272479564033)) <= 1e-9 * (1 + abs(11.0272479564033)),
       abs(r.statistic - (11.0272479564033)) <= 1e-9 * (1 + abs(11.0272479564033)),
       abs(r.p_value - (0.000134566516484337)) <= 1e-9 * (1 + abs(0.000134566516484337)),
       r.ci_lower IS NULL AND r.ci_upper IS NULL,
       r.conf_low IS NULL AND r.conf_high IS NULL,
       r.method = 'ICC2k'
FROM (SELECT icc_agg(rating, subject, rater, {'type': 'icc2k'}) AS r FROM sf);
----
true	true	true	true	true	true	true

# psych::ICC(sf)$results['ICC3k', ]  (Shrout & Fleiss)
query IIIIIII
SELECT abs(r.icc - (0.909315542377069)) <= 1e-9 * (1 + abs(0.909315542377069)),
       abs(r.f_statistic - (11.0272479564033)) <= 1e-9 * (1 + abs(11.0272479564033)),
       abs(r.statistic - (11.0272479564033)) <= 1e-9 * (1 + abs(11.0272479564033)),
       abs(r.p_value - (0.000134566516484337)) <= 1e-9 * (1 + abs(0.000134566516484337)),
       abs(r.ci_lower - (0.675674713816305)) <= 1e-9 * (1 + abs(0.675674713816305)),
       abs(r.ci_upper - (0.985891678169062)) <= 1e-9 * (1 + abs(0.985891678169062)),
       r.method = 'ICC3k'
FROM (SELECT icc_agg(rating, subject, rater, {'type': 'icc3k'}) AS r FROM sf);
----
true	true	true	true	true	true	true

# psych::ICC(sw)$results['ICC1', ]  (rater effect)
query IIIIIII
SELECT abs(r.icc - (0.605883131778752)) <= 1e-9 * (1 + abs(0.605883131778752)),
       abs(r.f_statistic - (5.61195534091139)) <= 1e-9 * (1 + abs(5.61195534091139)),
       abs(r.statistic - (5.61195534091139)) <= 1e-9 * (1 + abs(5.61195534091139)),
       abs(r.p_value - (0.000207300628436097)) <= 1e-9 * (1 + abs(0.000207300628436097)),
       abs(r.ci_lower - (0.280526651399866)) <= 1e-9 * (1 + abs(0.280526651399866)),
       abs(r.ci_upper - (0.848515708853344)) <= 1e-9 * (1 + abs(0.848515708853344)),
       r.method = 'ICC1'
FROM (SELECT icc_agg(rating, subject, rater, {'type': 'icc1'}) AS r FROM sw);
----
true	true	true	true	true	true	true

# psych::ICC(sw)$results['ICC2', ]  (rater effect)
query IIIIIII
SELECT abs(r.icc - (0.610350006677217)) <= 1e-9 * (1 + abs(0.610350006677217)),
       abs(r.f_statistic - (6.14848463642426)) <= 1e-9 * (1 + abs(6.14848463642426)),
       abs(r.statistic - (6.14848463642426)) <= 1e-9 * (1 + abs(6.14848463642426)),
       abs(r.p_value - (0.000154382001402496)) <= 1e-9 * (1 + abs(0.000154382001402496)),
       r.ci_lower IS NULL AND r.ci_upper IS NULL,
       r.conf_low IS NULL AND r.conf_high IS NULL,
       r.method = 'ICC2'
FROM (SELECT icc_agg(rating, subject, rater, {'type': 'icc2'}) AS r FROM sw);
----
true	true	true	true	true	true	true

# psych::ICC(sw)$results['ICC3', ]  (rater effect)
query IIIIIII
SELECT abs(r.icc - (0.631833385732876)) <= 1e-9 * (1 + abs(0.631833385732876)),
       abs(r.f_statistic - (6.14848463642426)) <= 1e-9 * (1 + abs(6.14848463642426)),
