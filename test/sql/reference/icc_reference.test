query IIIIIII
SELECT abs(r.icc - (0.837358298974044)) <= 1e-9 * (1 + abs(0.837358298974044)),
       abs(r.f_statistic - (6.14848463642426)) <= 1e-9 * (1 + abs(6.14848463642426)),
