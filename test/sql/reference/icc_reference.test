# psych::ICC(sw)$results['ICC2k', ]  (rater effect)
query IIIIIII
SELECT abs(r.icc - (0.82453731211799)) <= 1e-9 * (1 + abs(0.82453731211799)),
       abs(r.f_statistic - (6.14848463642426)) <= 1e-9 * (1 + abs(6.14848463642426)),
