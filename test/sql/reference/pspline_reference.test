    abs((max(r.yhat_lower) FILTER (WHERE t = 64)) - (-0.29357727584235938)) <= 1e-5 * (1 + abs(-0.29357727584235938)),
    abs((max(r.yhat_upper) FILTER (WHERE t = 64)) - (2.6353540404278428)) <= 1e-5 * (1 + abs(2.6353540404278428)),
    abs((max(r.yhat) FILTER (WHERE t = 1)) - (0.711909656154876)) <= 1e-5 * (1 + abs(0.711909656154876)),
