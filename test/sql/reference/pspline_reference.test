FROM (SELECT unnest(l) AS r, unnest(ts) AS t FROM (SELECT pspline_fit_predict_agg(y, x, {'n_basis': 12, 'penalty_order': 3} ORDER BY t) AS l, list(t ORDER BY t) AS ts FROM p))
