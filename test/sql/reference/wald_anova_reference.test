# ols y ~ rcs(age, 4) + bp + sex + rcs(age, 4) %ia% sex, anova(f) (F test): row count and labels
query I
SELECT len(t) FROM (SELECT wald_anova(ols_fit_agg(y, [a1, a2, a3, a4, a5, a6, a7, a8], {'compute_inference': true}), ['age', 'age', 'age', 'bp', 'sex', 'age * sex', 'age * sex', 'age * sex'], {'nonlinear': [false, true, true, false, false, false, true, true], 'interactions': MAP {'age * sex': ['age', 'sex']}}) AS t FROM d) s;
----
13

query I
SELECT list_transform(t, lambda r: trim(r.label)) = ['age  (Factor+Higher Order Factors)', 'All Interactions', 'Nonlinear (Factor+Higher Order Factors)', 'bp', 'sex  (Factor+Higher Order Factors)', 'All Interactions', 'age * sex  (Factor+Higher Order Factors)', 'Nonlinear', 'Nonlinear Interaction : f(A,B) vs. AB', 'TOTAL NONLINEAR', 'TOTAL NONLINEAR + INTERACTION', 'TOTAL', 'ERROR'] FROM (SELECT wald_anova(ols_fit_agg(y, [a1, a2, a3, a4, a5, a6, a7, a8], {'compute_inference': true}), ['age', 'age', 'age', 'bp', 'sex', 'age * sex', 'age * sex', 'age * sex'], {'nonlinear': [false, true, true, false, false, false, true, true], 'interactions': MAP {'age * sex': ['age', 'sex']}}) AS t FROM d) s;
----
true

# ols y ~ rcs(age, 4) + bp + sex + rcs(age, 4) %ia% sex, anova(f) (F test): row 1 'age  (Factor+Higher Order Factors)'
query IIIIII
SELECT
    abs((t[1].df1) - (6)) <= 1e-08 * (1 + abs(6)),
    abs((t[1].statistic) - (19.764267288921932)) <= 1e-08 * (1 + abs(19.764267288921932)),
    abs((t[1].df2) - (71)) <= 1e-08 * (1 + abs(71)),
    abs((t[1].p_value) - (1.9939605522267811e-13)) <= 1e-08 * (1 + abs(1.9939605522267811e-13)),
    abs((t[1].partial_ss) - (103.71470606111285)) <= 1e-08 * (1 + abs(103.71470606111285)),
    abs((t[1].mean_sq) - (17.285784343518809)) <= 1e-08 * (1 + abs(17.285784343518809))
FROM (SELECT wald_anova(ols_fit_agg(y, [a1, a2, a3, a4, a5, a6, a7, a8], {'compute_inference': true}), ['age', 'age', 'age', 'bp', 'sex', 'age * sex', 'age * sex', 'age * sex'], {'nonlinear': [false, true, true, false, false, false, true, true], 'interactions': MAP {'age * sex': ['age', 'sex']}}) AS t FROM d) s;
----
true	true	true	true	true	true

