FROM (SELECT wald_anova(ols_fit_agg(y, [c1, c2, c3, c4, c5, c6], {'compute_inference': true}), ['age', 'age', 'sex', 'w', 'age * sex', 'age * sex'], {'nonlinear': [false, true, false, false, false, true], 'interactions': MAP {'age * sex': ['age', 'sex']}}) AS t FROM d) s;
