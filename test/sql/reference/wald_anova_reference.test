FROM (SELECT fastbw(logistic_fit_agg(yb, [g1, g2, g3, g4, g5, g6], {'compute_inference': true, 'tolerance': 1e-12, 'max_iterations': 100}), ['age', 'age', 'age', 'bp', 'sex', 'w'], {'rule': 'p', 'sls': 0.5}) AS b FROM d) s;
----
true	true	true	true	true	true

