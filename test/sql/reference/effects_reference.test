# ---- lrm(y ~ rcs(x1, 4) * x2 + g) ----

statement ok
CREATE TABLE fit_lrm AS SELECT logistic_fit_agg(yb, effects_design([x1, x2, g], s.t_int), {'compute_inference': true}) AS m, any_value(s.t_int) AS t FROM d, specs s;

# fit_lrm: coefficients
query I
SELECT max_rel_diff(list_prepend((m).intercept, (m).coefficients), [-1.0666925363148296, 0.020641519377300226, -0.11438700744507758, 1.0794645850747091, 0.10416552026101936, 0.22428473397402515, -0.12430878095990873, 0.006546138674321595, 0.010675071120728742, -0.12967727774794474]) < 1e-6 FROM fit_lrm;
----
true

# fit_lrm: summary(fit) rows x1, x2, g - 1:2, g - 3:2
query I
SELECT array_to_string(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.label), '|') FROM d, fit_lrm;
----
x1|x2|g - 1:2|g - 3:2

# fit_lrm: summary Low
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.low), [42.857499999999995, 3, 2, 2]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: summary High
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.high), [56.899999999999999, 7.7999999999999998, 1, 3]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: summary Diff.
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.diff), [14.042500000000004, 4.7999999999999998, NULL, NULL]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: summary Effect
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.estimate), [0.7122882405196882, 2.1613162503936261, -0.22428473397402515, -0.34859351493393387]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: summary S.E.
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.std_error), [0.66084247249424, 0.47874673455583999, 0.44428132823279698, 0.43560116829638956]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: summary Lower 0.95
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.conf_low), [-0.58293920502342322, 1.2229898929480225, -1.0950601363139252, -1.202356116418428]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: summary Upper 0.95
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.conf_high), [2.0075156860627996, 3.0996426078392298, 0.64649066836587499, 0.50516908655056025]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: summary odds ratio
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.ratio), [2.0386508489600059, 8.6825585615547816, 0.79908757459319479, 0.70567992032710358]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: summary odds ratio lower
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.ratio_low), [0.55825512656640197, 3.3973302172541695, 0.33451948957468214, 0.3004853986355816]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: summary odds ratio upper
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.ratio_high), [7.4447991360649031, 22.190019325162414, 1.908830342534285, 1.6572657181149937]) < 1e-6 FROM d, fit_lrm;
----
true

# fit_lrm: contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 2}, {'x1': 45, 'x2': 2})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [1.198159704701012, 0.63108410131392789, -0.038742405090113063, 2.435061814492137, 0.057620543365792115]) < 1e-6 FROM (SELECT contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 2}, {'x1': 45, 'x2': 2}) AS c FROM d, fit_lrm);
----
true

# fit_lrm: double_contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 8}, {'x1': 45, 'x2': 8}, {'x1': 60, 'x2': 2}, {'x1': 45, 'x2': 2})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [-0.41948494315384277, 1.2221840376889959, -2.8149216395040182, 1.9759517531963326, 0.73142868956922547]) < 1e-6 FROM (SELECT double_contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 8}, {'x1': 45, 'x2': 8}, {'x1': 60, 'x2': 2}, {'x1': 45, 'x2': 2}) AS c FROM d, fit_lrm);
----
true

# fit_lrm: contrast_agg([x1, x2, g], m, t, MAP {'g': 3}, MAP {'g': 2})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [-0.34859351493393387, 0.43560116829638962, -1.2023561164184282, 0.50516908655056036, 0.42356107218130534]) < 1e-6 FROM (SELECT contrast_agg([x1, x2, g], m, t, MAP {'g': 3}, MAP {'g': 2}) AS c FROM d, fit_lrm);
----
true

# fit_lrm: contrast_agg([x1, x2, g], m, t, {'x1': 55, 'x2': 5, 'g': 1}, {'x1': 40, 'x2': 3, 'g': 3}, {'level': 0.9})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [1.498615968337035, 0.74055994032612293, 0.28050326451664631, 2.7167286721574238, 0.043008700809696584]) < 1e-6 FROM (SELECT contrast_agg([x1, x2, g], m, t, {'x1': 55, 'x2': 5, 'g': 1}, {'x1': 40, 'x2': 3, 'g': 3}, {'level': 0.9}) AS c FROM d, fit_lrm);
----
true

