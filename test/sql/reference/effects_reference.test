# ---- ols with rcs(x1, 4) %ia% rcs(x2, 3) ----

statement ok
CREATE TABLE fit_ia AS SELECT ols_fit_agg(yc, effects_design([x1, x2, g], s.t_ia), {'compute_inference': true}) AS m, any_value(s.t_ia) AS t FROM d, specs s;

# fit_ia: coefficients
query I
SELECT max_rel_diff(list_prepend((m).intercept, (m).coefficients), [-0.76399452363023279, 0.024454532525853629, -0.043355881506024554, 0.31784236332270949, 0.22439016059399555, 0.022652996034483296, 0.40376505289997966, -0.34253594180076719, -0.0014510218937184192, 0.0014032895749901252, 0.030044821336022584, -0.10933846927022553]) < 1e-8 FROM fit_ia;
----
true

# fit_ia: summary Effect
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.estimate), [1.1634497634109144, 1.517054366216962, -0.40376505289997966, -0.74630099470074684]) < 1e-8 FROM d, fit_ia;
----
true

# fit_ia: summary S.E.
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.std_error), [0.18699245350875826, 0.13385795961600902, 0.14372814725811772, 0.1420747002267112]) < 1e-8 FROM d, fit_ia;
----
true

# fit_ia: summary Lower 0.95
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.conf_low), [0.79540463921444915, 1.2535904218324256, -0.68665584777189226, -1.0259374169677362]) < 1e-8 FROM d, fit_ia;
----
true

# fit_ia: contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 7}, {'x1': 45, 'x2': 2})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [2.8240291741304033, 0.20181433418999067, 2.4268111030380148, 3.2212472452227918, 2.6636879321703552e-34]) < 1e-8 FROM (SELECT contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 7}, {'x1': 45, 'x2': 2}) AS c FROM d, fit_ia);
----
true

