statement ok
CREATE TABLE specs AS SELECT [effects_term('x1', spline_spec('rcs', [33.916000000000004, 45.382999999999996, 53.603499999999997, 66.81750000000001])), effects_term('x2', 'linear'), effects_term('g', 'categorical', [1, 2, 3]), effects_interaction('x1', 'x2')] AS t_int, [effects_term('x1', spline_spec('rcs', [33.916000000000004, 45.382999999999996, 53.603499999999997, 66.81750000000001])), effects_term('x2', spline_spec('lsp', [3, 6])), effects_term('g', 'categorical', [1, 2, 3])] AS t_lsp, [effects_term('x1', spline_spec('rcs', [33.916000000000004, 45.382999999999996, 53.603499999999997, 66.81750000000001])), effects_term('x2', spline_spec('rcs', [1.2900000000000003, 5.5999999999999996, 9.110000000000003])), effects_term('g', 'categorical', [1, 2, 3]), effects_interaction('x1', 'x2', true)] AS t_ia, [effects_term('x1', spline_spec('rcs', [33.916000000000004, 45.382999999999996, 53.603499999999997, 66.81750000000001])), effects_term('x2', 'linear'), effects_term('g', 'categorical', [1, 2, 3])] AS t_main;

# ---- ols(y ~ rcs(x1, 4) * x2 + g) ----

statement ok
CREATE TABLE fit_ols AS SELECT ols_fit_agg(yc, effects_design([x1, x2, g], s.t_int), {'compute_inference': true}) AS m, any_value(s.t_int) AS t FROM d, specs s;

# fit_ols: coefficients
query I
SELECT max_rel_diff(list_prepend((m).intercept, (m).coefficients), [-0.74569998154988559, 0.020465298542043216, -0.044077361859960827, 0.32733935032939054, 0.23205318400245922, 0.39229504318666264, -0.34992811473254953, -0.00010928186934837005, 0.030019416943782972, -0.11032356962355527]) < 1e-8 FROM fit_ols;
----
true

# fit_ols: summary(fit) rows x1, x2, g - 1:2, g - 3:2
query I
SELECT array_to_string(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.label), '|') FROM d, fit_ols;
----
x1|x2|g - 1:2|g - 3:2

# fit_ols: summary Low
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.low), [42.857499999999995, 3, 2, 2]) < 1e-8 FROM d, fit_ols;
----
true

# fit_ols: summary High
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.high), [56.899999999999999, 7.7999999999999998, 1, 3]) < 1e-8 FROM d, fit_ols;
----
true

# fit_ols: summary Diff.
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.diff), [14.042500000000004, 4.7999999999999998, NULL, NULL]) < 1e-8 FROM d, fit_ols;
----
true

# fit_ols: summary Effect
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.estimate), [1.1835004047551161, 1.4991629870181364, -0.39229504318666264, -0.74222315791921223]) < 1e-8 FROM d, fit_ols;
----
true

# fit_ols: summary S.E.
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.std_error), [0.15779961996191802, 0.13323739693964151, 0.14351409981228574, 0.14193510670825768]) < 1e-8 FROM d, fit_ols;
----
true

# fit_ols: summary Lower 0.95
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.conf_low), [0.87292268068539935, 1.236928087387366, -0.67475632225926463, -1.0215766976658947]) < 1e-8 FROM d, fit_ols;
----
true

# fit_ols: summary Upper 0.95
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.conf_high), [1.4940781288248328, 1.7613978866489068, -0.10983376411406065, -0.46286961817252981]) < 1e-8 FROM d, fit_ols;
----
true

# fit_ols: contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 2}, {'x1': 45, 'x2': 2})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [0.80165403038629723, 0.23209684978853273, 0.34484614080792209, 1.2584619199646725, 0.00063483995206967863]) < 1e-8 FROM (SELECT contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 2}, {'x1': 45, 'x2': 2}) AS c FROM d, fit_ols);
----
true

# fit_ols: double_contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 8}, {'x1': 45, 'x2': 8}, {'x1': 60, 'x2': 2}, {'x1': 45, 'x2': 2})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [0.95794064018106995, 0.3201690663493183, 0.32779096068060765, 1.5880903196815321, 0.0030099485685645428]) < 1e-8 FROM (SELECT double_contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 8}, {'x1': 45, 'x2': 8}, {'x1': 60, 'x2': 2}, {'x1': 45, 'x2': 2}) AS c FROM d, fit_ols);
----
true

# fit_ols: contrast_agg([x1, x2, g], m, t, MAP {'g': 3}, MAP {'g': 2})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [-0.74222315791921223, 0.14193510670825768, -1.0215766976658947, -0.46286961817252981, 3.2629482119167912e-07]) < 1e-8 FROM (SELECT contrast_agg([x1, x2, g], m, t, MAP {'g': 3}, MAP {'g': 2}) AS c FROM d, fit_ols);
----
true

# fit_ols: contrast_agg([x1, x2, g], m, t, {'x1': 55, 'x2': 5, 'g': 1}, {'x1': 40, 'x2': 3, 'g': 3}, {'level': 0.9})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [1.8284221023549114, 0.23880789677903394, 1.4343592382165888, 2.222484966493234, 2.8630784182671827e-13]) < 1e-8 FROM (SELECT contrast_agg([x1, x2, g], m, t, {'x1': 55, 'x2': 5, 'g': 1}, {'x1': 40, 'x2': 3, 'g': 3}, {'level': 0.9}) AS c FROM d, fit_ols);
----
true

