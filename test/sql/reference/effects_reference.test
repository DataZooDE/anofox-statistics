# ---- ols with lsp(x2, c(3, 6)) ----

statement ok
CREATE TABLE fit_lsp AS SELECT ols_fit_agg(yc, effects_design([x1, x2, g], s.t_lsp), {'compute_inference': true}) AS m, any_value(s.t_lsp) AS t FROM d, specs s;

# fit_lsp: coefficients
query I
SELECT max_rel_diff(list_prepend((m).intercept, (m).coefficients), [-1.2056568982793883, 0.02185409634076714, 0.1089719897092005, -0.23078068806604365, 0.30491966046378288, -0.050956708516731487, 0.16458214437268259, 0.36199584920668226, -0.39446757472141414]) < 1e-8 FROM fit_lsp;
----
true

# fit_lsp: summary Effect
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.estimate), [1.1349059567365407, 1.5152700292166752, -0.36199584920668226, -0.7564634239280964]) < 1e-8 FROM d, fit_lsp;
----
true

# fit_lsp: summary S.E.
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.std_error), [0.15992820646593942, 0.18607759745209518, 0.14640061831357098, 0.14427320205651417]) < 1e-8 FROM d, fit_lsp;
----
true

# fit_lsp: summary Lower 0.95
query I
SELECT max_rel_diff(list_transform(effects_summary_agg([x1, x2, g], m, t), lambda r: r.conf_low), [0.82014332846895155, 1.149041488735832, -0.6501341608821396, -1.0404146622455279]) < 1e-8 FROM d, fit_lsp;
----
true

# fit_lsp: contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 7}, {'x1': 45, 'x2': 2})
query I
SELECT max_rel_diff([c.estimate, c.std_error, c.conf_low, c.conf_high, c.p_value], [2.8217065389012403, 0.21368620284086537, 2.4011401340310856, 3.2422729437713951, 1.6299204474830627e-31]) < 1e-8 FROM (SELECT contrast_agg([x1, x2, g], m, t, {'x1': 60, 'x2': 7}, {'x1': 45, 'x2': 2}) AS c FROM d, fit_lsp);
----
true

