CREATE MACRO max_rel_diff(a, b) AS CASE WHEN len(a) = len(b) THEN coalesce(list_max(list_transform(range(1, len(a) + 1), lambda i: abs(a[i] - b[i]) / greatest(1, abs(b[i])))), 0) ELSE 1e300 END;

