# fit_lrm: Predict(fit, x2)$x2 (simultaneous)
query I
SELECT max_rel_diff(list_transform(predict_grid_agg([x1, x2, g], m, t, 'x2', {'values': [0, 2.5, 5, 7.5, 10]}), lambda r: r.x), [0, 2.5, 5, 7.5, 10]) < 1e-6 FROM d, fit_lrm;
----
true

