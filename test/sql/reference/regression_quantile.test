# tau = 0.37: check loss sum(rho_tau(y - fitted(rq))) = 14.745705371901
query I
SELECT sum((p.y - p.yhat) * (0.37 - CASE WHEN p.y - p.yhat < 0 THEN 1 ELSE 0 END)) <= 14.745705371900826 + 1e-4
FROM (SELECT UNNEST(quantile_fit_predict_agg(y, [x1, x2], {'tau': 0.37})) AS p FROM d1) s;
----
true

