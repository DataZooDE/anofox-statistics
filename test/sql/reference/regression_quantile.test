# tau = 0.37, row 9: fitted(rq(y ~ x1 + x2, tau = 0.37))[9]
query I
SELECT
    abs((r.yhat) - (5.1740495867768601)) <= 0.0001 * (1 + abs(5.1740495867768601))
FROM (SELECT quantile_fit_predict_agg(y, [x1, x2], {'tau': 0.37} ORDER BY id)[9] AS r FROM d1) s;
