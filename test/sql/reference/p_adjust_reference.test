# The p-values of each family, once.
statement ok
CREATE TABLE results AS SELECT DISTINCT endpoint, id, p FROM ref;

# Adjusted values compared with R: NULL must stay NULL, the rest within 1e-14.
statement ok
CREATE MACRO padj_matches(got, want) AS
    CASE WHEN want IS NULL THEN got IS NULL ELSE coalesce(abs(got - want) <= 1e-14 * (1 + abs(want)), false) END;

foreach method holm hochberg hommel bonferroni BH BY none

# p_adjust_agg: one list per family in ORDER BY order, unnested next to the ids.
query I
WITH adj AS (
    SELECT endpoint,
           UNNEST(list(id ORDER BY id)) AS id,
           UNNEST(p_adjust_agg(p, '${method}' ORDER BY id)) AS got
    FROM results GROUP BY endpoint
)
SELECT count(*) FILTER (WHERE NOT padj_matches(got, expected)) || ' mismatches of ' || count(*)
FROM adj JOIN ref USING (endpoint, id)
WHERE ref.method = '${method}' AND ref.n IS NULL;
----
0 mismatches of 14

query I
WITH adj AS (
    SELECT endpoint,
           UNNEST(list(id ORDER BY id)) AS id,
           UNNEST(p_adjust_agg(p, '${method}', 15 ORDER BY id)) AS got
    FROM results GROUP BY endpoint
)
SELECT count(*) FILTER (WHERE NOT padj_matches(got, expected)) || ' mismatches of ' || count(*)
FROM adj JOIN ref USING (endpoint, id)
WHERE ref.method = '${method}' AND ref.n = 15;
----
0 mismatches of 14

# p_adjust_list on the list of each family.
query I
WITH adj AS (
    SELECT endpoint,
           UNNEST(list(id ORDER BY id)) AS id,
           UNNEST(p_adjust_list(list(p ORDER BY id), '${method}')) AS got,
           UNNEST(p_adjust_list(list(p ORDER BY id), '${method}', 15)) AS got15
    FROM results GROUP BY endpoint
)
SELECT count(*) FILTER (WHERE NOT padj_matches(CASE WHEN ref.n IS NULL THEN got ELSE got15 END, expected))
       || ' mismatches of ' || count(*)
FROM adj JOIN ref USING (endpoint, id)
WHERE ref.method = '${method}';
----
0 mismatches of 28

# p_adjust_by: every row of every family, aligned to its own row.
query I
SELECT count(*) FILTER (WHERE NOT padj_matches(a.p_adjusted, ref.expected)) || ' mismatches of ' || count(*)
FROM p_adjust_by('results', endpoint, p, method := '${method}') a
JOIN ref USING (endpoint, id)
WHERE ref.method = '${method}' AND ref.n IS NULL;
----
0 mismatches of 14

query I
SELECT count(*) FILTER (WHERE NOT padj_matches(a.p_adjusted, ref.expected)) || ' mismatches of ' || count(*)
FROM p_adjust_by('results', endpoint, p, method := '${method}', n := 15) a
JOIN ref USING (endpoint, id)
WHERE ref.method = '${method}' AND ref.n = 15;
----
0 mismatches of 14

endloop

# ---------------------------------------------------------------------------
# Row-aligned recipe with plain window functions (docs: hypothesis.md, "Multiple
# Testing"): Bonferroni, Holm and BH must equal R and p_adjust_by.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE recipe AS
WITH ranked AS (
    SELECT *,
           count(p) OVER (PARTITION BY endpoint) AS n_tests,
           row_number() OVER (PARTITION BY endpoint ORDER BY p NULLS LAST) AS i
    FROM results
)
SELECT *,
       CASE WHEN p IS NOT NULL THEN least(1, n_tests * p) END AS p_bonferroni,
       CASE WHEN p IS NOT NULL THEN
           max(least(1, (n_tests - i + 1) * p)) OVER (PARTITION BY endpoint ORDER BY p NULLS LAST) END AS p_holm,
       CASE WHEN p IS NOT NULL THEN
           min(least(1, n_tests * p / i)) OVER (PARTITION BY endpoint ORDER BY p DESC NULLS LAST) END AS p_bh
FROM ranked;

statement ok
CREATE TABLE recipe_long AS
SELECT endpoint, id, 'bonferroni' AS method, p_bonferroni AS got FROM recipe
UNION ALL SELECT endpoint, id, 'holm', p_holm FROM recipe
UNION ALL SELECT endpoint, id, 'BH', p_bh FROM recipe;

query II
SELECT method, count(*) FILTER (WHERE NOT padj_matches(got, expected)) || ' mismatches of ' || count(*)
FROM recipe_long JOIN ref USING (endpoint, id, method)
WHERE ref.n IS NULL
GROUP BY method ORDER BY method;
----
BH	0 mismatches of 14
bonferroni	0 mismatches of 14
holm	0 mismatches of 14

foreach method bonferroni holm BH

query I
SELECT count(*) FILTER (WHERE NOT padj_matches(r.got, a.p_adjusted)) || ' mismatches of ' || count(*)
FROM recipe_long r
JOIN p_adjust_by('results', endpoint, p, method := '${method}') a USING (endpoint, id)
WHERE r.method = '${method}';
----
0 mismatches of 14

endloop

# ---------------------------------------------------------------------------
# Semantics
# ---------------------------------------------------------------------------

# Default method is holm; names are case-insensitive and fdr is BH.
query I
SELECT p_adjust_list([0.01, 0.02, 0.03]) = p_adjust_list([0.01, 0.02, 0.03], 'HOLM')
   AND p_adjust_list([0.01, 0.02, 0.03], 'fdr') = p_adjust_list([0.01, 0.02, 0.03], 'bh')
   AND p_adjust_list([0.01, 0.02, 0.03], 'Fdr') = p_adjust_list([0.01, 0.02, 0.03], 'BH');
----
true

# R: p.adjust(c(0.01, 0.02, 0.03), "holm") = 0.03 0.04 0.04; BH = 0.03 0.03 0.03
query II
SELECT p_adjust_list([0.01, 0.02, 0.03]), p_adjust_list([0.01, 0.02, 0.03], 'BH');
----
[0.03, 0.04, 0.04]	[0.03, 0.03, 0.03]

# NULL elements stay NULL and are not counted; NULL method / n mean the defaults
# (holm, n = 2). R: p.adjust(c(0.01, NA, 0.02), "bonferroni") = 0.02 NA 0.04; holm = 0.02 NA 0.02
query II
SELECT p_adjust_list([0.01, NULL, 0.02], 'bonferroni'), p_adjust_list([0.01, NULL, 0.02], NULL, NULL);
----
[0.02, NULL, 0.04]	[0.02, NULL, 0.02]

# A single p-value is returned unchanged unless n > 1 (R: p.adjust(0.3, "bonferroni", n = 2) = 0.6).
query III
SELECT p_adjust_list([0.3], 'bonferroni'), p_adjust_list([0.3], 'bonferroni', 2), p_adjust_list([0.3], 'bonferroni', 1);
----
[0.3]	[0.6]	[0.3]

# Empty and NULL lists; all-NULL lists.
query III
SELECT p_adjust_list([]::DOUBLE[]), p_adjust_list(NULL::DOUBLE[]), p_adjust_list([NULL, NULL]::DOUBLE[], 'hommel', 5);
----
[]	NULL	[NULL, NULL]

# p and 1 - p clamp at 1.
query I
SELECT p_adjust_list([0.0, 1.0, 0.5], 'bonferroni');
----
[0.0, 1.0, 1.0]

# Per-row method and n in the list form.
query II
SELECT m, p_adjust_list([0.01, 0.02], m, k) FROM (VALUES ('none', 2), ('bonferroni', 4), ('holm', NULL)) t(m, k) ORDER BY m;
----
bonferroni	[0.04, 0.08]
holm	[0.02, 0.02]
none	[0.01, 0.02]

# The aggregate keeps NULL rows in place; no rows give NULL.
query I
SELECT p_adjust_agg(p, 'bonferroni' ORDER BY i) FROM (VALUES (1, 0.01), (2, NULL), (3, 0.02)) t(i, p);
----
[0.02, NULL, 0.04]

query I
SELECT p_adjust_agg(p) FROM (SELECT 0.5::DOUBLE AS p WHERE false);
----
NULL

# As a window aggregate the family list is available on every row.
query II
SELECT i, p_adjust_agg(p, 'bonferroni' ) OVER (PARTITION BY g ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
FROM (VALUES ('a', 1, 0.01), ('a', 2, 0.02), ('b', 3, 0.2)) t(g, i, p) ORDER BY i;
----
1	[0.02, 0.04]
2	[0.02, 0.04]
3	[0.2]

# p_adjust_by keeps every source column and the source row order, NULL p included.
statement ok
CREATE TABLE fam AS SELECT * FROM (VALUES
    ('x', 'a', 0.04), ('y', 'a', 0.01), ('x', 'b', NULL), ('y', 'b', 0.03), ('x', 'c', 0.02)) t(endpoint, test, p_value);

query IIII
SELECT * FROM p_adjust_by('fam', endpoint, p_value, method := 'bonferroni');
----
x	a	0.04	0.08
y	a	0.01	0.02
x	b	NULL	NULL
y	b	0.03	0.06
x	c	0.02	0.04

# ---------------------------------------------------------------------------
# Errors
# ---------------------------------------------------------------------------

statement error
SELECT p_adjust_list([0.01, 0.02], 'nope');
----
unknown p-value adjustment method 'nope'

statement error
SELECT p_adjust_agg(p, 'nope') FROM (VALUES (0.01), (0.02)) t(p);
----
unknown p-value adjustment method 'nope'

statement error
SELECT * FROM p_adjust_by('fam', endpoint, p_value, method := 'nope');
----
unknown p-value adjustment method 'nope'

# n may not be smaller than the number of non-NULL p-values (R: stopifnot(n >= lp)).
statement error
SELECT p_adjust_list([0.01, 0.02, NULL], 'holm', 1);
----
n (1) must be at least the number of non-missing p-values (2)

statement error
SELECT p_adjust_agg(p, 'holm', 1) FROM (VALUES (0.01), (0.02)) t(p);
----
must be at least the number of non-missing p-values

statement error
SELECT p_adjust_list([0.01], 'holm', -1);
----
n must be non-negative

statement error
SELECT p_adjust_agg(p, m) FROM (VALUES (0.01, 'holm'), (0.02, 'BH')) t(p, m);
----
method must be a constant
