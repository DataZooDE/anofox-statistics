# name: test/sql/reference/p_adjust_reference.test
# description: #219 p_adjust_agg, p_adjust_list, p_adjust_by and the plain-window recipe vs R p.adjust (all methods, NULLs, ties, p = 0 / 1, a single p-value, n > count, several groups)
# group: [reference]
#
# R 4.6.1:
#   fam <- list(e1 = c(0.01, 0.04, 0.04, 0.0001, 0.2, 0.9, NA, 0.03, 0, 1),
#               e2 = c(0.02, 0.5, 0.013), e3 = c(0.3))
#   for each family e and method m in c("holm", "hochberg", "hommel", "bonferroni", "BH", "BY", "none"):
#     p.adjust(fam[[e]], m)          -> rows with n = NULL
#     p.adjust(fam[[e]], m, n = 15)  -> rows with n = 15
#   values printed with sprintf("%.17g"); id is the position in the family.

require anofox_statistics

statement ok
CREATE TABLE ref(endpoint VARCHAR, id INTEGER, method VARCHAR, n BIGINT, p DOUBLE, expected DOUBLE);

