true	true

# ---- offset ----
# 'offset': 2 adds x[2] = ln(ly) to the linear predictor with coefficient 1.
# poisson with offset: glmer(nc ~ q1 + offset(log(ly)) + (1|g), family = poisson, nAGQ = 0)
query IIIIII
SELECT
    abs((r.intercept) - (0.16255633014405899)) <= 0.0001 * (1 + abs(0.16255633014405899)),
    abs((r.coefficients[1]) - (-0.21934464568452955)) <= 0.0001 * (1 + abs(-0.21934464568452955)),
    abs((r.intercept_std_error) - (0.11408827158887794)) <= 0.0001 * (1 + abs(0.11408827158887794)),
    abs((r.std_errors[1]) - (0.15691482842324644)) <= 0.0001 * (1 + abs(0.15691482842324644)),
    abs((r.var_group) - (0.042351834460011228)) <= 0.0001 * (1 + abs(0.042351834460011228)),
    abs((r.log_likelihood) - (-118.29702122491946)) <= 0.0001 * (1 + abs(-118.29702122491946))
FROM (SELECT glmm_fit_agg(nc, [q1, ln(ly)], g, {'family': 'poisson', 'offset': 2, 'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

# ---- random slopes with crossed factors ----
# 'random' applies to the positional factor g, 'groups' adds h as a crossed
# random intercept: (1 + q1 | g) + (1 | h). random_cov is g's 2 x 2 covariance.
# crossed slopes: lmer(lc ~ q1 + (1 + q1|g) + (1|h), REML = TRUE): fixef, SEs, covariances, logLik, AIC
query IIIIII
SELECT
    abs((r.intercept) - (2.4935711918937939)) <= 0.0001 * (1 + abs(2.4935711918937939)),
    abs((r.coefficients[1]) - (0.62660122842978305)) <= 0.0001 * (1 + abs(0.62660122842978305)),
    abs((r.intercept_std_error) - (0.22602052310419773)) <= 0.0001 * (1 + abs(0.22602052310419773)),
    abs((r.std_errors[1]) - (0.33833240083810912)) <= 0.0001 * (1 + abs(0.33833240083810912)),
    abs((r.random_cov[1]) - (0.049857327135102658)) <= 0.0001 * (1 + abs(0.049857327135102658)),
    abs((r.random_cov[2]) - (0.15257648579012401)) <= 0.0001 * (1 + abs(0.15257648579012401))
FROM (SELECT glmm_fit_agg(lc, [q1, h], g, {'random': [1], 'groups': [2], 'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

# crossed slopes: lmer(lc ~ q1 + (1 + q1|g) + (1|h), REML = TRUE): fixef, SEs, covariances, logLik, AIC
query IIIII
SELECT
    abs((r.random_cov[4]) - (0.66478529312018697)) <= 0.0001 * (1 + abs(0.66478529312018697)),
    abs((r.factors[2].var) - (0.22760496899777558)) <= 0.0001 * (1 + abs(0.22760496899777558)),
    abs((r.var_residual) - (0.27176209519621142)) <= 0.0001 * (1 + abs(0.27176209519621142)),
    abs((r.log_likelihood) - (-50.797357387524187)) <= 0.0001 * (1 + abs(-50.797357387524187)),
    abs((r.aic) - (115.59471477504837)) <= 0.0001 * (1 + abs(115.59471477504837))
FROM (SELECT glmm_fit_agg(lc, [q1, h], g, {'random': [1], 'groups': [2], 'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true

