# ---- negative binomial ----
# theta estimated by maximising the profiled Laplace log-likelihood, as
# lme4::glmer.nb(nAGQ = 0); lme4 iterates theta.ml to ~1e-4, hence tolerance 1e-3.
# logLik df counts theta (fixed + variance + theta), so AIC = -2 logLik + 2 * 4.
# negbinom: glmer.nb(nc ~ q1 + (1|g), nAGQ = 0): fixef, SEs, var_group, theta, logLik, AIC
query IIIIII
SELECT
    abs((r.intercept) - (1.0704462809379378)) <= 0.001 * (1 + abs(1.0704462809379378)),
    abs((r.coefficients[1]) - (0.04737146260112738)) <= 0.001 * (1 + abs(0.04737146260112738)),
    abs((r.intercept_std_error) - (0.14346133034055056)) <= 0.001 * (1 + abs(0.14346133034055056)),
    abs((r.std_errors[1]) - (0.23221473123240474)) <= 0.001 * (1 + abs(0.23221473123240474)),
    abs((r.var_group) - (0.02503705491708243)) <= 0.001 * (1 + abs(0.02503705491708243)),
    abs((r.nb_theta) - (2.2668511206203368)) <= 0.001 * (1 + abs(2.2668511206203368))
FROM (SELECT glmm_fit_agg(nc, [q1], g, {'family': 'negbinom', 'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

# negbinom: glmer.nb(nc ~ q1 + (1|g), nAGQ = 0): fixef, SEs, var_group, theta, logLik, AIC
query II
SELECT
    abs((r.log_likelihood) - (-105.11261497578739)) <= 0.001 * (1 + abs(-105.11261497578739)),
