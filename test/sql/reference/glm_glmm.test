# gaussian, reml = TRUE: lmer(ly ~ q1 + (1|g), REML = TRUE): fixef, SEs, VarCorr, logLik, AIC, BIC
query IIIIII
SELECT
    abs((r.intercept) - (2.5024664635460252)) <= 1e-06 * (1 + abs(2.5024664635460252)),
    abs((r.coefficients[1]) - (0.59919186653533085)) <= 1e-06 * (1 + abs(0.59919186653533085)),
    abs((r.intercept_std_error) - (0.1230667649413117)) <= 1e-06 * (1 + abs(0.1230667649413117)),
    abs((r.std_errors[1]) - (0.12726636291370921)) <= 1e-06 * (1 + abs(0.12726636291370921)),
    abs((r.var_group) - (0.083504349942024284)) <= 1e-06 * (1 + abs(0.083504349942024284)),
    abs((r.var_residual) - (0.21094250445466003)) <= 1e-06 * (1 + abs(0.21094250445466003))
FROM (SELECT glmm_fit_agg(ly, [q1], g, {'compute_inference': true, 'reml': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

