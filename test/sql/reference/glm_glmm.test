# negbinom, theta fixed: glmer(nc ~ q1 + (1|g), family = negative.binomial(2), nAGQ = 0)
query IIIIII
SELECT
    abs((r.intercept) - (1.0740019557471889)) <= 0.0001 * (1 + abs(1.0740019557471889)),
    abs((r.coefficients[1]) - (0.052226583097377793)) <= 0.0001 * (1 + abs(0.052226583097377793)),
