# ---- Gamma (log link) ----
# var_residual = sigma(fit)^2 = pwrss / n; the fixed-effect SEs are scaled by sigma;
# the log-likelihood uses dispersion deviance / n (R's Gamma()$aic).
# gamma: glmer(ly ~ q1 + (1|g), family = Gamma(link = 'log'), nAGQ = 0)
query IIIIII
SELECT
    abs((r.intercept) - (0.90076681609804476)) <= 0.0001 * (1 + abs(0.90076681609804476)),
    abs((r.coefficients[1]) - (0.24228878630013337)) <= 0.0001 * (1 + abs(0.24228878630013337)),
    abs((r.intercept_std_error) - (0.041483087899962572)) <= 0.0001 * (1 + abs(0.041483087899962572)),
    abs((r.std_errors[1]) - (0.050113967884722305)) <= 0.0001 * (1 + abs(0.050113967884722305)),
    abs((r.var_group) - (0.23193421493633556)) <= 0.0001 * (1 + abs(0.23193421493633556)),
    abs((r.var_residual) - (0.033564456010688165)) <= 0.0001 * (1 + abs(0.033564456010688165))
FROM (SELECT glmm_fit_agg(ly, [q1], g, {'family': 'gamma', 'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

# gamma: glmer(ly ~ q1 + (1|g), family = Gamma(link = 'log'), nAGQ = 0)
query II
SELECT
    abs((r.log_likelihood) - (-35.705825986367564)) <= 0.0001 * (1 + abs(-35.705825986367564)),
    abs((r.aic) - (79.411651972735129)) <= 0.0001 * (1 + abs(79.411651972735129))
