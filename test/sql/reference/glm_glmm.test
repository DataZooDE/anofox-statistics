# binomial: logLik(glmer(..., nAGQ = 0)), AIC, BIC
query III
SELECT
    abs((r.log_likelihood) - (-29.686570244061588)) <= 0.005 * (1 + abs(-29.686570244061588)),
    abs((r.aic) - (65.37314048812317)) <= 0.005 * (1 + abs(65.37314048812317)),
