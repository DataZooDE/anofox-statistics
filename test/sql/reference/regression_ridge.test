true	true	true	true

# alpha = 0.5, lambda_scaling = 'glmnet': closed form with lambda = 0.5 * n
query IIII
SELECT
    abs((r.intercept) - (2.442836753564285)) <= 1e-09 * (1 + abs(2.442836753564285)),
    abs((r.coefficients[1]) - (0.69376994997310726)) <= 1e-09 * (1 + abs(0.69376994997310726)),
    abs((r.coefficients[2]) - (-0.56587644086894617)) <= 1e-09 * (1 + abs(-0.56587644086894617)),
    abs((r.r_squared) - (0.6378064839788673)) <= 1e-09 * (1 + abs(0.6378064839788673))
FROM (SELECT ridge_fit_agg(y, [x1, x2], {'alpha': 0.5, 'lambda_scaling': 'glmnet'}) AS r FROM d1) s;
----
true	true	true	true

# alpha = 0 reduces to OLS: coef(lm(y ~ x1 + x2))
query III
SELECT
    abs((r.intercept) - (2.5548105858837853)) <= 1e-09 * (1 + abs(2.5548105858837853)),
