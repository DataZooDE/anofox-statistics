    abs((r.intercept) - (2.5413678476987815)) <= 1e-09 * (1 + abs(2.5413678476987815)),
    abs((r.coefficients[1]) - (0.72390795804306529)) <= 1e-09 * (1 + abs(0.72390795804306529)),
    abs((r.coefficients[2]) - (-0.6143096522375856)) <= 1e-09 * (1 + abs(-0.6143096522375856)),
    abs((r.r_squared) - (0.64018568202701032)) <= 1e-09 * (1 + abs(0.64018568202701032))
FROM (SELECT ridge_fit_agg(y, [x1, x2], {'alpha': 1}) AS r FROM d1) s;
