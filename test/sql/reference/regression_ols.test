query III
SELECT
    abs((r.yhat) - (3.0902326270104887)) <= 1e-09 * (1 + abs(3.0902326270104887)),
    abs((r.yhat_lower) - (-1.6255385495487844)) <= 1e-09 * (1 + abs(-1.6255385495487844)),
    abs((r.yhat_upper) - (7.8060038035697623)) <= 1e-09 * (1 + abs(7.8060038035697623))
