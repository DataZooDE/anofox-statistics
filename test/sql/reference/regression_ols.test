# CONVENTION DIFFERENCE: without an intercept R's summary.lm reports the UNCENTERED
# R^2 = 1 - RSS/sum(y^2) (= 0.7757731896 here) and F on 2 and n-2 df. The extension always
# uses the centered TSS = sum((y - mean(y))^2) (and n-1 in adj. R^2). The values below are
# computed by hand with the extension's convention: 1 - RSS/TSS_c, 1-(1-R2)(n-1)/(n-2),
# ((TSS_c - RSS)/2) / (RSS/(n-2)).
# no intercept fit statistics (centered convention)
query III
SELECT
    abs((r.r_squared) - (0.59559510901138824)) <= 1e-09 * (1 + abs(0.59559510901138824)),
    abs((r.adj_r_squared) - (0.57312817062313204)) <= 1e-09 * (1 + abs(0.57312817062313204)),
    abs((r.f_statistic) - (13.254923717659594)) <= 1e-09 * (1 + abs(13.254923717659594))
FROM (SELECT ols_fit_agg(y, [x1, x2], {'compute_inference': true, 'intercept': false}) AS r FROM d1) s;
----
true	true	true

# Constant feature (rank deficient; was test/data/ols_tests/rank_deficient.json):
# R: coef(lm(y ~ x1 + I(rep(1, n)) + x2)) gives NA for the constant column; the
# extension reports NaN there and the R values for the identifiable coefficients.
# constant column aliased
query IIIIII
SELECT
    abs((r.intercept) - (2.5548105858837853)) <= 1e-09 * (1 + abs(2.5548105858837853)),
    abs((r.coefficients[1]) - (0.72736221632440101)) <= 1e-09 * (1 + abs(0.72736221632440101)),
    isnan(r.coefficients[2]),
    abs((r.coefficients[3]) - (-0.62027780809906041)) <= 1e-09 * (1 + abs(-0.62027780809906041)),
    abs((r.std_errors[1]) - (0.17694855358768863)) <= 1e-09 * (1 + abs(0.17694855358768863)),
    abs((r.std_errors[3]) - (0.24119105634503218)) <= 1e-09 * (1 + abs(0.24119105634503218))
FROM (SELECT ols_fit_agg(y, [x1, 1.0, x2], {'compute_inference': true}) AS r FROM d1) s;
----
true	true	true	true	true	true

# constant column aliased
query I
SELECT
    abs((r.r_squared) - (0.64021312047957835)) <= 1e-09 * (1 + abs(0.64021312047957835))
FROM (SELECT ols_fit_agg(y, [x1, 1.0, x2], {'compute_inference': true}) AS r FROM d1) s;
----
true

# Perfect collinearity x1, 2*x1 (was test/data/ols_tests/perfect_collinearity.json):
# R drops the aliased column (NA). The default SVD solver instead returns the
# minimum-norm split b1 = c/5, b2 = 2c/5 of the identifiable combination
# c = b1 + 2*b2 (= coef(lm(y ~ x1 + x2))['x1']); fitted values, R^2 and sigma are
# identical. We assert the identifiable quantities only.
# collinear pair: identifiable combination and fit statistics
query IIIII
SELECT
    abs((r.intercept) - (2.5548105858837853)) <= 1e-09 * (1 + abs(2.5548105858837853)),
    abs((r.coefficients[1] + 2 * r.coefficients[2]) - (0.72736221632440101)) <= 1e-09 * (1 + abs(0.72736221632440101)),
    abs((r.coefficients[3]) - (-0.62027780809906041)) <= 1e-09 * (1 + abs(-0.62027780809906041)),
    abs((r.r_squared) - (0.64021312047957835)) <= 1e-09 * (1 + abs(0.64021312047957835)),
    abs((r.residual_std_error) - (2.1809738871513558)) <= 1e-09 * (1 + abs(2.1809738871513558))
FROM (SELECT ols_fit_agg(y, [x1, 2 * x1, x2]) AS r FROM d1) s;
----
true	true	true	true	true

# ---- ols_fit_predict_agg: prediction intervals ----
# Rows with y IS NULL are prediction rows. Expected: R predict.lm(fit, newdata,
# interval = 'prediction'), i.e. yhat -/+ qt(1-a/2, n-p) * sigma * sqrt(1 + x0'(X'X)^-1 x0)
# (leverage-aware), for training rows and new rows alike.
statement ok
CREATE TABLE d1p AS SELECT id, y, x1, x2 FROM d1 UNION ALL SELECT * FROM (VALUES (21, NULL, 5.0, 5.0), (22, NULL, 12.0, 0.5), (23, NULL, 0.0, 10.0)) t(id, y, x1, x2);

# row 1: predict.lm(interval='prediction')[1, ] (training row)
query III
SELECT
    abs((r.yhat) - (4.2517893090042325)) <= 1e-09 * (1 + abs(4.2517893090042325)),
    abs((r.yhat_lower) - (-0.48956637155243765)) <= 1e-09 * (1 + abs(-0.48956637155243765)),
    abs((r.yhat_upper) - (8.9931449895609035)) <= 1e-09 * (1 + abs(8.9931449895609035))
FROM (SELECT ols_fit_predict_agg(y, [x1, x2] ORDER BY id)[1] AS r FROM d1p) s;
----
true	true	true

# row 7: predict.lm(interval='prediction')[7, ] (training row)
query III
SELECT
    abs((r.yhat) - (-0.13743483922992361)) <= 1e-09 * (1 + abs(-0.13743483922992361)),
    abs((r.yhat_lower) - (-5.3270352288218783)) <= 1e-09 * (1 + abs(-5.3270352288218783)),
    abs((r.yhat_upper) - (5.0521655503620311)) <= 1e-09 * (1 + abs(5.0521655503620311))
FROM (SELECT ols_fit_predict_agg(y, [x1, x2] ORDER BY id)[7] AS r FROM d1p) s;
----
true	true	true

