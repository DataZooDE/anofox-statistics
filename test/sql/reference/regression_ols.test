true	true	true

# row 22: predict.lm(interval='prediction')[22, ] (new row)
query III
SELECT
    abs((r.yhat) - (10.973018277727068)) <= 1e-09 * (1 + abs(10.973018277727068)),
    abs((r.yhat_lower) - (5.3422941493313481)) <= 1e-09 * (1 + abs(5.3422941493313481)),
    abs((r.yhat_upper) - (16.603742406122787)) <= 1e-09 * (1 + abs(16.603742406122787))
