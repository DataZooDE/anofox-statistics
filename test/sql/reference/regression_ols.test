# coefficients: coef(lm(y ~ x1 + x2))
query III
SELECT
    abs((r.intercept) - (2.5548105858837853)) <= 1e-10 * (1 + abs(2.5548105858837853)),
    abs((r.coefficients[1]) - (0.72736221632440101)) <= 1e-10 * (1 + abs(0.72736221632440101)),
    abs((r.coefficients[2]) - (-0.62027780809906041)) <= 1e-10 * (1 + abs(-0.62027780809906041))
FROM (SELECT ols_fit_agg(y, [x1, x2], {'compute_inference': true}) AS r FROM d1) s;
----
true	true	true

# fit statistics: summary(lm)$r.squared, $adj.r.squared, $sigma, $fstatistic, pf(F, 2, 17, lower.tail=FALSE)
query IIIII
