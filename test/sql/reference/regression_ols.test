# row 22 at 90%: predict.lm(interval='prediction', level=0.90)[22, ]
query III
SELECT
    abs((r.yhat) - (10.973018277727068)) <= 1e-09 * (1 + abs(10.973018277727068)),
    abs((r.yhat_lower) - (6.3303160105982688)) <= 1e-09 * (1 + abs(6.3303160105982688)),
    abs((r.yhat_upper) - (15.615720544855867)) <= 1e-09 * (1 + abs(15.615720544855867))
FROM (SELECT ols_fit_predict_agg(y, [x1, x2], {'confidence_level': 0.90} ORDER BY id)[22] AS r FROM d1p) s;
