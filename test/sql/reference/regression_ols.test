    abs((r.yhat) - (6.833722237053875)) <= 1e-09 * (1 + abs(6.833722237053875)),
    abs((r.yhat_lower) - (1.8802753027572896)) <= 1e-09 * (1 + abs(1.8802753027572896)),
    abs((r.yhat_upper) - (11.78716917135046)) <= 1e-09 * (1 + abs(11.78716917135046))
FROM (SELECT ols_fit_predict_agg(y, [x1, x2] ORDER BY id)[20] AS r FROM d1p) s;
