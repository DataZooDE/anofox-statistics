    abs((r.yhat) - (-3.6479674951068186)) <= 1e-09 * (1 + abs(-3.6479674951068186)),
    abs((r.yhat_lower) - (-9.0904132080855469)) <= 1e-09 * (1 + abs(-9.0904132080855469)),
