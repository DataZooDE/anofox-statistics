    abs((r.conf_high[1]) - (0.81154151272317088)) <= 1e-09 * (1 + abs(0.81154151272317088)),
    abs((r.conf_low[2]) - (-0.39823463794389485)) <= 1e-09 * (1 + abs(-0.39823463794389485)),
    abs((r.conf_high[2]) - (0.011719103538963854)) <= 1e-09 * (1 + abs(0.011719103538963854)),
    abs((r.intercept_conf_low) - (0.37449884507559528)) <= 1e-09 * (1 + abs(0.37449884507559528)),
    abs((r.intercept_conf_high) - (1.4447124100309792)) <= 1e-09 * (1 + abs(1.4447124100309792))
FROM (SELECT ols_fit_agg(y, [x1, x2], firm, {'confidence_level': 0.9}) AS r FROM d) s;
----
true	true	true	true	true	true

