# name: test/sql/reference/posthoc_reference.test
# description: #159 pairwise post-hoc aggregates vs R (pairwise.t.test, TukeyHSD, p.adjust)
# group: [reference]
#
# R (4.x):
#   A <- c(4.2, 5.1, 4.8, 5.5, 4.9); B <- c(6.3, 6.9, 7.1, 6.5)
#   C <- c(5.5, 5.0, 5.9, 6.1, 5.2, 5.7); D <- c(4.0, 4.4, 3.9, 4.6)
#   v <- c(A, B, C, D); g <- factor(rep(c("A", "B", "C", "D"), c(5, 4, 6, 4)))
#   pairwise.t.test(v, g, p.adjust.method = "none" | "holm" | "bonferroni" | "BH")$p.value
#   pairwise.t.test(v, g, p.adjust.method = "holm", pool.sd = FALSE)$p.value
#   TukeyHSD(aov(v ~ g))$g
#   pr <- pairs(emmeans::emmeans(lm(v ~ g), ~ g), reverse = TRUE)   # intervals of pairwise_t_test_agg (#198)
#   confint(pr, adjust = "none" | "holm", level = 0.95 | 0.9, side = "=" | ">")
#   t.test(v[g == b], v[g == a], conf.level = 1 - 0.05 / 6)$conf.int   # Welch, Bonferroni level
# FSA / dunn.test are not installed here, so dunn_test_agg is checked for shape and
# invariants only (its values come from upstream anofox-statistics, which is
# validated against FSA::dunnTest there).

require anofox_statistics

statement ok
CREATE TABLE ph AS SELECT * FROM (VALUES
    ('A', 4.2), ('A', 5.1), ('A', 4.8), ('A', 5.5), ('A', 4.9),
    ('B', 6.3), ('B', 6.9), ('B', 7.1), ('B', 6.5),
    ('C', 5.5), ('C', 5.0), ('C', 5.9), ('C', 6.1), ('C', 5.2), ('C', 5.7),
    ('D', 4.0), ('D', 4.4), ('D', 3.9), ('D', 4.6)) t(g, v);

# Reference p-values, one row per pair in R's order (B-A, C-A, D-A, C-B, D-B, D-C).
statement ok
CREATE TABLE ref AS SELECT * FROM (VALUES
    ('A', 'B', 8.86057018420620e-06, 4.4302850921031e-05, 5.31634211052372e-05, 2.65817105526186e-05, 0.00178289597092602),
    ('A', 'C', 1.65796712563508e-02, 0.033159342512701619, 9.94780275381049e-02, 1.98956055076210e-02, 0.07910388644602177),
    ('A', 'D', 2.62896804667003e-02, 0.033159342512701619, 1.57738082800202e-01, 2.62896804667003e-02, 0.07910388644602177),
    ('B', 'C', 6.31828134762951e-04, 1.89548440428885e-03, 3.79096880857770e-03, 9.47742202144426e-04, 0.00743344201369709),
    ('B', 'D', 3.64040212241668e-07, 2.18424127345001e-06, 2.18424127345001e-06, 2.18424127345001e-06, 0.00035882718849505),
    ('C', 'D', 0.000132983416119299, 0.000531933664477197, 0.000797900496715796, 0.000265966832238599, 0.00230052108541994))
    t(group1, group2, p_none, p_holm, p_bonferroni, p_bh, p_welch_holm);

# pairwise.t.test, pooled SD: raw and holm / bonferroni / BH adjusted p-values.
query IIII
SELECT bool_and(abs(h.p_value - ref.p_none) < 1e-12),
       bool_and(abs(h.p_adj - ref.p_holm) < 1e-12),
       bool_and(abs(b.p_adj - ref.p_bonferroni) < 1e-12),
       bool_and(abs(f.p_adj - ref.p_bh) < 1e-12)
FROM (SELECT unnest(pairwise_t_test_agg(v, g), recursive := true) FROM ph) h
JOIN (SELECT unnest(pairwise_t_test_agg(v, g, {'p_adjust': 'bonferroni'}), recursive := true) FROM ph) b USING (group1, group2)
JOIN (SELECT unnest(pairwise_t_test_agg(v, g, {'p_adjust': 'BH'}), recursive := true) FROM ph) f USING (group1, group2)
JOIN ref USING (group1, group2);
----
true	true	true	true

# pairwise.t.test(pool.sd = FALSE): Welch t-test per pair, holm.
query I
SELECT bool_and(abs(w.p_adj - ref.p_welch_holm) < 1e-10)
FROM (SELECT unnest(pairwise_t_test_agg(v, g, {'pool_sd': false}), recursive := true) FROM ph) w
JOIN ref USING (group1, group2);
----
true

# Rows: group1 < group2 in label order, estimate = mean(group2) - mean(group1), df = N - k.
query TTRRT
SELECT group1, group2, round(estimate, 10), df1, p_adjust_method
FROM (SELECT unnest(pairwise_t_test_agg(v, g), recursive := true) FROM ph);
----
A	B	1.8	15.0	holm
A	C	0.6666666667	15.0	holm
A	D	-0.675	15.0	holm
B	C	-1.1333333333	15.0	holm
B	D	-2.475	15.0	holm
C	D	-1.3416666667	15.0	holm

# TukeyHSD(aov(v ~ g)): diff, lwr, upr, p adj.
statement ok
CREATE TABLE tukey_ref AS SELECT * FROM (VALUES
    ('A', 'B',  1.800000000000000,  1.0105595421471478,  2.589440457852852, 4.73245173117087e-05),
    ('A', 'C',  0.666666666666667, -0.0459382886411072,  1.379271621974441, 7.05791534730034e-02),
    ('A', 'D', -0.675000000000000, -1.4644404578528518,  0.114440457852852, 1.07076749736065e-01),
    ('B', 'C', -1.133333333333333, -1.8929727680842088, -0.373693898582457, 3.15598757925850e-03),
    ('B', 'D', -2.475000000000000, -3.3071433079670567, -1.642856692032943, 1.98496509629109e-06),
    ('C', 'D', -1.341666666666667, -2.1013061014175429, -0.582027231915791, 6.86760611060988e-04))
    t(group1, group2, diff, lwr, upr, p_adj);

query IIIII
SELECT bool_and(abs(t.estimate - r.diff) < 1e-12), bool_and(abs(t.conf_low - r.lwr) < 1e-9),
       bool_and(abs(t.conf_high - r.upr) < 1e-9), bool_and(abs(t.p_adj - r.p_adj) < 1e-9),
       bool_and(t.p_value = t.p_adj AND t.conf_level = 0.95 AND t.p_adjust_method IS NULL)
FROM (SELECT unnest(tukey_hsd_agg(v, g), recursive := true) FROM ph) t
JOIN tukey_ref r USING (group1, group2);
----
true	true	true	true	true

# A wider family-wise level gives a wider interval.
query I
SELECT bool_and(w.conf_high - w.conf_low > t.conf_high - t.conf_low)
FROM (SELECT unnest(tukey_hsd_agg(v, g, {'confidence_level': 0.99}), recursive := true) FROM ph) w
JOIN (SELECT unnest(tukey_hsd_agg(v, g), recursive := true) FROM ph) t USING (group1, group2);
----
true

# pairwise_t_test_agg intervals (#198): the CI of estimate from the test's SE and df. Per comparison
# with p_adjust none; with any adjustment Bonferroni at 1 - 0.05/6, which emmeans also uses for holm.
statement ok
CREATE TABLE pt_ci AS SELECT * FROM (VALUES
    ('A', 'B',  1.21618122304592,   2.38381877695408,   0.968341018755809,  2.63165898124419,  1.31982737910385,  2.28017262089615,  0.782393121633408,  2.81760687836659),
    ('A', 'C',  0.139670426075276,  1.19366290725806,  -0.084047722576469,  1.4173810559098,   0.233228798553885, 1.10010453477945, -0.27587075770034,   1.60920409103367),
    ('A', 'D', -1.25881877695408,  -0.0911812230459219, -1.50665898124419,  0.156658981244191, -1.15517262089615, -0.194827379103848, -1.65629437534828, 0.306294375348274),
    ('B', 'C', -1.69511321338732,  -0.571553453279342, -1.93359756115884,  -0.333069105507827, -1.5953796532198, -0.671287013446864, -2.0319468665722,  -0.234719800094465),
    ('B', 'D', -3.09039902531623,  -1.85960097468376,  -3.35164553908897,  -1.59835446091103, -2.98114638402813, -1.96885361597187, -3.43023920891126, -1.51976079108874),
    ('C', 'D', -1.90344654672066,  -0.779886786612675, -2.14193089449217,  -0.54140243884116, -1.80371298655314, -0.879620346780197, -2.18077053563538, -0.50256279769795))
    t(group1, group2, lo_none, hi_none, lo_holm, hi_holm, lo_90, hi_90, lo_welch, hi_welch);

query IIIIII
SELECT bool_and(abs(n.conf_low - r.lo_none) < 1e-9 AND abs(n.conf_high - r.hi_none) < 1e-9),
       bool_and(abs(h.conf_low - r.lo_holm) < 1e-9 AND abs(h.conf_high - r.hi_holm) < 1e-9),
       bool_and(abs(c.conf_low - r.lo_90) < 1e-9 AND abs(c.conf_high - r.hi_90) < 1e-9),
       bool_and(abs(w.conf_low - r.lo_welch) < 1e-9 AND abs(w.conf_high - r.hi_welch) < 1e-9),
       bool_and(n.conf_level = 0.95 AND h.conf_level = 0.95 AND c.conf_level = 0.9 AND w.conf_level = 0.95),
       bool_and(h.estimate BETWEEN h.conf_low AND h.conf_high)
FROM (SELECT unnest(pairwise_t_test_agg(v, g, {'p_adjust': 'none'}), recursive := true) FROM ph) n
JOIN (SELECT unnest(pairwise_t_test_agg(v, g), recursive := true) FROM ph) h USING (group1, group2)
JOIN (SELECT unnest(pairwise_t_test_agg(v, g, {'p_adjust': 'none', 'confidence_level': 0.9}), recursive := true) FROM ph) c USING (group1, group2)
JOIN (SELECT unnest(pairwise_t_test_agg(v, g, {'pool_sd': false}), recursive := true) FROM ph) w USING (group1, group2)
JOIN pt_ci r USING (group1, group2);
----
true	true	true	true	true	true

# One-sided alternative: one-sided interval; the lower bound of 'greater' at 0.95 is the
# two-sided 0.90 lower bound (emmeans side = ">").
query II
SELECT bool_and(abs(g.conf_low - r.lo_90) < 1e-9), bool_and(g.conf_high = 'inf'::DOUBLE)
FROM (SELECT unnest(pairwise_t_test_agg(v, g, {'p_adjust': 'none', 'alternative': 'greater'}), recursive := true) FROM ph) g
JOIN pt_ci r USING (group1, group2);
----
true	true

# pairwise_t_test_by passes the options through and fills the same intervals.
statement ok
CREATE TABLE ph_by AS SELECT 'all' AS grp, * FROM ph;

query I
SELECT bool_and(abs(b.conf_low - r.lo_90) < 1e-9 AND abs(b.conf_high - r.hi_90) < 1e-9 AND b.conf_level = 0.9)
FROM pairwise_t_test_by('ph_by', grp, v, g, options := {'p_adjust': 'none', 'confidence_level': 0.9}) b
JOIN pt_ci r USING (group1, group2);
----
true

statement error
SELECT pairwise_t_test_agg(v, g, {'confidence_level': 1.5}) FROM ph;
----
confidence_level

# Dunn: mean-rank differences, z without df or interval, holm-adjusted p >= raw p.
query IIII
SELECT count(*), bool_and(p_adj >= p_value), bool_and(df1 IS NULL AND conf_low IS NULL), any_value(p_adjust_method)
FROM (SELECT unnest(dunn_test_agg(v, g), recursive := true) FROM ph);
----
6	true	true	holm

# Mean ranks: A = 5.4, B = 15.6 -> B - A = 10.2.
query R
SELECT estimate FROM (SELECT unnest(dunn_test_agg(v, g), recursive := true) FROM ph) WHERE group1 = 'A' AND group2 = 'B';
----
10.2

# Integer group labels sort numerically (10 after 9).
query TT
SELECT group1, group2 FROM (SELECT unnest(pairwise_t_test_agg(v, CASE g WHEN 'A' THEN 9 WHEN 'B' THEN 10 ELSE 11 END), recursive := true) FROM ph);
----
9	10
9	11
10	11

# Fewer than two groups: NULL. Unknown adjustment: error.
query I
SELECT tukey_hsd_agg(v, g) IS NULL FROM ph WHERE g = 'A';
----
true

statement error
SELECT pairwise_t_test_agg(v, g, {'p_adjust': 'nope'}) FROM ph;
----
unknown p-value adjustment method

statement error
SELECT tukey_hsd_agg(v, g, {'p_adjust': 'holm'}) FROM ph;
----
unknown option

# The _by macros: one row per pair within each group of source, test schema.
statement ok
CREATE TABLE ph2 AS SELECT 'e' || i AS experiment, g, v + i AS v FROM ph, range(2) r(i);

query TTTTRT
SELECT experiment, model_id, test_id, group1, round(p_adj, 12), p_adjust_method
FROM pairwise_t_test_by('ph2', experiment, v, g) WHERE group2 = 'B';
----
e0	e0	B-A	A	0.000044302851	holm
e1	e1	B-A	A	0.000044302851	holm

query II
SELECT count(*), count(DISTINCT experiment) FROM tukey_hsd_by('ph2', experiment, v, g, {'confidence_level': 0.9});
----
12	2

query IT
SELECT count(*), any_value(p_adjust_method) FROM dunn_test_by('ph2', experiment, v, g, {'p_adjust': 'bonferroni'});
----
12	bonferroni
