# ordinal_predict type 'quantile' continuous response vs rms::Quantile.orm(conf.int = 0.95)
query IIIIII
SELECT
    abs(((ordinal_predict(t.m, [-0.002, 1], {'type': 'quantile', 'q': 0.5, 'method': 'interpolated'})).yhat) - (1.40213414765568)) <= 1e-6 * (1 + abs(1.40213414765568)),
    abs(((ordinal_predict(t.m, [-0.002, 1], {'type': 'quantile', 'q': 0.5, 'method': 'interpolated'})).yhat_lower) - (1.15203486985561)) <= 1e-5 * (1 + abs(1.15203486985561)),
    abs(((ordinal_predict(t.m, [-0.002, 1], {'type': 'quantile', 'q': 0.5, 'method': 'interpolated'})).yhat_upper) - (1.58871059193023)) <= 1e-5 * (1 + abs(1.58871059193023)),
    abs(((ordinal_predict(t.m, [-0.619, 0], {'type': 'quantile', 'q': 0.5, 'method': 'interpolated'})).yhat) - (1.34464452039817)) <= 1e-6 * (1 + abs(1.34464452039817)),
    abs(((ordinal_predict(t.m, [-0.619, 0], {'type': 'quantile', 'q': 0.5, 'method': 'interpolated'})).yhat_lower) - (1.03817057931557)) <= 1e-5 * (1 + abs(1.03817057931557)),
    abs(((ordinal_predict(t.m, [-0.619, 0], {'type': 'quantile', 'q': 0.5, 'method': 'interpolated'})).yhat_upper) - (1.50604472341808)) <= 1e-5 * (1 + abs(1.50604472341808))
FROM (SELECT ordinal_fit_agg(yc, [x1, x2]) AS m FROM dc) t;
