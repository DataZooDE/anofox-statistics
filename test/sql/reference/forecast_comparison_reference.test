# MCS::MCSprocedure(statistic = 'TR', alpha = 0.1, k = 5): superior set [1], elimination order [4, 3, 2].
query III
SELECT list_sort(r.included_models), r.eliminated_models, r.statistic_type
FROM (SELECT model_confidence_set_agg([l0, l1, l2, l3], {'alpha': 0.1, 'statistic': 'range', 'n_bootstrap': 999, 'block_length': 5, 'seed': 42} ORDER BY t) AS r FROM mcs);
----
[1]	[4, 3, 2]	range

# MCS::MCSprocedure(statistic = 'Tmax', alpha = 0.1, k = 5): superior set [1], elimination order [4, 3, 2].
query III
SELECT list_sort(r.included_models), r.eliminated_models, r.statistic_type
FROM (SELECT model_confidence_set_agg([l0, l1, l2, l3], {'alpha': 0.1, 'statistic': 'max', 'n_bootstrap': 999, 'block_length': 5, 'seed': 42} ORDER BY t) AS r FROM mcs);
----
[1]	[4, 3, 2]	max

# MCS::MCSprocedure(statistic = 'TR', alpha = 0.1, k = 5): superior set [1, 2], elimination order [3].
query III
SELECT list_sort(r.included_models), r.eliminated_models, r.statistic_type
FROM (SELECT model_confidence_set_agg([q0, q1, q2], {'alpha': 0.1, 'statistic': 'range', 'n_bootstrap': 999, 'block_length': 5, 'seed': 42} ORDER BY t) AS r FROM mcs_tie);
----
[1, 2]	[3]	range

# MCS::MCSprocedure(statistic = 'Tmax', alpha = 0.1, k = 5): superior set [1, 2], elimination order [3].
query III
SELECT list_sort(r.included_models), r.eliminated_models, r.statistic_type
FROM (SELECT model_confidence_set_agg([q0, q1, q2], {'alpha': 0.1, 'statistic': 'max', 'n_bootstrap': 999, 'block_length': 5, 'seed': 42} ORDER BY t) AS r FROM mcs_tie);
----
[1, 2]	[3]	max

