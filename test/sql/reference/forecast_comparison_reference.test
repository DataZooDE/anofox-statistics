# All three competitors: model 1 is clearly better than the benchmark.
query I
SELECT abs((r.statistic) - (187.64855847805174)) <= 1e-09 * (1 + abs(187.64855847805174))
    AND r.best_model = 1 AND r.n_models = 3 AND r.n = 100
    AND r.p_value < 0.05 AND r.p_value_upper < 0.05
FROM (SELECT spa_test_agg(b, [m1, m2, m3], {'n_bootstrap': 499, 'block_length': 5, 'seed': 42} ORDER BY t) AS r FROM spa);
----
true

# Only the similar and the worse model: no competitor beats the benchmark.
query I
SELECT abs((r.statistic) - (-13.751292408898186)) <= 1e-09 * (1 + abs(-13.751292408898186))
    AND r.best_model = 1 AND r.p_value > 0.1
FROM (SELECT spa_test_agg(b, [m2, m3], {'n_bootstrap': 499, 'block_length': 5, 'seed': 42} ORDER BY t) AS r FROM spa);
----
true

