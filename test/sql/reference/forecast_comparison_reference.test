# Clark-West adjusted differentials f = (e_b^2 - e_k^2) + (e_b - e_k)^2.
query I
SELECT abs((r.statistic) - (122.58955818640835)) <= 1e-09 * (1 + abs(122.58955818640835))
    AND r.best_model = 1 AND r.n_models = 2 AND r.n = 120 AND r.p_value < 0.05
FROM (SELECT mspe_adjusted_spa_agg(eb, [ea, ec], {'n_bootstrap': 499, 'block_length': 4, 'seed': 7} ORDER BY t) AS r FROM mspe);
----
true

query I
SELECT abs((r.statistic) - (10.56878028383772)) <= 1e-09 * (1 + abs(10.56878028383772)) AND r.best_model = 1
FROM (SELECT mspe_adjusted_spa_agg(eb, [ec], {'n_bootstrap': 499, 'block_length': 4, 'seed': 7} ORDER BY t) AS r FROM mspe);
----
true

statement ok
