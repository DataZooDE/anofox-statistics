# MCSprocedure(statistic = 'Tmax', alpha = 0.1, k = 1, B = 20000): elimination order [4, 3, 5, 2, 1],
# MCS p-values [1.0000, 0.5547, 0.0784, 0.0000, 0.5547], superior set [1, 2, 5].
query IIIIIIII
SELECT r.elimination_order = [4, 3, 5, 2, 1],
       list_sort(r.included_models) = [1, 2, 5],
       abs((r.mcs_p_values[1]) - (1)) < 0.025,
       abs((r.mcs_p_values[2]) - (0.55469999999999997)) < 0.025,
       abs((r.mcs_p_values[3]) - (0.078350000000000003)) < 0.025,
       abs((r.mcs_p_values[4]) - (0)) < 0.025,
       abs((r.mcs_p_values[5]) - (0.55469999999999997)) < 0.025,
       r.bootstrap_method = 'moving_block' AND r.block_length = 1 AND r.statistic_type = 'max'
FROM (SELECT model_confidence_set_agg([l1, l2, l3, l4, l5], {'alpha': 0.1, 'statistic': 'max', 'n_bootstrap': 20000, 'method': 'moving_block', 'block_length': 1} ORDER BY t) AS r FROM mcs);
----
true	true	true	true	true	true	true	true

# MCSprocedure(statistic = 'Tmax', alpha = 0.1, k = 3, B = 20000): elimination order [4, 3, 2, 5, 1],
# MCS p-values [1.0000, 0.6086, 0.1713, 0.0000, 0.6086], superior set [1, 2, 3, 5].
query IIIIIIII
SELECT r.elimination_order = [4, 3, 2, 5, 1],
       list_sort(r.included_models) = [1, 2, 3, 5],
       abs((r.mcs_p_values[1]) - (1)) < 0.025,
       abs((r.mcs_p_values[2]) - (0.60860000000000003)) < 0.025,
       abs((r.mcs_p_values[3]) - (0.17125000000000001)) < 0.025,
       abs((r.mcs_p_values[4]) - (0)) < 0.025,
       abs((r.mcs_p_values[5]) - (0.60860000000000003)) < 0.025,
       r.bootstrap_method = 'moving_block' AND r.block_length = 3 AND r.statistic_type = 'max'
FROM (SELECT model_confidence_set_agg([l1, l2, l3, l4, l5], {'alpha': 0.1, 'statistic': 'max', 'n_bootstrap': 20000, 'method': 'moving_block', 'block_length': 3} ORDER BY t) AS r FROM mcs);
----
true	true	true	true	true	true	true	true

# MCSprocedure(statistic = 'TR', alpha = 0.1, k = 1, B = 20000): elimination order [4, 3, 2, 5, 1],
# MCS p-values [1.0000, 0.3093, 0.0294, 0.0000, 0.3093], superior set [1, 2, 5].
query IIIIIIII
SELECT r.elimination_order = [4, 3, 2, 5, 1],
       list_sort(r.included_models) = [1, 2, 5],
       abs((r.mcs_p_values[1]) - (1)) < 0.025,
       abs((r.mcs_p_values[2]) - (0.30930000000000002)) < 0.025,
       abs((r.mcs_p_values[3]) - (0.029399999999999999)) < 0.025,
       abs((r.mcs_p_values[4]) - (0)) < 0.025,
       abs((r.mcs_p_values[5]) - (0.30930000000000002)) < 0.025,
       r.bootstrap_method = 'moving_block' AND r.block_length = 1 AND r.statistic_type = 'range'
FROM (SELECT model_confidence_set_agg([l1, l2, l3, l4, l5], {'alpha': 0.1, 'statistic': 'range', 'n_bootstrap': 20000, 'method': 'moving_block', 'block_length': 1} ORDER BY t) AS r FROM mcs);
----
true	true	true	true	true	true	true	true

# MCSprocedure(statistic = 'TR', alpha = 0.1, k = 3, B = 20000): elimination order [4, 3, 2, 5, 1],
# MCS p-values [1.0000, 0.4027, 0.0535, 0.0000, 0.4027], superior set [1, 2, 5].
query IIIIIIII
SELECT r.elimination_order = [4, 3, 2, 5, 1],
       list_sort(r.included_models) = [1, 2, 5],
       abs((r.mcs_p_values[1]) - (1)) < 0.025,
       abs((r.mcs_p_values[2]) - (0.40275)) < 0.025,
       abs((r.mcs_p_values[3]) - (0.053499999999999999)) < 0.025,
       abs((r.mcs_p_values[4]) - (0)) < 0.025,
       abs((r.mcs_p_values[5]) - (0.40275)) < 0.025,
       r.bootstrap_method = 'moving_block' AND r.block_length = 3 AND r.statistic_type = 'range'
FROM (SELECT model_confidence_set_agg([l1, l2, l3, l4, l5], {'alpha': 0.1, 'statistic': 'range', 'n_bootstrap': 20000, 'method': 'moving_block', 'block_length': 3} ORDER BY t) AS r FROM mcs);
----
true	true	true	true	true	true	true	true

