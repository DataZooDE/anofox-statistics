# Hansen SPA on Clark-West differentials: T = 2.6965203881429241, best model 3; p = 0.0112, 0.0112, 0.0112.
query IIIII
SELECT abs((r.statistic) - (2.6965203881429241)) <= 1e-09 * (1 + abs(2.6965203881429241)), r.best_model = 3,
       abs((r.p_value_lower) - (0.01125)) < 0.025, abs((r.p_value_consistent) - (0.01125)) < 0.025,
       abs((r.p_value_upper) - (0.01125)) < 0.025
FROM (SELECT mspe_adjusted_spa_agg(e0, [e1, e2, e3], {'n_bootstrap': 20000, 'block_length': 3, 'seed': 12} ORDER BY t) AS r FROM mspe);
----
true	true	true	true	true

statement ok
CREATE TABLE mcs (t INTEGER, l1 DOUBLE, l2 DOUBLE, l3 DOUBLE, l4 DOUBLE, l5 DOUBLE);

# Rows are inserted in reverse time order: the aggregates must follow ORDER BY t.
