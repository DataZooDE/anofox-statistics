# Hansen (2005): T_SPA = 0.90113667744006043, best model 1; p (lower, consistent, upper) = 0.2661, 0.3459, 0.4333.
query IIIIIIII
SELECT abs((r.statistic) - (0.90113667744006043)) <= 1e-09 * (1 + abs(0.90113667744006043)), r.best_model = 1,
       abs((r.p_value_lower) - (0.26605000000000001)) < 0.025, abs((r.p_value_consistent) - (0.34594999999999998)) < 0.025,
       abs((r.p_value_upper) - (0.43330000000000002)) < 0.025, r.p_value = r.p_value_consistent,
       r.p_value_lower <= r.p_value_consistent AND r.p_value_consistent <= r.p_value_upper,
       r.n_models = 5 AND r.n = 200 AND r.block_length = 4
FROM (SELECT spa_test_agg(b, [m1, m2, m3, m4, m5], {'n_bootstrap': 20000, 'block_length': 4, 'seed': 11} ORDER BY t) AS r FROM spa);
----
true	true	true	true	true	true	true	true

# Only models that are clearly worse than the benchmark: T_SPA = max(0, ...) = 0.
query II
SELECT r.statistic, r.best_model
FROM (SELECT spa_test_agg(b, [m4, m5], {'n_bootstrap': 999, 'block_length': 4} ORDER BY t) AS r FROM spa);
----
0.0	1

statement ok
CREATE TABLE mspe (t INTEGER, e0 DOUBLE, e1 DOUBLE, e2 DOUBLE, e3 DOUBLE);

# Rows are inserted in reverse time order: the aggregates must follow ORDER BY t.
