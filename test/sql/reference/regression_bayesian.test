# bayesian_ridge_fit_agg: sklearn BayesianRidge() defaults
query IIIIIIIIIIIII
SELECT
    abs((m.intercept) - (1.508525723093793)) <= 1e-07 * (1 + abs(1.508525723093793)),
    abs((m.coefficients[1]) - (2.0433432228778896)) <= 1e-07 * (1 + abs(2.0433432228778896)),
    abs((m.coefficients[2]) - (-0.97262577378746)) <= 1e-07 * (1 + abs(-0.97262577378746)),
    abs((m.coefficients[3]) - (0.4525573915577838)) <= 1e-07 * (1 + abs(0.4525573915577838)),
    abs((m.coefficients[4]) - (-0.014754083486889063)) <= 1e-07 * (1 + abs(-0.014754083486889063)),
    abs((m.noise_precision) - (12.288648933296976)) <= 1e-07 * (1 + abs(12.288648933296976)),
    abs((m.weight_precision) - (0.748712202235323)) <= 1e-07 * (1 + abs(0.748712202235323)),
    abs((m.log_marginal_likelihood) - (-16.801683005996054)) <= 1e-07 * (1 + abs(-16.801683005996054)),
    abs((m.posterior_sd[1]) - (0.07914502412919605)) <= 1e-07 * (1 + abs(0.07914502412919605)),
    abs((m.posterior_sd[2]) - (0.05142193196879437)) <= 1e-07 * (1 + abs(0.05142193196879437)),
