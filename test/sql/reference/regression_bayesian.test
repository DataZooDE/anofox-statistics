    abs((m.posterior_sd[4]) - (0.04617676630253036)) <= 1e-07 * (1 + abs(0.04617676630253036)),
    m.iterations = 4
FROM (SELECT bayesian_ridge_fit_agg(y, [x1, x2, x3, x4]) AS m FROM d)
