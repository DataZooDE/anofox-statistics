# name: test/sql/reference/metrics_reference.test
# description: #368/#369 classification_metrics_agg, regression_metrics_agg, ranking_metrics_agg vs scikit-learn
# group: [reference]
#
# Reference values: validation/generators/make_reference_metrics.py (scikit-learn 1.9.1).
# Specificity (no scikit-learn function) follows R yardstick::spec's definition and sMAPE
# yardstick::smape / 100, both computed in the generator from the scikit-learn confusion
# matrix / the documented formula. MAP, MRR, precision@k, recall@k and hit rate follow
# evidently's definitions; NDCG is scikit-learn ndcg_score per query.

require anofox_statistics

# ---------------------------------------------------------------------------
# Binary: the scores of classification_reference.test, predicted 1 when score >= 0.5
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE b AS SELECT * FROM (VALUES
 (1, 1, 0.9), (2, 0, 0.1), (3, 1, 0.8), (4, 1, 0.65), (5, 0, 0.4), (6, 0, 0.3), (7, 1, 0.55),
 (8, 0, 0.55), (9, 1, 0.7), (10, 0, 0.2), (11, 1, 0.35), (12, 1, 0.95), (13, 0, 0.6), (14, 0, 0.05),
 (15, 1, 0.45), (16, 0, 0.5), (17, 0, 0.25), (18, 1, 0.75), (19, 1, 0.55), (20, 0, 0.15)
) t(id, y, s);

# accuracy, balanced accuracy, MCC, kappa and the confusion matrix do not depend on average.
query IIIIIII
SELECT m.n, abs(m.accuracy - 0.75) < 1e-12, abs(m.balanced_accuracy - 0.75) < 1e-12,
       abs(m.mcc - 0.502518907629606) < 1e-12, abs(m.cohen_kappa - 0.5) < 1e-12, m.labels, m.confusion
FROM (SELECT classification_metrics_agg(y, s, {'threshold': 0.5}) AS m FROM b);
----
20	true	true	true	true	[0, 1]	[[7, 3], [2, 8]]

# Predicted labels give the same result as the thresholded score.
query I
SELECT classification_metrics_agg(y, (s >= 0.5)::INT, {'average': 'weighted'})
     = classification_metrics_agg(y, s, {'threshold': 0.5, 'average': 'weighted'}) FROM b;
----
true

statement ok
CREATE TABLE bin_ref AS SELECT * FROM (VALUES
 ('binary', 0.7272727272727273, 0.8, 0.7619047619047619, 0.7),
 ('macro', 0.7525252525252526, 0.75, 0.7493734335839599, 0.75),
 ('micro', 0.75, 0.75, 0.75, 0.75),
 ('weighted', 0.7525252525252526, 0.75, 0.7493734335839599, 0.75)
) t(average, precision, recall, f1, specificity);

query II
SELECT count(*), max(abs(m.precision - r.precision) + abs(m.recall - r.recall) + abs(m.f1 - r.f1)
                     + abs(m.specificity - r.specificity)) < 1e-12
FROM (SELECT classification_metrics_agg(y, s, {'threshold': 0.5, 'average': 'binary'}) AS m FROM b
      UNION ALL SELECT classification_metrics_agg(y, s, {'threshold': 0.5, 'average': 'macro'}) FROM b
      UNION ALL SELECT classification_metrics_agg(y, s, {'threshold': 0.5, 'average': 'micro'}) FROM b
      UNION ALL SELECT classification_metrics_agg(y, s, {'threshold': 0.5, 'average': 'weighted'}) FROM b) x
JOIN bin_ref r ON m.average = r.average;
----
4	true

# BOOLEAN labels, binary of the positive class false (sklearn pos_label = 0).
query IIIII
SELECT abs(m.precision - 0.7777777777777778) < 1e-12, abs(m.recall - 0.7) < 1e-12,
       abs(m.f1 - 0.7368421052631579) < 1e-12, abs(m.specificity - 0.8) < 1e-12, m.labels
FROM (SELECT classification_metrics_agg(y = 1, s >= 0.5, {'average': 'binary', 'pos_label': false}) AS m FROM b);
----
true	true	true	true	[false, true]

# ---------------------------------------------------------------------------
# Multiclass VARCHAR labels: 'fish' is never predicted, 'bird' never true
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE mc AS SELECT * FROM (VALUES
 ('cat', 'cat'), ('dog', 'dog'), ('fish', 'dog'), ('cat', 'cat'), ('dog', 'cat'), ('cat', 'cat'),
 ('fish', 'bird'), ('dog', 'dog'), ('cat', 'dog'), ('dog', 'dog'), ('fish', 'cat'), ('cat', 'cat'),
 ('dog', 'dog'), ('dog', 'bird'), ('cat', 'cat'), ('fish', 'dog'), ('cat', 'cat'), ('dog', 'dog'),
 ('cat', 'dog'), ('fish', 'cat')
) t(y, p);

query IIIIIII
SELECT m.n, abs(m.accuracy - 0.55) < 1e-12, abs(m.balanced_accuracy - 0.48809523809523814) < 1e-12,
       abs(m.mcc - 0.343289366601465) < 1e-12, abs(m.cohen_kappa - 0.3207547169811321) < 1e-12, m.labels,
       m.confusion
FROM (SELECT classification_metrics_agg(y, p) AS m FROM mc);
----
20	true	true	true	true	[bird, cat, dog, fish]	[[0, 0, 0, 0], [0, 6, 2, 0], [1, 1, 5, 0], [1, 2, 2, 0]]

statement ok
CREATE TABLE mc_ref AS SELECT * FROM (VALUES
 ('macro', 0.3055555555555556, 0.3660714285714286, 0.33272058823529416, 0.835576923076923),
 ('micro', 0.55, 0.55, 0.55, 0.85),
 ('weighted', 0.4611111111111111, 0.55, 0.5011029411764707, 0.7923076923076924)
) t(average, precision, recall, f1, specificity);

query II
SELECT count(*), max(abs(m.precision - r.precision) + abs(m.recall - r.recall) + abs(m.f1 - r.f1)
                     + abs(m.specificity - r.specificity)) < 1e-12
FROM (SELECT classification_metrics_agg(y, p) AS m FROM mc
      UNION ALL SELECT classification_metrics_agg(y, p, {'average': 'micro'}) FROM mc
      UNION ALL SELECT classification_metrics_agg(y, p, {'average': 'weighted'}) FROM mc) x
JOIN mc_ref r ON m.average = r.average;
----
3	true

# zero_division = 1: precision of 'fish' (never predicted) counts as 1.
query I
SELECT abs((classification_metrics_agg(y, p, {'zero_division': 1})).precision - 0.5555555555555556) < 1e-12 FROM mc;
----
true

# ---------------------------------------------------------------------------
# Regression metrics (y = 0 in row 6: MAPE divides by machine epsilon, as sklearn)
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE r AS SELECT * FROM (VALUES
 (3.0, 2.5), (-0.5, 0.0), (2.0, 2.1), (7.0, 7.8), (4.2, 3.9), (0.0, 0.4), (5.5, 5.0), (1.3, 1.0),
 (8.8, 9.6), (2.2, 2.2)
) t(y, yhat);

query IIIIIIIIII
SELECT m.n, abs(m.mae - 0.42) < 1e-12, abs(m.mse - 0.238) < 1e-12, abs(m.rmse - 0.4878524367060185) < 1e-12,
       abs(m.mape / 180143985094820.0 - 1) < 1e-12, abs(m.smape - 0.4855845033999858) < 1e-12,
       abs(m.median_ae - 0.45) < 1e-12, abs(m.r2 - 0.9709348476521952) < 1e-12,
       abs(m.explained_variance - 0.9721560725407584) < 1e-12, abs(m.max_error - 0.8) < 1e-12
FROM (SELECT regression_metrics_agg(y, yhat) AS m FROM r);
----
10	true	true	true	true	true	true	true	true	true

# ---------------------------------------------------------------------------
# Ranking metrics: 4 queries, q4 without a relevant item, no tied scores
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE rk AS SELECT * FROM (VALUES
 (1, 3, 0.9), (1, 2, 0.3), (1, 0, 0.8), (1, 0, 0.1), (1, 1, 0.5), (1, 0, 0.2),
 (2, 0, 0.7), (2, 0, 0.6), (2, 1, 0.5), (2, 0, 0.4), (2, 2, 0.3),
 (3, 1, 0.2), (3, 0, 0.9), (3, 0, 0.8), (3, 0, 0.7),
 (4, 0, 0.3), (4, 0, 0.2), (4, 0, 0.1)
) t(q, rel, score);

query IIIIIIII
SELECT m.n_queries, m.k, abs(m.ndcg - 0.3083512894989472) < 1e-12, abs(m.map - 0.2407407407407407) < 1e-12,
       abs(m.mrr - 0.4444444444444444) < 1e-12, abs(m.precision - 0.3333333333333333) < 1e-12,
       abs(m.recall - 0.38888888888888884) < 1e-12, abs(m.hit_rate - 0.6666666666666666) < 1e-12
FROM (SELECT ranking_metrics_agg(q, rel, score, {'k': 3}) AS m FROM rk);
----
3	3	true	true	true	true	true	true

# Default k = 10.
query IIIIIIII
SELECT m.n_queries, m.k, abs(m.ndcg - 0.6102323271142586) < 1e-12, abs(m.map - 0.47407407407407404) < 1e-12,
       abs(m.mrr - 0.5277777777777778) < 1e-12, abs(m.precision - 0.3833333333333333) < 1e-12,
       abs(m.recall - 1.0) < 1e-12, abs(m.hit_rate - 1.0) < 1e-12
FROM (SELECT ranking_metrics_agg(q, rel, score) AS m FROM rk);
----
3	10	true	true	true	true	true	true

query IIIIIII
SELECT m.n_queries, abs(m.ndcg - 0.2312634671242104) < 1e-12, abs(m.map - 0.18055555555555552) < 1e-12,
       abs(m.mrr - 0.3333333333333333) < 1e-12, abs(m.precision - 0.25) < 1e-12,
       abs(m.recall - 0.29166666666666663) < 1e-12, abs(m.hit_rate - 0.5) < 1e-12
FROM (SELECT ranking_metrics_agg(q, rel, score, {'k': 3, 'include_no_feedback': true}) AS m FROM rk);
----
4	true	true	true	true	true	true

# min_relevance = 2: binary relevance (rel >= 2) for every metric, NDCG included.
query IIIIIII
SELECT m.n_queries, abs(m.ndcg - 0.30657359638272924) < 1e-12, abs(m.map - 0.25) < 1e-12,
       abs(m.mrr - 0.5) < 1e-12, abs(m.precision - 0.25) < 1e-12, abs(m.recall - 0.25) < 1e-12,
       abs(m.hit_rate - 0.5) < 1e-12
FROM (SELECT ranking_metrics_agg(q, rel, score, {'k': 2, 'min_relevance': 2}) AS m FROM rk);
----
2	true	true	true	true	true	true

# VARCHAR query ids give the same result.
query I
SELECT ranking_metrics_agg('q' || q, rel, score, {'k': 3}) = ranking_metrics_agg(q, rel, score, {'k': 3}) FROM rk;
----
true
