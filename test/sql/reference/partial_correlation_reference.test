# name: test/sql/reference/partial_correlation_reference.test
# description: partial_cor_agg / semi_partial_cor_agg vs R ppcor::pcor.test / spcor.test (#296)
# group: [reference]
#
# Reference values: validation/generators/make_reference_partial_cor.R (ppcor 1.1,
# cross-checked there against base-R residualization). df = n - 2 - n_controls.
# method = 'spearman' rank-transforms every column (average ties), as ppcor does.
# z1, z2 and z3 are correlated (r = 0.69 to 0.95): with several controls y is
# residualized on all of them jointly, as spcor.test (anofox-statistics >= 0.8.1).

require anofox_statistics

statement ok
CREATE TABLE pc AS SELECT
    unnest([3.1, 4.7, 2.2, 6.8, 5.5, 7.9, 4.1, 8.6, 6.0, 9.4, 5.2, 7.3, 3.8, 8.1, 6.6])::DOUBLE AS x,
    unnest([4.2, 3.9, 2.0, 4.9, 4.2, 6.4, 3.6, 6.9, 6.6, 10.2, 4.5, 8.0, 5.8, 8.6, 6.3])::DOUBLE AS y,
    unnest([0.6, 2.6, -0.2, 1.3, 3.8, 2.8, 2.9, 4.3, 3.4, 3.4, 1.4, 2.7, 0.6, 4.2, 1.4])::DOUBLE AS z1,
    unnest([0.9, 2.8, 1.6, 2.0, 2.5, 3.6, 1.1, 3.0, 3.9, 4.2, 1.8, 2.4, 2.3, 4.8, 1.7])::DOUBLE AS z2,
    unnest([1.2, 3.1, 0.5, 2.0, 3.5, 3.4, 2.1, 4.0, 3.9, 4.1, 1.9, 2.9, 1.3, 4.6, 1.8])::DOUBLE AS z3,
    unnest([3, 4, 2, 6, 5, 7, 4, 8, 6, 9, 5, 7, 3, 8, 6])::DOUBLE AS tx,
    unnest([1, 2, 1, 3, 2, 4, 2, 4, 3, 5, 2, 4, 1, 5, 3])::DOUBLE AS tz1;

# R: pcor.test(x, y, z1)
query IIIIII
SELECT abs(r.r - 0.78546272044352528) < 1e-12, abs(r.statistic - 4.3963212759209567) < 1e-9,
       abs(r.p_value - 0.0008709934947625156) < 1e-12, r.df = 12, r.n = 15, r.n_controls = 1
FROM (SELECT partial_cor_agg(x, y, [z1]) AS r FROM pc);
----
true	true	true	true	true	true

# R: pcor.test(x, y, cbind(z1, z2))
query IIIII
SELECT abs(r.r - 0.72398176186543961) < 1e-12, abs(r.statistic - 3.4808775436276367) < 1e-9,
       abs(r.p_value - 0.0051404940770096033) < 1e-12, r.df = 11, r.n_controls = 2
FROM (SELECT partial_cor_agg(x, y, [z1, z2]) AS r FROM pc);
----
true	true	true	true	true

# R: pcor.test(x, y, z1, method = "spearman")
query III
SELECT abs(r.r - 0.80549990744506239) < 1e-12, abs(r.statistic - 4.7086615629536333) < 1e-9,
       abs(r.p_value - 0.00050672464091378348) < 1e-12
FROM (SELECT partial_cor_agg(x, y, [z1], {'method': 'spearman'}) AS r FROM pc);
----
true	true	true

# R: pcor.test(x, y, cbind(z1, z2), method = "spearman")
query III
SELECT abs(r.r - 0.73564804042047482) < 1e-12, abs(r.statistic - 3.6020051286133916) < 1e-9,
       abs(r.p_value - 0.0041553102442021626) < 1e-12
FROM (SELECT partial_cor_agg(x, y, [z1, z2], {'method': 'spearman'}) AS r FROM pc);
----
true	true	true

# R: pcor.test(tx, y, tz1, method = "spearman") -- ties in x and the control
query III
SELECT abs(r.r - 0.45155861130567154) < 1e-12, abs(r.statistic - 1.7531632268003752) < 1e-9,
       abs(r.p_value - 0.10505675364479188) < 1e-12
FROM (SELECT partial_cor_agg(tx, y, [tz1], {'method': 'spearman'}) AS r FROM pc);
----
true	true	true

# R: spcor.test(x, y, z1)
query IIIII
SELECT abs(r.r - 0.55234422212853096) < 1e-12, abs(r.statistic - 2.2952728864025085) < 1e-9,
       abs(r.p_value - 0.040542944165616455) < 1e-12, r.df = 12, r.n_controls = 1
FROM (SELECT semi_partial_cor_agg(x, y, [z1]) AS r FROM pc);
----
true	true	true	true	true

# R: spcor.test(x, y, z1, method = "spearman")
query III
SELECT abs(r.r - 0.57798331576526851) < 1e-12, abs(r.statistic - 2.4535217437592185) < 1e-9,
       abs(r.p_value - 0.030396718788718885) < 1e-12
FROM (SELECT semi_partial_cor_agg(x, y, [z1], {'method': 'spearman'}) AS r FROM pc);
----
true	true	true

# R: spcor.test(tx, y, tz1, method = "spearman") -- ties
query III
SELECT abs(r.r - 0.083826642600800541) < 1e-12, abs(r.statistic - 0.29140966717484501) < 1e-9,
       abs(r.p_value - 0.77571395305249224) < 1e-12
FROM (SELECT semi_partial_cor_agg(tx, y, [tz1], {'method': 'spearman'}) AS r FROM pc);
----
true	true	true

# R: spcor.test(x, y, cbind(z1, z2)) -- correlated controls, joint residualization
query IIIII
SELECT abs(r.r - 0.4565251230535648) < 1e-12, abs(r.statistic - 1.7018148082947366) < 1e-9,
       abs(r.p_value - 0.1168476978748559) < 1e-12, r.df = 11, r.n_controls = 2
FROM (SELECT semi_partial_cor_agg(x, y, [z1, z2]) AS r FROM pc);
----
true	true	true	true	true

# R: spcor.test(x, y, cbind(z1, z2, z3))
query IIIII
SELECT abs(r.r - 0.40283113887396749) < 1e-12, abs(r.statistic - 1.391783740671368) < 1e-9,
       abs(r.p_value - 0.19416722235700681) < 1e-12, r.df = 10, r.n_controls = 3
FROM (SELECT semi_partial_cor_agg(x, y, [z1, z2, z3]) AS r FROM pc);
----
true	true	true	true	true

# R: spcor.test(x, y, cbind(z1, z2), method = "spearman")
query III
SELECT abs(r.r - 0.4616630131508771) < 1e-12, abs(r.statistic - 1.7261188129126463) < 1e-9,
       abs(r.p_value - 0.11226636606957495) < 1e-12
FROM (SELECT semi_partial_cor_agg(x, y, [z1, z2], {'method': 'spearman'}) AS r FROM pc);
----
true	true	true

# R: spcor.test(x, y, cbind(z1, z2, z3), method = "spearman")
query III
SELECT abs(r.r - 0.46771514119673807) < 1e-12, abs(r.statistic - 1.6733565418370853) < 1e-9,
       abs(r.p_value - 0.12520168521295308) < 1e-12
FROM (SELECT semi_partial_cor_agg(x, y, [z1, z2, z3], {'method': 'spearman'}) AS r FROM pc);
----
true	true	true

# R: pcor.test(x, y, cbind(z1, z2, z3))
query IIII
SELECT abs(r.r - 0.70088003263278131) < 1e-12, abs(r.statistic - 3.1073068594881459) < 1e-9,
       abs(r.p_value - 0.011111518372333561) < 1e-12, r.df = 10
FROM (SELECT partial_cor_agg(x, y, [z1, z2, z3]) AS r FROM pc);
----
true	true	true	true

# No controls: plain Pearson, R cor.test(x, y)
query III
SELECT abs(r.r - 0.85760491351703516) < 1e-12, abs(r.p_value - 4.3584439862792804e-05) < 1e-15, r.df = 13
FROM (SELECT partial_cor_agg(x, y, []::DOUBLE[]) AS r FROM pc);
----
true	true	true

# Unified test fields mirror the struct (#159)
query IIIIII
SELECT r.estimate = r.r, r.df1 = r.df, r.effect_name, r.effect_size = r.r, r.alternative, r.method
FROM (SELECT partial_cor_agg(x, y, [z1], {'method': 'spearman'}) AS r FROM pc);
----
true	true	r	true	two_sided	Spearman partial correlation (controlling for 1 variable(s))
