# ---- GLMM integration: n_agq ----
# {'n_agq': 1} is glmer's default Laplace fit (fixed effects optimised jointly
# with theta); {'n_agq': k > 1} adaptive Gauss-Hermite quadrature with k nodes.
# Standard errors from the Hessian of the deviance in (theta, beta), as lme4's
# vcov with calc.derivs = TRUE. For n_agq > 1 lme4's Poisson logLik omits the
# saturated-model term sum(log dpois(y, y)); the reference adds it back.
# The default (n_agq = 0, glmer(nAGQ = 0)) is checked in glm_glmm.test.

# poisson: glmer(pc ~ q1 + (1|g), nAGQ = 1): fixef, SEs, var_group, logLik
query IIIIII
SELECT
    abs((r.intercept) - (0.82923664783230677)) <= 0.0001 * (1 + abs(0.82923664783230677)),
    abs((r.coefficients[1]) - (0.62953149071699388)) <= 0.0001 * (1 + abs(0.62953149071699388)),
    abs((r.intercept_std_error) - (0.16165662252000021)) <= 0.0001 * (1 + abs(0.16165662252000021)),
    abs((r.std_errors[1]) - (0.1738086748310449)) <= 0.0001 * (1 + abs(0.1738086748310449)),
    abs((r.var_group) - (0.11732904663761171)) <= 0.0001 * (1 + abs(0.11732904663761171)),
    abs((r.log_likelihood) - (-88.363018436301857)) <= 0.0001 * (1 + abs(-88.363018436301857))
FROM (SELECT glmm_fit_agg(pc, [q1], g, {'family': 'poisson', 'n_agq': 1, 'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

# poisson: glmer(pc ~ q1 + (1|g), nAGQ = 5): fixef, SEs, var_group, logLik
query IIIIII
SELECT
    abs((r.intercept) - (0.82908870859522377)) <= 0.0001 * (1 + abs(0.82908870859522377)),
    abs((r.coefficients[1]) - (0.62961243947568257)) <= 0.0001 * (1 + abs(0.62961243947568257)),
    abs((r.intercept_std_error) - (0.16196100811529815)) <= 0.0001 * (1 + abs(0.16196100811529815)),
    abs((r.std_errors[1]) - (0.17382777415869013)) <= 0.0001 * (1 + abs(0.17382777415869013)),
    abs((r.var_group) - (0.11808200334120743)) <= 0.0001 * (1 + abs(0.11808200334120743)),
    abs((r.log_likelihood) - (-88.361125101519661)) <= 0.0001 * (1 + abs(-88.361125101519661))
FROM (SELECT glmm_fit_agg(pc, [q1], g, {'family': 'poisson', 'n_agq': 5, 'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

# binomial: glmer(bb ~ q1 + (1|g), nAGQ = 1): fixef, SEs, var_group, logLik
query IIIIII
SELECT
    abs((r.intercept) - (0.0050035582055185691)) <= 0.0001 * (1 + abs(0.0050035582055185691)),
    abs((r.coefficients[1]) - (1.3871704018429891)) <= 0.0001 * (1 + abs(1.3871704018429891)),
    abs((r.intercept_std_error) - (0.49318043958272489)) <= 0.0001 * (1 + abs(0.49318043958272489)),
    abs((r.std_errors[1]) - (0.68439374614181891)) <= 0.0001 * (1 + abs(0.68439374614181891)),
    abs((r.var_group) - (0.97542437794081915)) <= 0.0001 * (1 + abs(0.97542437794081915)),
    abs((r.log_likelihood) - (-29.66848836053358)) <= 0.0001 * (1 + abs(-29.66848836053358))
FROM (SELECT glmm_fit_agg(bb, [q1], g, {'family': 'binomial', 'n_agq': 1, 'compute_inference': true}) AS r FROM d4) s;
----
true	true	true	true	true	true

