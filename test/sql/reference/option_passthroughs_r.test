# ---- Poisson with prior weights ----
# poisson_fit_agg(y, x, w) is glm(y ~ x, family = poisson, weights = w): IRLS
# weights, deviance, log-likelihood and Pearson terms multiplied by w.
# glm(cnt ~ z1 + z2, poisson, weights = w): coefficients, deviance, null deviance, pseudo R^2, AIC, dispersion
query IIIIII
SELECT
    abs((r.intercept) - (0.68430312009665017)) <= 1e-06 * (1 + abs(0.68430312009665017)),
    abs((r.coefficients[1]) - (0.56299821276824724)) <= 1e-06 * (1 + abs(0.56299821276824724)),
    abs((r.coefficients[2]) - (-0.087923252878864613)) <= 1e-06 * (1 + abs(-0.087923252878864613)),
    abs((r.deviance) - (46.973399596757062)) <= 1e-06 * (1 + abs(46.973399596757062)),
    abs((r.null_deviance) - (78.745625739741953)) <= 1e-06 * (1 + abs(78.745625739741953)),
    abs((r.pseudo_r_squared) - (0.40347925163479703)) <= 1e-06 * (1 + abs(0.40347925163479703))
FROM (SELECT poisson_fit_agg(cnt, [z1, z2], w, {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true	true	true	true	true	true

# glm(cnt ~ z1 + z2, poisson, weights = w): coefficients, deviance, null deviance, pseudo R^2, AIC, dispersion
query II
SELECT
    abs((r.aic) - (173.48762154673062)) <= 1e-06 * (1 + abs(173.48762154673062)),
    abs((r.dispersion) - (1)) <= 1e-06 * (1 + abs(1))
FROM (SELECT poisson_fit_agg(cnt, [z1, z2], w, {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true	true

# glm(cnt ~ z1 + z2, poisson, weights = w): standard errors and z p-values (summary.glm)
query IIIIII
SELECT
    abs((r.intercept_std_error) - (0.10114888319044338)) <= 1e-06 * (1 + abs(0.10114888319044338)),
    abs((r.std_errors[1]) - (0.1114913259117131)) <= 1e-06 * (1 + abs(0.1114913259117131)),
    abs((r.std_errors[2]) - (0.17074450241961248)) <= 1e-06 * (1 + abs(0.17074450241961248)),
    abs((r.intercept_p_value) - (1.330279755433265e-11)) <= 1e-06 * (1 + abs(1.330279755433265e-11)),
    abs((r.p_values[1]) - (4.4249479113980051e-07)) <= 1e-06 * (1 + abs(4.4249479113980051e-07)),
    abs((r.p_values[2]) - (0.60659462558103805)) <= 1e-06 * (1 + abs(0.60659462558103805))
FROM (SELECT poisson_fit_agg(cnt, [z1, z2], w, {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true	true	true	true	true	true

# glm(cnt ~ z1 + z2 + offset(log(expo)), poisson, weights = w): coefficients, deviance, AIC
query IIIIII
SELECT
    abs((r.intercept) - (0.5270580371636322)) <= 1e-06 * (1 + abs(0.5270580371636322)),
    abs((r.coefficients[1]) - (0.56201155658925406)) <= 1e-06 * (1 + abs(0.56201155658925406)),
    abs((r.coefficients[2]) - (-0.27777597680765748)) <= 1e-06 * (1 + abs(-0.27777597680765748)),
    abs((r.deviance) - (50.242644216836638)) <= 1e-06 * (1 + abs(50.242644216836638)),
    abs((r.null_deviance) - (87.879477676868049)) <= 1e-06 * (1 + abs(87.879477676868049)),
    abs((r.aic) - (176.75686616681023)) <= 1e-06 * (1 + abs(176.75686616681023))
FROM (SELECT poisson_fit_agg(cnt, [z1, z2, lexpo], w, {'offset': 3, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true	true	true	true	true	true

# ---- Gamma (log link) with prior weights ----
# Dispersion = sum(w (y - mu)^2 / mu^2) / df (summary.glm); AIC is R's
# Gamma()$aic with weights (dispersion = deviance / sum(w)). The weighted fit's
# tests use t(df.residual) as summary.glm, the unweighted gamma_fit_agg uses z.
# glm(gam ~ z1 + z2, Gamma('log'), weights = w): coefficients, deviance, null deviance, pseudo R^2, AIC, dispersion
query IIIIII
SELECT
    abs((r.intercept) - (1.0118310821232406)) <= 1e-06 * (1 + abs(1.0118310821232406)),
    abs((r.coefficients[1]) - (0.18313584426811857)) <= 1e-06 * (1 + abs(0.18313584426811857)),
    abs((r.coefficients[2]) - (0.033996831311012471)) <= 1e-06 * (1 + abs(0.033996831311012471)),
    abs((r.deviance) - (27.120238616419829)) <= 1e-06 * (1 + abs(27.120238616419829)),
    abs((r.null_deviance) - (28.690018241794313)) <= 1e-06 * (1 + abs(28.690018241794313)),
    abs((r.pseudo_r_squared) - (0.05471518394114161)) <= 1e-06 * (1 + abs(0.05471518394114161))
FROM (SELECT gamma_fit_agg(gam, [z1, z2], w, {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true	true	true	true	true	true

# glm(gam ~ z1 + z2, Gamma('log'), weights = w): coefficients, deviance, null deviance, pseudo R^2, AIC, dispersion
query II
SELECT
    abs((r.aic) - (208.37713473715814)) <= 1e-06 * (1 + abs(208.37713473715814)),
    abs((r.dispersion) - (0.91699666236980792)) <= 1e-06 * (1 + abs(0.91699666236980792))
FROM (SELECT gamma_fit_agg(gam, [z1, z2], w, {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true	true

# glm(gam ~ z1 + z2, Gamma('log'), weights = w): standard errors and t p-values (summary.glm)
query IIIIII
SELECT
    abs((r.intercept_std_error) - (0.13357259706099261)) <= 1e-06 * (1 + abs(0.13357259706099261)),
    abs((r.std_errors[1]) - (0.12644693064091819)) <= 1e-06 * (1 + abs(0.12644693064091819)),
    abs((r.std_errors[2]) - (0.24330240357870295)) <= 1e-06 * (1 + abs(0.24330240357870295)),
    abs((r.intercept_p_value) - (1.0262069258602482e-08)) <= 1e-06 * (1 + abs(1.0262069258602482e-08)),
    abs((r.p_values[1]) - (0.15696264573377519)) <= 1e-06 * (1 + abs(0.15696264573377519)),
    abs((r.p_values[2]) - (0.88972206248866192)) <= 1e-06 * (1 + abs(0.88972206248866192))
FROM (SELECT gamma_fit_agg(gam, [z1, z2], w, {'compute_inference': true, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true	true	true	true	true	true

# ---- Tweedie (power 1.5, log link) with prior weights ----
# statmod::tweedie has no closed-form density for 1 < p < 2, so R's AIC is NA and
# the weighted fit reports NULL log-likelihood / AIC / BIC (checked below).
# glm(tw ~ z1 + z2, tweedie(1.5, link.power = 0), weights = w): coefficients, deviance, null deviance, pseudo R^2, AIC, dispersion
query IIIIII
SELECT
    abs((r.intercept) - (-0.015028134440742366)) <= 1e-06 * (1 + abs(-0.015028134440742366)),
    abs((r.coefficients[1]) - (0.35858739974051251)) <= 1e-06 * (1 + abs(0.35858739974051251)),
    abs((r.coefficients[2]) - (0.28199477860576744)) <= 1e-06 * (1 + abs(0.28199477860576744)),
    abs((r.deviance) - (73.276678111368199)) <= 1e-06 * (1 + abs(73.276678111368199)),
    abs((r.null_deviance) - (80.738613913384881)) <= 1e-06 * (1 + abs(80.738613913384881)),
    abs((r.pseudo_r_squared) - (0.092420905442118784)) <= 1e-06 * (1 + abs(0.092420905442118784))
FROM (SELECT tweedie_fit_agg(tw, [z1, z2], w, {'power': 1.5, 'compute_inference': true, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true	true	true	true	true	true

# glm(tw ~ z1 + z2, tweedie(1.5, link.power = 0), weights = w): coefficients, deviance, null deviance, pseudo R^2, AIC, dispersion
query I
SELECT
    abs((r.dispersion) - (1.4687731077264419)) <= 1e-06 * (1 + abs(1.4687731077264419))
FROM (SELECT tweedie_fit_agg(tw, [z1, z2], w, {'power': 1.5, 'compute_inference': true, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true

# glm(tw ~ z1 + z2, tweedie(1.5, link.power = 0), weights = w): standard errors and t p-values (summary.glm)
query IIIIII
SELECT
    abs((r.intercept_std_error) - (0.16941671481662132)) <= 1e-06 * (1 + abs(0.16941671481662132)),
    abs((r.std_errors[1]) - (0.16519403436017616)) <= 1e-06 * (1 + abs(0.16519403436017616)),
    abs((r.std_errors[2]) - (0.30531654926330049)) <= 1e-06 * (1 + abs(0.30531654926330049)),
    abs((r.intercept_p_value) - (0.92985239920512663)) <= 1e-06 * (1 + abs(0.92985239920512663)),
    abs((r.p_values[1]) - (0.037248394733491154)) <= 1e-06 * (1 + abs(0.037248394733491154)),
    abs((r.p_values[2]) - (0.36239159918695141)) <= 1e-06 * (1 + abs(0.36239159918695141))
FROM (SELECT tweedie_fit_agg(tw, [z1, z2], w, {'power': 1.5, 'compute_inference': true, 'tolerance': 1e-12}) AS r FROM gw) s;
----
true	true	true	true	true	true

query I
SELECT tweedie_fit_agg(tw, [z1, z2], w, {'power': 1.5}).aic IS NULL FROM gw;
----
true

# Integer weights equal replicated rows (the unweighted fit on the expanded data).
query III
WITH k AS (SELECT *, 1 + id % 3 AS f FROM gw),
     rep AS (SELECT k.* FROM k, range(3) r(i) WHERE r.i < k.f),
     a AS (SELECT poisson_fit_agg(cnt, [z1, z2], f, {'tolerance': 1e-12}) AS m FROM k),
     b AS (SELECT poisson_fit_agg(cnt, [z1, z2], {'tolerance': 1e-12}) AS m FROM rep)
SELECT abs(a.m.coefficients[1] - b.m.coefficients[1]) < 1e-9,
       abs(a.m.intercept - b.m.intercept) < 1e-9,
       abs(a.m.deviance - b.m.deviance) < 1e-8
FROM a, b;
----
true	true	true

