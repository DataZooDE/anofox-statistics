# ---- Ridge conditioning-aware lambda ----
# kappa(X'X) of the centred design: 1.09166 for [a1, a2] (well conditioned) and
# 40398.1 for [a1, a2, a3] (a3 ~ a1). With 'conditioning' the fit uses lambda_small
# (default 0.1, threshold 1000) on the first and alpha on the second.
# ridge_fit_agg {'alpha': 5, 'conditioning': true} on a well-conditioned design = ridge(lambda = 0.1)
query III
SELECT
    abs((r.intercept) - (1.0445559673962654)) <= 1e-08 * (1 + abs(1.0445559673962654)),
    abs((r.coefficients[1]) - (2.0734085194872458)) <= 1e-08 * (1 + abs(2.0734085194872458)),
    abs((r.coefficients[2]) - (-0.95490366056404263)) <= 1e-08 * (1 + abs(-0.95490366056404263))
FROM (SELECT ridge_fit_agg(ry, [a1, a2], {'alpha': 5, 'conditioning': true}) AS r FROM rd) s;
----
true	true	true

# ridge_fit_agg {'alpha': 5, 'conditioning': true} on an ill-conditioned design = ridge(lambda = 5)
query IIII
SELECT
    abs((r.intercept) - (1.0885626234437185)) <= 1e-08 * (1 + abs(1.0885626234437185)),
    abs((r.coefficients[1]) - (0.97196236151526938)) <= 1e-08 * (1 + abs(0.97196236151526938)),
    abs((r.coefficients[2]) - (-0.82712472097872747)) <= 1e-08 * (1 + abs(-0.82712472097872747)),
    abs((r.coefficients[3]) - (0.96534319275069858)) <= 1e-08 * (1 + abs(0.96534319275069858))
FROM (SELECT ridge_fit_agg(ry, [a1, a2, a3], {'alpha': 5, 'conditioning': true}) AS r FROM rd) s;
----
true	true	true	true

# ridge_fit_agg {'alpha': 5, 'lambda_small': 0.5, 'cond_threshold': 1e7}: both designs below the threshold
query IIII
SELECT
    abs((r.intercept) - (1.0465326270469462)) <= 1e-08 * (1 + abs(1.0465326270469462)),
    abs((r.coefficients[1]) - (1.0631309469304075)) <= 1e-08 * (1 + abs(1.0631309469304075)),
    abs((r.coefficients[2]) - (-0.94293511196424018)) <= 1e-08 * (1 + abs(-0.94293511196424018)),
    abs((r.coefficients[3]) - (1.0013641124746275)) <= 1e-08 * (1 + abs(1.0013641124746275))
FROM (SELECT ridge_fit_agg(ry, [a1, a2, a3], {'alpha': 5, 'lambda_small': 0.5, 'cond_threshold': 1e7}) AS r FROM rd) s;
----
true	true	true	true

# ridge_fit_agg without conditioning keeps alpha on the well-conditioned design
query III
SELECT
    abs((r.intercept) - (1.1133049102521742)) <= 1e-08 * (1 + abs(1.1133049102521742)),
    abs((r.coefficients[1]) - (1.8157701279217766)) <= 1e-08 * (1 + abs(1.8157701279217766)),
    abs((r.coefficients[2]) - (-0.82412420024882715)) <= 1e-08 * (1 + abs(-0.82412420024882715))
FROM (SELECT ridge_fit_agg(ry, [a1, a2], {'alpha': 5}) AS r FROM rd) s;
----
true	true	true

