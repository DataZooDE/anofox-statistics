# name: test/sql/reference/classification_reference.test
# description: #153 classifier evaluation (roc_agg, pr_agg, calibration_agg, auc_agg, brier_agg, log_loss_agg) vs scikit-learn and pROC
# group: [reference]
#
# Reference values: validation/generators/make_reference_classification.py (scikit-learn 1.9.1)
# and validation/generators/make_reference_classification.R (pROC 1.19, prop.test).
# Conventions:
#  * roc_agg = sklearn roc_curve (drop_intermediate default true); with false every
#    distinct score is a point, which equals pROC coords(roc, "all") in fpr/tpr. pROC's
#    thresholds are midpoints between scores, so only sklearn's thresholds are checked.
#  * pr_agg = sklearn precision_recall_curve; its last point has a NULL threshold.
#  * calibration_agg = sklearn calibration_curve(strategy = "uniform"), bin zero-based,
#    conf_low/conf_high = R prop.test(x, n, correct = FALSE)$conf.int (Wilson).

require anofox_statistics

# 0.55 is tied across labels 1, 0, 1. Scores double as probabilities.
statement ok
CREATE TABLE d AS SELECT * FROM (VALUES
 (1, 1, 0.9), (2, 0, 0.1), (3, 1, 0.8), (4, 1, 0.65), (5, 0, 0.4), (6, 0, 0.3), (7, 1, 0.55),
 (8, 0, 0.55), (9, 1, 0.7), (10, 0, 0.2), (11, 1, 0.35), (12, 1, 0.95), (13, 0, 0.6), (14, 0, 0.05),
 (15, 1, 0.45), (16, 0, 0.5), (17, 0, 0.25), (18, 1, 0.75), (19, 1, 0.55), (20, 0, 0.15)
) t(id, y, s);

# ---------------------------------------------------------------------------
# roc_agg — sklearn roc_curve(y, s)
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE roc_ref AS SELECT * FROM (VALUES
 (1, 'inf'::DOUBLE, 0.0, 0.0), (2, 0.95, 0.0, 0.1), (3, 0.65, 0.0, 0.6), (4, 0.6, 0.1, 0.6),
 (5, 0.55, 0.2, 0.8), (6, 0.5, 0.3, 0.8), (7, 0.45, 0.3, 0.9), (8, 0.4, 0.4, 0.9), (9, 0.35, 0.4, 1.0),
 (10, 0.05, 1.0, 1.0)
) t(i, threshold, fpr, tpr);

query III
SELECT count(*), max(abs(p.fpr - r.fpr) + abs(p.tpr - r.tpr)) < 1e-12,
       bool_and(p.threshold = r.threshold)
FROM (SELECT unnest(range(1, len(c) + 1)) AS i, unnest(c) AS p FROM (SELECT roc_agg(y, s) AS c FROM d)) a
JOIN roc_ref r USING (i);
----
10	true	true

query I
SELECT len(roc_agg(y, s)) FROM d;
----
10

# drop_intermediate = false — sklearn roc_curve(y, s, drop_intermediate = False) and
# pROC coords(roc(y, s, direction = "<"), "all") (19 points).
statement ok
CREATE TABLE roc_all_ref AS SELECT * FROM (VALUES
 (1, 'inf'::DOUBLE, 0.0, 0.0), (2, 0.95, 0.0, 0.1), (3, 0.9, 0.0, 0.2), (4, 0.8, 0.0, 0.3),
 (5, 0.75, 0.0, 0.4), (6, 0.7, 0.0, 0.5), (7, 0.65, 0.0, 0.6), (8, 0.6, 0.1, 0.6), (9, 0.55, 0.2, 0.8),
 (10, 0.5, 0.3, 0.8), (11, 0.45, 0.3, 0.9), (12, 0.4, 0.4, 0.9), (13, 0.35, 0.4, 1.0), (14, 0.3, 0.5, 1.0),
 (15, 0.25, 0.6, 1.0), (16, 0.2, 0.7, 1.0), (17, 0.15, 0.8, 1.0), (18, 0.1, 0.9, 1.0), (19, 0.05, 1.0, 1.0)
) t(i, threshold, fpr, tpr);

query IIII
SELECT count(*), max(abs(p.fpr - r.fpr) + abs(p.tpr - r.tpr)) < 1e-12,
       bool_and(p.threshold = r.threshold), max(len_c)
FROM (SELECT len(c) AS len_c, unnest(range(1, len(c) + 1)) AS i, unnest(c) AS p
      FROM (SELECT roc_agg(y, s, false) AS c FROM d)) a
JOIN roc_all_ref r USING (i);
----
19	true	true	19

# ---------------------------------------------------------------------------
# auc_agg — sklearn roc_auc_score = pROC auc = 0.9
# ---------------------------------------------------------------------------
query I
SELECT abs(auc_agg(y, s) - 0.9) < 1e-12 FROM d;
----
true

# ---------------------------------------------------------------------------
# pr_agg — sklearn precision_recall_curve(y, s)
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE pr_ref AS SELECT * FROM (VALUES
 (1, 0.05, 1.0, 0.5), (2, 0.1, 1.0, 0.5263157894736842), (3, 0.15, 1.0, 0.5555555555555556),
 (4, 0.2, 1.0, 0.5882352941176471), (5, 0.25, 1.0, 0.625), (6, 0.3, 1.0, 0.6666666666666666),
 (7, 0.35, 1.0, 0.7142857142857143), (8, 0.4, 0.9, 0.6923076923076923), (9, 0.45, 0.9, 0.75),
 (10, 0.5, 0.8, 0.7272727272727273), (11, 0.55, 0.8, 0.8), (12, 0.6, 0.6, 0.8571428571428571),
 (13, 0.65, 0.6, 1.0), (14, 0.7, 0.5, 1.0), (15, 0.75, 0.4, 1.0), (16, 0.8, 0.3, 1.0), (17, 0.9, 0.2, 1.0),
 (18, 0.95, 0.1, 1.0), (19, NULL, 0.0, 1.0)
) t(i, threshold, recall, precision);

query III
SELECT count(*), max(abs(p.recall - r.recall) + abs(p.precision - r.precision)) < 1e-12,
       bool_and(p.threshold IS NOT DISTINCT FROM r.threshold)
FROM (SELECT unnest(range(1, len(c) + 1)) AS i, unnest(c) AS p FROM (SELECT pr_agg(y, s) AS c FROM d)) a
JOIN pr_ref r USING (i);
----
19	true	true

# ---------------------------------------------------------------------------
# calibration_agg — sklearn calibration_curve(y, s, n_bins = 5); Wilson CI = R prop.test(correct = FALSE)
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE cal_ref AS SELECT * FROM (VALUES
 (0, 4, 0.125, 0.0, 0.0, 0.48989083645459719, 0.0, 0.4034786252027045),
 (1, 4, 0.32499999999999996, 0.25, 0.045587260809700589, 0.69935815741759799, 0.057907321199858731, 0.6438319914014935),
 (2, 6, 0.5333333333333333, 0.5, 0.18761630648265057, 0.8123836935173494, 0.22125998614034889, 0.77874001385965119),
 (3, 4, 0.7250000000000001, 1.0, 0.51010916354540281, 1.0, 0.5965213747972955, 1.0),
 (4, 2, 0.925, 1.0, 0.3423802275066532, 1.0, 0.42503060900634659, 1.0)
) t(bin, n, mean_pred, frac_pos, lo95, hi95, lo90, hi90);

query IIII
SELECT count(*), bool_and(p.n = r.n),
       max(abs(p.mean_pred - r.mean_pred) + abs(p.frac_pos - r.frac_pos)) < 1e-12,
       max(abs(p.conf_low - r.lo95) + abs(p.conf_high - r.hi95)) < 1e-9
FROM (SELECT unnest(calibration_agg(y, s, 5)) AS p FROM d) a
JOIN cal_ref r ON p.bin = r.bin;
----
5	true	true	true

query II
SELECT count(*), max(abs(p.conf_low - r.lo90) + abs(p.conf_high - r.hi90)) < 1e-9
FROM (SELECT unnest(calibration_agg(y, s, 5, 0.9)) AS p FROM d) a
JOIN cal_ref r ON p.bin = r.bin;
----
5	true

# ---------------------------------------------------------------------------
# brier_agg / log_loss_agg — sklearn brier_score_loss, log_loss (= R by hand)
# ---------------------------------------------------------------------------
query II
SELECT abs(brier_agg(y, s) - 0.13787500000000003) < 1e-12, abs(log_loss_agg(y, s) - 0.4302192827867991) < 1e-12
FROM d;
----
true	true

# 0 and 1 are clipped to eps: sklearn log_loss([1, 0, 1], [1, 0, 0])
query I
SELECT abs(log_loss_agg(y, p) - 12.014551129705717) < 1e-9 FROM (VALUES (1, 1.0), (0, 0.0), (1, 0.0)) t(y, p);
----
true

# ---------------------------------------------------------------------------
# Degenerate inputs, as sklearn
# ---------------------------------------------------------------------------

# Constant scores: (0, 0) at +inf and (1, 1); AUC 0.5 (sklearn roc_curve / roc_auc_score)
query IIII
SELECT len(c), c[2].threshold, c[2].fpr, c[2].tpr FROM (
  SELECT roc_agg(y, s) AS c FROM (VALUES (0, 0.5), (1, 0.5), (0, 0.5), (1, 0.5)) t(y, s));
----
2	0.5	1.0	1.0

query I
SELECT auc_agg(y, s) FROM (VALUES (0, 0.5), (1, 0.5), (0, 0.5), (1, 0.5)) t(y, s);
----
0.5

# All positive: fpr is undefined (sklearn nan) -> NULL; tpr as sklearn; AUC NULL
query III
SELECT [p.fpr IS NULL FOR p IN c], [p.tpr FOR p IN c], a FROM (
  SELECT roc_agg(y, s) AS c, auc_agg(y, s) AS a FROM (VALUES (1, 0.2), (1, 0.4), (1, 0.6)) t(y, s));
----
[true, true, true]	[0.0, 0.3333333333333333, 1.0]	NULL
