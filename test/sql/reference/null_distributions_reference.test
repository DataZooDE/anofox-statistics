query II
SELECT count(*), max(abs(CASE kind WHEN 'q' THEN auc_null_quantile(x, n_pos, n_neg)
                                   ELSE auc_null_p_value(x, n_pos, n_neg) END - expected)) < 1e-10
FROM large_ref;
----
6	true

