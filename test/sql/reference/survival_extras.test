query IIIIIIIIII
SELECT count(*) = 111,
    bool_and(CASE WHEN r.surv IS NULL THEN a.surv IS NULL ELSE abs(a.surv - r.surv) <= 1e-09 * (1 + abs(r.surv)) END),
    bool_and(CASE WHEN r.n_risk IS NULL THEN a.n_risk IS NULL ELSE abs(a.n_risk - r.n_risk) <= 1e-09 * (1 + abs(r.n_risk)) END),
    bool_and(CASE WHEN r.n_event IS NULL THEN a.n_event IS NULL ELSE abs(a.n_event - r.n_event) <= 1e-09 * (1 + abs(r.n_event)) END),
    bool_and(CASE WHEN r.n_censor IS NULL THEN a.n_censor IS NULL ELSE abs(a.n_censor - r.n_censor) <= 1e-09 * (1 + abs(r.n_censor)) END),
    bool_and(CASE WHEN r.std_err IS NULL THEN a.std_err IS NULL ELSE abs(a.std_err - r.std_err) <= 1e-09 * (1 + abs(r.std_err)) END),
    bool_and(CASE WHEN r.conf_low IS NULL THEN a.conf_low IS NULL ELSE abs(a.conf_low - r.conf_low) <= 1e-09 * (1 + abs(r.conf_low)) END),
    bool_and(CASE WHEN r.conf_high IS NULL THEN a.conf_high IS NULL ELSE abs(a.conf_high - r.conf_high) <= 1e-09 * (1 + abs(r.conf_high)) END),
    bool_and(CASE WHEN r.cumhaz IS NULL THEN a.cumhaz IS NULL ELSE abs(a.cumhaz - r.cumhaz) <= 1e-09 * (1 + abs(r.cumhaz)) END),
    bool_and(CASE WHEN r.std_chaz IS NULL THEN a.std_chaz IS NULL ELSE abs(a.std_chaz - r.std_chaz) <= 1e-09 * (1 + abs(r.std_chaz)) END)
FROM (SELECT p.time AS k, p.surv, p.n_risk, p.n_event, p.n_censor, p.std_err, p.conf_low, p.conf_high, p.cumhaz, p.std_chaz FROM (SELECT unnest(kaplan_meier_agg(stop, event, [id, start], {'entry': 2, 'cluster': 1, 'robust': false, 'hazard': 'fleming-harrington'})) AS p FROM heart)) a JOIN ref_km_10 r USING (k);
----
true	true	true	true	true	true	true	true	true	true

# survdiff(Surv(time, ev) ~ sex, rho = 1) (Peto-Peto)
query IIII
SELECT
    abs((r.statistic) - (12.271912348506719)) <= 1e-09 * (1 + abs(12.271912348506719)),
    abs((r.df1) - (1)) <= 1e-09 * (1 + abs(1)),
    abs((r.p_value) - (0.00045982682310880912)) <= 1e-09 * (1 + abs(0.00045982682310880912)),
    abs((r.n) - (227)) <= 1e-09 * (1 + abs(227))
FROM (SELECT log_rank_test_agg(time, ev, sex::BIGINT, {'rho': 1}) AS r FROM lung);
----
true	true	true	true

# survdiff(Surv(time, ev) ~ ph.ecog, rho = 0.5) (3 groups)
query IIII
SELECT
    abs((r.statistic) - (23.322896802239885)) <= 1e-09 * (1 + abs(23.322896802239885)),
    abs((r.df1) - (3)) <= 1e-09 * (1 + abs(3)),
    abs((r.p_value) - (3.4584166987167833e-05)) <= 1e-09 * (1 + abs(3.4584166987167833e-05)),
    abs((r.n) - (227)) <= 1e-09 * (1 + abs(227))
FROM (SELECT log_rank_test_agg(time, ev, ecog::BIGINT, {'rho': 0.5}) AS r FROM lung);
----
true	true	true	true

# survdiff(Surv(time, ev) ~ sex + strata(ph.ecog))
query IIII
SELECT
    abs((r.statistic) - (10.795059633496416)) <= 1e-09 * (1 + abs(10.795059633496416)),
    abs((r.df1) - (1)) <= 1e-09 * (1 + abs(1)),
    abs((r.p_value) - (0.0010177133447241489)) <= 1e-09 * (1 + abs(0.0010177133447241489)),
    abs((r.n) - (227)) <= 1e-09 * (1 + abs(227))
FROM (SELECT log_rank_test_agg(time, ev, sex::VARCHAR, [ecog], {'strata': 1}) AS r FROM lung);
----
true	true	true	true

# survdiff(Surv(time, ev) ~ sex + strata(ph.ecog), rho = 1)
query IIII
SELECT
    abs((r.statistic) - (13.857772753375185)) <= 1e-09 * (1 + abs(13.857772753375185)),
    abs((r.df1) - (1)) <= 1e-09 * (1 + abs(1)),
    abs((r.p_value) - (0.00019717946562927035)) <= 1e-09 * (1 + abs(0.00019717946562927035)),
    abs((r.n) - (227)) <= 1e-09 * (1 + abs(227))
FROM (SELECT log_rank_test_agg(time, ev, sex::VARCHAR, [age, ecog], {'strata': 2, 'rho': 1}) AS r FROM lung);
----
true	true	true	true

# survdiff(Surv(time, ev) ~ sex) via the options form with rho = 0 (anofox-statistics path)
query IIII
SELECT
    abs((r.statistic) - (10.008173805698842)) <= 1e-09 * (1 + abs(10.008173805698842)),
    abs((r.df1) - (1)) <= 1e-09 * (1 + abs(1)),
    abs((r.p_value) - (0.0015584698175100436)) <= 1e-09 * (1 + abs(0.0015584698175100436)),
    abs((r.n) - (227)) <= 1e-09 * (1 + abs(227))
FROM (SELECT log_rank_test_agg(time, ev, sex::BIGINT, {'rho': 0}) AS r FROM lung);
----
true	true	true	true

