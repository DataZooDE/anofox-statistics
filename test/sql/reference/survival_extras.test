query IIIII
SELECT count(*) = 185,
    bool_and(CASE WHEN r.surv IS NULL THEN a.surv IS NULL ELSE abs(a.surv - r.surv) <= 1e-09 * (1 + abs(r.surv)) END),
    bool_and(CASE WHEN r.n_risk IS NULL THEN a.n_risk IS NULL ELSE abs(a.n_risk - r.n_risk) <= 1e-09 * (1 + abs(r.n_risk)) END),
    bool_and(CASE WHEN r.cumhaz IS NULL THEN a.cumhaz IS NULL ELSE abs(a.cumhaz - r.cumhaz) <= 1e-09 * (1 + abs(r.cumhaz)) END),
    bool_and(CASE WHEN r.std_chaz IS NULL THEN a.std_chaz IS NULL ELSE abs(a.std_chaz - r.std_chaz) <= 1e-09 * (1 + abs(r.std_chaz)) END)
FROM (SELECT p.time AS k, p.surv, p.n_risk, p.n_event, p.n_censor, p.std_err, p.conf_low, p.conf_high, p.cumhaz, p.std_chaz FROM (SELECT unnest(kaplan_meier_agg(time, ev, [w], {'weight': 1, 'robust': true, 'hazard': 'fleming-harrington'})) AS p FROM lung)) a JOIN ref_km_5 r USING (k);
----
true	true	true	true	true

# survfit(..., weights = w, robust = TRUE)
statement ok
CREATE TABLE ref_km_6 (k DOUBLE, surv DOUBLE, n_risk DOUBLE, n_event DOUBLE, n_censor DOUBLE, std_err DOUBLE, conf_low DOUBLE, conf_high DOUBLE, cumhaz DOUBLE, std_chaz DOUBLE);

