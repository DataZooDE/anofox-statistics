query IIIIIIIII
SELECT count(*) = 227,
    bool_and(CASE WHEN r.fitted IS NULL THEN a.fitted IS NULL ELSE abs(a.fitted - r.fitted) <= 1e-05 * (1 + abs(r.fitted)) END),
    bool_and(CASE WHEN r.std_residual IS NULL THEN a.std_residual IS NULL ELSE abs(a.std_residual - r.std_residual) <= 1e-05 * (1 + abs(r.std_residual)) END),
    bool_and(CASE WHEN r.residual IS NULL THEN a.residual IS NULL ELSE abs(a.residual - r.residual) <= 1e-05 * (1 + abs(r.residual)) END),
    bool_and(CASE WHEN r.s1 IS NULL THEN a.s1 IS NULL ELSE abs(a.s1 - r.s1) <= 1e-05 * (1 + abs(r.s1)) END),
    bool_and(CASE WHEN r.s2 IS NULL THEN a.s2 IS NULL ELSE abs(a.s2 - r.s2) <= 1e-05 * (1 + abs(r.s2)) END),
    bool_and(CASE WHEN r.s3 IS NULL THEN a.s3 IS NULL ELSE abs(a.s3 - r.s3) <= 1e-05 * (1 + abs(r.s3)) END),
    bool_and(CASE WHEN r.s4 IS NULL THEN a.s4 IS NULL ELSE abs(a.s4 - r.s4) <= 1e-05 * (1 + abs(r.s4)) END),
    bool_and(CASE WHEN r.s5 IS NULL THEN a.s5 IS NULL ELSE abs(a.s5 - r.s5) <= 1e-05 * (1 + abs(r.s5)) END)
FROM (SELECT rid AS k, fitted, std_residual, residual, score_contributions[1] AS s1, score_contributions[2] AS s2, score_contributions[3] AS s3, score_contributions[4] AS s4, score_contributions[5] AS s5 FROM aft_augment_by('lung', 1, time, [age, sex, ecog], ev, options := {'distribution': 'weibull'})) a JOIN ref_aft_weibull r USING (k);
----
true	true	true	true	true	true	true	true	true

# survreg(Surv(time, ev) ~ age + sex + ph.ecog, dist = 'lognormal'): lp, (log t - lp)/scale, -log S, score
statement ok
CREATE TABLE ref_aft_lognormal (k DOUBLE, fitted DOUBLE, std_residual DOUBLE, residual DOUBLE, s1 DOUBLE, s2 DOUBLE, s3 DOUBLE, s4 DOUBLE, s5 DOUBLE);

