query IIIIIIIIII
SELECT count(*) = 185,
    bool_and(CASE WHEN r.surv IS NULL THEN a.surv IS NULL ELSE abs(a.surv - r.surv) <= 1e-09 * (1 + abs(r.surv)) END),
    bool_and(CASE WHEN r.n_risk IS NULL THEN a.n_risk IS NULL ELSE abs(a.n_risk - r.n_risk) <= 1e-09 * (1 + abs(r.n_risk)) END),
    bool_and(CASE WHEN r.n_event IS NULL THEN a.n_event IS NULL ELSE abs(a.n_event - r.n_event) <= 1e-09 * (1 + abs(r.n_event)) END),
    bool_and(CASE WHEN r.n_censor IS NULL THEN a.n_censor IS NULL ELSE abs(a.n_censor - r.n_censor) <= 1e-09 * (1 + abs(r.n_censor)) END),
    bool_and(CASE WHEN r.std_err IS NULL THEN a.std_err IS NULL ELSE abs(a.std_err - r.std_err) <= 1e-09 * (1 + abs(r.std_err)) END),
    bool_and(CASE WHEN r.conf_low IS NULL THEN a.conf_low IS NULL ELSE abs(a.conf_low - r.conf_low) <= 1e-09 * (1 + abs(r.conf_low)) END),
    bool_and(CASE WHEN r.conf_high IS NULL THEN a.conf_high IS NULL ELSE abs(a.conf_high - r.conf_high) <= 1e-09 * (1 + abs(r.conf_high)) END),
    bool_and(CASE WHEN r.cumhaz IS NULL THEN a.cumhaz IS NULL ELSE abs(a.cumhaz - r.cumhaz) <= 1e-09 * (1 + abs(r.cumhaz)) END),
    bool_and(CASE WHEN r.std_chaz IS NULL THEN a.std_chaz IS NULL ELSE abs(a.std_chaz - r.std_chaz) <= 1e-09 * (1 + abs(r.std_chaz)) END)
FROM (SELECT p.time AS k, p.surv, p.n_risk, p.n_event, p.n_censor, p.std_err, p.conf_low, p.conf_high, p.cumhaz, p.std_chaz FROM (SELECT unnest(kaplan_meier_agg(time, ev, [w], {'weight': 1, 'robust': true})) AS p FROM lung)) a JOIN ref_km_6 r USING (k);
----
true	true	true	true	true	true	true	true	true	true

# survfit(..., robust = TRUE, conf.type = 'plain')
statement ok
