# coxph(Surv(time, ev) ~ age + sex + ph.ecog, lung): Efron
query IIIIII
SELECT
    abs((m.coefficients[1]) - (0.011066764560073482)) <= 1e-06 * (1 + abs(0.011066764560073482)),
    abs((m.coefficients[2]) - (-0.55261239570363097)) <= 1e-06 * (1 + abs(-0.55261239570363097)),
    abs((m.coefficients[3]) - (0.46372847537042766)) <= 1e-06 * (1 + abs(0.46372847537042766)),
    abs((m.std_errors[1]) - (0.0092674110137005283)) <= 1e-06 * (1 + abs(0.0092674110137005283)),
    abs((m.std_errors[2]) - (0.1677390537872635)) <= 1e-06 * (1 + abs(0.1677390537872635)),
    abs((m.std_errors[3]) - (0.11357726616199662)) <= 1e-06 * (1 + abs(0.11357726616199662))
FROM (SELECT cox_fit_agg(time, [age, sex, ecog], ev) AS m FROM lung);
----
true	true	true	true	true	true

