# residuals(coxph(Surv(start, stop, event) ~ age + surgery + strata(year > 3), heart))
query IIIIIII
SELECT max(abs(a.fitted - r.lp)) < 1e-6, max(abs(a.residual - r.mart)) < 1e-6,
    max(abs(a.deviance_residual - r.dev)) < 1e-6,
    max(greatest(abs(a.score_residuals[1] - r.sc1), abs(a.score_residuals[2] - r.sc2))) < 1e-6,
    max(greatest(abs(a.dfbeta[1] - r.dfb1), abs(a.dfbeta[2] - r.dfb2), abs(a.dfbetas[1] - r.dfbs1), abs(a.dfbetas[2] - r.dfbs2))) < 1e-6,
    max(greatest(abs(a.schoenfeld_residuals[1] - r.sch1), abs(a.schoenfeld_residuals[2] - r.sch2), abs(a.scaled_schoenfeld_residuals[1] - r.ssch1), abs(a.scaled_schoenfeld_residuals[2] - r.ssch2))) < 1e-6,
    bool_and((a.schoenfeld_residuals IS NULL) = (r.sch1 IS NULL))
FROM cox_augment_by('heart_g', g, stop, [age, surgery, start, yr3], event, options := {'entry': 3, 'strata': 4}) a JOIN res_heart r USING (rid);
----
true	true	true	true	true	true	true

# cox_tidy_by: log hazard ratios with inference
query IIIIII
SELECT
    abs((e[1]) - (0.011066764560073482)) <= 1e-06 * (1 + abs(0.011066764560073482)),
    abs((e[2]) - (-0.55261239570363097)) <= 1e-06 * (1 + abs(-0.55261239570363097)),
    abs((e[3]) - (0.46372847537042766)) <= 1e-06 * (1 + abs(0.46372847537042766)),
    abs((s[1]) - (0.0092674110137005283)) <= 1e-06 * (1 + abs(0.0092674110137005283)),
    abs((s[2]) - (0.1677390537872635)) <= 1e-06 * (1 + abs(0.1677390537872635)),
    abs((s[3]) - (0.11357726616199662)) <= 1e-06 * (1 + abs(0.11357726616199662))
FROM (SELECT list(estimate ORDER BY term) AS e, list(std_error ORDER BY term) AS s, list(conf_low ORDER BY term) AS l FROM cox_tidy_by('lung', 1, time, [age, sex, ecog], ev));
----
true	true	true	true	true	true

# cox_tidy_by: log hazard ratios with inference
query II
SELECT
    abs((l[1]) - (-0.0070970272567093835)) <= 1e-06 * (1 + abs(-0.0070970272567093835)),
    abs((l[3]) - (0.24112112423039456)) <= 1e-06 * (1 + abs(0.24112112423039456))
FROM (SELECT list(estimate ORDER BY term) AS e, list(std_error ORDER BY term) AS s, list(conf_low ORDER BY term) AS l FROM cox_tidy_by('lung', 1, time, [age, sex, ecog], ev));
----
true	true

