# residuals(...), Breslow ties, case weights: cox_augment_agg over the table
query IIIIIII
SELECT max(abs(a.fitted - r.lp)) < 1e-6, max(abs(a.residual - r.mart)) < 1e-6,
    max(abs(a.deviance_residual - r.dev)) < 1e-6,
    max(greatest(abs(a.score_residuals[1] - r.sc1), abs(a.score_residuals[2] - r.sc2))) < 1e-6,
    max(greatest(abs(a.dfbeta[1] - r.dfb1), abs(a.dfbeta[2] - r.dfb2), abs(a.dfbetas[1] - r.dfbs1), abs(a.dfbetas[2] - r.dfbs2))) < 1e-6,
    max(greatest(abs(a.schoenfeld_residuals[1] - r.sch1), abs(a.schoenfeld_residuals[2] - r.sch2), abs(a.scaled_schoenfeld_residuals[1] - r.ssch1), abs(a.scaled_schoenfeld_residuals[2] - r.ssch2))) < 1e-6,
    bool_and((a.schoenfeld_residuals IS NULL) = (r.sch1 IS NULL))
FROM (SELECT rid, x.linear_predictor AS fitted, x.martingale_residual AS residual, x.deviance_residual, x.score_residuals, x.dfbeta, x.dfbetas, x.schoenfeld_residuals, x.scaled_schoenfeld_residuals FROM (SELECT rid, (cox_augment_agg(time, [age, ecog], ev, w, {'ties': 'breslow'}) OVER (ORDER BY rid ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING))[row_number() OVER (ORDER BY rid)] AS x FROM lung)) a JOIN res_breslow_w r USING (rid);
----
true	true	true	true	true	true	true

statement ok
CREATE TABLE res_heart (rid INTEGER, lp DOUBLE, mart DOUBLE, dev DOUBLE, sc1 DOUBLE, sc2 DOUBLE, dfb1 DOUBLE, dfb2 DOUBLE, dfbs1 DOUBLE, dfbs2 DOUBLE, sch1 DOUBLE, sch2 DOUBLE, ssch1 DOUBLE, ssch2 DOUBLE);

