statement ok
CREATE TABLE got AS
SELECT 'threshold' AS case_name, * FROM cbpe_by('cb', chunk, y_true, score, is_ref)
UNION ALL
SELECT 'pred045', * FROM cbpe_by('cb', chunk, y_true, score, is_ref, prediction := pred045);

query II
SELECT count(*), count(n.case_name) FROM got g LEFT JOIN nml n USING (case_name, chunk, metric);
----
160	160

query IIII
SELECT is_reference, count(*), min(n), min(n_labelled) FROM got GROUP BY ALL ORDER BY ALL;
----
false	80	250	250
true	80	250	250

# Estimates, bands and realized values (relative tolerance; counts are up to 250).
query II
SELECT g.case_name,
       max(greatest(abs(g.estimate - n.value), abs(g.lower_confidence - n.lower_confidence),
                    abs(g.upper_confidence - n.upper_confidence), abs(g.realized - n.realized))
           / greatest(abs(n.value), 1)) < 1e-9
FROM got g JOIN nml n USING (case_name, chunk, metric)
GROUP BY ALL ORDER BY ALL;
----
pred045	true
threshold	true

query II
SELECT g.case_name, max(abs(g.sampling_error - n.sampling_error) / greatest(abs(n.sampling_error), 1e-3)) < 1e-9
FROM got g JOIN nml n USING (case_name, chunk, metric)
GROUP BY ALL ORDER BY ALL;
----
pred045	true
threshold	true

# The aggregates directly: the model fitted on the reference, estimated per chunk.
query II
WITH m AS (SELECT cbpe_fit_agg(y_true, score) AS m FROM cb WHERE is_ref),
e AS (SELECT chunk, cbpe_estimate_agg(m, score) AS e, cbpe_realized_agg(m, y_true, score) AS r
      FROM cb CROSS JOIN m GROUP BY chunk)
SELECT max(abs((e).roc_auc.value - n.value)) < 1e-12, max(abs((r).roc_auc - n.realized)) < 1e-12
FROM e JOIN nml n ON n.chunk = e.chunk AND n.case_name = 'threshold' AND n.metric = 'roc_auc';
----
true	true

query IIIIII
SELECT (m).calibration, (m).threshold, (m).n_reference, (m).model_type, (m).platt_a IS NULL,
       len((m).isotonic_x) = len((m).isotonic_y)
FROM (SELECT cbpe_fit_agg(y_true, score) AS m FROM cb WHERE is_ref);
----
isotonic	0.5	1000	cbpe	true	true
