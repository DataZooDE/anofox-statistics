# name: test/sql/reference/cbpe_reference.test
# description: CBPE (cbpe_fit_agg / cbpe_estimate_agg / cbpe_realized_agg / cbpe_by, #365) vs NannyML 0.13.1
# group: [reference]
#
# Reference values: validation/generators/make_reference_cbpe.py, NannyML 0.13.1
# CBPE(problem_type = "classification_binary", calibration = "isotonic",
# chunk_size = 250) fitted on rows 0..999 and estimated on rows 1000..1999
# (drift: x shifted by 0.8 from row 1500). Chunks 0-3 are NannyML's reference
# period, chunks 4-7 its analysis period. Case 'threshold': y_pred = score >= 0.5;
# case 'pred045': y_pred = score >= 0.45 given as the prediction column.
# The lowest-scored reference row is a negative: NannyML's ROC AUC sampling error
# drops a minority-class row with the lowest score, upstream does not (documented
# in anofox-statistics monitoring::cbpe), so the data avoid that case.

require anofox_statistics

statement ok
CREATE TABLE cb AS
SELECT i, i // 250 AS chunk, i < 1000 AS is_ref, score, u2 < p AS y_true, score >= 0.45 AS pred045
FROM (
    SELECT i, 1 / (1 + exp(-(0.8 * x + 0.3))) AS score, 1 / (1 + exp(-(1.5 * x - 0.7))) AS p, u2
    FROM (
        SELECT i, 4 * u1 - 2 + CASE WHEN i >= 1500 THEN 0.8 ELSE 0.0 END AS x, u2
        FROM (
            SELECT i, ((i * i * 7919 + i * 104729 + 13) % 1000003) / 1000003.0 AS u1,
                   ((i * i * 6271 + i * 15485863 + 500101) % 999983) / 999983.0 AS u2
            FROM range(2000) r(i)
        )
    )
);

statement ok
CREATE TABLE nml(case_name VARCHAR, chunk BIGINT, metric VARCHAR, value DOUBLE, sampling_error DOUBLE,
                 lower_confidence DOUBLE, upper_confidence DOUBLE, realized DOUBLE);

statement ok
