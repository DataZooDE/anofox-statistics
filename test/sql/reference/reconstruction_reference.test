CREATE TABLE metric AS SELECT * FROM (VALUES (0, 0.91::DOUBLE), (1, 0.93::DOUBLE), (2, 'NaN'::DOUBLE), (3, 0.92::DOUBLE), (4, 0.95::DOUBLE), (5, 0.9::DOUBLE)) t(chunk, value)

# StandardDeviationThreshold(3, 3)
query II
SELECT (abs((b).lower_threshold - 0.8703860483977444) <= 1e-9 * (1 + 0.8703860483977444)), (abs((b).upper_threshold - 0.9736139516022557) <= 1e-9 * (1 + 0.9736139516022557)) FROM (SELECT alert_band_agg(value) AS b FROM metric)
----
true	true

# StandardDeviationThreshold(3, 3), limits [0.9, 0.96]
query II
