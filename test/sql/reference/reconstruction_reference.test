# Row reconstruction errors of the first 10 analysis rows
query II
WITH m AS (SELECT pca_reconstruction_fit_agg([car_value, debt_to_income_ratio, loan_length, driver_tenure]) AS model FROM car_loan WHERE period = 'reference')
SELECT id, CASE WHEN id = 0 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.07196694659324049) <= 1e-9 * (1 + 0.07196694659324049)) WHEN id = 1 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.8992212708665701) <= 1e-9 * (1 + 0.8992212708665701)) WHEN id = 2 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.9052962960157289) <= 1e-9 * (1 + 0.9052962960157289)) WHEN id = 3 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.9076877797172773) <= 1e-9 * (1 + 0.9076877797172773)) WHEN id = 4 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.09019964341944514) <= 1e-9 * (1 + 0.09019964341944514)) WHEN id = 5 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.6082724325465039) <= 1e-9 * (1 + 0.6082724325465039)) WHEN id = 6 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.8244999760059792) <= 1e-9 * (1 + 0.8244999760059792)) WHEN id = 7 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.1597909888764451) <= 1e-9 * (1 + 0.1597909888764451)) WHEN id = 8 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.22915732288155088) <= 1e-9 * (1 + 0.22915732288155088)) WHEN id = 9 THEN (abs(pca_reconstruction_error(model, [car_value, debt_to_income_ratio, loan_length, driver_tenure]) - 0.40994093095365625) <= 1e-9 * (1 + 0.40994093095365625)) END
FROM car_loan, m WHERE period = 'analysis' AND id < 10 ORDER BY id
