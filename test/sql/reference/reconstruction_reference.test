statement ok
CREATE TABLE car_loan_nan AS SELECT id, chunk, period,
    CASE WHEN period = 'reference' AND id % 37 = 0 THEN NULL WHEN period = 'analysis' AND id >= 3 AND (id - 3) % 17 = 0 THEN NULL ELSE car_value END AS car_value,
    CASE WHEN period = 'analysis' AND id % 11 = 0 THEN NULL ELSE debt_to_income_ratio END AS debt_to_income_ratio,
    loan_length,
    CASE WHEN period = 'reference' AND id >= 5 AND (id - 5) % 53 = 0 THEN NULL ELSE driver_tenure END AS driver_tenure
FROM car_loan

query II
SELECT count(*) FILTER (WHERE car_value IS NULL), count(*) FILTER (WHERE driver_tenure IS NULL) FROM car_loan_nan
----
173	38

