    SELECT *, CASE WHEN chunk = 0 AND is_reference = true THEN [(abs(reconstruction_error - 0.6268584305010971) <= 1e-9 * (1 + 0.6268584305010971)), (abs(sampling_error - 0.023553122681339706) <= 1e-9 * (1 + 0.023553122681339706)), (abs(lower_confidence - 0.5561990624570781) <= 1e-9 * (1 + 0.5561990624570781)), (abs(upper_confidence - 0.6975177985451162) <= 1e-9 * (1 + 0.6975177985451162)), (abs(lower_threshold - 0.5971207594127048) <= 1e-9 * (1 + 0.5971207594127048)), (abs(upper_threshold - 0.6891619137516791) <= 1e-9 * (1 + 0.6891619137516791))]
