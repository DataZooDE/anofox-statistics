# quantile_fit_agg tau = 0.5, alpha = 0.0: QuantileRegressor coef_ / intercept_
query IIII
SELECT
    abs((m.intercept) - (2.0076155873472974)) <= 1e-6 * (1 + abs(2.0076155873472974)),
    abs((m.coefficients[1]) - (1.4510863758725931)) <= 1e-6 * (1 + abs(1.4510863758725931)),
    abs((m.coefficients[2]) - (-1.0383167192226448)) <= 1e-6 * (1 + abs(-1.0383167192226448)),
    abs((m.coefficients[3]) - (-0.0388411989086412)) <= 1e-6 * (1 + abs(-0.0388411989086412))
FROM (SELECT quantile_fit_agg(y, [x1, x2, x3], {'tau': 0.5, 'alpha': 0.0}) AS m FROM d);
----
true	true	true	true

# quantile_fit_agg tau = 0.5, alpha = 0.05: QuantileRegressor coef_ / intercept_
query IIII
SELECT
    abs((m.intercept) - (2.0184817985014574)) <= 1e-6 * (1 + abs(2.0184817985014574)),
    abs((m.coefficients[1]) - (1.294330864875318)) <= 1e-6 * (1 + abs(1.294330864875318)),
    abs((m.coefficients[2]) - (-0.8855567131868076)) <= 1e-6 * (1 + abs(-0.8855567131868076)),
    abs((m.coefficients[3]) - (0.0)) <= 1e-6 * (1 + abs(0.0))
FROM (SELECT quantile_fit_agg(y, [x1, x2, x3], {'tau': 0.5, 'alpha': 0.05}) AS m FROM d);
----
true	true	true	true

# quantile_fit_predict_agg tau = 0.5, alpha = 0.05: QuantileRegressor.predict
query IIII
SELECT
    abs((list_extract(p, 1).yhat) - (4.995)) <= 1e-6 * (1 + abs(4.995)),
    abs((list_extract(p, 10).yhat) - (3.1319152655515987)) <= 1e-6 * (1 + abs(3.1319152655515987)),
    abs((list_extract(p, 20).yhat) - (3.325733537547805)) <= 1e-6 * (1 + abs(3.325733537547805)),
    abs((list_extract(p, 40).yhat) - (2.7196235112827445)) <= 1e-6 * (1 + abs(2.7196235112827445))
FROM (SELECT quantile_fit_predict_agg(y, [x1, x2, x3], {'tau': 0.5, 'alpha': 0.05} ORDER BY id) AS p FROM d);
----
true	true	true	true

# quantile_fit_agg tau = 0.5, alpha = 0.2: QuantileRegressor coef_ / intercept_
query IIII
SELECT
    abs((m.intercept) - (1.825055605381166)) <= 1e-6 * (1 + abs(1.825055605381166)),
    abs((m.coefficients[1]) - (0.7345291479820626)) <= 1e-6 * (1 + abs(0.7345291479820626)),
    abs((m.coefficients[2]) - (0.0)) <= 1e-6 * (1 + abs(0.0)),
    abs((m.coefficients[3]) - (0.0)) <= 1e-6 * (1 + abs(0.0))
FROM (SELECT quantile_fit_agg(y, [x1, x2, x3], {'tau': 0.5, 'alpha': 0.2}) AS m FROM d);
----
true	true	true	true

# quantile_fit_agg alpha = 0.2: slopes sklearn sets to exactly 0
query II
SELECT
    abs(m.coefficients[2]) <= 1e-9,
    abs(m.coefficients[3]) <= 1e-9
FROM (SELECT quantile_fit_agg(y, [x1, x2, x3], {'tau': 0.5, 'alpha': 0.2}) AS m FROM d);
----
true	true

# quantile_fit_agg tau = 0.8, alpha = 0.1: QuantileRegressor coef_ / intercept_
query IIII
SELECT
    abs((m.intercept) - (3.416886323268206)) <= 1e-6 * (1 + abs(3.416886323268206)),
    abs((m.coefficients[1]) - (0.7838957963291896)) <= 1e-6 * (1 + abs(0.7838957963291896)),
    abs((m.coefficients[2]) - (0.0)) <= 1e-6 * (1 + abs(0.0)),
    abs((m.coefficients[3]) - (0.0)) <= 1e-6 * (1 + abs(0.0))
FROM (SELECT quantile_fit_agg(y, [x1, x2, x3], {'tau': 0.8, 'alpha': 0.1}) AS m FROM d);
----
true	true	true	true

# huber_fit_agg scale_method = 'joint', epsilon = 1.35, alpha = 0.0001: HuberRegressor coef_ / intercept_ / scale_ / outliers_
query IIIIII
SELECT
    abs((m.intercept) - (2.0219282313942593)) <= 1e-6 * (1 + abs(2.0219282313942593)),
    abs((m.coefficients[1]) - (1.4253639980190047)) <= 1e-6 * (1 + abs(1.4253639980190047)),
    abs((m.coefficients[2]) - (-0.9963043008671887)) <= 1e-6 * (1 + abs(-0.9963043008671887)),
    abs((m.coefficients[3]) - (-0.036222069135437)) <= 1e-6 * (1 + abs(-0.036222069135437)),
    abs((m.scale) - (0.34797594413790567)) <= 1e-6 * (1 + abs(0.34797594413790567)),
    m.n_outliers = 13
FROM (SELECT huber_fit_agg(y, [x1, x2, x3], {'scale_method': 'joint', 'epsilon': 1.35, 'alpha': 0.0001, 'tolerance': 1e-12}) AS m FROM d);
----
true	true	true	true	true	true

# huber_fit_predict_agg scale_method = 'joint': HuberRegressor.predict
query IIII
SELECT
    abs((list_extract(p, 1).yhat) - (5.2806055324333965)) <= 1e-6 * (1 + abs(5.2806055324333965)),
    abs((list_extract(p, 10).yhat) - (3.2355337936877424)) <= 1e-6 * (1 + abs(3.2355337936877424)),
    abs((list_extract(p, 20).yhat) - (3.511256142612069)) <= 1e-6 * (1 + abs(3.511256142612069)),
    abs((list_extract(p, 40).yhat) - (2.6993829906259754)) <= 1e-6 * (1 + abs(2.6993829906259754))
FROM (SELECT huber_fit_predict_agg(y, [x1, x2, x3], {'scale_method': 'joint', 'epsilon': 1.35, 'alpha': 0.0001, 'tolerance': 1e-12} ORDER BY id) AS p FROM d);
----
true	true	true	true

# huber_fit (scalar) scale_method = 'joint': HuberRegressor coef_
query III
SELECT
    abs((m.coefficients[1]) - (1.4253639980190047)) <= 1e-6 * (1 + abs(1.4253639980190047)),
    abs((m.coefficients[2]) - (-0.9963043008671887)) <= 1e-6 * (1 + abs(-0.9963043008671887)),
    abs((m.coefficients[3]) - (-0.036222069135437)) <= 1e-6 * (1 + abs(-0.036222069135437))
FROM (SELECT huber_fit(list(y ORDER BY id), [list(x1 ORDER BY id), list(x2 ORDER BY id), list(x3 ORDER BY id)], {'scale_method': 'joint', 'epsilon': 1.35, 'alpha': 0.0001, 'tolerance': 1e-12}) AS m FROM d);
----
true	true	true

# huber_fit_agg scale_method = 'joint', epsilon = 1.5, alpha = 0.1: HuberRegressor coef_ / intercept_ / scale_ / outliers_
query IIIIII
SELECT
    abs((m.intercept) - (2.019431671073335)) <= 1e-4 * (1 + abs(2.019431671073335)),
    abs((m.coefficients[1]) - (1.4324793237972537)) <= 1e-4 * (1 + abs(1.4324793237972537)),
    abs((m.coefficients[2]) - (-0.9676037599273156)) <= 1e-4 * (1 + abs(-0.9676037599273156)),
    abs((m.coefficients[3]) - (-0.03047967673610838)) <= 1e-4 * (1 + abs(-0.03047967673610838)),
    abs((m.scale) - (0.41733062163148926)) <= 1e-4 * (1 + abs(0.41733062163148926)),
    m.n_outliers = 11
FROM (SELECT huber_fit_agg(y, [x1, x2, x3], {'scale_method': 'joint', 'epsilon': 1.5, 'alpha': 0.1, 'tolerance': 1e-12}) AS m FROM d);
