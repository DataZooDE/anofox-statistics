# lowess_agg(y, x): R defaults (f = 2/3, iter = 3) on unsorted x with outliers
query IIIIIIIIIIIIIII
SELECT
    len(c) = 50,
    abs((c[1].x) - (0.22900000000000001)) <= 1e-08 * (1 + abs(0.22900000000000001)),
    abs((c[1].yhat) - (0.97443657477782197)) <= 1e-08 * (1 + abs(0.97443657477782197)),
    abs((c[2].x) - (0.28699999999999998)) <= 1e-08 * (1 + abs(0.28699999999999998)),
    abs((c[2].yhat) - (0.95772902187364461)) <= 1e-08 * (1 + abs(0.95772902187364461)),
    abs((c[13].x) - (2.161)) <= 1e-08 * (1 + abs(2.161)),
    abs((c[13].yhat) - (0.34185308830341271)) <= 1e-08 * (1 + abs(0.34185308830341271)),
    abs((c[25].x) - (5.5270000000000001)) <= 1e-08 * (1 + abs(5.5270000000000001)),
    abs((c[25].yhat) - (-0.38841595920968014)) <= 1e-08 * (1 + abs(-0.38841595920968014)),
    abs((c[26].x) - (5.71)) <= 1e-08 * (1 + abs(5.71)),
    abs((c[26].yhat) - (-0.32794076516315324)) <= 1e-08 * (1 + abs(-0.32794076516315324)),
    abs((c[38].x) - (7.2779999999999996)) <= 1e-08 * (1 + abs(7.2779999999999996)),
    abs((c[38].yhat) - (0.42011141787665357)) <= 1e-08 * (1 + abs(0.42011141787665357)),
    abs((c[50].x) - (9.4290000000000003)) <= 1e-08 * (1 + abs(9.4290000000000003)),
    abs((c[50].yhat) - (1.0771977684576373)) <= 1e-08 * (1 + abs(1.0771977684576373))
FROM (SELECT lowess_agg(y, x) AS c FROM s)
