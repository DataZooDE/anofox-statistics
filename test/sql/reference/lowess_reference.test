# lowess_by(..., frac := 0.4): one curve point per row, x increasing
query IIIII
SELECT
    count(*) = 50,
    bool_and(curve_type = 'lowess' AND model_id = 'lowess'),
    abs((list(y ORDER BY x)[1]) - (0.56534188342454306)) <= 1e-08 * (1 + abs(0.56534188342454306)),
    abs((list(y ORDER BY x)[25]) - (-0.59462118962638999)) <= 1e-08 * (1 + abs(-0.59462118962638999)),
    abs((list(y ORDER BY x)[50]) - (0.42915556641120256)) <= 1e-08 * (1 + abs(0.42915556641120256))
FROM lowess_by('s', 1, x, y, frac := 0.4)
----
true	true	true	true	true

