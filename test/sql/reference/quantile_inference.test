# n = 63, so n * tau is not an integer for the taus used and rq's solution is unique. The taus
# give an odd number (h + 1) of points to the median regression behind the 'iid' sparsity, so
# that regression has a unique slope too (with an even count R and upstream may pick different
# optimal slopes).
# summary.rq: statistic = estimate / se, two-sided t p-value with n - 3 df, CI estimate -/+ qt * se.

# tau = 0.2: coef(rq) and summary.rq(se = 'iid') intercept and slopes
query IIIIII
SELECT
    abs((r.intercept) - (0.61783650170525384)) <= 1e-06 * (1 + abs(0.61783650170525384)),
    abs((r.coefficients[1]) - (0.57259641639104408)) <= 1e-06 * (1 + abs(0.57259641639104408)),
    abs((r.coefficients[2]) - (-0.90058627760089838)) <= 1e-06 * (1 + abs(-0.90058627760089838)),
    abs((r.intercept_std_error) - (0.27393443837278836)) <= 1e-06 * (1 + abs(0.27393443837278836)),
    abs((r.std_errors[1]) - (0.044578930941516416)) <= 1e-06 * (1 + abs(0.044578930941516416)),
    abs((r.std_errors[2]) - (0.13141758920642824)) <= 1e-06 * (1 + abs(0.13141758920642824))
FROM (SELECT quantile_fit_agg(qy, [q1, q2], {'tau': 0.2, 'se': 'iid'}) AS r FROM d4) s;
----
true	true	true	true	true	true

