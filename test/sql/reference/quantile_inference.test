# xy-pair bootstrap: the generator differs from R's, so only a statistical check:
# 500 seeded resamples within 25% of summary.rq(se = 'boot', bsmethod = 'xy', R = 4000) = 0.271461, 0.059392, 0.204353.
query III
SELECT abs(r.intercept_std_error / 0.27146108264275759 - 1) < 0.25, abs(r.std_errors[1] / 0.059391967133066881 - 1) < 0.25, abs(r.std_errors[2] / 0.20435268948106894 - 1) < 0.25
FROM (SELECT quantile_fit_agg(qy, [q1, q2], {'se': 'boot', 'n_boot': 500, 'seed': 7}) AS r FROM d4) s;
----
true	true	true

# quantile_tidy_by computes 'nid' inference by default (summary.rq(se = 'nid') at tau = 0.5)
query III
SELECT
    abs((se[1]) - (0.27608425619882881)) <= 1e-06 * (1 + abs(0.27608425619882881)),
    abs((se[2]) - (0.064616681247066127)) <= 1e-06 * (1 + abs(0.064616681247066127)),
    abs((se[3]) - (0.19754254545547717)) <= 1e-06 * (1 + abs(0.19754254545547717))
FROM (SELECT list(std_error ORDER BY term) AS se FROM quantile_tidy_by('d4', 1, qy, [q1, q2])) s;
----
true	true	true

