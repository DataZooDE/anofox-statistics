   AND len(p.conf_high) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((p.conf_high)[_i] - ([1.6150628211626468, 1.0055722073331381, -0.43597189719292134])[_i]) / (1 + abs(([1.6150628211626468, 1.0055722073331381, -0.43597189719292134])[_i])))) <= 1e-7
