600	5	600

# the imputed values replay R's
query II
SELECT count(*), sum(CASE WHEN abs(i.x[e.col] - e.value) <= 1e-12 * (1 + abs(e.value)) THEN 1 ELSE 0 END)
FROM imp_w_expected e JOIN imp_w i ON i.imputation = e.imputation AND i.id = e.id;
----
185	185

# observed values are kept
query I
SELECT count(*) FROM imp_w i JOIN imp_data o ON i.id = o.id
WHERE i.x[1] IS DISTINCT FROM o.y OR i.x[4] IS DISTINCT FROM o.b
   OR (o.x1 IS NOT NULL AND i.x[2] <> o.x1) OR (o.x2 IS NOT NULL AND i.x[3] <> o.x2)
   OR (o.g IS NOT NULL AND i.x[5] <> o.g);
----
0

