# every completed data set has all rows, without missing values
query III
SELECT count(*), count(DISTINCT imputation), sum(CASE WHEN list_count(x) = 5 AND list_bool_and(list_transform(x, lambda v: isfinite(v))) THEN 1 ELSE 0 END) FROM imp_b;
----
240	2	240

# the imputed values replay R's
query II
SELECT count(*), sum(CASE WHEN abs(i.x[e.col] - e.value) <= 1e-12 * (1 + abs(e.value)) THEN 1 ELSE 0 END)
FROM imp_b_expected e JOIN imp_b i ON i.imputation = e.imputation AND i.id = e.id;
----
74	74

# observed values are kept
query I
SELECT count(*) FROM imp_b i JOIN imp_data o ON i.id = o.id
WHERE i.x[1] IS DISTINCT FROM o.y OR i.x[4] IS DISTINCT FROM o.b
   OR (o.x1 IS NOT NULL AND i.x[2] <> o.x1) OR (o.x2 IS NOT NULL AND i.x[3] <> o.x2)
   OR (o.g IS NOT NULL AND i.x[5] <> o.g);
----
0

# areg_impute_by: one group per copy of the data, each the same as the aggregate
query II
WITH two AS (SELECT 'A' AS grp, * FROM imp_data UNION ALL SELECT 'B' AS grp, * FROM imp_data)
SELECT count(*), sum(CASE WHEN abs(i.x[e.col] - e.value) <= 1e-12 * (1 + abs(e.value)) THEN 1 ELSE 0 END)
FROM imp_w_expected e JOIN areg_impute_by('two', grp, id, [y, x1, x2, b, g], options := {'seed': 7, 'categorical': [5]}) i
  ON i.imputation = e.imputation AND i.id = e.id;
----
370	370

# OLS y ~ x1 + x2 + b: mice::pool (Barnard-Rubin, dfcom = n - 4) and mice::D1
statement ok
CREATE OR REPLACE TABLE pooled AS SELECT pool_rubin_agg(fit) AS p FROM (SELECT imputation, ols_fit_agg(x[1], [x[2], x[3], x[4]], {'compute_inference': true}) AS fit FROM imp_w GROUP BY imputation);

query I
SELECT p.n_imputations = 5 AND abs((p.intercept) - (1.5096881133595463)) <= 1e-9 * (1 + abs(1.5096881133595463))
   AND len(p.coefficients) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((p.coefficients)[_i] - ([1.23081004108419, 0.44541482184560144, -0.93165918959096394])[_i]) / (1 + abs(([1.23081004108419, 0.44541482184560144, -0.93165918959096394])[_i])))) <= 1e-9
   AND abs((p.intercept_std_error) - (0.37098792110579737)) <= 1e-9 * (1 + abs(0.37098792110579737))
   AND len(p.std_errors) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((p.std_errors)[_i] - ([0.19383112897904969, 0.28224632558657348, 0.25020585024169972])[_i]) / (1 + abs(([0.19383112897904969, 0.28224632558657348, 0.25020585024169972])[_i])))) <= 1e-9
   AND len(p.t_values) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((p.t_values)[_i] - ([6.3499090552024926, 1.5781067155433322, -3.7235707665946975])[_i]) / (1 + abs(([6.3499090552024926, 1.5781067155433322, -3.7235707665946975])[_i])))) <= 1e-9
   AND len(p.df) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((p.df)[_i] - ([106.87417612645397, 97.322489240337305, 113.33006995101631])[_i]) / (1 + abs(([106.87417612645397, 97.322489240337305, 113.33006995101631])[_i])))) <= 1e-9
   AND abs((p.intercept_df) - (92.939653043190376)) <= 1e-9 * (1 + abs(92.939653043190376))
   AND len(p.p_values) = 3 AND list_max(list_transform(range(1, 4), lambda _i: abs((p.p_values)[_i] - ([5.3547655298316975e-09, 0.11778607609087018, 0.00030765351971922991])[_i]) / (1 + abs(([5.3547655298316975e-09, 0.11778607609087018, 0.00030765351971922991])[_i])))) <= 1e-9
