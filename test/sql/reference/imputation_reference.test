# every completed data set has all rows, without missing values
query III
SELECT count(*), count(DISTINCT imputation), sum(CASE WHEN list_count(x) = 5 AND list_bool_and(list_transform(x, lambda v: isfinite(v))) THEN 1 ELSE 0 END) FROM imp_w;
