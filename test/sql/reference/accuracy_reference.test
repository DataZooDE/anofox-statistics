# name: test/sql/reference/accuracy_reference.test
# description: #308 predictive accuracy indexes (concordance_agg, somers2_agg, rcorr_cens_agg, lrm_stats_agg, val_prob_agg, gini_md_agg, r2_measures) vs R rms / Hmisc / survival
# group: [reference]
#
# Reference values: validation/generators/make_reference_accuracy.R (rms 8.1.1,
# Hmisc 5.2.6, survival): lrm()$stats, somers2, survival::concordance,
# rcorr.cens, val.prob(pl = FALSE), GiniMd, R2Measures. lp / lpw are the linear
# predictors of lrm(y ~ x1 + x2) and lrm(y ~ x1 + x2, weights = w).
# rms prints the lrm p-value as 1 - pchisq(); the reference is the upper tail
# pchisq(lower.tail = FALSE), which keeps its digits below 1e-12.

require anofox_statistics

statement ok
CREATE MACRO close(a, b) AS abs(a - b) <= 1e-9 * (1 + abs(b));

statement ok
CREATE TABLE d AS SELECT * FROM (VALUES
 (0, 0, 1, 1, 1, 0, 0.55, 4.5, 0, 1.4758140192869569, 0.82008573559157194),
 (1, 1.17, 0.92, 1, 2, 1, 0.74, 5, 1, 5.1526123642948569, 4.2897161698404354),
