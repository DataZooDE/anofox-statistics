# ---------------------------------------------------------------------------
# lrm_stats_agg — rms::lrm(y ~ x1 + x2)$stats
# ---------------------------------------------------------------------------
query II
SELECT r.n, r.df FROM (SELECT lrm_stats_agg(y, lp, 2) r FROM d);
----
40	2.0

query IIIIIIIIIIIIIIII
SELECT close(r.sum_weights, 40),
       close(r.model_lr, 32.8356356117274),
       close(r.p_value, 7.41024081987806e-08),
       close(r.c, 0.962666666666667),
       close(r.dxy, 0.925333333333333),
       close(r.gamma, 0.925333333333333),
       close(r.tau_a, 0.444871794871795),
       close(r.r2, 0.763202434550781),
       close(r.r2_n, 0.559960547049591),
       close(r.r2_adj_n, 0.537399241848118),
       close(r.r2_ess, 0.688852830900714),
       close(r.r2_adj_ess, 0.665921122959832),
       close(r.brier, 0.0822474725574736),
       close(r.g, 3.85621929020954),
       close(r.gr, 47.2862374524455),
       close(r.gp, 0.438079278331159)
FROM (SELECT lrm_stats_agg(y, lp, 2) r FROM d);
----
true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true

# The effective sample size 3 n1 n0 / n of R2(28.1): n1 = 25, n0 = 15.
query I
SELECT close(r.ess, 3 * 25 * 15 / 40) FROM (SELECT lrm_stats_agg(y, lp, 2) r FROM d);
----
true

# Weighted: lrm(y ~ x1 + x2, weights = w)$stats (Sum of Weights 79, R2(79), R2(55.8))
query I
SELECT r.n FROM (SELECT lrm_stats_agg(y, lpw, 2, w) r FROM d);
----
40

query IIIIIIIIIIIIIIII
SELECT close(r.sum_weights, 79),
       close(r.model_lr, 62.0483237632296),
       close(r.p_value, 3.36029719280041e-14),
       close(r.c, 0.957142857142857),
       close(r.dxy, 0.914285714285714),
       close(r.gamma, 0.914285714285714),
       close(r.tau_a, 0.443710795642126),
       close(r.r2, 0.740273704241329),
       close(r.r2_n, 0.544072657956716),
       close(r.r2_adj_n, 0.532382845642475),
       close(r.r2_ess, 0.670942660812494),
       close(r.r2_adj_ess, 0.658939567420083),
       close(r.brier, 0.0910031292243255),
       close(r.g, 3.61052879937046),
       close(r.gr, 36.9856056095766),
       close(r.gp, 0.437396468716996)
FROM (SELECT lrm_stats_agg(y, lpw, 2, w) r FROM d);
----
true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true

# The effective sample size 3 n1 n0 / n with weighted class sizes (R2(55.8))
query I
SELECT close(r.ess, 3 * (SELECT sum(w * y) FROM d) * (SELECT sum(w * (1 - y)) FROM d) / 79.0)
FROM (SELECT lrm_stats_agg(y, lpw, 2, w) r FROM d);
----
true

# ---------------------------------------------------------------------------
# somers2_agg — Hmisc::somers2(p, y [, weights = w])
# ---------------------------------------------------------------------------
query III
SELECT close(r.c, 0.96),
       close(r.dxy, 0.92),
       close(r.n, 40)
FROM (SELECT somers2_agg(y, p) r FROM d);
----
true	true	true

query III
SELECT close(r.c, 0.953061224489796),
       close(r.dxy, 0.906122448979592),
       close(r.n, 79)
FROM (SELECT somers2_agg(y, p, w) r FROM d);
----
true	true	true

# ---------------------------------------------------------------------------
# concordance_agg — survival::concordance(yo ~ x1 [, weights = w])$count
# C = (concordant + tied_x / 2) / (concordant + discordant + tied_x)
# ---------------------------------------------------------------------------
query IIIII
SELECT r.concordant, r.discordant, r.tied_x, r.tied_y, r.tied_xy FROM (SELECT concordance_agg(yo, x1) r FROM d);
----
500.0	21.0	2.0	253.0	4.0

query IIIII
SELECT r.concordant, r.discordant, r.tied_x, r.tied_y, r.tied_xy FROM (SELECT concordance_agg(yo, x1, w) r FROM d);
----
1868.0	117.0	9.0	1026.0	9.0

query IIII
SELECT close(r.c, 501.0 / 523), close(r.dxy, 479.0 / 523), close(r.gamma, 479.0 / 521), close(r.tau_a, 479.0 / 780)
FROM (SELECT concordance_agg(yo, x1) r FROM d);
----
true	true	true	true

# ---------------------------------------------------------------------------
# rcorr_cens_agg — Hmisc::rcorr.cens(x1, Surv(tm, ev))
# ---------------------------------------------------------------------------
query III
SELECT r.n, r.missing, r.uncensored FROM (SELECT rcorr_cens_agg(tm, ev, x1) r FROM d);
----
40	0	30

query IIIIII
SELECT close(r.c, 0.591766723842196),
       close(r.dxy, 0.183533447684391),
       close(r.sd, 0.111949763956394),
       close(r.relevant_pairs, 1166),
       close(r.concordant, 690),
       close(r.uncertain, 382)
FROM (SELECT rcorr_cens_agg(tm, ev, x1) r FROM d);
----
true	true	true	true	true	true

# ---------------------------------------------------------------------------
# val_prob_agg — rms::val.prob(p, y, pl = FALSE)
# ---------------------------------------------------------------------------
query IIIIIIIIIIIIIIIIII
SELECT close(r.dxy, 0.92),
       close(r.c, 0.96),
       close(r.r2, 0.475865259350264),
       close(r.d, 0.40446327628372),
       close(r.d_chisq, 17.1785310513488),
       close(r.d_p, 3.40260134067405e-05),
       close(r.u, 0.338378076603335),
       close(r.u_chisq, 15.5351230641334),
       close(r.u_p, 0.000423244076608764),
       close(r.q, 0.0660851996803855),
       close(r.brier, 0.13443),
       close(r.intercept, 0.487046835446526),
       close(r.slope, 4.28157681439405),
       close(r.emax, 0.348084817466114),
       close(r.e90, 0.348084817466114),
       close(r.eavg, 0.214829478504524),
       close(r.s_z, -3.13127244001682),
       close(r.s_p, 0.00174050614466801)
FROM (SELECT val_prob_agg(y, p) r FROM d);
----
true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true

# Probabilities of exactly 1 (i = 0, y = 1) and 0 (i = 2, y = 1) are left out of the
# logistic calibration, but kept in the deviance of U as R does: the prediction 0 for an
# event gives U = Inf, U:p = 0 and Q = -Inf (anofox-regression 0.11.1).
query IIIIIIIIIIIIIIIIII
SELECT close(r.dxy, 0.92463768115942),
       close(r.c, 0.96231884057971),
       close(r.r2, 0.486723083289803),
       close(r.d, 0.419167812953069),
       close(r.d_chisq, 16.9283768922166),
       close(r.d_p, 3.88169487208767e-05),
       r.u = 'inf'::DOUBLE,
       r.u_chisq = 'inf'::DOUBLE,
       r.u_p = 0,
       r.q = '-inf'::DOUBLE,
       close(r.brier, 0.1531575),
       close(r.intercept, 0.395683601353857),
       close(r.slope, 4.15441363534747),
       close(r.emax, 0.552927884127489),
       close(r.e90, 0.268772011030087),
       close(r.eavg, 0.204561531237979),
       close(r.s_z, -2.05888392029457),
       close(r.s_p, 0.039505359815515)
FROM (SELECT val_prob_agg(y, CASE i WHEN 0 THEN 1.0 WHEN 2 THEN 0.0 ELSE p END) r FROM d);
----
true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true

# 1 for an event (i = 0), 0 and 1 for non-events (i = 5, 6): these rows drop out of the
# deviance of U as in R (sum(..., na.rm = TRUE)), so U and Q stay finite.
query IIIIIIIIIIIIIIIIII
SELECT close(r.dxy, 0.916666666666667),
       close(r.c, 0.958333333333333),
       close(r.r2, 0.457204402160318),
       close(r.d, 0.376697726784044),
       close(r.d_chisq, 14.9378158910096),
       close(r.d_p, 0.000111113290512388),
       close(r.u, 0.312828288725323),
       close(r.u_chisq, 13.5746466828369),
       close(r.u_p, 0.00112798396501623),
       close(r.q, 0.0638694380587216),
       close(r.brier, 0.149375),
       close(r.intercept, 0.426284411999167),
       close(r.slope, 4.03809434800062),
       close(r.emax, 0.301936464182272),
       close(r.e90, 0.282488871844998),
       close(r.eavg, 0.189646460849162),
       close(r.s_z, -1.9577226209014),
       close(r.s_p, 0.0502625693994085)
FROM (SELECT val_prob_agg(y, CASE i WHEN 0 THEN 1.0 WHEN 5 THEN 0.0 WHEN 6 THEN 1.0 ELSE p END) r FROM d);
----
true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true

# ---------------------------------------------------------------------------
# gini_md_agg — Hmisc::GiniMd; GiniMd(lp) is the lrm g-index
# ---------------------------------------------------------------------------
query II
SELECT close(gini_md_agg(x1), 1.22002564102564), close(gini_md_agg(lp), 3.85621929020954) FROM d;
----
true	true

# ---------------------------------------------------------------------------
# r2_measures — Hmisc::R2Measures(10, 2, 100 [, 60])
# ---------------------------------------------------------------------------
query IIII
SELECT close(r.r2, 0.0951625819640405), close(r.r2_adj, 0.0768836536133642),
       close(r.r2_ess, 0.153518275109386), close(r.r2_adj_ess, 0.124826680957053)
FROM (SELECT r2_measures(10, 2, 100, 60) r);
----
true	true	true	true

query IIII
SELECT close(r.r2, 0.0951625819640405), close(r.r2_adj, 0.0768836536133642), r.r2_ess IS NULL, r.r2_adj_ess IS NULL
FROM (SELECT r2_measures(10, 2, 100) r);
----
true	true	true	true
