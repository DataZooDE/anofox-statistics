# lr_test of nested ML fits = anova(full, reduced)
query III
SELECT
    abs((r.statistic) - (3.8904353493765029)) <= 1e-5 * (1 + abs(3.8904353493765029)),
    abs((r.p_value) - (0.048561834011427059)) <= 1e-5 * (1 + abs(0.048561834011427059)),
    abs((r.df1) - (1)) <= 1e-5 * (1 + abs(1))
FROM (SELECT lr_test(gls_fit_agg(y, [dose, week], subject, week, {'correlation': 'ar1', 'method': 'ml'}), gls_fit_agg(y, [dose], subject, week, {'correlation': 'ar1', 'method': 'ml'})) AS r FROM d) s;
----
true	true	true

