    abs((r.correlation_params[6]) - (0.6107222609159334)) <= 1e-4 * (1 + abs(0.6107222609159334))
FROM (SELECT gls_fit_agg(y, [dose, week], subject, week, {'correlation': 'unstructured', 'compute_inference': true}) AS r FROM d WHERE week <= 4) s;
