FROM (SELECT rn, l[rn] AS a FROM (SELECT row_number() OVER w AS rn, gls_augment_agg(y, [dose, week], subject, week, {'correlation': 'ar1'}) OVER w AS l FROM d WINDOW w AS (ORDER BY subject, week ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING))) WHERE rn IN (1, 2, 17, 40, 66);
