# corSymm(form = ~ week | subject) on weeks 1-4, REML: counts
query IIII
SELECT r.n_observations, r.n_groups, r.n_params, len(r.correlation_params) + len(r.variance_params) FROM (SELECT gls_fit_agg(y, [dose, week], subject, week, {'correlation': 'unstructured', 'compute_inference': true}) AS r FROM d WHERE week <= 4) s;
