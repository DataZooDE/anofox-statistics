    bool_and(abs((a).fitted - [3.1234355753240837, 3.4573027462941202, 3.1145570101474216, 2.3652392295646929, 0.83293136138301049][list_position([1, 2, 17, 40, 66], rn)]) <= 1e-5 * (1 + abs((a).fitted))),
    bool_and(abs((a).se_fit - [0.42170150536547207, 0.37558870368040903, 0.42158845993333655, 0.35707153747345732, 0.47591458233211137][list_position([1, 2, 17, 40, 66], rn)]) <= 1e-5 * (1 + abs((a).se_fit))),
