    abs((r.sigma) - (1.5749574245177056)) <= 1e-4 * (1 + abs(1.5749574245177056)),
    abs((r.log_likelihood) - (-70.764700540718536)) <= 1e-4 * (1 + abs(-70.764700540718536)),
    abs((r.aic) - (161.52940108143707)) <= 1e-4 * (1 + abs(161.52940108143707)),
    abs((r.bic) - (178.90609726427076)) <= 1e-4 * (1 + abs(178.90609726427076)),
    abs((r.df_residual) - (42)) <= 1e-4 * (1 + abs(42)),
    abs((r.correlation_params[1]) - (0.58811893421573813)) <= 1e-4 * (1 + abs(0.58811893421573813)),
    abs((r.correlation_params[2]) - (0.73950641585956578)) <= 1e-4 * (1 + abs(0.73950641585956578)),
    abs((r.correlation_params[3]) - (0.43769264671174224)) <= 1e-4 * (1 + abs(0.43769264671174224)),
