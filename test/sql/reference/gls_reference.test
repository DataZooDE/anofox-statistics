# corAR1 without intercept
query IIIIII
SELECT
    abs((r.coefficients[1]) - (1.1353414007716878)) <= 1e-5 * (1 + abs(1.1353414007716878)),
    abs((r.coefficients[2]) - (0.00058809988317794096)) <= 1e-5 * (1 + abs(0.00058809988317794096)),
