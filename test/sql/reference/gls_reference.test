    abs((r.std_errors[2]) - (0.092997479175310205)) <= 1e-5 * (1 + abs(0.092997479175310205)),
    abs((r.correlation_params[1]) - (0.64359432131574712)) <= 1e-5 * (1 + abs(0.64359432131574712)),
    abs((r.log_likelihood) - (-114.45227061688297)) <= 1e-5 * (1 + abs(-114.45227061688297))
FROM (SELECT gls_fit_agg(y, [dose, week], subject, week, {'correlation': 'ar1', 'fit_intercept': false, 'compute_inference': true}) AS r FROM d) s;
