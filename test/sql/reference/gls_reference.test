true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true	true

# corSymm(form = ~ week | subject) on weeks 1-4, REML: sigma, logLik, AIC, BIC, df, correlation / variance parameters
query IIIIIIIIIII
